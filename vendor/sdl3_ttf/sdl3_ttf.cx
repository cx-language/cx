extern void TTF_GetFreeTypeVersion(c_int*? major, c_int*? minor, c_int*? patch);
/// Query the version of the HarfBuzz library in use.
extern void TTF_GetHarfBuzzVersion(c_int*? major, c_int*? minor, c_int*? patch);
