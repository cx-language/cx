// SDL3_ttf bindings, translated from the system SDL3_ttf headers
// (generated from version 3.2.2; unused declarations cost nothing thanks to lazy checking).
// Doc comments derive in part from those headers (zlib license;
// Copyright (C) 2001-2025 Sam Lantinga <slouken@libsdl.org>).
// Covers SDL_ttf.h and SDL_textengine.h. Link requirements live in
// the build.cx next to this file. SDL types (SDL_Color, SDL_Surface,
// SDL_Renderer, ...) come from the sdl3 module, imported below, so
// fonts, surfaces, and renderers mix with plain sdl3 calls.
// Function-like macros are implemented as cx functions; string macros
// are const char* so they pass to char* params.
// Omitted on purpose: the SDL_INIT_INTERFACE version-init boilerplate
// for TTF_TextEngine (zero the struct and set version to
// sizeof(TTF_TextEngine) manually) and the TTF_TextEngine_SIZE
// compile-time assert (cx has its own assert).
// Nullability is semantic: 'T*?'/'T[*]?' iff the SDL_ttf API permits null
// there (out-params, userdata, optional args), else 'T*'/'T[*]'.
// Pointers to arrays use the indexable form (buffer+count params,
// plural/array params and returns). 'void*' stays opaque.

import sdl3;

/// Font style flags for TTF_Font.
using TTF_FontStyleFlags = Uint32;
/// Hinting level for font rendering.
using TTF_HintingFlags = c_int;
/// Horizontal alignment for wrapped text.
using TTF_HorizontalAlignment = c_int;
/// Text shaping direction.
using TTF_Direction = c_int;
/// Type of data in a glyph image.
using TTF_ImageType = c_int;
/// Font atlas draw command.
using TTF_DrawCommand = c_int;
/// Winding order of GPU text geometry.
using TTF_GPUTextEngineWinding = c_int;
/// Flags for TTF_SubString.
using TTF_SubStringFlags = Uint32;

/// Printable format major version.
const SDL_TTF_MAJOR_VERSION = 3;
/// Printable format minor version.
const SDL_TTF_MINOR_VERSION = 2;
/// Printable format micro version.
const SDL_TTF_MICRO_VERSION = 2;
/// This is the version number macro for the current SDL_ttf version.
const SDL_TTF_VERSION = 3002002;
/// No special style.
const TTF_STYLE_NORMAL = 0;
/// Bold style.
const TTF_STYLE_BOLD = 1;
/// Italic style.
const TTF_STYLE_ITALIC = 2;
/// Underlined text.
const TTF_STYLE_UNDERLINE = 4;
/// Strikethrough text.
const TTF_STYLE_STRIKETHROUGH = 8;
/// Thin (100) named font weight value.
const TTF_FONT_WEIGHT_THIN = 100;
/// ExtraLight (200) named font weight value.
const TTF_FONT_WEIGHT_EXTRA_LIGHT = 200;
/// Light (300) named font weight value.
const TTF_FONT_WEIGHT_LIGHT = 300;
/// Normal (400) named font weight value.
const TTF_FONT_WEIGHT_NORMAL = 400;
/// Medium (500) named font weight value.
const TTF_FONT_WEIGHT_MEDIUM = 500;
/// SemiBold (600) named font weight value.
const TTF_FONT_WEIGHT_SEMI_BOLD = 600;
/// Bold (700) named font weight value.
const TTF_FONT_WEIGHT_BOLD = 700;
/// ExtraBold (800) named font weight value.
const TTF_FONT_WEIGHT_EXTRA_BOLD = 800;
/// Black (900) named font weight value.
const TTF_FONT_WEIGHT_BLACK = 900;
/// ExtraBlack (950) named font weight value.
const TTF_FONT_WEIGHT_EXTRA_BLACK = 950;
/// Invalid hinting value.
const TTF_HINTING_INVALID = -1;
/// Normal hinting applies standard grid-fitting.
const TTF_HINTING_NORMAL = 0;
/// Light hinting applies subtle adjustments to improve rendering.
const TTF_HINTING_LIGHT = 1;
/// Monochrome hinting adjusts the font for better rendering at lower resolutions.
const TTF_HINTING_MONO = 2;
/// No hinting, the font is rendered without any grid-fitting.
const TTF_HINTING_NONE = 3;
/// Light hinting with subpixel rendering for more precise font edges.
const TTF_HINTING_LIGHT_SUBPIXEL = 4;
/// Invalid wrap alignment.
const TTF_HORIZONTAL_ALIGN_INVALID = -1;
/// Left-aligned wrapped text.
const TTF_HORIZONTAL_ALIGN_LEFT = 0;
/// Center-aligned wrapped text.
const TTF_HORIZONTAL_ALIGN_CENTER = 1;
/// Right-aligned wrapped text.
const TTF_HORIZONTAL_ALIGN_RIGHT = 2;
/// Invalid text direction.
const TTF_DIRECTION_INVALID = 0;
/// Left to right text.
const TTF_DIRECTION_LTR = 4;
/// Right to left text.
const TTF_DIRECTION_RTL = 5;
/// Top to bottom text.
const TTF_DIRECTION_TTB = 6;
/// Bottom to top text.
const TTF_DIRECTION_BTT = 7;
/// Invalid glyph image type.
const TTF_IMAGE_INVALID = 0;
/// Glyph color channels are white.
const TTF_IMAGE_ALPHA = 1;
/// Glyph color channels have image data.
const TTF_IMAGE_COLOR = 2;
/// Glyph alpha channel has signed distance field information.
const TTF_IMAGE_SDF = 3;
/// The mask for the flow direction for this substring.
const TTF_SUBSTRING_DIRECTION_MASK = 255;
/// This substring contains the beginning of the text.
const TTF_SUBSTRING_TEXT_START = 256;
/// This substring contains the beginning of a line.
const TTF_SUBSTRING_LINE_START = 512;
/// This substring contains the end of a line.
const TTF_SUBSTRING_LINE_END = 1024;
/// This substring contains the end of the text.
const TTF_SUBSTRING_TEXT_END = 2048;
/// No-op draw command.
const TTF_DRAW_COMMAND_NOOP = 0;
/// Filled rectangle draw command.
const TTF_DRAW_COMMAND_FILL = 1;
/// Texture copy draw command.
const TTF_DRAW_COMMAND_COPY = 2;
/// Invalid GPU text winding.
const TTF_GPU_TEXTENGINE_WINDING_INVALID = -1;
/// Clockwise GPU text winding.
const TTF_GPU_TEXTENGINE_WINDING_CLOCKWISE = 0;
/// Counter-clockwise GPU text winding.
const TTF_GPU_TEXTENGINE_WINDING_COUNTER_CLOCKWISE = 1;

/// The font file to open for TTF_OpenFontWithProperties.
const char* TTF_PROP_FONT_CREATE_FILENAME_STRING = "SDL_ttf.font.create.filename";
/// An SDL_IOStream containing the font for TTF_OpenFontWithProperties.
const char* TTF_PROP_FONT_CREATE_IOSTREAM_POINTER = "SDL_ttf.font.create.iostream";
/// The offset in the iostream for the beginning of the font.
const char* TTF_PROP_FONT_CREATE_IOSTREAM_OFFSET_NUMBER = "SDL_ttf.font.create.iostream.offset";
/// True if closing the font should also close the iostream.
const char* TTF_PROP_FONT_CREATE_IOSTREAM_AUTOCLOSE_BOOLEAN = "SDL_ttf.font.create.iostream.autoclose";
/// The point size of the font.
const char* TTF_PROP_FONT_CREATE_SIZE_FLOAT = "SDL_ttf.font.create.size";
/// The face index of the font, if it contains multiple faces.
const char* TTF_PROP_FONT_CREATE_FACE_NUMBER = "SDL_ttf.font.create.face";
/// The horizontal DPI to use for font rendering.
const char* TTF_PROP_FONT_CREATE_HORIZONTAL_DPI_NUMBER = "SDL_ttf.font.create.hdpi";
/// The vertical DPI to use for font rendering.
const char* TTF_PROP_FONT_CREATE_VERTICAL_DPI_NUMBER = "SDL_ttf.font.create.vdpi";
/// An existing font to copy data, size, and style from.
const char* TTF_PROP_FONT_CREATE_EXISTING_FONT = "SDL_ttf.font.create.existing_font";
/// The FT_Stroker_LineCap value used when setting the font outline.
const char* TTF_PROP_FONT_OUTLINE_LINE_CAP_NUMBER = "SDL_ttf.font.outline.line_cap";
/// The FT_Stroker_LineJoin value used when setting the font outline.
const char* TTF_PROP_FONT_OUTLINE_LINE_JOIN_NUMBER = "SDL_ttf.font.outline.line_join";
/// The FT_Fixed miter limit used when setting the font outline.
const char* TTF_PROP_FONT_OUTLINE_MITER_LIMIT_NUMBER = "SDL_ttf.font.outline.miter_limit";
/// The renderer to use for a renderer text engine.
const char* TTF_PROP_RENDERER_TEXT_ENGINE_RENDERER = "SDL_ttf.renderer_text_engine.create.renderer";
/// The size of the texture atlas for a renderer text engine.
const char* TTF_PROP_RENDERER_TEXT_ENGINE_ATLAS_TEXTURE_SIZE = "SDL_ttf.renderer_text_engine.create.atlas_texture_size";
/// The SDL_GPUDevice to use for a GPU text engine.
const char* TTF_PROP_GPU_TEXT_ENGINE_DEVICE = "SDL_ttf.gpu_text_engine.create.device";
/// The size of the texture atlas for a GPU text engine.
const char* TTF_PROP_GPU_TEXT_ENGINE_ATLAS_TEXTURE_SIZE = "SDL_ttf.gpu_text_engine.create.atlas_texture_size";

/// The internal structure containing font information. Opaque data!
struct TTF_Font {}
/// Private layout data in TTF_Text. Opaque data!
struct TTF_TextLayout {}

/// A text engine used to create text objects.
struct TTF_TextEngine {
    /// The version of this interface.
    Uint32 version;
    /// User data pointer passed to callbacks.
    void*? userdata;
    /// Create a text representation from draw instructions.
    bool(void*?, TTF_Text*)? CreateText;
    /// Destroy a text representation.
    void(void*?, TTF_Text*)? DestroyText;
}
/// A filled rectangle draw operation.
struct TTF_FillOperation {
    /// TTF_DRAW_COMMAND_FILL.
    TTF_DrawCommand cmd;
    /// The rectangle to fill, in pixels.
    SDL_Rect rect;
}
/// A texture copy draw operation.
struct TTF_CopyOperation {
    /// TTF_DRAW_COMMAND_COPY.
    TTF_DrawCommand cmd;
    /// The offset in the text corresponding to this glyph.
    c_int text_offset;
    /// The font containing the glyph to be drawn.
    TTF_Font* glyph_font;
    /// The glyph index of the glyph to be drawn.
    Uint32 glyph_index;
    /// The area within the glyph to be drawn.
    SDL_Rect src;
    /// The drawing coordinates of the glyph, in pixels.
    SDL_Rect dst;
    void*? reserved;
}
/// A text engine draw operation.
union TTF_DrawOperation {
    TTF_DrawCommand cmd;
    TTF_FillOperation fill;
    TTF_CopyOperation copy;
}
/// Internal data for TTF_Text.
struct TTF_TextData {
    /// The font used by this text, read-only.
    TTF_Font*? font;
    /// The color of the text, read-only.
    SDL_FColor color;
    /// True if the layout needs to be updated.
    bool needs_layout_update;
    /// Cached layout information, read-only.
    TTF_TextLayout*? layout;
    /// The x offset of the upper left corner of this text, in pixels, read-only.
    c_int x;
    /// The y offset of the upper left corner of this text, in pixels, read-only.
    c_int y;
    /// The width of this text, in pixels, read-only.
    c_int w;
    /// The height of this text, in pixels, read-only.
    c_int h;
    /// The number of drawing operations to render this text, read-only.
    c_int num_ops;
    /// The drawing operations used to render this text, read-only.
    TTF_DrawOperation[*]? ops;
    /// The number of glyph-cluster substrings in the string, read-only.
    c_int num_clusters;
    /// Substrings representing clusters of glyphs in the string, read-only.
    TTF_SubString[*]? clusters;
    /// Custom properties associated with this text, read-only.
    SDL_PropertiesID props;
    /// True if the engine text needs to be updated.
    bool needs_engine_update;
    /// The engine used to render this text, read-only.
    TTF_TextEngine*? engine;
    /// The implementation-specific representation of this text.
    void*? engine_text;
}
/// Text created with TTF_CreateText.
struct TTF_Text {
    /// A copy of the UTF-8 string that this text object represents.
    char* text;
    /// The number of lines in the text, 0 if it's empty.
    c_int num_lines;
    /// Application reference count, used when freeing surface.
    c_int refcount;
    /// Private data.
    TTF_TextData* internal;
}
/// The representation of a substring within text.
struct TTF_SubString {
    /// The flags for this substring.
    TTF_SubStringFlags flags;
    /// The byte offset from the beginning of the text.
    c_int offset;
    /// The byte length starting at the offset.
    c_int length;
    /// The index of the line that contains this substring.
    c_int line_index;
    /// The internal cluster index, used for quickly iterating.
    c_int cluster_index;
    /// The rectangle, relative to the top left of the text, containing the substring.
    SDL_Rect rect;
}
/// Draw sequence returned by TTF_GetGPUTextDrawData.
struct TTF_GPUAtlasDrawSequence {
    /// Texture atlas that stores the glyphs.
    SDL_GPUTexture* atlas_texture;
    /// An array of vertex positions.
    SDL_FPoint[*]? xy;
    /// An array of normalized texture coordinates for each vertex.
    SDL_FPoint[*]? uv;
    /// Number of vertices.
    c_int num_vertices;
    /// An array of indices into the vertex arrays.
    c_int[*]? indices;
    /// Number of indices.
    c_int num_indices;
    /// The image type of this draw sequence.
    TTF_ImageType image_type;
    /// The next sequence (NULL in case of the last sequence).
    TTF_GPUAtlasDrawSequence*? next;
}

