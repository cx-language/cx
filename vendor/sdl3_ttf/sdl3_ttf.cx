/// Calculate how much of a UTF-8 string will fit in a given width.
extern bool TTF_MeasureString(TTF_Font* font, char* text, c_size_t length, c_int max_width, c_int*? measured_width, c_size_t*? measured_length);
/// Render UTF-8 text at fast quality to a new 8-bit surface.
