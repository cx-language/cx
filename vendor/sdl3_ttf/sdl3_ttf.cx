extern float32 TTF_GetFontSize(TTF_Font* font);
/// Get font target resolutions, in dots per inch.
extern bool TTF_GetFontDPI(TTF_Font* font, c_int* hdpi, c_int* vdpi);
/// Set a font's current style.
extern void TTF_SetFontStyle(TTF_Font* font, TTF_FontStyleFlags style);
/// Query a font's current style.
extern TTF_FontStyleFlags TTF_GetFontStyle(TTF_Font* font);
/// Set a font's current outline.
extern bool TTF_SetFontOutline(TTF_Font* font, c_int outline);
/// Query a font's current outline.
extern c_int TTF_GetFontOutline(TTF_Font* font);
/// Set a font's current hinter setting.
extern void TTF_SetFontHinting(TTF_Font* font, TTF_HintingFlags hinting);
/// Query the number of faces of a font.
extern c_int TTF_GetNumFontFaces(TTF_Font* font);
/// Query a font's current FreeType hinter setting.
extern TTF_HintingFlags TTF_GetFontHinting(TTF_Font* font);
/// Enable Signed Distance Field rendering for a font.
extern bool TTF_SetFontSDF(TTF_Font* font, bool enabled);
/// Query whether Signed Distance Field rendering is enabled for a font.
extern bool TTF_GetFontSDF(TTF_Font* font);
/// Query a font's weight, in terms of the lightness/heaviness of the strokes.
extern c_int TTF_GetFontWeight(TTF_Font* font);
/// Set a font's current wrap alignment option.
extern void TTF_SetFontWrapAlignment(TTF_Font* font, TTF_HorizontalAlignment align);
/// Query a font's current wrap alignment option.
extern TTF_HorizontalAlignment TTF_GetFontWrapAlignment(TTF_Font* font);
/// Query the total height of a font.
extern c_int TTF_GetFontHeight(TTF_Font* font);
/// Query the offset from the baseline to the top of a font.
extern c_int TTF_GetFontAscent(TTF_Font* font);
/// Query the offset from the baseline to the bottom of a font.
extern c_int TTF_GetFontDescent(TTF_Font* font);
/// Set the spacing between lines of text for a font.
extern void TTF_SetFontLineSkip(TTF_Font* font, c_int lineskip);
/// Query the spacing between lines of text for a font.
extern c_int TTF_GetFontLineSkip(TTF_Font* font);
/// Set if kerning is enabled for a font.
extern void TTF_SetFontKerning(TTF_Font* font, bool enabled);
