extern Uint32 TTF_GetTextScript(TTF_Text* text);
/// Set the color of a text object.
extern bool TTF_SetTextColor(TTF_Text* text, Uint8 r, Uint8 g, Uint8 b, Uint8 a);
/// Set the color of a text object, with float components.
extern bool TTF_SetTextColorFloat(TTF_Text* text, float32 r, float32 g, float32 b, float32 a);
/// Get the color of a text object.
extern bool TTF_GetTextColor(TTF_Text* text, Uint8*? r, Uint8*? g, Uint8*? b, Uint8*? a);
/// Get the color of a text object, with float components.
extern bool TTF_GetTextColorFloat(TTF_Text* text, float32*? r, float32*? g, float32*? b, float32*? a);
/// Set the position of a text object.
extern bool TTF_SetTextPosition(TTF_Text* text, c_int x, c_int y);
/// Get the position of a text object.
extern bool TTF_GetTextPosition(TTF_Text* text, c_int*? x, c_int*? y);
/// Set whether wrapping is enabled on a text object.
extern bool TTF_SetTextWrapWidth(TTF_Text* text, c_int wrap_width);
/// Get whether wrapping is enabled on a text object.
extern bool TTF_GetTextWrapWidth(TTF_Text* text, c_int* wrap_width);
/// Set whether whitespace should be visible when wrapping a text object.
extern bool TTF_SetTextWrapWhitespaceVisible(TTF_Text* text, bool visible);
/// Return whether whitespace is shown when wrapping a text object.
extern bool TTF_TextWrapWhitespaceVisible(TTF_Text* text);
/// Set the UTF-8 text used by a text object.
extern bool TTF_SetTextString(TTF_Text* text, char*? string, c_size_t length);
/// Insert UTF-8 text into a text object.
extern bool TTF_InsertTextString(TTF_Text* text, c_int offset, char* string, c_size_t length);
/// Append UTF-8 text to a text object.
extern bool TTF_AppendTextString(TTF_Text* text, char* string, c_size_t length);
/// Delete UTF-8 text from a text object.
extern bool TTF_DeleteTextString(TTF_Text* text, c_int offset, c_int length);
/// Get the size of a text object.
extern bool TTF_GetTextSize(TTF_Text* text, c_int*? w, c_int*? h);
/// Get the substring of a text object that surrounds a text offset.
extern bool TTF_GetTextSubString(TTF_Text* text, c_int offset, TTF_SubString* substring);
/// Get the substring of a text object that contains the given line.
extern bool TTF_GetTextSubStringForLine(TTF_Text* text, c_int line, TTF_SubString* substring);
/// Get the substrings of a text object that contain a range of text.
extern TTF_SubString*[*]? TTF_GetTextSubStringsForRange(TTF_Text* text, c_int offset, c_int length, c_int*? count);
/// Get the portion of a text string that is closest to a point.
extern bool TTF_GetTextSubStringForPoint(TTF_Text* text, c_int x, c_int y, TTF_SubString* substring);
/// Get the previous substring in a text object.
extern bool TTF_GetPreviousTextSubString(TTF_Text* text, TTF_SubString* substring, TTF_SubString* previous);
/// Get the next substring in a text object.
extern bool TTF_GetNextTextSubString(TTF_Text* text, TTF_SubString* substring, TTF_SubString* next);
/// Update the layout of a text object.
extern bool TTF_UpdateText(TTF_Text* text);
/// Destroy a text object created by a text engine.
extern void TTF_DestroyText(TTF_Text* text);
/// Dispose of a previously-created font.
extern void TTF_CloseFont(TTF_Font*? font);
/// Deinitialize SDL_ttf.
extern void TTF_Quit();
/// Check if SDL_ttf is initialized.
extern c_int TTF_WasInit();

/// Determine if the SDL_ttf version is at least X.Y.Z.
bool SDL_TTF_VERSION_ATLEAST(c_int x, c_int y, c_int z) {
    return SDL_TTF_MAJOR_VERSION >= x && (SDL_TTF_MAJOR_VERSION > x || SDL_TTF_MINOR_VERSION >= y) && (SDL_TTF_MAJOR_VERSION > x || SDL_TTF_MINOR_VERSION > y || SDL_TTF_MICRO_VERSION >= z);
}
