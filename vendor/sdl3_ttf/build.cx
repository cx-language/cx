#if Windows
// pkg-config is not available on Windows; link the SDL3_ttf import library
// directly. Pass its directory with -L (see the example READMEs), e.g.
// vcpkg's installed/x64-windows/lib or the SDL3_ttf VC development libraries.
var libraries = ["SDL3_ttf"]
#else
var pkgConfigDependencies = ["sdl3-ttf"]
#endif
