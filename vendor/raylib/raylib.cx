extern c_uint rlLoadVertexArray();
/// Load a vertex buffer object.
extern c_uint rlLoadVertexBuffer(void*? buffer, c_int size, bool dynamic);
/// Load vertex buffer elements object.
extern c_uint rlLoadVertexBufferElement(void*? buffer, c_int size, bool dynamic);
/// Update vertex buffer object data on GPU buffer.
extern void rlUpdateVertexBuffer(c_uint bufferId, void*? data, c_int dataSize, c_int offset);
/// Update vertex buffer elements data on GPU buffer.
extern void rlUpdateVertexBufferElements(c_uint id, void*? data, c_int dataSize, c_int offset);
/// Unload vertex array (vao).
extern void rlUnloadVertexArray(c_uint vaoId);
/// Unload vertex buffer object.
extern void rlUnloadVertexBuffer(c_uint vboId);
/// Set vertex attribute data configuration.
extern void rlSetVertexAttribute(c_uint index, c_int compSize, c_int type, bool normalized, c_int stride, c_int offset);
/// Set vertex attribute data divisor.
extern void rlSetVertexAttributeDivisor(c_uint index, c_int divisor);
/// Set vertex attribute default value, when attribute to provided.
extern void rlSetVertexAttributeDefault(c_int locIndex, void*? value, c_int attribType, c_int count);
/// Draw vertex array (currently active vao).
extern void rlDrawVertexArray(c_int offset, c_int count);
/// Draw vertex array elements.
extern void rlDrawVertexArrayElements(c_int offset, c_int count, void*? buffer);
/// Draw vertex array (currently active vao) with instancing.
extern void rlDrawVertexArrayInstanced(c_int offset, c_int count, c_int instances);
/// Draw vertex array elements with instancing.
extern void rlDrawVertexArrayElementsInstanced(c_int offset, c_int count, void*? buffer, c_int instances);
/// Load texture data.
extern c_uint rlLoadTexture(void*? data, c_int width, c_int height, c_int format, c_int mipmapCount);
/// Load depth texture/renderbuffer (to be attached to fbo).
extern c_uint rlLoadTextureDepth(c_int width, c_int height, bool useRenderBuffer);
/// Load texture cubemap data.
extern c_uint rlLoadTextureCubemap(void*? data, c_int size, c_int format, c_int mipmapCount);
/// Update texture with new data on GPU.
extern void rlUpdateTexture(c_uint id, c_int offsetX, c_int offsetY, c_int width, c_int height, c_int format, void*? data);
/// Get OpenGL internal formats.
extern void rlGetGlTextureFormats(c_int format, c_uint*? glInternalFormat, c_uint*? glFormat, c_uint*? glType);
/// Get name string for pixel format.
extern char*? rlGetPixelFormatName(c_uint format);
/// Unload texture from GPU memory.
extern void rlUnloadTexture(c_uint id);
/// Generate mipmap data for selected texture.
extern void rlGenTextureMipmaps(c_uint id, c_int width, c_int height, c_int format, c_int*? mipmaps);
/// Read texture pixel data.
extern void*? rlReadTexturePixels(c_uint id, c_int width, c_int height, c_int format);
/// Read screen pixel data (color buffer).
extern c_uchar[*]? rlReadScreenPixels(c_int width, c_int height);
/// Load an empty framebuffer.
extern c_uint rlLoadFramebuffer();
/// Attach texture/renderbuffer to a framebuffer.
extern void rlFramebufferAttach(c_uint id, c_uint texId, c_int attachType, c_int texType, c_int mipLevel);
/// Verify framebuffer is complete.
extern bool rlFramebufferComplete(c_uint id);
/// Delete framebuffer from GPU.
extern void rlUnloadFramebuffer(c_uint id);
/// Copy framebuffer pixel data to internal buffer.
extern void rlCopyFramebuffer(c_int x, c_int y, c_int width, c_int height, c_int format, void*? pixels);
/// Resize internal framebuffer.
extern void rlResizeFramebuffer(c_int width, c_int height);
/// Load (compile) shader and return shader id (type: RL_VERTEX_SHADER, RL_FRAGMENT_SHADER, RL_COMPUTE_SHADER).
extern c_uint rlLoadShader(char*? code, c_int type);
/// Load shader from code strings.
extern c_uint rlLoadShaderProgram(char*? vsCode, char*? fsCode);
/// Load shader program, using already loaded shader ids.
extern c_uint rlLoadShaderProgramEx(c_uint vsId, c_uint fsId);
/// Load compute shader program.
extern c_uint rlLoadShaderProgramCompute(c_uint csId);
/// Unload shader, loaded with rlLoadShader().
extern void rlUnloadShader(c_uint id);
/// Unload shader program.
extern void rlUnloadShaderProgram(c_uint id);
/// Get shader location uniform, requires shader program id.
extern c_int rlGetLocationUniform(c_uint id, char*? uniformName);
/// Get shader location attribute, requires shader program id.
extern c_int rlGetLocationAttrib(c_uint id, char*? attribName);
/// Set shader value uniform.
extern void rlSetUniform(c_int locIndex, void*? value, c_int uniformType, c_int count);
/// Set shader value matrix.
extern void rlSetUniformMatrix(c_int locIndex, Matrix mat);
/// Set shader value matrices.
extern void rlSetUniformMatrices(c_int locIndex, Matrix[*]? mat, c_int count);
/// Set shader value sampler.
extern void rlSetUniformSampler(c_int locIndex, c_uint textureId);
/// Set shader currently active (id and locations).
extern void rlSetShader(c_uint id, c_int[*]? locs);
/// Dispatch compute shader (equivalent to *draw* for graphics pipeline).
extern void rlComputeShaderDispatch(c_uint groupX, c_uint groupY, c_uint groupZ);
/// Load shader storage buffer object (SSBO).
extern c_uint rlLoadShaderBuffer(c_uint size, void*? data, c_int usageHint);
/// Unload shader storage buffer object (SSBO).
extern void rlUnloadShaderBuffer(c_uint ssboId);
/// Update SSBO buffer data.
extern void rlUpdateShaderBuffer(c_uint id, void*? data, c_uint dataSize, c_uint offset);
/// Bind SSBO buffer.
extern void rlBindShaderBuffer(c_uint id, c_uint index);
/// Read SSBO buffer data (GPU->CPU).
extern void rlReadShaderBuffer(c_uint id, void*? dest, c_uint count, c_uint offset);
/// Copy SSBO data between buffers.
extern void rlCopyShaderBuffer(c_uint destId, c_uint srcId, c_uint destOffset, c_uint srcOffset, c_uint count);
/// Get SSBO buffer size.
extern c_uint rlGetShaderBufferSize(c_uint id);
/// Bind image texture.
extern void rlBindImageTexture(c_uint id, c_uint index, c_int format, bool readonly);
/// Get internal modelview matrix.
extern Matrix rlGetMatrixModelview();
/// Get internal projection matrix.
extern Matrix rlGetMatrixProjection();
/// Get internal accumulated transform matrix.
extern Matrix rlGetMatrixTransform();
/// Get internal projection matrix for stereo render (selected eye).
extern Matrix rlGetMatrixProjectionStereo(c_int eye);
/// Get internal view offset matrix for stereo render (selected eye).
extern Matrix rlGetMatrixViewOffsetStereo(c_int eye);
/// Set a custom projection matrix (replaces internal projection matrix).
extern void rlSetMatrixProjection(Matrix proj);
/// Set a custom modelview matrix (replaces internal modelview matrix).
extern void rlSetMatrixModelview(Matrix view);
/// Set eyes projection matrices for stereo rendering.
extern void rlSetMatrixProjectionStereo(Matrix right, Matrix left);
/// Set eyes view offsets matrices for stereo rendering.
extern void rlSetMatrixViewOffsetStereo(Matrix right, Matrix left);
/// Load and draw a cube.
extern void rlLoadDrawCube();
/// Load and draw a quad.
extern void rlLoadDrawQuad();
/// Returns the camera's forward direction.
extern Vector3 GetCameraForward(Camera*? camera);
/// Returns the camera's up direction.
extern Vector3 GetCameraUp(Camera*? camera);
/// Returns the camera's right direction.
extern Vector3 GetCameraRight(Camera*? camera);
/// Moves the camera forward by distance.
extern void CameraMoveForward(Camera*? camera, float32 distance, bool moveInWorldPlane);
/// Moves the camera up by distance.
extern void CameraMoveUp(Camera*? camera, float32 distance);
/// Moves the camera right by distance.
extern void CameraMoveRight(Camera*? camera, float32 distance, bool moveInWorldPlane);
/// Moves the camera toward its target.
extern void CameraMoveToTarget(Camera*? camera, float32 delta);
/// Yaws the camera by angle.
extern void CameraYaw(Camera*? camera, float32 angle, bool rotateAroundTarget);
/// Pitches the camera by angle.
extern void CameraPitch(Camera*? camera, float32 angle, bool lockView, bool rotateAroundTarget, bool rotateUp);
/// Rolls the camera by angle.
extern void CameraRoll(Camera*? camera, float32 angle);
/// Returns the camera's view matrix.
extern Matrix GetCameraViewMatrix(Camera*? camera);
/// Returns the camera's projection matrix.
extern Matrix GetCameraProjectionMatrix(Camera*? camera, float32 aspect);
