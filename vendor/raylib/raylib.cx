struct rAudioBuffer {}
struct rAudioProcessor {}

struct AudioStream {
    rAudioBuffer*? buffer;
    rAudioProcessor*? processor;
    c_uint sampleRate;
    c_uint sampleSize;
    c_uint channels;
}
struct AutomationEvent {
    c_uint frame;
    c_uint type;
    c_int[4] params;
}
struct AutomationEventList {
    c_uint capacity;
    c_uint count;
    AutomationEvent[*]? events;
}
struct BoneInfo {
    char[32] name;
    c_int parent;
}
struct BoundingBox {
    Vector3 min;
    Vector3 max;
}
struct Camera2D {
    Vector2 offset;
    Vector2 target;
    float32 rotation;
    float32 zoom;
}
struct Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    float32 fovy;
    c_int projection;
}
struct Color {
    c_uchar r;
    c_uchar g;
    c_uchar b;
    c_uchar a;
}
struct FilePathList {
    c_uint count;
    char*?[*]? paths;
}
struct Font {
    c_int baseSize;
    c_int glyphCount;
    c_int glyphPadding;
    Texture2D texture;
    Rectangle[*]? recs;
    GlyphInfo[*]? glyphs;
}
struct GlyphInfo {
    c_int value;
    c_int offsetX;
    c_int offsetY;
    c_int advanceX;
    Image image;
}
struct Image {
    void*? data;
    c_int width;
    c_int height;
    c_int mipmaps;
    c_int format;
}
struct Material {
    Shader shader;
    MaterialMap[*]? maps;
    float32[4] params;
}
struct MaterialMap {
    Texture2D texture;
    Color color;
    float32 value;
}
struct Matrix {
    float32 m0;
    float32 m4;
    float32 m8;
    float32 m12;
    float32 m1;
    float32 m5;
    float32 m9;
    float32 m13;
    float32 m2;
    float32 m6;
    float32 m10;
    float32 m14;
    float32 m3;
    float32 m7;
    float32 m11;
    float32 m15;
}
struct Mesh {
    c_int vertexCount;
    c_int triangleCount;
    float32[*]? vertices;
    float32[*]? texcoords;
    float32[*]? texcoords2;
    float32[*]? normals;
    float32[*]? tangents;
    c_uchar[*]? colors;
    c_ushort[*]? indices;
    c_int boneCount;
    c_uchar[*]? boneIndices;
    float32[*]? boneWeights;
    float32[*]? animVertices;
    float32[*]? animNormals;
    c_uint vaoId;
    c_uint[*]? vboId;
}
struct Model {
    Matrix transform;
    c_int meshCount;
    c_int materialCount;
    Mesh[*]? meshes;
    Material[*]? materials;
    c_int[*]? meshMaterial;
    ModelSkeleton skeleton;
    ModelAnimPose currentPose;
    Matrix[*]? boneMatrices;
}
struct ModelAnimation {
    char[32] name;
    c_int boneCount;
    c_int keyframeCount;
    ModelAnimPose[*]? keyframePoses;
}
struct ModelSkeleton {
    c_int boneCount;
    BoneInfo[*]? bones;
    ModelAnimPose bindPose;
}
struct Music {
    AudioStream stream;
    c_uint frameCount;
    bool looping;
    c_int ctxType;
    void*? ctxData;
}
struct NPatchInfo {
    Rectangle source;
    c_int left;
    c_int top;
    c_int right;
    c_int bottom;
    c_int layout;
}
struct Ray {
    Vector3 position;
    Vector3 direction;
}
struct RayCollision {
    bool hit;
    float32 distance;
    Vector3 point;
    Vector3 normal;
}
struct Rectangle {
    float32 x;
    float32 y;
    float32 width;
    float32 height;
}
struct RenderTexture {
    c_uint id;
    Texture texture;
    Texture depth;
}
struct Shader {
    c_uint id;
    c_int[*]? locs;
}
struct Sound {
    AudioStream stream;
    c_uint frameCount;
}
struct Texture {
    c_uint id;
    c_int width;
    c_int height;
    c_int mipmaps;
    c_int format;
}
struct Transform {
    Vector3 translation;
    Quaternion rotation;
    Vector3 scale;
}
struct Vector2 {
    float32 x;
    float32 y;
}
struct Vector3 {
    float32 x;
    float32 y;
    float32 z;
}
struct Vector4 {
    float32 x;
    float32 y;
    float32 z;
    float32 w;
}
struct VrDeviceInfo {
    c_int hResolution;
    c_int vResolution;
    float32 hScreenSize;
    float32 vScreenSize;
    float32 eyeToScreenDistance;
    float32 lensSeparationDistance;
    float32 interpupillaryDistance;
    float32[4] lensDistortionValues;
    float32[4] chromaAbCorrection;
}
struct VrStereoConfig {
    Matrix[2] projection;
    Matrix[2] viewOffset;
    float32[2] leftLensCenter;
    float32[2] rightLensCenter;
    float32[2] leftScreenCenter;
    float32[2] rightScreenCenter;
    float32[2] scale;
    float32[2] scaleIn;
}
struct Wave {
    c_uint frameCount;
    c_uint sampleRate;
    c_uint sampleSize;
    c_uint channels;
    void*? data;
}
struct rlDrawCall {
    c_int mode;
    c_int vertexCount;
    c_int vertexAlignment;
    c_uint textureId;
}
struct rlRenderBatch {
    c_int bufferCount;
    c_int currentBuffer;
    rlVertexBuffer[*]? vertexBuffer;
    rlDrawCall[*]? draws;
    c_int drawCounter;
    float32 currentDepth;
}
struct rlVertexBuffer {
    c_int elementCount;
    float32[*]? vertices;
    float32[*]? texcoords;
    float32[*]? normals;
    c_uchar[*]? colors;
    c_uint[*]? indices;
    c_uint vaoId;
    c_uint[5] vboId;
}

