// raylib bindings, translated from the system raylib headers
// (generated from version 6.0.0; unused declarations cost nothing thanks to lazy checking).
// Doc comments derive in part from those headers (zlib license;
// Copyright (c) 2013-2026 Ramon Santamaria (@raysan5)).
// Covers raylib.h, rlgl.h, and rcamera.h. Link requirements live in
// the build.cx next to this file.
// Omitted on purpose: raymath.h (static inline only, no out-of-line
// symbols), the TraceLogCallback typedef and SetTraceLogCallback (cx
// cannot name a va_list), the GetMouseRay alias (use
// GetScreenToWorldRay), the color macros (RED, BLUE, ... are C
// compound literals, which no cx holds; write Color(r = ..., ...)
// instead), function-like macros (RL_MALLOC, TRACELOG, ...), string
// macros (pass literals), and the double macros (RL_CULL_DISTANCE_*,
// CAMERA_CULL_DISTANCE_*): float literals infer float32, so no const
// holds them exactly. The rlgl declarations assume desktop OpenGL
// (GRAPHICS_API_OPENGL_11/33): other GL flavors change
// RL_DEFAULT_BATCH_BUFFER_ELEMENTS and rlVertexBuffer.indices.
// C pointers to single items become 'T*?'; pointers to arrays become
// the indexable 'T[*]?' (nullability still matches header imports, so
// header-imported code migrates unchanged).

/// Color blending modes (pre-defined).
using BlendMode = c_int;
/// Camera system modes.
using CameraMode = c_int;
/// Camera projection.
using CameraProjection = c_int;
/// System and window config flags.
using ConfigFlags = c_int;
/// Cubemap layouts.
using CubemapLayout = c_int;
/// Font type, defines generation method.
using FontType = c_int;
/// Gamepad axes.
using GamepadAxis = c_int;
/// Gamepad buttons.
using GamepadButton = c_int;
/// Gesture.
using Gesture = c_int;
/// Keyboard keys (US keyboard layout).
using KeyboardKey = c_int;
/// Material map index.
using MaterialMapIndex = c_int;
/// Mouse buttons.
using MouseButton = c_int;
/// Mouse cursor.
using MouseCursor = c_int;
/// N-patch layout.
using NPatchLayout = c_int;
/// Pixel formats.
using PixelFormat = c_int;
/// Shader attribute data types.
using ShaderAttributeDataType = c_int;
/// Shader location index.
using ShaderLocationIndex = c_int;
/// Shader uniform data type.
using ShaderUniformDataType = c_int;
/// Texture parameters: filter mode.
using TextureFilter = c_int;
/// Texture parameters: wrap mode.
using TextureWrap = c_int;
/// Trace log level.
using TraceLogLevel = c_int;
/// Color blending modes (pre-defined).
using rlBlendMode = c_int;
/// Face culling mode.
using rlCullMode = c_int;
/// Framebuffer texture attachment type.
using rlFramebufferAttachTextureType = c_int;
/// Framebuffer attachment type.
using rlFramebufferAttachType = c_int;
/// OpenGL version.
using rlGlVersion = c_int;
/// Texture pixel formats.
using rlPixelFormat = c_int;
/// Shader attribute data types.
using rlShaderAttributeDataType = c_int;
/// Shader location point type.
using rlShaderLocationIndex = c_int;
/// Shader uniform data type.
using rlShaderUniformDataType = c_int;
/// Texture parameters: filter mode.
using rlTextureFilter = c_int;
/// Trace log level.
using rlTraceLogLevel = c_int;

/// Set to try enabling V-Sync on GPU.
const FLAG_VSYNC_HINT = 64;
/// Set to run program in fullscreen.
const FLAG_FULLSCREEN_MODE = 2;
/// Set to allow resizable window.
const FLAG_WINDOW_RESIZABLE = 4;
/// Set to disable window decoration (frame and buttons).
const FLAG_WINDOW_UNDECORATED = 8;
/// Set to hide window.
const FLAG_WINDOW_HIDDEN = 128;
/// Set to minimize window (iconify).
const FLAG_WINDOW_MINIMIZED = 512;
/// Set to maximize window (expanded to monitor).
const FLAG_WINDOW_MAXIMIZED = 1024;
/// Set to window non focused.
const FLAG_WINDOW_UNFOCUSED = 2048;
/// Set to window always on top.
const FLAG_WINDOW_TOPMOST = 4096;
/// Set to allow windows running while minimized.
const FLAG_WINDOW_ALWAYS_RUN = 256;
/// Set to allow transparent framebuffer.
const FLAG_WINDOW_TRANSPARENT = 16;
/// Set to support HighDPI.
const FLAG_WINDOW_HIGHDPI = 8192;
/// Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED.
const FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384;
/// Set to run program in borderless windowed mode.
const FLAG_BORDERLESS_WINDOWED_MODE = 32768;
/// Set to try enabling MSAA 4X.
const FLAG_MSAA_4X_HINT = 32;
/// Set to try enabling interlaced video format (for V3D).
const FLAG_INTERLACED_HINT = 65536;
/// Display all logs.
const LOG_ALL = 0;
/// Trace logging, intended for internal use only.
const LOG_TRACE = 1;
/// Debug logging, used for internal debugging, it should be disabled on release builds.
const LOG_DEBUG = 2;
/// Info logging, used for program execution info.
const LOG_INFO = 3;
/// Warning logging, used on recoverable failures.
const LOG_WARNING = 4;
/// Error logging, used on unrecoverable failures.
const LOG_ERROR = 5;
/// Fatal logging, used to abort program: exit(EXIT_FAILURE).
const LOG_FATAL = 6;
/// Disable logging.
const LOG_NONE = 7;
