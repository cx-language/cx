/// NOTE: Actual structs are defined internally in raudio module.
struct rAudioBuffer {}
/// An opaque handle to an audio stream processor.
struct rAudioProcessor {}

/// AudioStream, custom audio stream.
struct AudioStream {
    rAudioBuffer*? buffer;
    rAudioProcessor*? processor;
    c_uint sampleRate;
    c_uint sampleSize;
    c_uint channels;
}
/// Automation event.
struct AutomationEvent {
    c_uint frame;
    c_uint type;
    c_int[4] params;
}
/// Automation event list.
struct AutomationEventList {
    c_uint capacity;
    c_uint count;
    AutomationEvent[*]? events;
}
/// Bone, skeletal animation bone.
struct BoneInfo {
    char[32] name;
    c_int parent;
}
/// BoundingBox.
struct BoundingBox {
    Vector3 min;
    Vector3 max;
}
/// Camera2D, defines position/orientation in 2d space.
struct Camera2D {
    Vector2 offset;
    Vector2 target;
    float32 rotation;
    float32 zoom;
}
/// Camera, defines position/orientation in 3d space.
struct Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    float32 fovy;
    c_int projection;
}
/// Color, 4 components, R8G8B8A8 (32bit).
struct Color {
    c_uchar r;
    c_uchar g;
    c_uchar b;
    c_uchar a;
}
/// File path list.
struct FilePathList {
    c_uint count;
    char*?[*]? paths;
}
/// Font, font texture and GlyphInfo array data.
struct Font {
    c_int baseSize;
    c_int glyphCount;
    c_int glyphPadding;
    Texture2D texture;
    Rectangle[*]? recs;
    GlyphInfo[*]? glyphs;
}
/// GlyphInfo, font characters glyphs info.
struct GlyphInfo {
    c_int value;
    c_int offsetX;
    c_int offsetY;
    c_int advanceX;
    Image image;
}
/// Image, pixel data stored in CPU memory (RAM).
struct Image {
    void*? data;
    c_int width;
    c_int height;
    c_int mipmaps;
    c_int format;
}
/// Material, includes shader and maps.
struct Material {
    Shader shader;
    MaterialMap[*]? maps;
    float32[4] params;
}
/// MaterialMap.
struct MaterialMap {
    Texture2D texture;
    Color color;
    float32 value;
}
/// Matrix, 4x4 components, column major, OpenGL style, right-handed.
struct Matrix {
    float32 m0;
    float32 m4;
    float32 m8;
    float32 m12;
    float32 m1;
    float32 m5;
    float32 m9;
    float32 m13;
    float32 m2;
    float32 m6;
    float32 m10;
    float32 m14;
    float32 m3;
    float32 m7;
    float32 m11;
    float32 m15;
}
/// Mesh, vertex data and vao/vbo.
struct Mesh {
    c_int vertexCount;
    c_int triangleCount;
    float32[*]? vertices;
    float32[*]? texcoords;
    float32[*]? texcoords2;
    float32[*]? normals;
    float32[*]? tangents;
    c_uchar[*]? colors;
    c_ushort[*]? indices;
    c_int boneCount;
    c_uchar[*]? boneIndices;
    float32[*]? boneWeights;
    float32[*]? animVertices;
    float32[*]? animNormals;
    c_uint vaoId;
    c_uint[*]? vboId;
}
/// Model, meshes, materials and animation data.
struct Model {
    Matrix transform;
    c_int meshCount;
    c_int materialCount;
    Mesh[*]? meshes;
    Material[*]? materials;
    c_int[*]? meshMaterial;
    ModelSkeleton skeleton;
    ModelAnimPose currentPose;
    Matrix[*]? boneMatrices;
}
/// ModelAnimation, contains a full animation sequence.
struct ModelAnimation {
    char[32] name;
    c_int boneCount;
    c_int keyframeCount;
    ModelAnimPose[*]? keyframePoses;
}
/// Skeleton, animation bones hierarchy.
struct ModelSkeleton {
    c_int boneCount;
    BoneInfo[*]? bones;
    ModelAnimPose bindPose;
}
/// Music, audio stream, anything longer than ~10 seconds should be streamed.
struct Music {
    AudioStream stream;
    c_uint frameCount;
    bool looping;
    c_int ctxType;
    void*? ctxData;
}
/// NPatchInfo, n-patch layout info.
struct NPatchInfo {
    Rectangle source;
    c_int left;
    c_int top;
    c_int right;
    c_int bottom;
    c_int layout;
}
/// Ray, ray for raycasting.
struct Ray {
    Vector3 position;
    Vector3 direction;
}
/// RayCollision, ray hit information.
struct RayCollision {
    bool hit;
    float32 distance;
    Vector3 point;
    Vector3 normal;
}
/// Rectangle, 4 components.
struct Rectangle {
    float32 x;
    float32 y;
    float32 width;
    float32 height;
}
/// RenderTexture, fbo for texture rendering.
struct RenderTexture {
    c_uint id;
    Texture texture;
    Texture depth;
}
/// Shader.
struct Shader {
    c_uint id;
    c_int[*]? locs;
}
/// Sound.
struct Sound {
    AudioStream stream;
    c_uint frameCount;
}
/// Texture, tex data stored in GPU memory (VRAM).
struct Texture {
    c_uint id;
    c_int width;
    c_int height;
    c_int mipmaps;
    c_int format;
}
/// Transform, vertex transformation data.
struct Transform {
    Vector3 translation;
    Quaternion rotation;
    Vector3 scale;
}
/// Vector2, 2 components.
struct Vector2 {
    float32 x;
    float32 y;
}
/// Vector3, 3 components.
struct Vector3 {
    float32 x;
    float32 y;
    float32 z;
}
/// Vector4, 4 components.
struct Vector4 {
    float32 x;
    float32 y;
    float32 z;
    float32 w;
}
/// VrDeviceInfo, Head-Mounted-Display device parameters.
struct VrDeviceInfo {
    c_int hResolution;
    c_int vResolution;
    float32 hScreenSize;
    float32 vScreenSize;
    float32 eyeToScreenDistance;
    float32 lensSeparationDistance;
    float32 interpupillaryDistance;
    float32[4] lensDistortionValues;
    float32[4] chromaAbCorrection;
}
/// VrStereoConfig, VR stereo rendering configuration for simulator.
struct VrStereoConfig {
    Matrix[2] projection;
    Matrix[2] viewOffset;
    float32[2] leftLensCenter;
    float32[2] rightLensCenter;
    float32[2] leftScreenCenter;
    float32[2] rightScreenCenter;
    float32[2] scale;
    float32[2] scaleIn;
}
/// Wave, audio wave data.
struct Wave {
    c_uint frameCount;
    c_uint sampleRate;
    c_uint sampleSize;
    c_uint channels;
    void*? data;
}
/// Draw call type.
struct rlDrawCall {
    c_int mode;
    c_int vertexCount;
    c_int vertexAlignment;
    c_uint textureId;
}
/// rlRenderBatch type.
struct rlRenderBatch {
    c_int bufferCount;
    c_int currentBuffer;
    rlVertexBuffer[*]? vertexBuffer;
    rlDrawCall[*]? draws;
    c_int drawCounter;
    float32 currentDepth;
}
/// Dynamic vertex buffers (position + texcoords + colors + indices arrays).
struct rlVertexBuffer {
    c_int elementCount;
    float32[*]? vertices;
    float32[*]? texcoords;
    float32[*]? normals;
    c_uchar[*]? colors;
    c_uint[*]? indices;
    c_uint vaoId;
    c_uint[5] vboId;
}

/// Callback receiving audio frames for processing.
using AudioCallback = void(void*?, c_uint)?;
/// Convenience alias for Camera3D.
using Camera = Camera3D;
/// FileIO: Load binary data.
using LoadFileDataCallback = c_uchar[*]?(char*?, c_int*?)?;
/// FileIO: Load text data.
using LoadFileTextCallback = char*?(char*?)?;
/// An animation pose: an array of bone transforms.
using ModelAnimPose = Transform[*]?;
/// Convenience alias for Vector4.
using Quaternion = Vector4;
/// Convenience alias for RenderTexture.
using RenderTexture2D = RenderTexture;
/// FileIO: Save binary data.
using SaveFileDataCallback = bool(char*?, void*?, c_int)?;
/// FileIO: Save text data.
using SaveFileTextCallback = bool(char*?, char*?)?;
/// Convenience alias for Texture.
using Texture2D = Texture;
/// Convenience alias for Texture.
using TextureCubemap = Texture;

/// Initialize window and OpenGL context.
extern void InitWindow(c_int width, c_int height, char*? title);
/// Close window and unload OpenGL context.
extern void CloseWindow();
/// Check if application should close (KEY_ESCAPE pressed or windows close icon clicked).
extern bool WindowShouldClose();
/// Check if window has been initialized successfully.
extern bool IsWindowReady();
/// Check if window is currently fullscreen.
extern bool IsWindowFullscreen();
/// Check if window is currently hidden.
extern bool IsWindowHidden();
/// Check if window is currently minimized.
extern bool IsWindowMinimized();
/// Check if window is currently maximized.
extern bool IsWindowMaximized();
/// Check if window is currently focused.
extern bool IsWindowFocused();
/// Check if window has been resized last frame.
extern bool IsWindowResized();
/// Check if one specific window flag is enabled.
extern bool IsWindowState(c_uint flag);
/// Set window configuration state using flags.
extern void SetWindowState(c_uint flags);
/// Clear window configuration state flags.
extern void ClearWindowState(c_uint flags);
/// Toggle window state: fullscreen/windowed, resizes monitor to match window resolution.
extern void ToggleFullscreen();
/// Toggle window state: borderless windowed, resizes window to match monitor resolution.
extern void ToggleBorderlessWindowed();
/// Set window state: maximized, if resizable.
extern void MaximizeWindow();
/// Set window state: minimized, if resizable.
extern void MinimizeWindow();
/// Restore window from being minimized/maximized.
extern void RestoreWindow();
/// Set icon for window (single image, RGBA 32bit).
extern void SetWindowIcon(Image image);
/// Set icon for window (multiple images, RGBA 32bit).
extern void SetWindowIcons(Image[*]? images, c_int count);
/// Set title for window.
extern void SetWindowTitle(char*? title);
/// Set window position on screen.
extern void SetWindowPosition(c_int x, c_int y);
/// Set monitor for the current window.
extern void SetWindowMonitor(c_int monitor);
/// Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE).
extern void SetWindowMinSize(c_int width, c_int height);
/// Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE).
extern void SetWindowMaxSize(c_int width, c_int height);
/// Set window dimensions.
extern void SetWindowSize(c_int width, c_int height);
/// Set window opacity [0.0f..1.0f].
extern void SetWindowOpacity(float32 opacity);
/// Set window focused.
extern void SetWindowFocused();
/// Get native window handle.
extern void*? GetWindowHandle();
/// Get current screen width.
extern c_int GetScreenWidth();
/// Get current screen height.
extern c_int GetScreenHeight();
/// Get current render width (it considers HiDPI).
extern c_int GetRenderWidth();
/// Get current render height (it considers HiDPI).
extern c_int GetRenderHeight();
/// Get number of connected monitors.
extern c_int GetMonitorCount();
/// Get current monitor where window is placed.
extern c_int GetCurrentMonitor();
/// Get specified monitor position.
extern Vector2 GetMonitorPosition(c_int monitor);
/// Get specified monitor width (current video mode used by monitor).
extern c_int GetMonitorWidth(c_int monitor);
/// Get specified monitor height (current video mode used by monitor).
extern c_int GetMonitorHeight(c_int monitor);
/// Get specified monitor physical width in millimetres.
extern c_int GetMonitorPhysicalWidth(c_int monitor);
/// Get specified monitor physical height in millimetres.
extern c_int GetMonitorPhysicalHeight(c_int monitor);
/// Get specified monitor refresh rate.
extern c_int GetMonitorRefreshRate(c_int monitor);
/// Get window position XY on monitor.
extern Vector2 GetWindowPosition();
/// Get window scale DPI factor.
extern Vector2 GetWindowScaleDPI();
/// Get the human-readable, UTF-8 encoded name of the specified monitor.
extern char*? GetMonitorName(c_int monitor);
/// Set clipboard text content.
extern void SetClipboardText(char*? text);
/// Get clipboard text content.
extern char*? GetClipboardText();
/// Get clipboard image content.
extern Image GetClipboardImage();
/// Enable waiting for events on EndDrawing(), no automatic event polling.
extern void EnableEventWaiting();
/// Disable waiting for events on EndDrawing(), automatic events polling.
extern void DisableEventWaiting();
/// Shows cursor.
extern void ShowCursor();
/// Hides cursor.
extern void HideCursor();
/// Check if cursor is not visible.
extern bool IsCursorHidden();
/// Enables cursor (unlock cursor).
extern void EnableCursor();
/// Disables cursor (lock cursor).
extern void DisableCursor();
/// Check if cursor is on the screen.
extern bool IsCursorOnScreen();
/// Set background color (framebuffer clear color).
extern void ClearBackground(Color color);
/// Setup canvas (framebuffer) to start drawing.
extern void BeginDrawing();
/// End canvas drawing and swap buffers (double buffering).
extern void EndDrawing();
/// Begin 2D mode with custom camera (2D).
extern void BeginMode2D(Camera2D camera);
/// Ends 2D mode with custom camera.
extern void EndMode2D();
/// Begin 3D mode with custom camera (3D).
extern void BeginMode3D(Camera3D camera);
/// Ends 3D mode and returns to default 2D orthographic mode.
extern void EndMode3D();
/// Begin drawing to render texture.
extern void BeginTextureMode(RenderTexture2D target);
/// Ends drawing to render texture.
extern void EndTextureMode();
/// Begin custom shader drawing.
extern void BeginShaderMode(Shader shader);
/// End custom shader drawing (use default shader).
extern void EndShaderMode();
/// Begin blending mode (alpha, additive, multiplied, subtract, custom).
extern void BeginBlendMode(c_int mode);
/// End blending mode (reset to default: alpha blending).
extern void EndBlendMode();
/// Begin scissor mode (define screen area for following drawing).
extern void BeginScissorMode(c_int x, c_int y, c_int width, c_int height);
/// End scissor mode.
extern void EndScissorMode();
/// Begin stereo rendering (requires VR simulator).
extern void BeginVrStereoMode(VrStereoConfig config);
/// End stereo rendering (requires VR simulator).
extern void EndVrStereoMode();
/// Load VR stereo config for VR simulator device parameters.
extern VrStereoConfig LoadVrStereoConfig(VrDeviceInfo device);
/// Unload VR stereo config.
extern void UnloadVrStereoConfig(VrStereoConfig config);
/// Load shader from files and bind default locations.
extern Shader LoadShader(char*? vsFileName, char*? fsFileName);
/// Load shader from code strings and bind default locations.
extern Shader LoadShaderFromMemory(char*? vsCode, char*? fsCode);
/// Check if a shader is valid (loaded on GPU).
extern bool IsShaderValid(Shader shader);
/// Get shader uniform location.
extern c_int GetShaderLocation(Shader shader, char*? uniformName);
/// Get shader attribute location.
extern c_int GetShaderLocationAttrib(Shader shader, char*? attribName);
/// Set shader uniform value.
extern void SetShaderValue(Shader shader, c_int locIndex, void*? value, c_int uniformType);
/// Set shader uniform value vector.
extern void SetShaderValueV(Shader shader, c_int locIndex, void*? value, c_int uniformType, c_int count);
/// Set shader uniform value (matrix 4x4).
extern void SetShaderValueMatrix(Shader shader, c_int locIndex, Matrix mat);
/// Set shader uniform value and bind the texture (sampler2d).
extern void SetShaderValueTexture(Shader shader, c_int locIndex, Texture2D texture);
/// Unload shader from GPU memory (VRAM).
extern void UnloadShader(Shader shader);
/// Get a ray trace from screen position (i.e mouse).
extern Ray GetScreenToWorldRay(Vector2 position, Camera camera);
/// Get a ray trace from screen position (i.e mouse) in a viewport.
extern Ray GetScreenToWorldRayEx(Vector2 position, Camera camera, c_int width, c_int height);
/// Get the screen space position for a 3d world space position.
extern Vector2 GetWorldToScreen(Vector3 position, Camera camera);
/// Get size position for a 3d world space position.
extern Vector2 GetWorldToScreenEx(Vector3 position, Camera camera, c_int width, c_int height);
/// Get the screen space position for a 2d camera world space position.
extern Vector2 GetWorldToScreen2D(Vector2 position, Camera2D camera);
/// Get the world space position for a 2d camera screen space position.
extern Vector2 GetScreenToWorld2D(Vector2 position, Camera2D camera);
/// Get camera transform matrix (view matrix).
extern Matrix GetCameraMatrix(Camera camera);
/// Get camera 2d transform matrix.
extern Matrix GetCameraMatrix2D(Camera2D camera);
/// Set target FPS (maximum).
extern void SetTargetFPS(c_int fps);
/// Get time in seconds for last frame drawn (delta time).
extern float32 GetFrameTime();
/// Get elapsed time in seconds since InitWindow().
extern float64 GetTime();
/// Get current FPS.
extern c_int GetFPS();
/// Swap back buffer with front buffer (screen drawing).
extern void SwapScreenBuffer();
/// Register all input events.
extern void PollInputEvents();
/// Wait for some time (halt program execution).
extern void WaitTime(float64 seconds);
/// Set the seed for the random number generator.
extern void SetRandomSeed(c_uint seed);
/// Get a random value between min and max (both included).
extern c_int GetRandomValue(c_int min, c_int max);
/// Load random values sequence, no values repeated.
extern c_int[*]? LoadRandomSequence(c_uint count, c_int min, c_int max);
/// Unload random values sequence.
extern void UnloadRandomSequence(c_int[*]? sequence);
/// Takes a screenshot of current screen (filename extension defines format).
extern void TakeScreenshot(char*? fileName);
/// Setup init configuration flags (view FLAGS).
extern void SetConfigFlags(c_uint flags);
/// Open URL with default system browser (if available).
extern void OpenURL(char*? url);
/// Set the current threshold (minimum) log level.
extern void SetTraceLogLevel(c_int logLevel);
/// Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...).
extern void TraceLog(c_int logLevel, char*? text, ...);
/// Internal memory allocator.
extern void*? MemAlloc(c_uint size);
/// Internal memory reallocator.
extern void*? MemRealloc(void*? ptr, c_uint size);
/// Internal memory free.
extern void MemFree(void*? ptr);
/// Load file data as byte array (read).
extern c_uchar[*]? LoadFileData(char*? fileName, c_int*? dataSize);
/// Unload file data allocated by LoadFileData().
extern void UnloadFileData(c_uchar[*]? data);
/// Save data to file from byte array (write), returns true on success.
extern bool SaveFileData(char*? fileName, void*? data, c_int dataSize);
/// Export data to code (.h), returns true on success.
extern bool ExportDataAsCode(c_uchar[*]? data, c_int dataSize, char*? fileName);
/// Load text data from file (read), returns a '\0' terminated string.
extern char*? LoadFileText(char*? fileName);
/// Unload file text data allocated by LoadFileText().
extern void UnloadFileText(char*? text);
/// Save text data to file (write), string must be '\0' terminated, returns true on success.
extern bool SaveFileText(char*? fileName, char*? text);
/// Set custom file binary data loader.
extern void SetLoadFileDataCallback(LoadFileDataCallback callback);
/// Set custom file binary data saver.
extern void SetSaveFileDataCallback(SaveFileDataCallback callback);
/// Set custom file text data loader.
extern void SetLoadFileTextCallback(LoadFileTextCallback callback);
/// Set custom file text data saver.
extern void SetSaveFileTextCallback(SaveFileTextCallback callback);
/// Rename file (if exists).
extern c_int FileRename(char*? fileName, char*? fileRename);
/// Remove file (if exists).
extern c_int FileRemove(char*? fileName);
/// Copy file from one path to another, dstPath created if it doesn't exist.
extern c_int FileCopy(char*? srcPath, char*? dstPath);
/// Move file from one directory to another, dstPath created if it doesn't exist.
extern c_int FileMove(char*? srcPath, char*? dstPath);
/// Replace text in an existing file.
extern c_int FileTextReplace(char*? fileName, char*? search, char*? replacement);
/// Find text in existing file.
extern c_int FileTextFindIndex(char*? fileName, char*? search);
/// Check if file exists.
extern bool FileExists(char*? fileName);
/// Check if a directory path exists.
extern bool DirectoryExists(char*? dirPath);
/// Check file extension (recommended include point: .png, .wav).
extern bool IsFileExtension(char*? fileName, char*? ext);
/// Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h).
extern c_int GetFileLength(char*? fileName);
/// Get file modification time (last write time).
extern c_long GetFileModTime(char*? fileName);
/// Get pointer to extension for a filename string (includes dot: '.png').
extern char*? GetFileExtension(char*? fileName);
/// Get pointer to filename for a path string.
extern char*? GetFileName(char*? filePath);
/// Get filename string without extension (uses static string).
extern char*? GetFileNameWithoutExt(char*? filePath);
/// Get full path for a given fileName with path (uses static string).
extern char*? GetDirectoryPath(char*? filePath);
/// Get previous directory path for a given path (uses static string).
extern char*? GetPrevDirectoryPath(char*? dirPath);
/// Get current working directory (uses static string).
extern char*? GetWorkingDirectory();
/// Get the directory of the running application (uses static string).
extern char*? GetApplicationDirectory();
/// Create directories (including full path requested), returns 0 on success.
extern c_int MakeDirectory(char*? dirPath);
/// Change working directory, return true on success.
extern bool ChangeDirectory(char*? dirPath);
/// Check if a given path is a file or a directory.
extern bool IsPathFile(char*? path);
/// Check if fileName is valid for the platform/OS.
extern bool IsFileNameValid(char*? fileName);
/// Load directory filepaths, files and directories, no subdirs scan.
extern FilePathList LoadDirectoryFiles(char*? dirPath);
/// Load directory filepaths with extension filtering and subdir scan; some filters available: "*.*", "FILES*", "DIRS*".
extern FilePathList LoadDirectoryFilesEx(char*? basePath, char*? filter, bool scanSubdirs);
/// Unload filepaths.
extern void UnloadDirectoryFiles(FilePathList files);
/// Check if a file has been dropped into window.
extern bool IsFileDropped();
/// Load dropped filepaths.
extern FilePathList LoadDroppedFiles();
/// Unload dropped filepaths.
extern void UnloadDroppedFiles(FilePathList files);
/// Get the file count in a directory.
extern c_uint GetDirectoryFileCount(char*? dirPath);
/// Get the file count in a directory with extension filtering and recursive directory scan. Use 'DIR' in the filter string to include directories in the result.
extern c_uint GetDirectoryFileCountEx(char*? basePath, char*? filter, bool scanSubdirs);
/// Compress data (DEFLATE algorithm), memory must be MemFree().
extern c_uchar[*]? CompressData(c_uchar[*]? data, c_int dataSize, c_int*? compDataSize);
/// Decompress data (DEFLATE algorithm), memory must be MemFree().
extern c_uchar[*]? DecompressData(c_uchar[*]? compData, c_int compDataSize, c_int*? dataSize);
/// Encode data to Base64 string (includes NULL terminator), memory must be MemFree().
extern char*? EncodeDataBase64(c_uchar[*]? data, c_int dataSize, c_int*? outputSize);
/// Decode Base64 string (expected NULL terminated), memory must be MemFree().
extern c_uchar[*]? DecodeDataBase64(char*? text, c_int*? outputSize);
/// Compute CRC32 hash code.
extern c_uint ComputeCRC32(c_uchar[*]? data, c_int dataSize);
/// Compute MD5 hash code, returns static int[4] (16 bytes).
extern c_uint[*]? ComputeMD5(c_uchar[*]? data, c_int dataSize);
/// Compute SHA1 hash code, returns static int[5] (20 bytes).
extern c_uint[*]? ComputeSHA1(c_uchar[*]? data, c_int dataSize);
/// Compute SHA256 hash code, returns static int[8] (32 bytes).
extern c_uint[*]? ComputeSHA256(c_uchar[*]? data, c_int dataSize);
/// Load automation events list from file, NULL for empty list, capacity = MAX_AUTOMATION_EVENTS.
extern AutomationEventList LoadAutomationEventList(char*? fileName);
/// Unload automation events list from file.
extern void UnloadAutomationEventList(AutomationEventList list);
/// Export automation events list as text file.
extern bool ExportAutomationEventList(AutomationEventList list, char*? fileName);
/// Set automation event list to record to.
extern void SetAutomationEventList(AutomationEventList*? list);
/// Set automation event internal base frame to start recording.
extern void SetAutomationEventBaseFrame(c_int frame);
/// Start recording automation events (AutomationEventList must be set).
extern void StartAutomationEventRecording();
/// Stop recording automation events.
extern void StopAutomationEventRecording();
/// Play a recorded automation event.
extern void PlayAutomationEvent(AutomationEvent event);
/// Check if a key has been pressed once.
extern bool IsKeyPressed(c_int key);
/// Check if a key has been pressed again.
extern bool IsKeyPressedRepeat(c_int key);
/// Check if a key is being pressed.
extern bool IsKeyDown(c_int key);
/// Check if a key has been released once.
extern bool IsKeyReleased(c_int key);
/// Check if a key is NOT being pressed.
extern bool IsKeyUp(c_int key);
/// Get key pressed (keycode), call it multiple times for keys queued, returns 0 when the queue is empty.
extern c_int GetKeyPressed();
/// Get char pressed (unicode), call it multiple times for chars queued, returns 0 when the queue is empty.
extern c_int GetCharPressed();
/// Get name of a QWERTY key on the current keyboard layout (eg returns string 'q' for KEY_A on an AZERTY keyboard).
extern char*? GetKeyName(c_int key);
/// Set a custom key to exit program (default is ESC).
extern void SetExitKey(c_int key);
/// Check if a gamepad is available.
extern bool IsGamepadAvailable(c_int gamepad);
/// Get gamepad internal name id.
extern char*? GetGamepadName(c_int gamepad);
/// Check if a gamepad button has been pressed once.
extern bool IsGamepadButtonPressed(c_int gamepad, c_int button);
/// Check if a gamepad button is being pressed.
extern bool IsGamepadButtonDown(c_int gamepad, c_int button);
/// Check if a gamepad button has been released once.
extern bool IsGamepadButtonReleased(c_int gamepad, c_int button);
/// Check if a gamepad button is NOT being pressed.
extern bool IsGamepadButtonUp(c_int gamepad, c_int button);
/// Get the last gamepad button pressed.
extern c_int GetGamepadButtonPressed();
/// Get axis count for a gamepad.
extern c_int GetGamepadAxisCount(c_int gamepad);
/// Get movement value for a gamepad axis.
extern float32 GetGamepadAxisMovement(c_int gamepad, c_int axis);
/// Set internal gamepad mappings (SDL_GameControllerDB).
extern c_int SetGamepadMappings(char*? mappings);
/// Set gamepad vibration for both motors (duration in seconds).
extern void SetGamepadVibration(c_int gamepad, float32 leftMotor, float32 rightMotor, float32 duration);
/// Check if a mouse button has been pressed once.
extern bool IsMouseButtonPressed(c_int button);
/// Check if a mouse button is being pressed.
extern bool IsMouseButtonDown(c_int button);
/// Check if a mouse button has been released once.
extern bool IsMouseButtonReleased(c_int button);
/// Check if a mouse button is NOT being pressed.
extern bool IsMouseButtonUp(c_int button);
/// Get mouse position X.
extern c_int GetMouseX();
/// Get mouse position Y.
extern c_int GetMouseY();
/// Get mouse position XY.
extern Vector2 GetMousePosition();
/// Get mouse delta between frames.
extern Vector2 GetMouseDelta();
/// Set mouse position XY.
extern void SetMousePosition(c_int x, c_int y);
/// Set mouse offset.
extern void SetMouseOffset(c_int offsetX, c_int offsetY);
/// Set mouse scaling.
extern void SetMouseScale(float32 scaleX, float32 scaleY);
/// Get mouse wheel movement for X or Y, whichever is larger.
extern float32 GetMouseWheelMove();
/// Get mouse wheel movement for both X and Y.
extern Vector2 GetMouseWheelMoveV();
/// Set mouse cursor.
extern void SetMouseCursor(c_int cursor);
/// Get touch position X for touch point 0 (relative to screen size).
extern c_int GetTouchX();
/// Get touch position Y for touch point 0 (relative to screen size).
extern c_int GetTouchY();
/// Get touch position XY for a touch point index (relative to screen size).
extern Vector2 GetTouchPosition(c_int index);
/// Get touch point identifier for given index.
extern c_int GetTouchPointId(c_int index);
/// Get number of touch points.
extern c_int GetTouchPointCount();
/// Enable a set of gestures using flags.
extern void SetGesturesEnabled(c_uint flags);
/// Check if a gesture have been detected.
extern bool IsGestureDetected(c_uint gesture);
/// Get latest detected gesture.
extern c_int GetGestureDetected();
/// Get gesture hold time in seconds.
extern float32 GetGestureHoldDuration();
/// Get gesture drag vector.
extern Vector2 GetGestureDragVector();
/// Get gesture drag angle.
extern float32 GetGestureDragAngle();
/// Get gesture pinch delta.
extern Vector2 GetGesturePinchVector();
/// Get gesture pinch angle.
extern float32 GetGesturePinchAngle();
/// Update camera position for selected mode.
extern void UpdateCamera(Camera*? camera, c_int mode);
/// Update camera movement/rotation.
extern void UpdateCameraPro(Camera*? camera, Vector3 movement, Vector3 rotation, float32 zoom);
/// Set texture and rectangle to be used on shapes drawing.
extern void SetShapesTexture(Texture2D texture, Rectangle source);
/// Get texture that is used for shapes drawing.
extern Texture2D GetShapesTexture();
/// Get texture source rectangle that is used for shapes drawing.
extern Rectangle GetShapesTextureRectangle();
/// Draw a pixel using geometry [Can be slow, use with care].
extern void DrawPixel(c_int posX, c_int posY, Color color);
/// Draw a pixel using geometry (Vector version) [Can be slow, use with care].
extern void DrawPixelV(Vector2 position, Color color);
/// Draw a line.
extern void DrawLine(c_int startPosX, c_int startPosY, c_int endPosX, c_int endPosY, Color color);
/// Draw a line (using gl lines).
extern void DrawLineV(Vector2 startPos, Vector2 endPos, Color color);
/// Draw a line (using triangles/quads).
extern void DrawLineEx(Vector2 startPos, Vector2 endPos, float32 thick, Color color);
/// Draw lines sequence (using gl lines).
extern void DrawLineStrip(Vector2[*]? points, c_int pointCount, Color color);
/// Draw line segment cubic-bezier in-out interpolation.
extern void DrawLineBezier(Vector2 startPos, Vector2 endPos, float32 thick, Color color);
/// Draw a dashed line.
extern void DrawLineDashed(Vector2 startPos, Vector2 endPos, c_int dashSize, c_int spaceSize, Color color);
/// Draw a color-filled circle.
extern void DrawCircle(c_int centerX, c_int centerY, float32 radius, Color color);
/// Draw a color-filled circle (Vector version).
extern void DrawCircleV(Vector2 center, float32 radius, Color color);
/// Draw a gradient-filled circle.
extern void DrawCircleGradient(Vector2 center, float32 radius, Color inner, Color outer);
/// Draw a piece of a circle.
extern void DrawCircleSector(Vector2 center, float32 radius, float32 startAngle, float32 endAngle, c_int segments, Color color);
/// Draw circle sector outline.
extern void DrawCircleSectorLines(Vector2 center, float32 radius, float32 startAngle, float32 endAngle, c_int segments, Color color);
/// Draw circle outline.
extern void DrawCircleLines(c_int centerX, c_int centerY, float32 radius, Color color);
/// Draw circle outline (Vector version).
extern void DrawCircleLinesV(Vector2 center, float32 radius, Color color);
/// Draw ellipse.
extern void DrawEllipse(c_int centerX, c_int centerY, float32 radiusH, float32 radiusV, Color color);
/// Draw ellipse (Vector version).
extern void DrawEllipseV(Vector2 center, float32 radiusH, float32 radiusV, Color color);
/// Draw ellipse outline.
extern void DrawEllipseLines(c_int centerX, c_int centerY, float32 radiusH, float32 radiusV, Color color);
/// Draw ellipse outline (Vector version).
extern void DrawEllipseLinesV(Vector2 center, float32 radiusH, float32 radiusV, Color color);
/// Draw ring.
extern void DrawRing(Vector2 center, float32 innerRadius, float32 outerRadius, float32 startAngle, float32 endAngle, c_int segments, Color color);
/// Draw ring outline.
extern void DrawRingLines(Vector2 center, float32 innerRadius, float32 outerRadius, float32 startAngle, float32 endAngle, c_int segments, Color color);
/// Draw a color-filled rectangle.
extern void DrawRectangle(c_int posX, c_int posY, c_int width, c_int height, Color color);
/// Draw a color-filled rectangle (Vector version).
extern void DrawRectangleV(Vector2 position, Vector2 size, Color color);
/// Draw a color-filled rectangle.
extern void DrawRectangleRec(Rectangle rec, Color color);
/// Draw a color-filled rectangle with pro parameters.
extern void DrawRectanglePro(Rectangle rec, Vector2 origin, float32 rotation, Color color);
/// Draw a vertical-gradient-filled rectangle.
extern void DrawRectangleGradientV(c_int posX, c_int posY, c_int width, c_int height, Color top, Color bottom);
/// Draw a horizontal-gradient-filled rectangle.
extern void DrawRectangleGradientH(c_int posX, c_int posY, c_int width, c_int height, Color left, Color right);
/// Draw a gradient-filled rectangle with custom vertex colors.
extern void DrawRectangleGradientEx(Rectangle rec, Color topLeft, Color bottomLeft, Color bottomRight, Color topRight);
/// Draw rectangle outline.
extern void DrawRectangleLines(c_int posX, c_int posY, c_int width, c_int height, Color color);
/// Draw rectangle outline with extended parameters.
extern void DrawRectangleLinesEx(Rectangle rec, float32 lineThick, Color color);
/// Draw rectangle with rounded edges.
extern void DrawRectangleRounded(Rectangle rec, float32 roundness, c_int segments, Color color);
/// Draw rectangle lines with rounded edges.
extern void DrawRectangleRoundedLines(Rectangle rec, float32 roundness, c_int segments, Color color);
/// Draw rectangle with rounded edges outline.
extern void DrawRectangleRoundedLinesEx(Rectangle rec, float32 roundness, c_int segments, float32 lineThick, Color color);
/// Draw a color-filled triangle (vertex in counter-clockwise order!).
extern void DrawTriangle(Vector2 v1, Vector2 v2, Vector2 v3, Color color);
/// Draw triangle outline (vertex in counter-clockwise order!).
extern void DrawTriangleLines(Vector2 v1, Vector2 v2, Vector2 v3, Color color);
/// Draw a triangle fan defined by points (first vertex is the center).
extern void DrawTriangleFan(Vector2[*]? points, c_int pointCount, Color color);
/// Draw a triangle strip defined by points.
extern void DrawTriangleStrip(Vector2[*]? points, c_int pointCount, Color color);
/// Draw a regular polygon (Vector version).
extern void DrawPoly(Vector2 center, c_int sides, float32 radius, float32 rotation, Color color);
/// Draw a polygon outline of n sides.
extern void DrawPolyLines(Vector2 center, c_int sides, float32 radius, float32 rotation, Color color);
/// Draw a polygon outline of n sides with extended parameters.
extern void DrawPolyLinesEx(Vector2 center, c_int sides, float32 radius, float32 rotation, float32 lineThick, Color color);
/// Draw spline: Linear, minimum 2 points.
extern void DrawSplineLinear(Vector2[*]? points, c_int pointCount, float32 thick, Color color);
/// Draw spline: B-Spline, minimum 4 points.
extern void DrawSplineBasis(Vector2[*]? points, c_int pointCount, float32 thick, Color color);
/// Draw spline: Catmull-Rom, minimum 4 points.
extern void DrawSplineCatmullRom(Vector2[*]? points, c_int pointCount, float32 thick, Color color);
/// Draw spline: Quadratic Bezier, minimum 3 points (1 control point): [p1, c2, p3, c4...].
extern void DrawSplineBezierQuadratic(Vector2[*]? points, c_int pointCount, float32 thick, Color color);
/// Draw spline: Cubic Bezier, minimum 4 points (2 control points): [p1, c2, c3, p4, c5, c6...].
extern void DrawSplineBezierCubic(Vector2[*]? points, c_int pointCount, float32 thick, Color color);
/// Draw spline segment: Linear, 2 points.
extern void DrawSplineSegmentLinear(Vector2 p1, Vector2 p2, float32 thick, Color color);
/// Draw spline segment: B-Spline, 4 points.
extern void DrawSplineSegmentBasis(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, float32 thick, Color color);
/// Draw spline segment: Catmull-Rom, 4 points.
extern void DrawSplineSegmentCatmullRom(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, float32 thick, Color color);
/// Draw spline segment: Quadratic Bezier, 2 points, 1 control point.
extern void DrawSplineSegmentBezierQuadratic(Vector2 p1, Vector2 c2, Vector2 p3, float32 thick, Color color);
/// Draw spline segment: Cubic Bezier, 2 points, 2 control points.
extern void DrawSplineSegmentBezierCubic(Vector2 p1, Vector2 c2, Vector2 c3, Vector2 p4, float32 thick, Color color);
/// Get (evaluate) spline point: Linear.
extern Vector2 GetSplinePointLinear(Vector2 startPos, Vector2 endPos, float32 t);
/// Get (evaluate) spline point: B-Spline.
extern Vector2 GetSplinePointBasis(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, float32 t);
/// Get (evaluate) spline point: Catmull-Rom.
extern Vector2 GetSplinePointCatmullRom(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, float32 t);
/// Get (evaluate) spline point: Quadratic Bezier.
extern Vector2 GetSplinePointBezierQuad(Vector2 p1, Vector2 c2, Vector2 p3, float32 t);
/// Get (evaluate) spline point: Cubic Bezier.
extern Vector2 GetSplinePointBezierCubic(Vector2 p1, Vector2 c2, Vector2 c3, Vector2 p4, float32 t);
/// Check collision between two rectangles.
extern bool CheckCollisionRecs(Rectangle rec1, Rectangle rec2);
/// Check collision between two circles.
extern bool CheckCollisionCircles(Vector2 center1, float32 radius1, Vector2 center2, float32 radius2);
/// Check collision between circle and rectangle.
extern bool CheckCollisionCircleRec(Vector2 center, float32 radius, Rectangle rec);
/// Check if circle collides with a line created betweeen two points [p1] and [p2].
extern bool CheckCollisionCircleLine(Vector2 center, float32 radius, Vector2 p1, Vector2 p2);
/// Check if point is inside rectangle.
extern bool CheckCollisionPointRec(Vector2 point, Rectangle rec);
/// Check if point is inside circle.
extern bool CheckCollisionPointCircle(Vector2 point, Vector2 center, float32 radius);
/// Check if point is inside a triangle.
extern bool CheckCollisionPointTriangle(Vector2 point, Vector2 p1, Vector2 p2, Vector2 p3);
/// Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold].
extern bool CheckCollisionPointLine(Vector2 point, Vector2 p1, Vector2 p2, c_int threshold);
/// Check if point is within a polygon described by array of vertices.
extern bool CheckCollisionPointPoly(Vector2 point, Vector2[*]? points, c_int pointCount);
/// Check the collision between two lines defined by two points each, returns collision point by reference.
extern bool CheckCollisionLines(Vector2 startPos1, Vector2 endPos1, Vector2 startPos2, Vector2 endPos2, Vector2*? collisionPoint);
/// Get collision rectangle for two rectangles collision.
extern Rectangle GetCollisionRec(Rectangle rec1, Rectangle rec2);
/// Load image from file into CPU memory (RAM).
extern Image LoadImage(char*? fileName);
/// Load image from RAW file data.
extern Image LoadImageRaw(char*? fileName, c_int width, c_int height, c_int format, c_int headerSize);
/// Load image sequence from file (frames appended to image.data).
extern Image LoadImageAnim(char*? fileName, c_int*? frames);
/// Load image sequence from memory buffer.
extern Image LoadImageAnimFromMemory(char*? fileType, c_uchar[*]? fileData, c_int dataSize, c_int*? frames);
/// Load image from memory buffer, fileType refers to extension: i.e. '.png'.
extern Image LoadImageFromMemory(char*? fileType, c_uchar[*]? fileData, c_int dataSize);
/// Load image from GPU texture data.
extern Image LoadImageFromTexture(Texture2D texture);
/// Load image from screen buffer and (screenshot).
extern Image LoadImageFromScreen();
/// Check if an image is valid (data and parameters).
extern bool IsImageValid(Image image);
/// Unload image from CPU memory (RAM).
extern void UnloadImage(Image image);
/// Export image data to file, returns true on success.
extern bool ExportImage(Image image, char*? fileName);
/// Export image to memory buffer, memory must be MemFree().
extern c_uchar[*]? ExportImageToMemory(Image image, char*? fileType, c_int*? fileSize);
/// Export image as code file defining an array of bytes, returns true on success.
extern bool ExportImageAsCode(Image image, char*? fileName);
/// Generate image: plain color.
extern Image GenImageColor(c_int width, c_int height, Color color);
/// Generate image: linear gradient, direction in degrees [0..360], 0=Vertical gradient.
extern Image GenImageGradientLinear(c_int width, c_int height, c_int direction, Color start, Color end);
/// Generate image: radial gradient.
extern Image GenImageGradientRadial(c_int width, c_int height, float32 density, Color inner, Color outer);
/// Generate image: square gradient.
extern Image GenImageGradientSquare(c_int width, c_int height, float32 density, Color inner, Color outer);
/// Generate image: checked.
extern Image GenImageChecked(c_int width, c_int height, c_int checksX, c_int checksY, Color col1, Color col2);
/// Generate image: white noise.
extern Image GenImageWhiteNoise(c_int width, c_int height, float32 factor);
/// Generate image: perlin noise.
extern Image GenImagePerlinNoise(c_int width, c_int height, c_int offsetX, c_int offsetY, float32 scale);
/// Generate image: cellular algorithm, bigger tileSize means bigger cells.
extern Image GenImageCellular(c_int width, c_int height, c_int tileSize);
/// Generate image: grayscale image from text data.
extern Image GenImageText(c_int width, c_int height, char*? text);
/// Create an image duplicate (useful for transformations).
extern Image ImageCopy(Image image);
/// Create an image from another image piece.
extern Image ImageFromImage(Image image, Rectangle rec);
/// Create an image from a selected channel of another image (GRAYSCALE).
extern Image ImageFromChannel(Image image, c_int selectedChannel);
/// Create an image from text (default font).
extern Image ImageText(char*? text, c_int fontSize, Color color);
/// Create an image from text (custom sprite font).
extern Image ImageTextEx(Font font, char*? text, float32 fontSize, float32 spacing, Color tint);
/// Convert image data to desired format.
extern void ImageFormat(Image*? image, c_int newFormat);
/// Convert image to POT (power-of-two).
extern void ImageToPOT(Image*? image, Color fill);
/// Crop an image to a defined rectangle.
extern void ImageCrop(Image*? image, Rectangle crop);
/// Crop image depending on alpha value.
extern void ImageAlphaCrop(Image*? image, float32 threshold);
/// Clear alpha channel to desired color.
extern void ImageAlphaClear(Image*? image, Color color, float32 threshold);
/// Apply alpha mask to image.
extern void ImageAlphaMask(Image*? image, Image alphaMask);
/// Premultiply alpha channel.
extern void ImageAlphaPremultiply(Image*? image);
/// Apply Gaussian blur using a box blur approximation.
extern void ImageBlurGaussian(Image*? image, c_int blurSize);
/// Apply custom square convolution kernel to image.
extern void ImageKernelConvolution(Image*? image, float32[*]? kernel, c_int kernelSize);
/// Resize image (Bicubic scaling algorithm).
extern void ImageResize(Image*? image, c_int newWidth, c_int newHeight);
/// Resize image (Nearest-Neighbor scaling algorithm).
extern void ImageResizeNN(Image*? image, c_int newWidth, c_int newHeight);
/// Resize canvas and fill with color.
extern void ImageResizeCanvas(Image*? image, c_int newWidth, c_int newHeight, c_int offsetX, c_int offsetY, Color fill);
/// Compute all mipmap levels for a provided image.
extern void ImageMipmaps(Image*? image);
/// Dither image data to 16bpp or lower (Floyd-Steinberg dithering).
extern void ImageDither(Image*? image, c_int rBpp, c_int gBpp, c_int bBpp, c_int aBpp);
/// Flip image vertically.
extern void ImageFlipVertical(Image*? image);
/// Flip image horizontally.
extern void ImageFlipHorizontal(Image*? image);
/// Rotate image by input angle in degrees (-359 to 359).
extern void ImageRotate(Image*? image, c_int degrees);
/// Rotate image clockwise 90deg.
extern void ImageRotateCW(Image*? image);
/// Rotate image counter-clockwise 90deg.
extern void ImageRotateCCW(Image*? image);
/// Modify image color: tint.
extern void ImageColorTint(Image*? image, Color color);
/// Modify image color: invert.
extern void ImageColorInvert(Image*? image);
/// Modify image color: grayscale.
extern void ImageColorGrayscale(Image*? image);
/// Modify image color: contrast (-100 to 100).
extern void ImageColorContrast(Image*? image, float32 contrast);
/// Modify image color: brightness (-255 to 255).
extern void ImageColorBrightness(Image*? image, c_int brightness);
/// Modify image color: replace color.
extern void ImageColorReplace(Image*? image, Color color, Color replace);
/// Load color data from image as a Color array (RGBA - 32bit).
extern Color[*]? LoadImageColors(Image image);
/// Load colors palette from image as a Color array (RGBA - 32bit).
extern Color[*]? LoadImagePalette(Image image, c_int maxPaletteSize, c_int*? colorCount);
/// Unload color data loaded with LoadImageColors().
extern void UnloadImageColors(Color[*]? colors);
/// Unload colors palette loaded with LoadImagePalette().
extern void UnloadImagePalette(Color[*]? colors);
/// Get image alpha border rectangle.
extern Rectangle GetImageAlphaBorder(Image image, float32 threshold);
/// Get image pixel color at (x, y) position.
extern Color GetImageColor(Image image, c_int x, c_int y);
/// Clear image background with given color.
extern void ImageClearBackground(Image*? dst, Color color);
/// Draw pixel within an image.
extern void ImageDrawPixel(Image*? dst, c_int posX, c_int posY, Color color);
/// Draw pixel within an image (Vector version).
extern void ImageDrawPixelV(Image*? dst, Vector2 position, Color color);
/// Draw line within an image.
extern void ImageDrawLine(Image*? dst, c_int startPosX, c_int startPosY, c_int endPosX, c_int endPosY, Color color);
/// Draw line within an image (Vector version).
extern void ImageDrawLineV(Image*? dst, Vector2 start, Vector2 end, Color color);
/// Draw a line defining thickness within an image.
extern void ImageDrawLineEx(Image*? dst, Vector2 start, Vector2 end, c_int thick, Color color);
/// Draw a filled circle within an image.
extern void ImageDrawCircle(Image*? dst, c_int centerX, c_int centerY, c_int radius, Color color);
/// Draw a filled circle within an image (Vector version).
extern void ImageDrawCircleV(Image*? dst, Vector2 center, c_int radius, Color color);
/// Draw circle outline within an image.
extern void ImageDrawCircleLines(Image*? dst, c_int centerX, c_int centerY, c_int radius, Color color);
/// Draw circle outline within an image (Vector version).
extern void ImageDrawCircleLinesV(Image*? dst, Vector2 center, c_int radius, Color color);
/// Draw rectangle within an image.
extern void ImageDrawRectangle(Image*? dst, c_int posX, c_int posY, c_int width, c_int height, Color color);
/// Draw rectangle within an image (Vector version).
extern void ImageDrawRectangleV(Image*? dst, Vector2 position, Vector2 size, Color color);
/// Draw rectangle within an image.
extern void ImageDrawRectangleRec(Image*? dst, Rectangle rec, Color color);
/// Draw rectangle lines within an image.
extern void ImageDrawRectangleLines(Image*? dst, Rectangle rec, c_int thick, Color color);
/// Draw triangle within an image.
extern void ImageDrawTriangle(Image*? dst, Vector2 v1, Vector2 v2, Vector2 v3, Color color);
/// Draw triangle with interpolated colors within an image.
extern void ImageDrawTriangleEx(Image*? dst, Vector2 v1, Vector2 v2, Vector2 v3, Color c1, Color c2, Color c3);
/// Draw triangle outline within an image.
extern void ImageDrawTriangleLines(Image*? dst, Vector2 v1, Vector2 v2, Vector2 v3, Color color);
/// Draw a triangle fan defined by points within an image (first vertex is the center).
extern void ImageDrawTriangleFan(Image*? dst, Vector2[*]? points, c_int pointCount, Color color);
/// Draw a triangle strip defined by points within an image.
extern void ImageDrawTriangleStrip(Image*? dst, Vector2[*]? points, c_int pointCount, Color color);
/// Draw a source image within a destination image (tint applied to source).
extern void ImageDraw(Image*? dst, Image src, Rectangle srcRec, Rectangle dstRec, Color tint);
/// Draw text (using default font) within an image (destination).
extern void ImageDrawText(Image*? dst, char*? text, c_int posX, c_int posY, c_int fontSize, Color color);
/// Draw text (custom sprite font) within an image (destination).
extern void ImageDrawTextEx(Image*? dst, Font font, char*? text, Vector2 position, float32 fontSize, float32 spacing, Color tint);
/// Load texture from file into GPU memory (VRAM).
extern Texture2D LoadTexture(char*? fileName);
/// Load texture from image data.
extern Texture2D LoadTextureFromImage(Image image);
/// Load cubemap from image, multiple image cubemap layouts supported.
extern TextureCubemap LoadTextureCubemap(Image image, c_int layout);
/// Load texture for rendering (framebuffer).
extern RenderTexture2D LoadRenderTexture(c_int width, c_int height);
/// Check if a texture is valid (loaded in GPU).
extern bool IsTextureValid(Texture2D texture);
/// Unload texture from GPU memory (VRAM).
extern void UnloadTexture(Texture2D texture);
/// Check if a render texture is valid (loaded in GPU).
extern bool IsRenderTextureValid(RenderTexture2D target);
/// Unload render texture from GPU memory (VRAM).
extern void UnloadRenderTexture(RenderTexture2D target);
/// Update GPU texture with new data (pixels should be able to fill texture).
extern void UpdateTexture(Texture2D texture, void*? pixels);
/// Update GPU texture rectangle with new data (pixels and rec should fit in texture).
extern void UpdateTextureRec(Texture2D texture, Rectangle rec, void*? pixels);
/// Generate GPU mipmaps for a texture.
extern void GenTextureMipmaps(Texture2D*? texture);
/// Set texture scaling filter mode.
extern void SetTextureFilter(Texture2D texture, c_int filter);
/// Set texture wrapping mode.
extern void SetTextureWrap(Texture2D texture, c_int wrap);
/// Draw a Texture2D.
extern void DrawTexture(Texture2D texture, c_int posX, c_int posY, Color tint);
/// Draw a Texture2D with position defined as Vector2.
extern void DrawTextureV(Texture2D texture, Vector2 position, Color tint);
/// Draw a Texture2D with extended parameters.
extern void DrawTextureEx(Texture2D texture, Vector2 position, float32 rotation, float32 scale, Color tint);
/// Draw a part of a texture defined by a rectangle.
extern void DrawTextureRec(Texture2D texture, Rectangle source, Vector2 position, Color tint);
/// Draw a part of a texture defined by a rectangle with 'pro' parameters.
extern void DrawTexturePro(Texture2D texture, Rectangle source, Rectangle dest, Vector2 origin, float32 rotation, Color tint);
/// Draws a texture (or part of it) that stretches or shrinks nicely.
extern void DrawTextureNPatch(Texture2D texture, NPatchInfo nPatchInfo, Rectangle dest, Vector2 origin, float32 rotation, Color tint);
/// Check if two colors are equal.
extern bool ColorIsEqual(Color col1, Color col2);
/// Get color with alpha applied, alpha goes from 0.0f to 1.0f.
extern Color Fade(Color color, float32 alpha);
/// Get hexadecimal value for a Color (0xRRGGBBAA).
extern c_int ColorToInt(Color color);
/// Get Color normalized as float [0..1].
extern Vector4 ColorNormalize(Color color);
/// Get Color from normalized values [0..1].
extern Color ColorFromNormalized(Vector4 normalized);
/// Get HSV values for a Color, hue [0..360], saturation/value [0..1].
extern Vector3 ColorToHSV(Color color);
/// Get a Color from HSV values, hue [0..360], saturation/value [0..1].
extern Color ColorFromHSV(float32 hue, float32 saturation, float32 value);
/// Get color multiplied with another color.
extern Color ColorTint(Color color, Color tint);
/// Get color with brightness correction, brightness factor goes from -1.0f to 1.0f.
extern Color ColorBrightness(Color color, float32 factor);
/// Get color with contrast correction, contrast values between -1.0f and 1.0f.
extern Color ColorContrast(Color color, float32 contrast);
/// Get color with alpha applied, alpha goes from 0.0f to 1.0f.
extern Color ColorAlpha(Color color, float32 alpha);
/// Get src alpha-blended into dst color with tint.
extern Color ColorAlphaBlend(Color dst, Color src, Color tint);
/// Get color lerp interpolation between two colors, factor [0.0f..1.0f].
extern Color ColorLerp(Color color1, Color color2, float32 factor);
/// Get Color structure from hexadecimal value.
extern Color GetColor(c_uint hexValue);
/// Get Color from a source pixel pointer of certain format.
extern Color GetPixelColor(void*? srcPtr, c_int format);
/// Set color formatted into destination pixel pointer.
extern void SetPixelColor(void*? dstPtr, Color color, c_int format);
/// Get pixel data size in bytes for certain format.
extern c_int GetPixelDataSize(c_int width, c_int height, c_int format);
/// Get the default Font.
extern Font GetFontDefault();
/// Load font from file into GPU memory (VRAM).
extern Font LoadFont(char*? fileName);
/// Load font from file with extended parameters, use NULL for codepoints and 0 for codepointCount to load the default character set, font size is provided in pixels height.
extern Font LoadFontEx(char*? fileName, c_int fontSize, c_int[*]? codepoints, c_int codepointCount);
/// Load font from Image (XNA style).
extern Font LoadFontFromImage(Image image, Color key, c_int firstChar);
/// Load font from memory buffer, fileType refers to extension: i.e. '.ttf'.
extern Font LoadFontFromMemory(char*? fileType, c_uchar[*]? fileData, c_int dataSize, c_int fontSize, c_int[*]? codepoints, c_int codepointCount);
/// Check if a font is valid (font data loaded, WARNING: GPU texture not checked).
extern bool IsFontValid(Font font);
/// Load font data for further use.
extern GlyphInfo[*]? LoadFontData(c_uchar[*]? fileData, c_int dataSize, c_int fontSize, c_int[*]? codepoints, c_int codepointCount, c_int type, c_int*? glyphCount);
/// Generate image font atlas using chars info.
extern Image GenImageFontAtlas(GlyphInfo[*]? glyphs, Rectangle*?*? glyphRecs, c_int glyphCount, c_int fontSize, c_int padding, c_int packMethod);
/// Unload font chars info data (RAM).
extern void UnloadFontData(GlyphInfo[*]? glyphs, c_int glyphCount);
/// Unload font from GPU memory (VRAM).
extern void UnloadFont(Font font);
/// Export font as code file, returns true on success.
extern bool ExportFontAsCode(Font font, char*? fileName);
/// Draw current FPS.
extern void DrawFPS(c_int posX, c_int posY);
/// Draw text (using default font).
extern void DrawText(char*? text, c_int posX, c_int posY, c_int fontSize, Color color);
/// Draw text using font and additional parameters.
extern void DrawTextEx(Font font, char*? text, Vector2 position, float32 fontSize, float32 spacing, Color tint);
/// Draw text using Font and pro parameters (rotation).
extern void DrawTextPro(Font font, char*? text, Vector2 position, Vector2 origin, float32 rotation, float32 fontSize, float32 spacing, Color tint);
/// Draw one character (codepoint).
extern void DrawTextCodepoint(Font font, c_int codepoint, Vector2 position, float32 fontSize, Color tint);
/// Draw multiple character (codepoint).
extern void DrawTextCodepoints(Font font, c_int[*]? codepoints, c_int codepointCount, Vector2 position, float32 fontSize, float32 spacing, Color tint);
/// Set vertical line spacing when drawing with line-breaks.
extern void SetTextLineSpacing(c_int spacing);
/// Measure string width for default font.
extern c_int MeasureText(char*? text, c_int fontSize);
/// Measure string size for Font.
extern Vector2 MeasureTextEx(Font font, char*? text, float32 fontSize, float32 spacing);
/// Measure string size for an existing array of codepoints for Font.
extern Vector2 MeasureTextCodepoints(Font font, c_int[*]? codepoints, c_int length, float32 fontSize, float32 spacing);
/// Get glyph index position in font for a codepoint (unicode character), fallback to '?' if not found.
extern c_int GetGlyphIndex(Font font, c_int codepoint);
/// Get glyph font info data for a codepoint (unicode character), fallback to '?' if not found.
extern GlyphInfo GetGlyphInfo(Font font, c_int codepoint);
/// Get glyph rectangle in font atlas for a codepoint (unicode character), fallback to '?' if not found.
extern Rectangle GetGlyphAtlasRec(Font font, c_int codepoint);
/// Load UTF-8 text encoded from codepoints array.
extern char*? LoadUTF8(c_int[*]? codepoints, c_int length);
/// Unload UTF-8 text encoded from codepoints array.
extern void UnloadUTF8(char*? text);
/// Load all codepoints from a UTF-8 text string, codepoints count returned by parameter.
extern c_int[*]? LoadCodepoints(char*? text, c_int*? count);
/// Unload codepoints data from memory.
extern void UnloadCodepoints(c_int[*]? codepoints);
/// Get total number of codepoints in a UTF-8 encoded string.
extern c_int GetCodepointCount(char*? text);
/// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure.
extern c_int GetCodepoint(char*? text, c_int*? codepointSize);
/// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure.
extern c_int GetCodepointNext(char*? text, c_int*? codepointSize);
/// Get previous codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure.
extern c_int GetCodepointPrevious(char*? text, c_int*? codepointSize);
/// Encode one codepoint into UTF-8 byte array (array length returned as parameter).
extern char*? CodepointToUTF8(c_int codepoint, c_int*? utf8Size);
/// Load text as separate lines ('\n').
extern char*?[*]? LoadTextLines(char*? text, c_int*? count);
/// Unload text lines.
extern void UnloadTextLines(char*?[*]? text, c_int lineCount);
/// Copy one string to another, returns bytes copied.
extern c_int TextCopy(char*? dst, char*? src);
/// Check if two text string are equal.
extern bool TextIsEqual(char*? text1, char*? text2);
/// Get text length, checks for '\0' ending.
extern c_uint TextLength(char*? text);
/// Text formatting with variables (sprintf() style).
extern char*? TextFormat(char*? text, ...);
/// Get a piece of a text string.
extern char*? TextSubtext(char*? text, c_int position, c_int length);
/// Remove text spaces, concat words.
extern char*? TextRemoveSpaces(char*? text);
/// Get text between two strings.
extern char*? GetTextBetween(char*? text, char*? begin, char*? end);
/// Replace text string with new string.
extern char*? TextReplace(char*? text, char*? search, char*? replacement);
/// Replace text string with new string, memory must be MemFree().
extern char*? TextReplaceAlloc(char*? text, char*? search, char*? replacement);
/// Replace text between two specific strings.
extern char*? TextReplaceBetween(char*? text, char*? begin, char*? end, char*? replacement);
/// Replace text between two specific strings, memory must be MemFree().
extern char*? TextReplaceBetweenAlloc(char*? text, char*? begin, char*? end, char*? replacement);
/// Insert text in a defined byte position.
extern char*? TextInsert(char*? text, char*? insert, c_int position);
/// Insert text in a defined byte position, memory must be MemFree().
extern char*? TextInsertAlloc(char*? text, char*? insert, c_int position);
/// Join text strings with delimiter.
extern char*? TextJoin(char*?[*]? textList, c_int count, char*? delimiter);
/// Split text into multiple strings, using MAX_TEXTSPLIT_COUNT static strings.
extern char*?[*]? TextSplit(char*? text, char delimiter, c_int*? count);
/// Append text at specific position and move cursor.
extern void TextAppend(char*? text, char*? append, c_int*? position);
/// Find first text occurrence within a string, -1 if not found.
extern c_int TextFindIndex(char*? text, char*? search);
/// Get upper case version of provided string.
extern char*? TextToUpper(char*? text);
/// Get lower case version of provided string.
extern char*? TextToLower(char*? text);
/// Get Pascal case notation version of provided string.
extern char*? TextToPascal(char*? text);
/// Get Snake case notation version of provided string.
extern char*? TextToSnake(char*? text);
/// Get Camel case notation version of provided string.
extern char*? TextToCamel(char*? text);
/// Get integer value from text.
extern c_int TextToInteger(char*? text);
/// Get float value from text.
extern float32 TextToFloat(char*? text);
