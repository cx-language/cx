// Loads every entry point for the current context. Call again
// after making another context current (pointer values may vary).
void loadGL() {
    ptr_glCullFace = procTransmute<void(GLenum)>(loadProc("glCullFace"));
    ptr_glFrontFace = procTransmute<void(GLenum)>(loadProc("glFrontFace"));
    ptr_glHint = procTransmute<void(GLenum, GLenum)>(loadProc("glHint"));
    ptr_glLineWidth = procTransmute<void(GLfloat)>(loadProc("glLineWidth"));
    ptr_glPointSize = procTransmute<void(GLfloat)>(loadProc("glPointSize"));
    ptr_glPolygonMode = procTransmute<void(GLenum, GLenum)>(loadProc("glPolygonMode"));
    ptr_glScissor = procTransmute<void(GLint, GLint, GLsizei, GLsizei)>(loadProc("glScissor"));
    ptr_glTexParameterf = procTransmute<void(GLenum, GLenum, GLfloat)>(loadProc("glTexParameterf"));
    ptr_glTexParameterfv = procTransmute<void(GLenum, GLenum, GLfloat[*])>(loadProc("glTexParameterfv"));
    ptr_glTexParameteri = procTransmute<void(GLenum, GLenum, GLint)>(loadProc("glTexParameteri"));
    ptr_glTexParameteriv = procTransmute<void(GLenum, GLenum, GLint[*])>(loadProc("glTexParameteriv"));
    ptr_glTexImage1D = procTransmute<void(GLenum, GLint, GLint, GLsizei, GLint, GLenum, GLenum, void*?)>(loadProc("glTexImage1D"));
    ptr_glTexImage2D = procTransmute<void(GLenum, GLint, GLint, GLsizei, GLsizei, GLint, GLenum, GLenum, void*?)>(loadProc("glTexImage2D"));
    ptr_glDrawBuffer = procTransmute<void(GLenum)>(loadProc("glDrawBuffer"));
    ptr_glClear = procTransmute<void(GLbitfield)>(loadProc("glClear"));
    ptr_glClearColor = procTransmute<void(GLfloat, GLfloat, GLfloat, GLfloat)>(loadProc("glClearColor"));
    ptr_glClearStencil = procTransmute<void(GLint)>(loadProc("glClearStencil"));
    ptr_glClearDepth = procTransmute<void(GLdouble)>(loadProc("glClearDepth"));
    ptr_glStencilMask = procTransmute<void(GLuint)>(loadProc("glStencilMask"));
    ptr_glColorMask = procTransmute<void(GLboolean, GLboolean, GLboolean, GLboolean)>(loadProc("glColorMask"));
    ptr_glDepthMask = procTransmute<void(GLboolean)>(loadProc("glDepthMask"));
    ptr_glDisable = procTransmute<void(GLenum)>(loadProc("glDisable"));
    ptr_glEnable = procTransmute<void(GLenum)>(loadProc("glEnable"));
    ptr_glFinish = procTransmute<void()>(loadProc("glFinish"));
    ptr_glFlush = procTransmute<void()>(loadProc("glFlush"));
    ptr_glBlendFunc = procTransmute<void(GLenum, GLenum)>(loadProc("glBlendFunc"));
    ptr_glLogicOp = procTransmute<void(GLenum)>(loadProc("glLogicOp"));
    ptr_glStencilFunc = procTransmute<void(GLenum, GLint, GLuint)>(loadProc("glStencilFunc"));
    ptr_glStencilOp = procTransmute<void(GLenum, GLenum, GLenum)>(loadProc("glStencilOp"));
    ptr_glDepthFunc = procTransmute<void(GLenum)>(loadProc("glDepthFunc"));
    ptr_glPixelStoref = procTransmute<void(GLenum, GLfloat)>(loadProc("glPixelStoref"));
    ptr_glPixelStorei = procTransmute<void(GLenum, GLint)>(loadProc("glPixelStorei"));
    ptr_glReadBuffer = procTransmute<void(GLenum)>(loadProc("glReadBuffer"));
    ptr_glReadPixels = procTransmute<void(GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void*?)>(loadProc("glReadPixels"));
    ptr_glGetBooleanv = procTransmute<void(GLenum, GLboolean[*])>(loadProc("glGetBooleanv"));
    ptr_glGetDoublev = procTransmute<void(GLenum, GLdouble[*])>(loadProc("glGetDoublev"));
    ptr_glGetError = procTransmute<GLenum()>(loadProc("glGetError"));
    ptr_glGetFloatv = procTransmute<void(GLenum, GLfloat[*])>(loadProc("glGetFloatv"));
    ptr_glGetIntegerv = procTransmute<void(GLenum, GLint[*])>(loadProc("glGetIntegerv"));
    ptr_glGetString = procTransmute<GLubyte*?(GLenum)>(loadProc("glGetString"));
    ptr_glGetTexImage = procTransmute<void(GLenum, GLint, GLenum, GLenum, void*?)>(loadProc("glGetTexImage"));
    ptr_glGetTexParameterfv = procTransmute<void(GLenum, GLenum, GLfloat[*])>(loadProc("glGetTexParameterfv"));
    ptr_glGetTexParameteriv = procTransmute<void(GLenum, GLenum, GLint[*])>(loadProc("glGetTexParameteriv"));
    ptr_glGetTexLevelParameterfv = procTransmute<void(GLenum, GLint, GLenum, GLfloat*)>(loadProc("glGetTexLevelParameterfv"));
    ptr_glGetTexLevelParameteriv = procTransmute<void(GLenum, GLint, GLenum, GLint*)>(loadProc("glGetTexLevelParameteriv"));
    ptr_glIsEnabled = procTransmute<GLboolean(GLenum)>(loadProc("glIsEnabled"));
    ptr_glDepthRange = procTransmute<void(GLdouble, GLdouble)>(loadProc("glDepthRange"));
    ptr_glViewport = procTransmute<void(GLint, GLint, GLsizei, GLsizei)>(loadProc("glViewport"));
    ptr_glDrawArrays = procTransmute<void(GLenum, GLint, GLsizei)>(loadProc("glDrawArrays"));
    ptr_glDrawElements = procTransmute<void(GLenum, GLsizei, GLenum, void*?)>(loadProc("glDrawElements"));
    ptr_glGetPointerv = procTransmute<void(GLenum, void**)>(loadProc("glGetPointerv"));
    ptr_glPolygonOffset = procTransmute<void(GLfloat, GLfloat)>(loadProc("glPolygonOffset"));
    ptr_glCopyTexImage1D = procTransmute<void(GLenum, GLint, GLenum, GLint, GLint, GLsizei, GLint)>(loadProc("glCopyTexImage1D"));
    ptr_glCopyTexImage2D = procTransmute<void(GLenum, GLint, GLenum, GLint, GLint, GLsizei, GLsizei, GLint)>(loadProc("glCopyTexImage2D"));
    ptr_glCopyTexSubImage1D = procTransmute<void(GLenum, GLint, GLint, GLint, GLint, GLsizei)>(loadProc("glCopyTexSubImage1D"));
    ptr_glCopyTexSubImage2D = procTransmute<void(GLenum, GLint, GLint, GLint, GLint, GLint, GLsizei, GLsizei)>(loadProc("glCopyTexSubImage2D"));
    ptr_glTexSubImage1D = procTransmute<void(GLenum, GLint, GLint, GLsizei, GLenum, GLenum, void*?)>(loadProc("glTexSubImage1D"));
    ptr_glTexSubImage2D = procTransmute<void(GLenum, GLint, GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void*?)>(loadProc("glTexSubImage2D"));
    ptr_glBindTexture = procTransmute<void(GLenum, GLuint)>(loadProc("glBindTexture"));
    ptr_glDeleteTextures = procTransmute<void(GLsizei, GLuint[*])>(loadProc("glDeleteTextures"));
    ptr_glGenTextures = procTransmute<void(GLsizei, GLuint[*])>(loadProc("glGenTextures"));
    ptr_glIsTexture = procTransmute<GLboolean(GLuint)>(loadProc("glIsTexture"));
    ptr_glDrawRangeElements = procTransmute<void(GLenum, GLuint, GLuint, GLsizei, GLenum, void*?)>(loadProc("glDrawRangeElements"));
    ptr_glTexImage3D = procTransmute<void(GLenum, GLint, GLint, GLsizei, GLsizei, GLsizei, GLint, GLenum, GLenum, void*?)>(loadProc("glTexImage3D"));
    ptr_glTexSubImage3D = procTransmute<void(GLenum, GLint, GLint, GLint, GLint, GLsizei, GLsizei, GLsizei, GLenum, GLenum, void*?)>(loadProc("glTexSubImage3D"));
    ptr_glCopyTexSubImage3D = procTransmute<void(GLenum, GLint, GLint, GLint, GLint, GLint, GLint, GLsizei, GLsizei)>(loadProc("glCopyTexSubImage3D"));
    ptr_glActiveTexture = procTransmute<void(GLenum)>(loadProc("glActiveTexture"));
    ptr_glSampleCoverage = procTransmute<void(GLfloat, GLboolean)>(loadProc("glSampleCoverage"));
    ptr_glCompressedTexImage3D = procTransmute<void(GLenum, GLint, GLenum, GLsizei, GLsizei, GLsizei, GLint, GLsizei, void*?)>(loadProc("glCompressedTexImage3D"));
    ptr_glCompressedTexImage2D = procTransmute<void(GLenum, GLint, GLenum, GLsizei, GLsizei, GLint, GLsizei, void*?)>(loadProc("glCompressedTexImage2D"));
    ptr_glCompressedTexImage1D = procTransmute<void(GLenum, GLint, GLenum, GLsizei, GLint, GLsizei, void*?)>(loadProc("glCompressedTexImage1D"));
    ptr_glCompressedTexSubImage3D = procTransmute<void(GLenum, GLint, GLint, GLint, GLint, GLsizei, GLsizei, GLsizei, GLenum, GLsizei, void*?)>(loadProc("glCompressedTexSubImage3D"));
    ptr_glCompressedTexSubImage2D = procTransmute<void(GLenum, GLint, GLint, GLint, GLsizei, GLsizei, GLenum, GLsizei, void*?)>(loadProc("glCompressedTexSubImage2D"));
    ptr_glCompressedTexSubImage1D = procTransmute<void(GLenum, GLint, GLint, GLsizei, GLenum, GLsizei, void*?)>(loadProc("glCompressedTexSubImage1D"));
    ptr_glGetCompressedTexImage = procTransmute<void(GLenum, GLint, void*?)>(loadProc("glGetCompressedTexImage"));
    ptr_glBlendFuncSeparate = procTransmute<void(GLenum, GLenum, GLenum, GLenum)>(loadProc("glBlendFuncSeparate"));
    ptr_glMultiDrawArrays = procTransmute<void(GLenum, GLint[*], GLsizei[*], GLsizei)>(loadProc("glMultiDrawArrays"));
    ptr_glMultiDrawElements = procTransmute<void(GLenum, GLsizei[*], GLenum, void*?[*], GLsizei)>(loadProc("glMultiDrawElements"));
    ptr_glPointParameterf = procTransmute<void(GLenum, GLfloat)>(loadProc("glPointParameterf"));
    ptr_glPointParameterfv = procTransmute<void(GLenum, GLfloat[*])>(loadProc("glPointParameterfv"));
    ptr_glPointParameteri = procTransmute<void(GLenum, GLint)>(loadProc("glPointParameteri"));
    ptr_glPointParameteriv = procTransmute<void(GLenum, GLint[*])>(loadProc("glPointParameteriv"));
    ptr_glBlendColor = procTransmute<void(GLfloat, GLfloat, GLfloat, GLfloat)>(loadProc("glBlendColor"));
