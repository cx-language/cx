extern void glUniformBlockBinding(GLuint program, GLuint uniformBlockIndex, GLuint uniformBlockBinding);

// OpenGL 3.2
/// Flag requesting a core profile context.
const GL_CONTEXT_CORE_PROFILE_BIT = 0x00000001;
/// Flag requesting a compatibility profile context.
const GL_CONTEXT_COMPATIBILITY_PROFILE_BIT = 0x00000002;
/// Draws line segments with adjacency vertices.
const GL_LINES_ADJACENCY = 0x000A;
/// Draws a line strip with adjacency vertices.
const GL_LINE_STRIP_ADJACENCY = 0x000B;
/// Draws triangles with adjacency vertices.
const GL_TRIANGLES_ADJACENCY = 0x000C;
/// Draws a triangle strip with adjacency vertices.
const GL_TRIANGLE_STRIP_ADJACENCY = 0x000D;
/// Enable flag for shader-controlled point size.
const GL_PROGRAM_POINT_SIZE = 0x8642;
/// Largest supported geometry texture unit count.
const GL_MAX_GEOMETRY_TEXTURE_IMAGE_UNITS = 0x8C29;
/// Whether a framebuffer attachment is layered.
const GL_FRAMEBUFFER_ATTACHMENT_LAYERED = 0x8DA7;
/// Status for inconsistent layered attachments.
const GL_FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS = 0x8DA8;
/// Geometry shader type.
const GL_GEOMETRY_SHADER = 0x8DD9;
/// Vertex count emitted by a geometry shader.
const GL_GEOMETRY_VERTICES_OUT = 0x8916;
/// Primitive type accepted by a geometry shader.
const GL_GEOMETRY_INPUT_TYPE = 0x8917;
/// Primitive type emitted by a geometry shader.
const GL_GEOMETRY_OUTPUT_TYPE = 0x8918;
/// Largest supported geometry uniform component count.
const GL_MAX_GEOMETRY_UNIFORM_COMPONENTS = 0x8DDF;
/// Largest supported geometry output vertex count.
const GL_MAX_GEOMETRY_OUTPUT_VERTICES = 0x8DE0;
/// Largest supported geometry output component count.
const GL_MAX_GEOMETRY_TOTAL_OUTPUT_COMPONENTS = 0x8DE1;
/// Largest supported vertex output component count.
const GL_MAX_VERTEX_OUTPUT_COMPONENTS = 0x9122;
/// Largest supported geometry input component count.
const GL_MAX_GEOMETRY_INPUT_COMPONENTS = 0x9123;
/// Largest supported geometry output component count.
const GL_MAX_GEOMETRY_OUTPUT_COMPONENTS = 0x9124;
/// Largest supported fragment input component count.
const GL_MAX_FRAGMENT_INPUT_COMPONENTS = 0x9125;
/// Profile mask the context was created with.
const GL_CONTEXT_PROFILE_MASK = 0x9126;
/// Enable flag clamping depth to the near and far planes.
const GL_DEPTH_CLAMP = 0x864F;
/// Whether quads follow the provoking vertex convention.
const GL_QUADS_FOLLOW_PROVOKING_VERTEX_CONVENTION = 0x8E4C;
/// Provoking vertex mode using the first vertex.
const GL_FIRST_VERTEX_CONVENTION = 0x8E4D;
/// Provoking vertex mode using the last vertex.
const GL_LAST_VERTEX_CONVENTION = 0x8E4E;
/// Current provoking vertex mode.
const GL_PROVOKING_VERTEX = 0x8E4F;
/// Enable flag for seamless cube map filtering.
const GL_TEXTURE_CUBE_MAP_SEAMLESS = 0x884F;
/// Largest supported server wait timeout.
const GL_MAX_SERVER_WAIT_TIMEOUT = 0x9111;
/// Object type of a sync object.
const GL_OBJECT_TYPE = 0x9112;
/// Wait condition of a sync object.
const GL_SYNC_CONDITION = 0x9113;
/// Signal status of a sync object.
const GL_SYNC_STATUS = 0x9114;
/// Flags a sync object was created with.
const GL_SYNC_FLAGS = 0x9115;
/// Fence sync object type.
const GL_SYNC_FENCE = 0x9116;
/// Sync condition for completed GPU commands.
const GL_SYNC_GPU_COMMANDS_COMPLETE = 0x9117;
/// Sync status meaning not yet signaled.
const GL_UNSIGNALED = 0x9118;
/// Sync status meaning signaled.
const GL_SIGNALED = 0x9119;
/// Wait result meaning already signaled.
const GL_ALREADY_SIGNALED = 0x911A;
/// Wait result meaning the timeout elapsed.
const GL_TIMEOUT_EXPIRED = 0x911B;
/// Wait result meaning the condition was met.
const GL_CONDITION_SATISFIED = 0x911C;
/// Wait result meaning the wait failed.
const GL_WAIT_FAILED = 0x911D;
/// Timeout value waiting indefinitely.
const GL_TIMEOUT_IGNORED = 0xFFFFFFFFFFFFFFFF;
/// Wait flag flushing commands first.
const GL_SYNC_FLUSH_COMMANDS_BIT = 0x00000001;
/// Position query for multisample samples.
const GL_SAMPLE_POSITION = 0x8E50;
/// Enable flag for sample masking.
const GL_SAMPLE_MASK = 0x8E51;
/// Current sample mask value.
const GL_SAMPLE_MASK_VALUE = 0x8E52;
/// Largest supported sample mask word count.
const GL_MAX_SAMPLE_MASK_WORDS = 0x8E59;
/// 2D multisample texture target.
const GL_TEXTURE_2D_MULTISAMPLE = 0x9100;
/// Proxy target probing 2D multisample support.
const GL_PROXY_TEXTURE_2D_MULTISAMPLE = 0x9101;
/// 2D multisample array texture target.
const GL_TEXTURE_2D_MULTISAMPLE_ARRAY = 0x9102;
/// Proxy target probing multisample array support.
const GL_PROXY_TEXTURE_2D_MULTISAMPLE_ARRAY = 0x9103;
/// Currently bound 2D multisample texture.
const GL_TEXTURE_BINDING_2D_MULTISAMPLE = 0x9104;
/// Currently bound multisample array texture.
const GL_TEXTURE_BINDING_2D_MULTISAMPLE_ARRAY = 0x9105;
/// Sample count of a multisample texture.
const GL_TEXTURE_SAMPLES = 0x9106;
/// Whether sample locations of a texture are fixed.
const GL_TEXTURE_FIXED_SAMPLE_LOCATIONS = 0x9107;
/// Multisample sampler uniform type.
const GL_SAMPLER_2D_MULTISAMPLE = 0x9108;
/// Signed integer multisample sampler uniform type.
const GL_INT_SAMPLER_2D_MULTISAMPLE = 0x9109;
/// Unsigned integer multisample sampler uniform type.
const GL_UNSIGNED_INT_SAMPLER_2D_MULTISAMPLE = 0x910A;
/// Multisample array sampler uniform type.
const GL_SAMPLER_2D_MULTISAMPLE_ARRAY = 0x910B;
/// Signed integer multisample array sampler uniform type.
const GL_INT_SAMPLER_2D_MULTISAMPLE_ARRAY = 0x910C;
/// Unsigned integer multisample array sampler uniform type.
const GL_UNSIGNED_INT_SAMPLER_2D_MULTISAMPLE_ARRAY = 0x910D;
/// Largest supported color texture sample count.
const GL_MAX_COLOR_TEXTURE_SAMPLES = 0x910E;
/// Largest supported depth texture sample count.
const GL_MAX_DEPTH_TEXTURE_SAMPLES = 0x910F;
/// Largest supported integer texture sample count.
const GL_MAX_INTEGER_SAMPLES = 0x9110;
/// Draws indexed primitives with a base vertex.
extern void glDrawElementsBaseVertex(GLenum mode, GLsizei count, GLenum type, void*? indices, GLint basevertex);
/// Draws ranged indexed primitives with a base vertex.
extern void glDrawRangeElementsBaseVertex(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum type, void*? indices, GLint basevertex);
/// Draws instanced indexed primitives with a base vertex.
extern void glDrawElementsInstancedBaseVertex(GLenum mode, GLsizei count, GLenum type, void*? indices, GLsizei instancecount, GLint basevertex);
/// Draws several indexed ranges with base vertices.
extern void glMultiDrawElementsBaseVertex(GLenum mode, GLsizei[*] count, GLenum type, void*?[*] indices, GLsizei drawcount, GLint[*] basevertex);
/// Selects the provoking vertex convention.
extern void glProvokingVertex(GLenum mode);
