using GLfloat = float;
using GLclampf = float;
using GLdouble = double;
using GLclampd = double;
using GLchar = char;
using GLint64 = int64;
using GLuint64 = uint64;
using GLsizeiptr = int64;
using GLintptr = int64;

struct GLSyncOpaque {}
using GLsync = GLSyncOpaque*;

