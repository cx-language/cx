// OpenGL 3.3 core bindings, translated from Khronos glcorearb.h
// (compatibility-profile entry points are not included).
// Link requirements live in the build.cx next to this file.

using GLenum = c_uint;
using GLboolean = c_uchar;
using GLbitfield = c_uint;
using GLbyte = c_schar;
