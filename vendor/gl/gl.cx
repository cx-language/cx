const GL_UNIFORM_BLOCK_REFERENCED_BY_GEOMETRY_SHADER = 0x8A45;
/// Fragment usage query for uniform blocks.
const GL_UNIFORM_BLOCK_REFERENCED_BY_FRAGMENT_SHADER = 0x8A46;
/// Result marking an invalid index.
const GL_INVALID_INDEX = 0xFFFFFFFF;
/// Draws instanced primitives from array data.
extern void glDrawArraysInstanced(GLenum mode, GLint first, GLsizei count, GLsizei instancecount);
/// Draws instanced indexed primitives.
extern void glDrawElementsInstanced(GLenum mode, GLsizei count, GLenum type, void*? indices, GLsizei instancecount);
/// Attaches a buffer as a texture.
extern void glTexBuffer(GLenum target, GLenum internalformat, GLuint buffer);
/// Sets the index restarting primitives.
extern void glPrimitiveRestartIndex(GLuint index);
/// Copies data between buffers.
extern void glCopyBufferSubData(GLenum readTarget, GLenum writeTarget, GLintptr readOffset, GLintptr writeOffset, GLsizeiptr size);
