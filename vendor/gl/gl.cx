extern void glGetInteger64v(GLenum pname, GLint64[*] data);
/// Queries integer sync object parameters.
extern void glGetSynciv(GLsync sync, GLenum pname, GLsizei count, GLsizei*? length, GLint[*] values);
/// Queries indexed 64-bit integer state values.
extern void glGetInteger64i_v(GLenum target, GLuint index, GLint64[*] data);
/// Queries 64-bit integer buffer parameters.
extern void glGetBufferParameteri64v(GLenum target, GLenum pname, GLint64* params);
/// Attaches a whole texture to a framebuffer.
extern void glFramebufferTexture(GLenum target, GLenum attachment, GLuint texture, GLint level);
/// Allocates a 2D multisample texture.
extern void glTexImage2DMultisample(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLboolean fixedsamplelocations);
/// Allocates a 3D multisample texture.
extern void glTexImage3DMultisample(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLsizei depth, GLboolean fixedsamplelocations);
/// Queries float multisample parameters.
extern void glGetMultisamplefv(GLenum pname, GLuint index, GLfloat[*] val);
/// Sets the sample mask for one mask word.
extern void glSampleMaski(GLuint maskNumber, GLbitfield mask);

// OpenGL 3.3
/// Instance divisor of a vertex attribute array.
const GL_VERTEX_ATTRIB_ARRAY_DIVISOR = 0x88FE;
/// Blend factor using the second source color.
const GL_SRC1_COLOR = 0x88F9;
/// Blend factor using one minus the second source color.
const GL_ONE_MINUS_SRC1_COLOR = 0x88FA;
/// Blend factor using one minus the second source alpha.
const GL_ONE_MINUS_SRC1_ALPHA = 0x88FB;
/// Largest supported dual-source draw buffer count.
const GL_MAX_DUAL_SOURCE_DRAW_BUFFERS = 0x88FC;
/// Query target reporting whether any samples passed.
const GL_ANY_SAMPLES_PASSED = 0x8C2F;
/// Sampler object bound to a texture unit.
const GL_SAMPLER_BINDING = 0x8919;
/// Packed unsigned integer RGBA format with 10-10-10-2 bits.
const GL_RGB10_A2UI = 0x906F;
/// Red channel swizzle parameter.
const GL_TEXTURE_SWIZZLE_R = 0x8E42;
/// Green channel swizzle parameter.
const GL_TEXTURE_SWIZZLE_G = 0x8E43;
/// Blue channel swizzle parameter.
const GL_TEXTURE_SWIZZLE_B = 0x8E44;
/// Alpha channel swizzle parameter.
const GL_TEXTURE_SWIZZLE_A = 0x8E45;
/// Combined channel swizzle parameter.
const GL_TEXTURE_SWIZZLE_RGBA = 0x8E46;
/// Query target measuring elapsed time.
const GL_TIME_ELAPSED = 0x88BF;
/// Query target recording timestamps.
const GL_TIMESTAMP = 0x8E28;
/// Reversed packed signed pixel type with 2-10-10-10 bits.
const GL_INT_2_10_10_10_REV = 0x8D9F;
