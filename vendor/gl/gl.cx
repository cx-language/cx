extern void glGetUniformIndices(GLuint program, GLsizei uniformCount, GLchar*[*] uniformNames, GLuint[*] uniformIndices);
/// Queries integer properties of active uniforms.
extern void glGetActiveUniformsiv(GLuint program, GLsizei uniformCount, GLuint[*] uniformIndices, GLenum pname, GLint[*] params);
/// Queries the name of an active uniform.
extern void glGetActiveUniformName(GLuint program, GLuint uniformIndex, GLsizei bufSize, GLsizei*? length, GLchar* uniformName);
/// Queries the index of a uniform block.
extern GLuint glGetUniformBlockIndex(GLuint program, GLchar* uniformBlockName);
