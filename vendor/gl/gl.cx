// OpenGL 3.3 core bindings, translated from Khronos glcorearb.h
// (compatibility-profile entry points are not included).
// Link requirements live in the build.cx next to this file.

/// Unsigned integer type used for OpenGL enumeration tokens.
using GLenum = c_uint;
/// Unsigned byte type used for OpenGL boolean values.
using GLboolean = c_uchar;
/// Unsigned integer type used for OpenGL bitmask fields.
using GLbitfield = c_uint;
/// Signed 8-bit integer type used by OpenGL.
using GLbyte = c_schar;
/// Signed 16-bit integer type used by OpenGL.
using GLshort = c_short;
/// Signed 32-bit integer type used by OpenGL.
using GLint = c_int;
/// Signed integer type used for OpenGL sizes and counts.
using GLsizei = c_int;
/// Unsigned 8-bit integer type used by OpenGL.
using GLubyte = c_uchar;
/// Unsigned 16-bit integer type used by OpenGL.
using GLushort = c_ushort;
/// 16-bit floating point type used by OpenGL.
using GLhalf = c_ushort;
/// Unsigned 32-bit integer type used by OpenGL.
using GLuint = c_uint;
/// 32-bit floating point type used by OpenGL.
using GLfloat = float;
/// 32-bit floating point type for clamped OpenGL values.
using GLclampf = float;
/// 64-bit floating point type used by OpenGL.
using GLdouble = double;
/// 64-bit floating point type for clamped OpenGL values.
using GLclampd = double;
/// Character type used for shader source and info logs.
using GLchar = char;
/// Signed 64-bit integer type used by OpenGL.
using GLint64 = int64;
/// Unsigned 64-bit integer type used by OpenGL.
using GLuint64 = uint64;
/// Signed integer type for buffer sizes and offsets.
using GLsizeiptr = int64;
/// Signed integer type for buffer offsets.
using GLintptr = int64;

/// Opaque backing type for sync object handles.
struct GLSyncOpaque {}
/// Opaque handle to an OpenGL fence sync object.
using GLsync = GLSyncOpaque*;

// OpenGL 1.0
/// Selects the depth buffer in a clear mask.
const GL_DEPTH_BUFFER_BIT = 0x00000100;
/// Selects the stencil buffer in a clear mask.
const GL_STENCIL_BUFFER_BIT = 0x00000400;
/// Selects the color buffers in a clear mask.
const GL_COLOR_BUFFER_BIT = 0x00004000;
/// Boolean false value.
const GL_FALSE = 0;
/// Boolean true value.
const GL_TRUE = 1;
/// Draws each vertex as a single point.
const GL_POINTS = 0x0000;
/// Draws vertices as separate line segments.
const GL_LINES = 0x0001;
/// Draws vertices as a closed loop of lines.
const GL_LINE_LOOP = 0x0002;
/// Draws vertices as a connected strip of lines.
const GL_LINE_STRIP = 0x0003;
/// Draws vertices as separate triangles.
const GL_TRIANGLES = 0x0004;
/// Draws vertices as a connected strip of triangles.
const GL_TRIANGLE_STRIP = 0x0005;
/// Draws vertices as a fan of triangles around the first vertex.
const GL_TRIANGLE_FAN = 0x0006;
/// Draws vertices as separate quadrilaterals.
const GL_QUADS = 0x0007;
/// Test that never passes.
const GL_NEVER = 0x0200;
/// Test that passes when the incoming value is smaller.
const GL_LESS = 0x0201;
/// Test that passes when values match.
const GL_EQUAL = 0x0202;
/// Test that passes when the incoming value is smaller or equal.
const GL_LEQUAL = 0x0203;
/// Test that passes when the incoming value is larger.
const GL_GREATER = 0x0204;
/// Test that passes when values differ.
const GL_NOTEQUAL = 0x0205;
/// Test that passes when the incoming value is larger or equal.
const GL_GEQUAL = 0x0206;
/// Test that always passes.
const GL_ALWAYS = 0x0207;
/// Blend factor of zero.
const GL_ZERO = 0;
/// Blend factor of one.
const GL_ONE = 1;
/// Blend factor using the source color.
const GL_SRC_COLOR = 0x0300;
/// Blend factor using one minus the source color.
const GL_ONE_MINUS_SRC_COLOR = 0x0301;
/// Blend factor using the source alpha.
const GL_SRC_ALPHA = 0x0302;
/// Blend factor using one minus the source alpha.
const GL_ONE_MINUS_SRC_ALPHA = 0x0303;
/// Blend factor using the destination alpha.
const GL_DST_ALPHA = 0x0304;
/// Blend factor using one minus the destination alpha.
const GL_ONE_MINUS_DST_ALPHA = 0x0305;
/// Blend factor using the destination color.
const GL_DST_COLOR = 0x0306;
/// Blend factor using one minus the destination color.
const GL_ONE_MINUS_DST_COLOR = 0x0307;
/// Blend factor saturating against the destination alpha.
const GL_SRC_ALPHA_SATURATE = 0x0308;
/// Selects no buffer.
const GL_NONE = 0;
/// Front-left color buffer selector.
const GL_FRONT_LEFT = 0x0400;
/// Front-right color buffer selector.
const GL_FRONT_RIGHT = 0x0401;
/// Back-left color buffer selector.
const GL_BACK_LEFT = 0x0402;
/// Back-right color buffer selector.
const GL_BACK_RIGHT = 0x0403;
/// Front face selector.
const GL_FRONT = 0x0404;
/// Back face selector.
const GL_BACK = 0x0405;
/// Left buffer selector.
const GL_LEFT = 0x0406;
/// Right buffer selector.
const GL_RIGHT = 0x0407;
/// Front and back face selector.
const GL_FRONT_AND_BACK = 0x0408;
/// Reports that no error occurred.
const GL_NO_ERROR = 0;
/// Error for an invalid enumeration value.
const GL_INVALID_ENUM = 0x0500;
/// Error for a numeric argument out of range.
const GL_INVALID_VALUE = 0x0501;
/// Error for a call invalid in the current state.
const GL_INVALID_OPERATION = 0x0502;
/// Error for a failed memory allocation.
const GL_OUT_OF_MEMORY = 0x0505;
/// Clockwise front-face winding.
const GL_CW = 0x0900;
/// Counter-clockwise front-face winding.
const GL_CCW = 0x0901;
/// Current rasterized point diameter.
const GL_POINT_SIZE = 0x0B11;
/// Supported range of point diameters.
const GL_POINT_SIZE_RANGE = 0x0B12;
/// Step size between supported point diameters.
const GL_POINT_SIZE_GRANULARITY = 0x0B13;
/// Enable flag for antialiased lines.
const GL_LINE_SMOOTH = 0x0B20;
/// Current rasterized line width.
const GL_LINE_WIDTH = 0x0B21;
/// Supported range of line widths.
const GL_LINE_WIDTH_RANGE = 0x0B22;
/// Step size between supported line widths.
const GL_LINE_WIDTH_GRANULARITY = 0x0B23;
/// Current polygon rasterization mode.
const GL_POLYGON_MODE = 0x0B40;
/// Enable flag for antialiased polygons.
const GL_POLYGON_SMOOTH = 0x0B41;
/// Enable flag for face culling.
const GL_CULL_FACE = 0x0B44;
/// Which faces get culled.
const GL_CULL_FACE_MODE = 0x0B45;
/// Winding order treated as front-facing.
const GL_FRONT_FACE = 0x0B46;
/// Current near and far depth mapping.
const GL_DEPTH_RANGE = 0x0B70;
/// Enable flag for depth testing.
const GL_DEPTH_TEST = 0x0B71;
/// Whether depth writes are enabled.
const GL_DEPTH_WRITEMASK = 0x0B72;
/// Value used when clearing the depth buffer.
const GL_DEPTH_CLEAR_VALUE = 0x0B73;
/// Current depth comparison function.
const GL_DEPTH_FUNC = 0x0B74;
/// Enable flag for stencil testing.
const GL_STENCIL_TEST = 0x0B90;
/// Value used when clearing the stencil buffer.
const GL_STENCIL_CLEAR_VALUE = 0x0B91;
/// Current stencil comparison function.
const GL_STENCIL_FUNC = 0x0B92;
/// Mask applied to values in the stencil test.
const GL_STENCIL_VALUE_MASK = 0x0B93;
/// Stencil action taken when the stencil test fails.
const GL_STENCIL_FAIL = 0x0B94;
/// Stencil action taken when depth testing fails.
const GL_STENCIL_PASS_DEPTH_FAIL = 0x0B95;
/// Stencil action taken when both tests pass.
const GL_STENCIL_PASS_DEPTH_PASS = 0x0B96;
/// Reference value for the stencil test.
const GL_STENCIL_REF = 0x0B97;
/// Mask selecting writable stencil bits.
const GL_STENCIL_WRITEMASK = 0x0B98;
/// Current viewport rectangle.
const GL_VIEWPORT = 0x0BA2;
/// Enable flag for color dithering.
const GL_DITHER = 0x0BD0;
/// Current destination blend factor.
const GL_BLEND_DST = 0x0BE0;
/// Current source blend factor.
const GL_BLEND_SRC = 0x0BE1;
/// Enable flag for blending.
const GL_BLEND = 0x0BE2;
/// Current logic operation.
const GL_LOGIC_OP_MODE = 0x0BF0;
/// Current draw buffer selector.
const GL_DRAW_BUFFER = 0x0C01;
/// Current read buffer selector.
const GL_READ_BUFFER = 0x0C02;
/// Current scissor rectangle.
const GL_SCISSOR_BOX = 0x0C10;
/// Enable flag for the scissor test.
const GL_SCISSOR_TEST = 0x0C11;
/// Color used when clearing color buffers.
const GL_COLOR_CLEAR_VALUE = 0x0C22;
/// Per-channel color write enables.
const GL_COLOR_WRITEMASK = 0x0C23;
/// Whether the buffers are double-buffered.
const GL_DOUBLEBUFFER = 0x0C32;
/// Whether stereo buffers are present.
const GL_STEREO = 0x0C33;
/// Quality hint for line smoothing.
const GL_LINE_SMOOTH_HINT = 0x0C52;
/// Quality hint for polygon smoothing.
const GL_POLYGON_SMOOTH_HINT = 0x0C53;
/// Byte-swapping flag for pixel uploads.
const GL_UNPACK_SWAP_BYTES = 0x0CF0;
/// Bit-order flag for pixel uploads.
const GL_UNPACK_LSB_FIRST = 0x0CF1;
/// Row length override for pixel uploads.
const GL_UNPACK_ROW_LENGTH = 0x0CF2;
/// Rows skipped at the start of pixel uploads.
const GL_UNPACK_SKIP_ROWS = 0x0CF3;
/// Pixels skipped at the start of pixel uploads.
const GL_UNPACK_SKIP_PIXELS = 0x0CF4;
/// Row alignment for pixel uploads.
const GL_UNPACK_ALIGNMENT = 0x0CF5;
/// Byte-swapping flag for pixel downloads.
const GL_PACK_SWAP_BYTES = 0x0D00;
/// Bit-order flag for pixel downloads.
const GL_PACK_LSB_FIRST = 0x0D01;
/// Row length override for pixel downloads.
const GL_PACK_ROW_LENGTH = 0x0D02;
/// Rows skipped at the start of pixel downloads.
const GL_PACK_SKIP_ROWS = 0x0D03;
/// Pixels skipped at the start of pixel downloads.
const GL_PACK_SKIP_PIXELS = 0x0D04;
/// Row alignment for pixel downloads.
const GL_PACK_ALIGNMENT = 0x0D05;
/// Largest supported texture dimension.
const GL_MAX_TEXTURE_SIZE = 0x0D33;
/// Largest supported viewport dimensions.
const GL_MAX_VIEWPORT_DIMS = 0x0D3A;
/// Subpixel precision bits for window coordinates.
const GL_SUBPIXEL_BITS = 0x0D50;
/// One-dimensional texture target.
const GL_TEXTURE_1D = 0x0DE0;
/// Two-dimensional texture target.
const GL_TEXTURE_2D = 0x0DE1;
/// Width of a texture level.
const GL_TEXTURE_WIDTH = 0x1000;
/// Height of a texture level.
const GL_TEXTURE_HEIGHT = 0x1001;
/// Border color of a texture.
const GL_TEXTURE_BORDER_COLOR = 0x1004;
/// Hint letting the driver pick speed or quality.
const GL_DONT_CARE = 0x1100;
/// Hint preferring rendering speed.
const GL_FASTEST = 0x1101;
/// Hint preferring rendering quality.
const GL_NICEST = 0x1102;
/// Signed 8-bit integer data type.
const GL_BYTE = 0x1400;
/// Unsigned 8-bit integer data type.
const GL_UNSIGNED_BYTE = 0x1401;
/// Signed 16-bit integer data type.
const GL_SHORT = 0x1402;
/// Unsigned 16-bit integer data type.
const GL_UNSIGNED_SHORT = 0x1403;
/// Signed 32-bit integer data type.
const GL_INT = 0x1404;
/// Unsigned 32-bit integer data type.
const GL_UNSIGNED_INT = 0x1405;
/// 32-bit floating point data type.
const GL_FLOAT = 0x1406;
/// Error for pushing onto a full stack.
const GL_STACK_OVERFLOW = 0x0503;
/// Error for popping from an empty stack.
const GL_STACK_UNDERFLOW = 0x0504;
/// Logic op forcing the destination to zero.
const GL_CLEAR = 0x1500;
/// Logic op AND-ing source and destination.
const GL_AND = 0x1501;
/// Logic op AND-ing source with inverted destination.
const GL_AND_REVERSE = 0x1502;
/// Logic op copying the source.
const GL_COPY = 0x1503;
/// Logic op AND-ing inverted source with destination.
const GL_AND_INVERTED = 0x1504;
/// Logic op leaving the destination unchanged.
const GL_NOOP = 0x1505;
/// Logic op XOR-ing source and destination.
const GL_XOR = 0x1506;
/// Logic op OR-ing source and destination.
const GL_OR = 0x1507;
/// Logic op NOR-ing source and destination.
const GL_NOR = 0x1508;
/// Logic op for bitwise equivalence of source and destination.
const GL_EQUIV = 0x1509;
/// Logic op inverting the destination.
const GL_INVERT = 0x150A;
/// Logic op OR-ing source with inverted destination.
const GL_OR_REVERSE = 0x150B;
/// Logic op copying the inverted source.
const GL_COPY_INVERTED = 0x150C;
/// Logic op OR-ing inverted source with destination.
const GL_OR_INVERTED = 0x150D;
/// Logic op NAND-ing source and destination.
const GL_NAND = 0x150E;
/// Logic op forcing the destination to one.
const GL_SET = 0x150F;
/// Texture matrix stack selector.
const GL_TEXTURE = 0x1702;
/// Color buffer selector for buffer commands.
const GL_COLOR = 0x1800;
/// Depth buffer selector for buffer commands.
const GL_DEPTH = 0x1801;
/// Stencil buffer selector for buffer commands.
const GL_STENCIL = 0x1802;
/// Stencil-index pixel format.
const GL_STENCIL_INDEX = 0x1901;
/// Depth-component pixel format.
const GL_DEPTH_COMPONENT = 0x1902;
/// Single-channel red pixel format.
const GL_RED = 0x1903;
/// Single-channel green pixel format.
const GL_GREEN = 0x1904;
/// Single-channel blue pixel format.
const GL_BLUE = 0x1905;
/// Single-channel alpha pixel format.
const GL_ALPHA = 0x1906;
/// Three-channel red-green-blue pixel format.
const GL_RGB = 0x1907;
/// Four-channel red-green-blue-alpha pixel format.
const GL_RGBA = 0x1908;
/// Point polygon rasterization mode.
const GL_POINT = 0x1B00;
/// Wireframe polygon rasterization mode.
const GL_LINE = 0x1B01;
/// Filled polygon rasterization mode.
const GL_FILL = 0x1B02;
/// Stencil action keeping the stored value.
const GL_KEEP = 0x1E00;
/// Stencil action replacing with the reference value.
const GL_REPLACE = 0x1E01;
/// Stencil action incrementing with saturation.
const GL_INCR = 0x1E02;
/// Stencil action decrementing with saturation.
const GL_DECR = 0x1E03;
/// String naming the driver vendor.
const GL_VENDOR = 0x1F00;
/// String naming the renderer.
const GL_RENDERER = 0x1F01;
/// String naming the OpenGL version.
const GL_VERSION = 0x1F02;
/// String listing supported extensions.
const GL_EXTENSIONS = 0x1F03;
/// Filter picking the nearest texel.
const GL_NEAREST = 0x2600;
/// Filter interpolating nearby texels.
const GL_LINEAR = 0x2601;
/// Mipmap filter picking the nearest level and texel.
const GL_NEAREST_MIPMAP_NEAREST = 0x2700;
/// Mipmap filter interpolating within the nearest level.
const GL_LINEAR_MIPMAP_NEAREST = 0x2701;
/// Mipmap filter picking the nearest texel across two levels.
const GL_NEAREST_MIPMAP_LINEAR = 0x2702;
/// Mipmap filter interpolating within and across levels.
const GL_LINEAR_MIPMAP_LINEAR = 0x2703;
/// Texture magnification filter parameter.
const GL_TEXTURE_MAG_FILTER = 0x2800;
/// Texture minification filter parameter.
const GL_TEXTURE_MIN_FILTER = 0x2801;
/// Texture wrap mode along the S axis.
const GL_TEXTURE_WRAP_S = 0x2802;
/// Texture wrap mode along the T axis.
const GL_TEXTURE_WRAP_T = 0x2803;
/// Wrap mode tiling the texture.
const GL_REPEAT = 0x2901;
/// Selects which faces get culled.
extern void glCullFace(GLenum mode);
/// Selects the winding order treated as front-facing.
extern void glFrontFace(GLenum mode);
/// Sets a quality hint for an implementation choice.
extern void glHint(GLenum target, GLenum mode);
/// Sets the rasterized line width.
extern void glLineWidth(GLfloat width);
/// Sets the rasterized point diameter.
extern void glPointSize(GLfloat size);
/// Sets the rasterization mode for polygons.
extern void glPolygonMode(GLenum face, GLenum mode);
/// Sets the scissor rectangle.
extern void glScissor(GLint x, GLint y, GLsizei width, GLsizei height);
/// Sets a float texture parameter.
extern void glTexParameterf(GLenum target, GLenum pname, GLfloat param);
/// Sets a texture parameter from a float array.
extern void glTexParameterfv(GLenum target, GLenum pname, GLfloat[*] params);
/// Sets an integer texture parameter.
extern void glTexParameteri(GLenum target, GLenum pname, GLint param);
/// Sets a texture parameter from an integer array.
extern void glTexParameteriv(GLenum target, GLenum pname, GLint[*] params);
/// Uploads a 1D texture image.
extern void glTexImage1D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLint border, GLenum format, GLenum type, void*? pixels);
/// Uploads a 2D texture image.
extern void glTexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, void*? pixels);
/// Selects the buffer drawn into.
extern void glDrawBuffer(GLenum buf);
/// Clears the selected buffers.
extern void glClear(GLbitfield mask);
/// Sets the color used when clearing.
extern void glClearColor(GLfloat red, GLfloat green, GLfloat blue, GLfloat alpha);
/// Sets the value used when clearing the stencil buffer.
extern void glClearStencil(GLint s);
/// Sets the value used when clearing the depth buffer.
extern void glClearDepth(GLdouble depth);
/// Sets the stencil write mask.
extern void glStencilMask(GLuint mask);
/// Sets the per-channel color write mask.
extern void glColorMask(GLboolean red, GLboolean green, GLboolean blue, GLboolean alpha);
/// Sets whether depth writes are enabled.
extern void glDepthMask(GLboolean flag);
/// Disables a rendering capability.
extern void glDisable(GLenum cap);
/// Enables a rendering capability.
extern void glEnable(GLenum cap);
/// Blocks until all commands complete.
extern void glFinish();
/// Submits queued commands for execution.
extern void glFlush();
/// Sets the source and destination blend factors.
extern void glBlendFunc(GLenum sfactor, GLenum dfactor);
/// Sets the logic operation for color writes.
extern void glLogicOp(GLenum opcode);
/// Sets the stencil test function and reference.
extern void glStencilFunc(GLenum func, GLint ref, GLuint mask);
/// Sets the actions for stencil test outcomes.
extern void glStencilOp(GLenum fail, GLenum zfail, GLenum zpass);
/// Sets the depth comparison function.
extern void glDepthFunc(GLenum func);
/// Sets a float pixel storage parameter.
extern void glPixelStoref(GLenum pname, GLfloat param);
/// Sets an integer pixel storage parameter.
extern void glPixelStorei(GLenum pname, GLint param);
/// Selects the buffer read from.
extern void glReadBuffer(GLenum src);
/// Reads a rectangle of pixels into memory.
extern void glReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, void*? pixels);
/// Queries boolean state values.
extern void glGetBooleanv(GLenum pname, GLboolean[*] data);
/// Queries double state values.
extern void glGetDoublev(GLenum pname, GLdouble[*] data);
/// Returns and clears the oldest error.
extern GLenum glGetError();
/// Queries float state values.
extern void glGetFloatv(GLenum pname, GLfloat[*] data);
/// Queries integer state values.
extern void glGetIntegerv(GLenum pname, GLint[*] data);
/// Queries a string describing the implementation.
extern GLubyte*? glGetString(GLenum name);
/// Downloads a texture image into memory.
extern void glGetTexImage(GLenum target, GLint level, GLenum format, GLenum type, void*? pixels);
/// Queries float texture parameters.
extern void glGetTexParameterfv(GLenum target, GLenum pname, GLfloat[*] params);
/// Queries integer texture parameters.
extern void glGetTexParameteriv(GLenum target, GLenum pname, GLint[*] params);
/// Queries float parameters of a texture level.
extern void glGetTexLevelParameterfv(GLenum target, GLint level, GLenum pname, GLfloat* params);
/// Queries integer parameters of a texture level.
extern void glGetTexLevelParameteriv(GLenum target, GLint level, GLenum pname, GLint* params);
/// Reports whether a capability is enabled.
extern GLboolean glIsEnabled(GLenum cap);
/// Sets the mapping from clip depth to window depth.
extern void glDepthRange(GLdouble n, GLdouble f);
/// Sets the viewport rectangle.
extern void glViewport(GLint x, GLint y, GLsizei width, GLsizei height);

// OpenGL 1.1
/// Enable flag for color logic operations.
const GL_COLOR_LOGIC_OP = 0x0BF2;
/// Depth offset units factor.
const GL_POLYGON_OFFSET_UNITS = 0x2A00;
/// Enable flag for point polygon offset.
const GL_POLYGON_OFFSET_POINT = 0x2A01;
/// Enable flag for line polygon offset.
const GL_POLYGON_OFFSET_LINE = 0x2A02;
/// Enable flag for filled polygon offset.
const GL_POLYGON_OFFSET_FILL = 0x8037;
/// Depth offset slope factor.
const GL_POLYGON_OFFSET_FACTOR = 0x8038;
/// Currently bound 1D texture.
const GL_TEXTURE_BINDING_1D = 0x8068;
/// Currently bound 2D texture.
const GL_TEXTURE_BINDING_2D = 0x8069;
/// Internal storage format of a texture level.
const GL_TEXTURE_INTERNAL_FORMAT = 0x1003;
/// Red channel bit depth of a texture level.
const GL_TEXTURE_RED_SIZE = 0x805C;
/// Green channel bit depth of a texture level.
const GL_TEXTURE_GREEN_SIZE = 0x805D;
/// Blue channel bit depth of a texture level.
const GL_TEXTURE_BLUE_SIZE = 0x805E;
/// Alpha channel bit depth of a texture level.
const GL_TEXTURE_ALPHA_SIZE = 0x805F;
/// 64-bit floating point data type.
const GL_DOUBLE = 0x140A;
/// Proxy target probing 1D texture support.
const GL_PROXY_TEXTURE_1D = 0x8063;
/// Proxy target probing 2D texture support.
const GL_PROXY_TEXTURE_2D = 0x8064;
/// Packed 8-bit RGB internal format.
const GL_R3_G3_B2 = 0x2A10;
/// RGB internal format with 4 bits per channel.
const GL_RGB4 = 0x804F;
/// RGB internal format with 5 bits per channel.
const GL_RGB5 = 0x8050;
/// RGB internal format with 8 bits per channel.
const GL_RGB8 = 0x8051;
/// RGB internal format with 10 bits per channel.
const GL_RGB10 = 0x8052;
/// RGB internal format with 12 bits per channel.
const GL_RGB12 = 0x8053;
/// RGB internal format with 16 bits per channel.
const GL_RGB16 = 0x8054;
/// RGBA internal format with 2 bits per channel.
const GL_RGBA2 = 0x8055;
/// RGBA internal format with 4 bits per channel.
const GL_RGBA4 = 0x8056;
/// RGBA internal format with 5 color bits and 1 alpha bit.
const GL_RGB5_A1 = 0x8057;
/// RGBA internal format with 8 bits per channel.
const GL_RGBA8 = 0x8058;
/// RGBA internal format with 10 color bits and 2 alpha bits.
const GL_RGB10_A2 = 0x8059;
/// RGBA internal format with 12 bits per channel.
const GL_RGBA12 = 0x805A;
/// RGBA internal format with 16 bits per channel.
const GL_RGBA16 = 0x805B;
/// Enable flag for the vertex array.
const GL_VERTEX_ARRAY = 0x8074;
/// Draws primitives from array data.
extern void glDrawArrays(GLenum mode, GLint first, GLsizei count);
/// Draws primitives from indexed array data.
extern void glDrawElements(GLenum mode, GLsizei count, GLenum type, void*? indices);
/// Queries an array pointer.
extern void glGetPointerv(GLenum pname, void** params);
/// Sets the depth offset for polygons.
extern void glPolygonOffset(GLfloat factor, GLfloat units);
/// Copies the framebuffer into a 1D texture image.
extern void glCopyTexImage1D(GLenum target, GLint level, GLenum internalformat, GLint x, GLint y, GLsizei width, GLint border);
/// Copies the framebuffer into a 2D texture image.
extern void glCopyTexImage2D(GLenum target, GLint level, GLenum internalformat, GLint x, GLint y, GLsizei width, GLsizei height, GLint border);
/// Copies the framebuffer into part of a 1D texture.
extern void glCopyTexSubImage1D(GLenum target, GLint level, GLint xoffset, GLint x, GLint y, GLsizei width);
/// Copies the framebuffer into part of a 2D texture.
extern void glCopyTexSubImage2D(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLint x, GLint y, GLsizei width, GLsizei height);
/// Replaces part of a 1D texture image.
extern void glTexSubImage1D(GLenum target, GLint level, GLint xoffset, GLsizei width, GLenum format, GLenum type, void*? pixels);
/// Replaces part of a 2D texture image.
extern void glTexSubImage2D(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width, GLsizei height, GLenum format, GLenum type, void*? pixels);
/// Binds a texture to a target.
extern void glBindTexture(GLenum target, GLuint texture);
/// Deletes texture objects.
extern void glDeleteTextures(GLsizei n, GLuint[*] textures);
/// Creates texture object names.
extern void glGenTextures(GLsizei n, GLuint[*] textures);
/// Reports whether a name is a texture object.
extern GLboolean glIsTexture(GLuint texture);

// OpenGL 1.2
/// Packed pixel type with 3-3-2 bits.
const GL_UNSIGNED_BYTE_3_3_2 = 0x8032;
/// Packed pixel type with 4 bits per channel.
const GL_UNSIGNED_SHORT_4_4_4_4 = 0x8033;
