extern GLsync? glFenceSync(GLenum condition, GLbitfield flags);
/// Reports whether a handle is a sync object.
extern GLboolean glIsSync(GLsync? sync);
/// Deletes a sync object.
extern void glDeleteSync(GLsync? sync);
