// The OpenGL extern declarations: the single source of truth behind
// gl-loader.cx. Edit by hand (shared decls live in gl.cx), then run
// scripts/generate-gl-loader.py to regenerate the Windows loader.

#if !Windows
/// Selects which faces get culled.
extern void glCullFace(GLenum mode);

/// Selects the winding order treated as front-facing.
extern void glFrontFace(GLenum mode);

/// Sets a quality hint for an implementation choice.
extern void glHint(GLenum target, GLenum mode);

/// Sets the rasterized line width.
extern void glLineWidth(GLfloat width);

/// Sets the rasterized point diameter.
extern void glPointSize(GLfloat size);

/// Sets the rasterization mode for polygons.
extern void glPolygonMode(GLenum face, GLenum mode);

/// Sets the scissor rectangle.
extern void glScissor(GLint x, GLint y, GLsizei width, GLsizei height);

/// Sets a float texture parameter.
extern void glTexParameterf(GLenum target, GLenum pname, GLfloat param);

/// Sets a texture parameter from a float array.
extern void glTexParameterfv(GLenum target, GLenum pname, GLfloat[*] params);

/// Sets an integer texture parameter.
extern void glTexParameteri(GLenum target, GLenum pname, GLint param);

/// Sets a texture parameter from an integer array.
extern void glTexParameteriv(GLenum target, GLenum pname, GLint[*] params);

/// Uploads a 1D texture image.
extern void glTexImage1D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLint border, GLenum format, GLenum type, void*? pixels);

/// Uploads a 2D texture image.
extern void glTexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, void*? pixels);

/// Selects the buffer drawn into.
extern void glDrawBuffer(GLenum buf);

/// Clears the selected buffers.
extern void glClear(GLbitfield mask);

/// Sets the color used when clearing.
extern void glClearColor(GLfloat red, GLfloat green, GLfloat blue, GLfloat alpha);

/// Sets the value used when clearing the stencil buffer.
extern void glClearStencil(GLint s);

/// Sets the value used when clearing the depth buffer.
extern void glClearDepth(GLdouble depth);

/// Sets the stencil write mask.
extern void glStencilMask(GLuint mask);

/// Sets the per-channel color write mask.
extern void glColorMask(GLboolean red, GLboolean green, GLboolean blue, GLboolean alpha);

/// Sets whether depth writes are enabled.
extern void glDepthMask(GLboolean flag);

/// Disables a rendering capability.
extern void glDisable(GLenum cap);

/// Enables a rendering capability.
extern void glEnable(GLenum cap);

/// Blocks until all commands complete.
extern void glFinish();

