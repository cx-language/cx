}
/// Pinch event structure (event.pinch.*).
struct SDL_PinchFingerEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    float32 scale;
    SDL_WindowID windowID;
}
/// Details about the format of a pixel.
struct SDL_PixelFormatDetails {
    SDL_PixelFormat format;
    Uint8 bits_per_pixel;
    Uint8 bytes_per_pixel;
    Uint8[2] padding;
    Uint32 Rmask;
    Uint32 Gmask;
    Uint32 Bmask;
    Uint32 Amask;
    Uint8 Rbits;
    Uint8 Gbits;
    Uint8 Bbits;
    Uint8 Abits;
    Uint8 Rshift;
    Uint8 Gshift;
    Uint8 Bshift;
    Uint8 Ashift;
}
/// The structure that defines a point (using integers).
struct SDL_Point {
    c_int x;
    c_int y;
}
/// The "quit requested" event.
struct SDL_QuitEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
}
/// A rectangle, with the origin at the upper left (using integers).
struct SDL_Rect {
    c_int x;
    c_int y;
    c_int w;
    c_int h;
}
/// Renderer event structure (event.render.*).
struct SDL_RenderEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
}
/// Sensor event structure (event.sensor.*).
struct SDL_SensorEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_SensorID which;
    float32[6] data;
    Uint64 sensor_timestamp;
}
/// Function interface for SDL_Storage.
struct SDL_StorageInterface {
    Uint32 version;
    bool(void*?)? close;
    bool(void*?)? ready;
    bool(void*?, char*?, SDL_EnumerateDirectoryCallback, void*?)? enumerate;
    bool(void*?, char*?, SDL_PathInfo*?)? info;
    bool(void*?, char*?, void*?, Uint64)? read_file;
    bool(void*?, char*?, void*?, Uint64)? write_file;
    bool(void*?, char*?)? mkdir;
    bool(void*?, char*?)? remove;
    bool(void*?, char*?, char*?)? rename;
    bool(void*?, char*?, char*?)? copy;
    Uint64(void*?)? space_remaining;
}
/// A collection of pixels used in software blitting.
struct SDL_Surface {
    SDL_SurfaceFlags flags;
    SDL_PixelFormat format;
    c_int w;
    c_int h;
    c_int pitch;
    void*? pixels;
    c_int refcount;
    void*? reserved;
}
/// Keyboard IME candidates event structure (event.edit_candidates.*).
struct SDL_TextEditingCandidatesEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    char*?[*]? candidates;
    Sint32 num_candidates;
    Sint32 selected_candidate;
    bool horizontal;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// Keyboard text editing event structure (event.edit.*).
struct SDL_TextEditingEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    char*? text;
    Sint32 start;
    Sint32 length;
}
/// Keyboard text input event structure (event.text.*).
struct SDL_TextInputEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    char*? text;
}
/// An efficient driver-specific representation of pixel data.
struct SDL_Texture {
    SDL_PixelFormat format;
    c_int w;
    c_int h;
    c_int refcount;
}
/// Touch finger event structure (event.tfinger.*).
struct SDL_TouchFingerEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_TouchID touchID;
    SDL_FingerID fingerID;
    float32 x;
    float32 y;
    float32 dx;
    float32 dy;
    float32 pressure;
    SDL_WindowID windowID;
}
/// A user-defined event type (event.user.*).
struct SDL_UserEvent {
    Uint32 type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    Sint32 code;
    void*? data1;
    void*? data2;
}
/// Vertex structure.
struct SDL_Vertex {
    SDL_FPoint position;
    SDL_FColor color;
    SDL_FPoint tex_coord;
}
/// The structure that describes a virtual joystick.
struct SDL_VirtualJoystickDesc {
    Uint32 version;
    Uint16 type;
    Uint16 padding;
    Uint16 vendor_id;
    Uint16 product_id;
    Uint16 naxes;
    Uint16 nbuttons;
    Uint16 nballs;
    Uint16 nhats;
    Uint16 ntouchpads;
    Uint16 nsensors;
    Uint16[2] padding2;
    Uint32 button_mask;
    Uint32 axis_mask;
    char*? name;
    SDL_VirtualJoystickTouchpadDesc[*]? touchpads;
    SDL_VirtualJoystickSensorDesc[*]? sensors;
    void*? userdata;
    void(void*?)? Update;
    void(void*?, c_int)? SetPlayerIndex;
    bool(void*?, Uint16, Uint16)? Rumble;
    bool(void*?, Uint16, Uint16)? RumbleTriggers;
    bool(void*?, Uint8, Uint8, Uint8)? SetLED;
    bool(void*?, void*?, c_int)? SendEffect;
    bool(void*?, bool)? SetSensorsEnabled;
    void(void*?)? Cleanup;
}
/// The structure that describes a virtual joystick sensor.
struct SDL_VirtualJoystickSensorDesc {
    SDL_SensorType type;
    float32 rate;
}
/// The structure that describes a virtual joystick touchpad.
struct SDL_VirtualJoystickTouchpadDesc {
    Uint16 nfingers;
    Uint16[3] padding;
}
/// Window state change event data (event.window.*).
struct SDL_WindowEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    Sint32 data1;
    Sint32 data2;
}
/// Internal struct for testing alignment.
struct SDL_alignment_test {
    Uint8 a;
    void*? b;
}
/// Pointer to the next device.
struct SDL_hid_device_info {
    char*? path;
    c_ushort vendor_id;
    c_ushort product_id;
    wchar_t*? serial_number;
    c_ushort release_number;
    wchar_t*? manufacturer_string;
    wchar_t*? product_string;
    c_ushort usage_page;
    c_ushort usage;
    c_int interface_number;
    c_int interface_class;
    c_int interface_subclass;
    c_int interface_protocol;
    SDL_hid_bus_type bus_type;
    SDL_hid_device_info*? next;
}

/// Function pointer typedef for SDL_AppEvent.
using SDL_AppEvent_func = extern SDL_AppResult(void*?, SDL_Event*?)?;
/// Function pointer typedef for SDL_AppInit.
using SDL_AppInit_func = extern SDL_AppResult(void*?*?, c_int, char*?[*]?)?;
/// Function pointer typedef for SDL_AppIterate.
using SDL_AppIterate_func = extern SDL_AppResult(void*?)?;
/// Function pointer typedef for SDL_AppQuit.
using SDL_AppQuit_func = extern void(void*?, SDL_AppResult)?;
/// A callback that fires when an SDL assertion fails.
using SDL_AssertionHandler = extern SDL_AssertState(SDL_AssertData*?, void*?)?;
/// SDL Audio Device instance IDs.
using SDL_AudioDeviceID = Uint32;
/// A callback that fires when data is about to be fed to an audio device.
using SDL_AudioPostmixCallback = extern void(void*?, SDL_AudioSpec*?, float32[*]?, c_int)?;
/// A callback that fires when data passes through an SDL_AudioStream.
using SDL_AudioStreamCallback = extern void(void*?, SDL_AudioStream*?, c_int, c_int)?;
/// A callback that fires for completed SDL_PutAudioStreamDataNoCopy() data.
using SDL_AudioStreamDataCompleteCallback = extern void(void*?, void*?, c_int)?;
/// A set of blend modes used in drawing operations.
using SDL_BlendMode = Uint32;
/// This is a unique ID for a camera device for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_CameraID = Uint32;
/// A callback used to free resources when a property is deleted.
using SDL_CleanupPropertyCallback = extern void(void*?, void*?)?;
/// Callback function that will be called when the clipboard is cleared, or when new data is set.
using SDL_ClipboardCleanupCallback = extern void(void*?)?;
/// Callback function that will be called when data for the specified mime-type is requested by the OS.
using SDL_ClipboardDataCallback = extern void*?(void*?, char*?, c_size_t*?)?;
/// A callback used with SDL sorting and binary search functions.
using SDL_CompareCallback = extern c_int(void*?, void*?)?;
/// A callback used with SDL sorting and binary search functions.
using SDL_CompareCallback_r = extern c_int(void*?, void*?, void*?)?;
/// Callback used by file dialog functions.
using SDL_DialogFileCallback = extern void(void*?, char*?[*]?, c_int)?;
/// This is a unique ID for a display for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_DisplayID = Uint32;
/// An EGL attribute, used when creating an EGL context.
using SDL_EGLAttrib = int64;
/// EGL platform attribute initialization callback.
using SDL_EGLAttribArrayCallback = extern SDL_EGLAttrib[*]?(void*?)?;
/// Opaque type for an EGL config.
using SDL_EGLConfig = void*?;
/// Opaque type for an EGL display.
using SDL_EGLDisplay = void*?;
/// EGL surface/context attribute initialization callback types.
using SDL_EGLIntArrayCallback = extern SDL_EGLint[*]?(void*?, SDL_EGLDisplay, SDL_EGLConfig)?;
/// Opaque type for an EGL surface.
using SDL_EGLSurface = void*?;
/// An EGL integer attribute, used when creating an EGL surface.
using SDL_EGLint = c_int;
/// Callback for directory enumeration.
using SDL_EnumerateDirectoryCallback = extern SDL_EnumerationResult(void*?, char*?, char*?)?;
/// A callback used to enumerate all the properties in a group of properties.
using SDL_EnumeratePropertiesCallback = extern void(void*?, SDL_PropertiesID, char*?)?;
/// A function pointer used for callbacks that watch the event queue.
using SDL_EventFilter = extern bool(void*?, SDL_Event*?)?;
/// A unique ID for a single finger on a touch device.
using SDL_FingerID = Uint64;
/// A generic function pointer.
using SDL_FunctionPointer = extern void()?;
/// An opaque handle to an OpenGL context.
using SDL_GLContext = SDL_GLContextState*?;
/// Possible flags to be set for the SDL_GL_CONTEXT_FLAGS attribute.
using SDL_GLContextFlag = Uint32;
/// Possible values to be set for the SDL_GL_CONTEXT_RELEASE_BEHAVIOR attribute.
using SDL_GLContextReleaseFlag = Uint32;
/// Possible values to be set SDL_GL_CONTEXT_RESET_NOTIFICATION attribute.
using SDL_GLContextResetNotification = Uint32;
/// Possible values to be set for the SDL_GL_CONTEXT_PROFILE_MASK attribute.
using SDL_GLProfile = Uint32;
/// Specifies how a buffer is intended to be used by the client.
using SDL_GPUBufferUsageFlags = Uint32;
/// Specifies which color components are written in a graphics pipeline.
using SDL_GPUColorComponentFlags = Uint8;
/// Specifies the format of shader code.
using SDL_GPUShaderFormat = Uint32;
/// Specifies how a texture is intended to be used by the client.
using SDL_GPUTextureUsageFlags = Uint32;
/// Flags for path matching.
using SDL_GlobFlags = Uint32;
/// Type of coordinates used for haptic direction.
using SDL_HapticDirectionType = Uint8;
/// ID for haptic effects.
using SDL_HapticEffectID = c_int;
/// Type of haptic effect.
using SDL_HapticEffectType = Uint16;
/// This is a unique ID for a haptic device for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_HapticID = Uint32;
/// A callback used to send notifications of hint value changes.
using SDL_HintCallback = extern void(void*?, char*?, char*?, char*?)?;
/// Callback used for hit-testing.
using SDL_HitTest = extern SDL_HitTestResult(SDL_Window*?, SDL_Point*?, void*?)?;
/// Initialization flags for SDL_Init and/or SDL_InitSubSystem.
using SDL_InitFlags = Uint32;
/// This is a unique ID for a joystick for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_JoystickID = Uint32;
/// This is a unique ID for a keyboard for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_KeyboardID = Uint32;
/// The SDL virtual key representation.
using SDL_Keycode = Uint32;
/// Valid key modifiers (possibly OR'd together).
using SDL_Keymod = Uint16;
/// The prototype for the log output callback function.
using SDL_LogOutputFunction = extern void(void*?, c_int, SDL_LogPriority, char*?)?;
/// Callback run on the main thread.
using SDL_MainThreadCallback = extern void(void*?)?;
/// SDL_MessageBoxButtonData flags.
using SDL_MessageBoxButtonFlags = Uint32;
/// Message box flags.
using SDL_MessageBoxFlags = Uint32;
/// A handle to a CAMetalLayer-backed NSView (macOS) or UIView (iOS/tvOS).
using SDL_MetalView = void*?;
/// A bitmask of pressed mouse buttons, as reported by SDL_GetMouseState, etc.
using SDL_MouseButtonFlags = Uint32;
/// This is a unique ID for a mouse for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_MouseID = Uint32;
/// A callback used to transform mouse motion delta from raw values.
using SDL_MouseMotionTransformCallback = extern void(void*?, Uint64, SDL_Window*?, SDL_MouseID, float32*?, float32*?)?;
/// Function prototype for the nanosecond timer callback function.
using SDL_NSTimerCallback = extern Uint64(void*?, SDL_TimerID, Uint64)?;
/// SDL pen instance IDs.
using SDL_PenID = Uint32;
/// Pen input flags, as reported by various pen events' `pen_state` field.
using SDL_PenInputFlags = Uint32;
/// An ID that represents a properties set.
using SDL_PropertiesID = Uint32;
/// A callback to be used with SDL_RequestAndroidPermission.
using SDL_RequestAndroidPermissionCallback = extern void(void*?, char*?, bool)?;
/// This is a unique ID for a sensor for the time it is connected to the system, and is never reused for the lifetime of the application.
using SDL_SensorID = Uint32;
/// An atomic spinlock.
using SDL_SpinLock = c_int;
/// The flags on an SDL_Surface.
using SDL_SurfaceFlags = Uint32;
/// The callback used to cleanup data passed to SDL_SetTLS.
using SDL_TLSDestructorCallback = extern void(void*?)?;
/// Thread local storage ID.
using SDL_TLSID = SDL_AtomicInt;
/// The function passed to SDL_CreateThread() as the new thread's entry point.
using SDL_ThreadFunction = extern c_int(void*?)?;
/// A unique numeric ID that identifies a thread.
using SDL_ThreadID = Uint64;
/// SDL times are signed, 64-bit integers representing nanoseconds since the Unix epoch (Jan 1, 1970).
using SDL_Time = Sint64;
/// Function prototype for the millisecond timer callback function.
using SDL_TimerCallback = extern Uint32(void*?, SDL_TimerID, Uint32)?;
/// Definition of the timer ID type.
using SDL_TimerID = Uint32;
/// A unique ID for a touch device.
using SDL_TouchID = Uint64;
/// A callback that is invoked when a tray entry is selected.
using SDL_TrayCallback = extern void(void*?, SDL_TrayEntry*?)?;
/// Flags that control the creation of system tray entries.
using SDL_TrayEntryFlags = Uint32;
/// The flags on a window.
using SDL_WindowFlags = Uint64;
/// This is a unique ID for a window.
using SDL_WindowID = Uint32;
/// A callback to be used with SDL_SetWindowsMessageHook. Takes a Win32 MSG pointer, spelled void* so this module stays mixable with a windows.h import.
using SDL_WindowsMessageHook = extern bool(void*?, void*?)?;
/// A callback to be used with SDL_SetX11EventHook.
using SDL_X11EventHook = extern bool(void*?, XEvent*?)?;
/// A callback used to implement SDL_calloc().
using SDL_calloc_func = extern void*?(c_size_t, c_size_t)?;
/// A callback used to implement SDL_free().
using SDL_free_func = extern void(void*?)?;
/// A callback to be used with SDL_SetiOSAnimationCallback.
using SDL_iOSAnimationCallback = extern void(void*?)?;
/// An opaque handle representing string encoding conversion state.
using SDL_iconv_t = SDL_iconv_data_t*?;
/// The prototype for the application's main() function.
using SDL_main_func = extern c_int(c_int, char*?[*]?)?;
/// A callback used to implement SDL_malloc().
using SDL_malloc_func = extern void*?(c_size_t)?;
/// A callback used to implement SDL_realloc().
using SDL_realloc_func = extern void*?(void*?, c_size_t)?;
/// Alias for _XEvent.
using XEvent = _XEvent;

/// Allocate uninitialized memory.
extern void*? SDL_malloc(c_size_t size);
/// Allocate a zero-initialized array.
extern void*? SDL_calloc(c_size_t nmemb, c_size_t size);
/// Change the size of allocated memory.
extern void*? SDL_realloc(void*? mem, c_size_t size);
