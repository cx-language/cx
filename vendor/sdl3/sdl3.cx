    float32 y;
    SDL_PenAxis axis;
    float32 value;
}
/// Pressure-sensitive pen button event structure (event.pbutton.*).
struct SDL_PenButtonEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    SDL_PenID which;
    SDL_PenInputFlags pen_state;
    float32 x;
    float32 y;
    Uint8 button;
    bool down;
}
