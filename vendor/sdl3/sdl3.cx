/// A variable controlling whether the libdecor Wayland backend is preferred over native decorations.
const char* SDL_HINT_VIDEO_WAYLAND_PREFER_LIBDECOR = "SDL_VIDEO_WAYLAND_PREFER_LIBDECOR";
/// A variable forcing non-DPI-aware Wayland windows to output at 1:1 scaling.
const char* SDL_HINT_VIDEO_WAYLAND_SCALE_TO_DISPLAY = "SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY";
/// A variable specifying which shader compiler to preload when using the Chrome ANGLE binaries.
