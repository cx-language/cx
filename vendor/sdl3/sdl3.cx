// SDL3 bindings, translated from the system SDL3 headers
// (generated from version 3.4.16; unused declarations cost nothing thanks to lazy checking).
// Doc comments derive in part from those headers (zlib license;
// Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>).
// Link requirements live in the build.cx next to this file.
// Function-like macros and static inline helpers are implemented as cx
// functions; string macros are const char* so they pass to char* params.
// The platform-specific and Vulkan functions are declared
// unconditionally: SDL exports them on every platform, and unused
// declarations cost nothing. VkInstance, VkPhysicalDevice, MSG, and the
// GDK handles are spelled void* (VkSurfaceKHR is Uint64), matching their
// ABI while staying mixable with vulkan.h, windows.h, and GDK imports.
// Omitted on purpose: va_list forwarders (cx cannot name a va_list),
// deprecated SDL2 names (SDL_oldnames.h is opt-in), the SDL_test
// headers (a separate test library), the bundled Khronos headers
// (SDL_egl.h, SDL_opengl*.h; see the gl module), the assert macros
// (cx has its own assert), barrier and pause instructions
// (SDL_CompilerBarrier, SDL_MemoryBarrierAcquire/Release,
// SDL_CPUPauseInstruction), annotation and location macros
// (SDL_DECLSPEC, SDL_FILE, SDL_STRINGIFY_ARG, ...), libc aliases
// (SDL_memcpy, ...),
// literal-suffix helpers (SDL_SINT64_C, SDL_UINT64_C; cx literals need
// no suffix), and helpers needing implicit address-of, alloca, or
// struct-version boilerplate (SDL_zero, SDL_zerop, SDL_zeroa,
// SDL_copyp, SDL_stack_alloc, SDL_INIT_INTERFACE).
// The size_t-derived consts (SDL_SIZE_MAX, SDL_ICONV_*) assume 64-bit
// size_t; all cx targets that can link SDL are 64-bit. The _LE/_BE byte
// order helpers assume little-endian, like SDL_BYTEORDER does.
// Nullability is semantic: 'T*?'/'T[*]?' iff the SDL API permits null
// there (out-params, userdata, callbacks, optional args), else 'T*'/'T[*]'.
// Pointers to arrays use the indexable form (buffer+count params,
// plural/array params and returns, string arrays as 'T*[*]?').
// 'void*' stays opaque.

#if Windows
/// The C wchar_t type.
using wchar_t = c_ushort;
#else
/// The C wchar_t type.
using wchar_t = c_int;
#endif

/// An unsigned 8-bit integer type.
using Uint8 = uint8;
/// An unsigned 16-bit integer type.
using Uint16 = uint16;
/// An unsigned 32-bit integer type.
using Uint32 = uint32;
/// An unsigned 64-bit integer type.
using Uint64 = uint64;
/// A signed 8-bit integer type.
using Sint8 = int8;
/// A signed 16-bit integer type.
using Sint16 = int16;
/// A signed 32-bit integer type.
using Sint32 = int32;
/// A signed 64-bit integer type.
using Sint64 = int64;

