extern void SDL_GDKSuspendComplete();
/// Compose an audio format value from its components.
SDL_AudioFormat SDL_DEFINE_AUDIO_FORMAT(c_int isSigned, c_int bigendian, c_int flt, c_int size) {
    return (isSigned << 15) | (bigendian << 12) | (flt << 8) | (size & SDL_AUDIO_MASK_BITSIZE);
}
/// Retrieve the size, in bits, from an audio format.
c_int SDL_AUDIO_BITSIZE(SDL_AudioFormat x) {
    return x & SDL_AUDIO_MASK_BITSIZE;
}
/// Retrieve the size, in bytes, from an audio format.
c_int SDL_AUDIO_BYTESIZE(SDL_AudioFormat x) {
    return SDL_AUDIO_BITSIZE(x) / 8;
}
/// Determine if an audio format represents floating point data.
c_int SDL_AUDIO_ISFLOAT(SDL_AudioFormat x) {
    return x & SDL_AUDIO_MASK_FLOAT;
}
/// Determine if an audio format represents bigendian data.
c_int SDL_AUDIO_ISBIGENDIAN(SDL_AudioFormat x) {
    return x & SDL_AUDIO_MASK_BIG_ENDIAN;
}
/// Determine if an audio format represents littleendian data.
c_int SDL_AUDIO_ISLITTLEENDIAN(SDL_AudioFormat x) {
    if SDL_AUDIO_ISBIGENDIAN(x) != 0 return 0;
    return 1;
}
/// Determine if an audio format represents signed data.
c_int SDL_AUDIO_ISSIGNED(SDL_AudioFormat x) {
    return x & SDL_AUDIO_MASK_SIGNED;
}
/// Determine if an audio format represents integer data.
c_int SDL_AUDIO_ISINT(SDL_AudioFormat x) {
    if SDL_AUDIO_ISFLOAT(x) != 0 return 0;
    return 1;
}
/// Determine if an audio format represents unsigned data.
c_int SDL_AUDIO_ISUNSIGNED(SDL_AudioFormat x) {
    if SDL_AUDIO_ISSIGNED(x) != 0 return 0;
    return 1;
}
/// Retrieve the size, in bytes, of an audio frame for an audio spec.
c_int SDL_AUDIO_FRAMESIZE(SDL_AudioSpec x) {
    return SDL_AUDIO_BYTESIZE(x.format) * x.channels;
}
/// Compose a FourCC value from four characters.
Uint32 SDL_FOURCC(c_int a, c_int b, c_int c, c_int d) {
    return (Uint32(Uint8(a)) << 0) | (Uint32(Uint8(b)) << 8) | (Uint32(Uint8(c)) << 16) | (Uint32(Uint8(d)) << 24);
}
/// Compose a FourCC pixel format value from four characters.
Uint32 SDL_DEFINE_PIXELFOURCC(c_int a, c_int b, c_int c, c_int d) {
    return SDL_FOURCC(a, b, c, d);
}
/// Compose a pixel format value from its components.
SDL_PixelFormat SDL_DEFINE_PIXELFORMAT(c_int type, c_int order, c_int layout, c_int bits, c_int bytes) {
    return SDL_PixelFormat((1 << 28) | (type << 24) | (order << 20) | (layout << 16) | (bits << 8) | bytes);
}
/// Get the flag field of a pixel format.
c_int SDL_PIXELFLAG(SDL_PixelFormat format) {
    return (format >> 28) & 0x0F;
}
/// Get the type field of a pixel format.
c_int SDL_PIXELTYPE(SDL_PixelFormat format) {
    return (format >> 24) & 0x0F;
}
/// Get the order field of a pixel format.
c_int SDL_PIXELORDER(SDL_PixelFormat format) {
    return (format >> 20) & 0x0F;
}
/// Get the layout field of a pixel format.
c_int SDL_PIXELLAYOUT(SDL_PixelFormat format) {
    return (format >> 16) & 0x0F;
}
/// Get the bits per pixel of a pixel format, or 0 for FourCC formats.
c_int SDL_BITSPERPIXEL(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return 0;
    return (format >> 8) & 0xFF;
}
/// Get the bytes per pixel of a pixel format.
c_int SDL_BYTESPERPIXEL(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) {
        if format == SDL_PIXELFORMAT_YUY2 || format == SDL_PIXELFORMAT_UYVY || format == SDL_PIXELFORMAT_YVYU || format == SDL_PIXELFORMAT_P010 return 2;
        return 1;
    }
    return format & 0xFF;
}
/// Determine if a pixel format is indexed.
bool SDL_ISPIXELFORMAT_INDEXED(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return false;
    var t = SDL_PIXELTYPE(format);
    return t == SDL_PIXELTYPE_INDEX1 || t == SDL_PIXELTYPE_INDEX2 || t == SDL_PIXELTYPE_INDEX4 || t == SDL_PIXELTYPE_INDEX8;
}
/// Determine if a pixel format is packed.
bool SDL_ISPIXELFORMAT_PACKED(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return false;
    var t = SDL_PIXELTYPE(format);
    return t == SDL_PIXELTYPE_PACKED8 || t == SDL_PIXELTYPE_PACKED16 || t == SDL_PIXELTYPE_PACKED32;
}
/// Determine if a pixel format is an array of channels.
bool SDL_ISPIXELFORMAT_ARRAY(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return false;
    var t = SDL_PIXELTYPE(format);
    return t == SDL_PIXELTYPE_ARRAYU8 || t == SDL_PIXELTYPE_ARRAYU16 || t == SDL_PIXELTYPE_ARRAYU32 || t == SDL_PIXELTYPE_ARRAYF16 || t == SDL_PIXELTYPE_ARRAYF32;
}
/// Determine if a pixel format is a 10-bit packed format.
bool SDL_ISPIXELFORMAT_10BIT(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return false;
    return SDL_PIXELTYPE(format) == SDL_PIXELTYPE_PACKED32 && SDL_PIXELLAYOUT(format) == SDL_PACKEDLAYOUT_2101010;
}
/// Determine if a pixel format is a floating point format.
bool SDL_ISPIXELFORMAT_FLOAT(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_FOURCC(format) return false;
    var t = SDL_PIXELTYPE(format);
    return t == SDL_PIXELTYPE_ARRAYF16 || t == SDL_PIXELTYPE_ARRAYF32;
}
/// Determine if a pixel format has an alpha channel.
bool SDL_ISPIXELFORMAT_ALPHA(SDL_PixelFormat format) {
    if SDL_ISPIXELFORMAT_PACKED(format) {
        var o = SDL_PIXELORDER(format);
        return o == SDL_PACKEDORDER_ARGB || o == SDL_PACKEDORDER_RGBA || o == SDL_PACKEDORDER_ABGR || o == SDL_PACKEDORDER_BGRA;
    }
    if SDL_ISPIXELFORMAT_ARRAY(format) {
        var o = SDL_PIXELORDER(format);
        return o == SDL_ARRAYORDER_ARGB || o == SDL_ARRAYORDER_RGBA || o == SDL_ARRAYORDER_ABGR || o == SDL_ARRAYORDER_BGRA;
    }
    return false;
}
/// Determine if a pixel format is a FourCC format.
bool SDL_ISPIXELFORMAT_FOURCC(SDL_PixelFormat format) {
    return format != 0 && SDL_PIXELFLAG(format) != 1;
}
/// Compose a colorspace value from its components.
SDL_Colorspace SDL_DEFINE_COLORSPACE(c_int type, c_int range, c_int primaries, c_int transfer, c_int matrix, c_int chroma) {
    return (type << 28) | (range << 24) | (chroma << 20) | (primaries << 10) | (transfer << 5) | matrix;
}
/// Get the color type of a colorspace.
SDL_ColorType SDL_COLORSPACETYPE(SDL_Colorspace cspace) {
    return (cspace >> 28) & 0x0F;
}
/// Get the color range of a colorspace.
SDL_ColorRange SDL_COLORSPACERANGE(SDL_Colorspace cspace) {
    return (cspace >> 24) & 0x0F;
}
/// Get the chroma location of a colorspace.
SDL_ChromaLocation SDL_COLORSPACECHROMA(SDL_Colorspace cspace) {
    return (cspace >> 20) & 0x0F;
}
/// Get the color primaries of a colorspace.
SDL_ColorPrimaries SDL_COLORSPACEPRIMARIES(SDL_Colorspace cspace) {
    return (cspace >> 10) & 0x1F;
}
/// Get the transfer characteristics of a colorspace.
SDL_TransferCharacteristics SDL_COLORSPACETRANSFER(SDL_Colorspace cspace) {
    return (cspace >> 5) & 0x1F;
}
/// Get the matrix coefficients of a colorspace.
SDL_MatrixCoefficients SDL_COLORSPACEMATRIX(SDL_Colorspace cspace) {
    return cspace & 0x1F;
}
/// Determine if a colorspace uses BT.601 matrix coefficients.
bool SDL_ISCOLORSPACE_MATRIX_BT601(SDL_Colorspace cspace) {
    var m = SDL_COLORSPACEMATRIX(cspace);
    return m == SDL_MATRIX_COEFFICIENTS_BT601 || m == SDL_MATRIX_COEFFICIENTS_BT470BG;
}
/// Determine if a colorspace uses BT.709 matrix coefficients.
bool SDL_ISCOLORSPACE_MATRIX_BT709(SDL_Colorspace cspace) {
    return SDL_COLORSPACEMATRIX(cspace) == SDL_MATRIX_COEFFICIENTS_BT709;
}
/// Determine if a colorspace uses BT.2020 non-constant luminance matrix coefficients.
bool SDL_ISCOLORSPACE_MATRIX_BT2020_NCL(SDL_Colorspace cspace) {
    return SDL_COLORSPACEMATRIX(cspace) == SDL_MATRIX_COEFFICIENTS_BT2020_NCL;
}
/// Determine if a colorspace has limited range.
bool SDL_ISCOLORSPACE_LIMITED_RANGE(SDL_Colorspace cspace) {
    return SDL_COLORSPACERANGE(cspace) != SDL_COLOR_RANGE_FULL;
}
/// Determine if a colorspace has full range.
bool SDL_ISCOLORSPACE_FULL_RANGE(SDL_Colorspace cspace) {
    return SDL_COLORSPACERANGE(cspace) == SDL_COLOR_RANGE_FULL;
}
/// Byte-swap an unsigned 16-bit number.
Uint16 SDL_Swap16(Uint16 x) {
    return (x << 8) | (x >> 8);
}
/// Byte-swap an unsigned 32-bit number.
Uint32 SDL_Swap32(Uint32 x) {
    return ((x & 0xFF) << 24) | (((x >> 8) & 0xFF) << 16) | (((x >> 16) & 0xFF) << 8) | (x >> 24);
}
/// Byte-swap an unsigned 64-bit number.
Uint64 SDL_Swap64(Uint64 x) {
    return ((x & 0xFF) << 56) | (((x >> 8) & 0xFF) << 48) | (((x >> 16) & 0xFF) << 40) | (((x >> 24) & 0xFF) << 32) | (((x >> 32) & 0xFF) << 24) | (((x >> 40) & 0xFF) << 16) | (((x >> 48) & 0xFF) << 8) | (x >> 56);
}
private union FloatUintPun {
    float32 f;
    Uint32 u;
}
/// Byte-swap a floating point number.
float32 SDL_SwapFloat(float32 x) {
    FloatUintPun p = undefined;
    p.f = x;
    p.u = SDL_Swap32(p.u);
    return p.f;
}
/// Swap a 16-bit value from littleendian to native byte order.
Uint16 SDL_Swap16LE(Uint16 x) {
    return x;
}
/// Swap a 32-bit value from littleendian to native byte order.
Uint32 SDL_Swap32LE(Uint32 x) {
    return x;
}
/// Swap a 64-bit value from littleendian to native byte order.
Uint64 SDL_Swap64LE(Uint64 x) {
    return x;
}
/// Swap a float from littleendian to native byte order.
float32 SDL_SwapFloatLE(float32 x) {
    return x;
}
/// Swap a 16-bit value from bigendian to native byte order.
Uint16 SDL_Swap16BE(Uint16 x) {
    return SDL_Swap16(x);
}
/// Swap a 32-bit value from bigendian to native byte order.
Uint32 SDL_Swap32BE(Uint32 x) {
    return SDL_Swap32(x);
}
/// Swap a 64-bit value from bigendian to native byte order.
Uint64 SDL_Swap64BE(Uint64 x) {
    return SDL_Swap64(x);
}
/// Swap a float from bigendian to native byte order.
float32 SDL_SwapFloatBE(float32 x) {
    return SDL_SwapFloat(x);
}
/// Convert an SDL_Rect to an SDL_FRect.
void SDL_RectToFRect(SDL_Rect* rect, SDL_FRect* frect) {
    frect.x = float32(rect.x);
    frect.y = float32(rect.y);
    frect.w = float32(rect.w);
    frect.h = float32(rect.h);
}
/// Determine if a point is inside a rectangle.
bool SDL_PointInRect(SDL_Point*? p, SDL_Rect*? r) {
    if p == null || r == null return false;
    return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;
}
/// Determine if a rectangle is empty.
bool SDL_RectEmpty(SDL_Rect*? r) {
    if r == null return true;
    return r.w <= 0 || r.h <= 0;
}
/// Determine if two rectangles are equal.
bool SDL_RectsEqual(SDL_Rect*? a, SDL_Rect*? b) {
    if a == null || b == null return false;
    return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h;
}
/// Determine if a floating point point is inside a floating point rectangle.
bool SDL_PointInRectFloat(SDL_FPoint*? p, SDL_FRect*? r) {
    if p == null || r == null return false;
    return p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h;
}
/// Determine if a floating point rectangle is empty.
bool SDL_RectEmptyFloat(SDL_FRect*? r) {
    if r == null return true;
    return r.w < 0.0 || r.h < 0.0;
}
/// Determine if two floating point rectangles are equal within some epsilon.
bool SDL_RectsEqualEpsilon(SDL_FRect*? a, SDL_FRect*? b, float32 epsilon) {
    if a == null || b == null return false;
    if a == b return true;
    return SDL_fabsf(a.x - b.x) <= epsilon && SDL_fabsf(a.y - b.y) <= epsilon && SDL_fabsf(a.w - b.w) <= epsilon && SDL_fabsf(a.h - b.h) <= epsilon;
}
/// Determine if two floating point rectangles are exactly equal.
bool SDL_RectsEqualFloat(SDL_FRect*? a, SDL_FRect*? b) {
    return SDL_RectsEqualEpsilon(a, b, SDL_FLT_EPSILON);
}
/// Determine if a 32-bit value has exactly one bit set.
bool SDL_HasExactlyOneBitSet32(Uint32 x) {
    return x != 0 && (x & (x - 1)) == 0;
}
/// Get the index of the most significant set bit in a 32-bit value, or -1 if none.
c_int SDL_MostSignificantBitIndex32(Uint32 x) {
    if x == 0 return -1;
    c_int msbIndex = 0;
    if x & 0xFFFF0000 != 0 {
        x = x >> 16;
        msbIndex = msbIndex | 16;
    }
    if x & 0xFF00 != 0 {
        x = x >> 8;
        msbIndex = msbIndex | 8;
    }
    if x & 0xF0 != 0 {
        x = x >> 4;
        msbIndex = msbIndex | 4;
    }
    if x & 0xC != 0 {
        x = x >> 2;
        msbIndex = msbIndex | 2;
    }
    if x & 0x2 != 0 {
        msbIndex = msbIndex | 1;
    }
    return msbIndex;
}
/// Multiply two integers, checking for overflow.
bool SDL_size_mul_check_overflow(c_size_t a, c_size_t b, c_size_t* ret) {
    if a != 0 && b > SDL_SIZE_MAX / a {
        return false;
    }
    *ret = a * b;
    return true;
}
/// Multiply two integers, checking for overflow.
bool SDL_size_mul_check_overflow_builtin(c_size_t a, c_size_t b, c_size_t* ret) {
    return SDL_size_mul_check_overflow(a, b, ret);
}
/// Add two integers, checking for overflow.
bool SDL_size_add_check_overflow(c_size_t a, c_size_t b, c_size_t* ret) {
    if b > SDL_SIZE_MAX - a {
        return false;
    }
    *ret = a + b;
    return true;
}
/// Add two integers, checking for overflow.
bool SDL_size_add_check_overflow_builtin(c_size_t a, c_size_t b, c_size_t* ret) {
    return SDL_size_add_check_overflow(a, b, ret);
}
/// Return the smaller of two values.
T SDL_min<T: Copyable + Comparable>(T a, T b) {
    return min(a, b);
}
/// Return the greater of two values.
T SDL_max<T: Copyable + Comparable>(T a, T b) {
    return max(a, b);
}
/// Return a value clamped to a range.
T SDL_clamp<T>(T x, T a, T b) {
    return clamp(x, a, b);
}
/// Get the number of elements in a fixed-size array.
c_size_t SDL_arraysize<T, c_size_t N>(T[N]& array) {
    return N;
}
/// Convert a UTF-8 string to the current locale encoding.
char*? SDL_iconv_utf8_locale(char* s) {
    return SDL_iconv_string("", "UTF-8", s, SDL_strlen(s) + 1);
}
/// Convert a UTF-8 string to UCS-2.
Uint16*? SDL_iconv_utf8_ucs2(char* s) {
    return cast<Uint16*?>(SDL_iconv_string("UCS-2", "UTF-8", s, SDL_strlen(s) + 1));
}
/// Convert a UTF-8 string to UCS-4.
Uint32*? SDL_iconv_utf8_ucs4(char* s) {
    return cast<Uint32*?>(SDL_iconv_string("UCS-4", "UTF-8", s, SDL_strlen(s) + 1));
}
/// Convert a wide string to UTF-8.
char*? SDL_iconv_wchar_utf8(wchar_t* s) {
    return SDL_iconv_string("UTF-8", "WCHAR_T", cast<char*>(s), (SDL_wcslen(s) + 1) * c_size_t(sizeof(wchar_t)));
}
/// Set the SDL error to "That operation is not supported".
bool SDL_Unsupported() {
    return SDL_SetError("That operation is not supported");
}
/// Set the SDL error to "Parameter 'x' is invalid".
bool SDL_InvalidParamError(char* param) {
    return SDL_SetError("Parameter '%s' is invalid", param);
}
/// Increment an atomic reference count.
c_int SDL_AtomicIncRef(SDL_AtomicInt* a) {
    return SDL_AddAtomicInt(a, 1);
}
/// Decrement an atomic reference count, returning whether it reached zero.
bool SDL_AtomicDecRef(SDL_AtomicInt* a) {
    return SDL_AddAtomicInt(a, -1) == 1;
}
/// Create a new thread with the default stack size.
SDL_Thread*? SDL_CreateThread(SDL_ThreadFunction fn, char*? name, void*? data) {
    // The C macro passes _beginthreadex/_endthreadex on Windows; null is
    // allowed by SDL docs and matches the macro on other platforms.
    return SDL_CreateThreadRuntime(fn, name, data, null, null);
}
/// Create a new thread with the specified properties.
SDL_Thread*? SDL_CreateThreadWithProperties(SDL_PropertiesID props) {
    return SDL_CreateThreadWithPropertiesRuntime(props, null, null);
}
/// Get the bit mask for a mouse button index.
Uint32 SDL_BUTTON_MASK(c_int x) {
    return Uint32(1) << (Uint32(x) - Uint32(1));
}
/// Convert a scancode to the corresponding keycode.
Uint32 SDL_SCANCODE_TO_KEYCODE(SDL_Scancode x) {
    return Uint32(x) | Uint32(SDLK_SCANCODE_MASK);
}
/// Center a window on a display.
c_int SDL_WINDOWPOS_CENTERED_DISPLAY(c_int x) {
    return SDL_WINDOWPOS_CENTERED_MASK | x;
}
/// Determine if a window position is centered.
bool SDL_WINDOWPOS_ISCENTERED(c_int x) {
    return (x & 0xFFFF0000) == SDL_WINDOWPOS_CENTERED_MASK;
}
/// Let the window manager place a window on a display.
c_int SDL_WINDOWPOS_UNDEFINED_DISPLAY(c_int x) {
    return SDL_WINDOWPOS_UNDEFINED_MASK | x;
}
/// Determine if a window position is undefined.
bool SDL_WINDOWPOS_ISUNDEFINED(c_int x) {
    return (x & 0xFFFF0000) == SDL_WINDOWPOS_UNDEFINED_MASK;
}
/// Compose a version number from its components.
c_int SDL_VERSIONNUM(c_int major, c_int minor, c_int patch) {
    return major * 1000000 + minor * 1000 + patch;
}
/// Extract the major version from a version number.
c_int SDL_VERSIONNUM_MAJOR(c_int version) {
    return version / 1000000;
}
/// Extract the minor version from a version number.
c_int SDL_VERSIONNUM_MINOR(c_int version) {
    return (version / 1000) % 1000;
}
/// Extract the micro version from a version number.
c_int SDL_VERSIONNUM_MICRO(c_int version) {
    return version % 1000;
}
/// Determine if the SDL version is at least X.Y.Z.
bool SDL_VERSION_ATLEAST(c_int x, c_int y, c_int z) {
    return SDL_VERSION >= SDL_VERSIONNUM(x, y, z);
}
/// Convert seconds to nanoseconds.
Uint64 SDL_SECONDS_TO_NS(Uint64 s) {
    return s * SDL_NS_PER_SECOND;
}
/// Convert nanoseconds to seconds.
Uint64 SDL_NS_TO_SECONDS(Uint64 ns) {
    return ns / SDL_NS_PER_SECOND;
}
/// Convert milliseconds to nanoseconds.
Uint64 SDL_MS_TO_NS(Uint64 ms) {
    return ms * SDL_NS_PER_MS;
}
/// Convert nanoseconds to milliseconds.
Uint64 SDL_NS_TO_MS(Uint64 ns) {
    return ns / SDL_NS_PER_MS;
}
/// Convert microseconds to nanoseconds.
Uint64 SDL_US_TO_NS(Uint64 us) {
    return us * SDL_NS_PER_US;
}
/// Convert nanoseconds to microseconds.
Uint64 SDL_NS_TO_US(Uint64 ns) {
    return ns / SDL_NS_PER_US;
}
/// Determine if a surface must be locked to access its pixels.
bool SDL_MUSTLOCK(SDL_Surface* s) {
    return (s.flags & SDL_SURFACE_LOCK_NEEDED) == SDL_SURFACE_LOCK_NEEDED;
}
