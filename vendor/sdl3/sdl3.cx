// SDL3 bindings, translated from the system SDL3 headers
// (generated from version 3.4.16; unused declarations cost nothing thanks to lazy checking).
// Link requirements live in the build.cx next to this file.
// Omitted on purpose: static inline helpers (no out-of-line symbol),
// va_list forwarders (cx cannot name a va_list), function-like macros
// (use SDL_CreateThreadRuntime instead of SDL_CreateThread), string
// macros (pass literals), deprecated SDL2 names, and attribute,
// annotation, location, and libc-alias macros (SDL_DECLSPEC, SDL_FILE,
// SDL_memcpy, ...). SDL_PI_D is skipped too: float literals infer
// float32, so no const holds it exactly.
// The size_t-derived consts (SDL_SIZE_MAX, SDL_ICONV_*) assume 64-bit
// size_t; all cx targets that can link SDL are 64-bit.
// C pointers to single items become 'T*?', but pointers to arrays
// become the indexable 'T[*]?' (buffer+count params, plural/array
// params and returns, string arrays as 'T*[*]?'). 'void*' stays opaque.

#if Windows
using wchar_t = c_ushort;
#else
using wchar_t = c_int;
#endif

