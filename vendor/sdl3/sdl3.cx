/// Printf format for a signed 32-bit integer.
const char* SDL_PRIs32 = "d";
/// Printf format for an unsigned 32-bit integer.
const char* SDL_PRIu32 = "u";
/// Printf format for a 32-bit integer in lowercase hexadecimal.
const char* SDL_PRIx32 = "x";
/// Printf format for a 32-bit integer in uppercase hexadecimal.
const char* SDL_PRIX32 = "X";
#if Windows
/// Printf format for a signed 64-bit integer.
const char* SDL_PRIs64 = "I64d";
/// Printf format for an unsigned 64-bit integer.
const char* SDL_PRIu64 = "I64u";
/// Printf format for a 64-bit integer in lowercase hexadecimal.
const char* SDL_PRIx64 = "I64x";
/// Printf format for a 64-bit integer in uppercase hexadecimal.
const char* SDL_PRIX64 = "I64X";
/// Printf length modifier for a 64-bit `long long`.
const char* SDL_PRILL_PREFIX = "I64";
/// Printf format for a 64-bit `long long`.
const char* SDL_PRILLd = "I64d";
/// Printf format for an unsigned 64-bit `long long`.
const char* SDL_PRILLu = "I64u";
/// Printf format for a 64-bit `long long` in lowercase hexadecimal.
const char* SDL_PRILLx = "I64x";
/// Printf format for a 64-bit `long long` in uppercase hexadecimal.
const char* SDL_PRILLX = "I64X";
#else
#if macOS
/// Printf format for a signed 64-bit integer.
const char* SDL_PRIs64 = "lld";
/// Printf format for an unsigned 64-bit integer.
const char* SDL_PRIu64 = "llu";
/// Printf format for a 64-bit integer in lowercase hexadecimal.
const char* SDL_PRIx64 = "llx";
/// Printf format for a 64-bit integer in uppercase hexadecimal.
const char* SDL_PRIX64 = "llX";
#else
/// Printf format for a signed 64-bit integer.
const char* SDL_PRIs64 = "ld";
/// Printf format for an unsigned 64-bit integer.
const char* SDL_PRIu64 = "lu";
/// Printf format for a 64-bit integer in lowercase hexadecimal.
const char* SDL_PRIx64 = "lx";
/// Printf format for a 64-bit integer in uppercase hexadecimal.
const char* SDL_PRIX64 = "lX";
#endif
/// Printf length modifier for a 64-bit `long long`.
const char* SDL_PRILL_PREFIX = "ll";
/// Printf format for a 64-bit `long long`.
const char* SDL_PRILLd = "lld";
/// Printf format for an unsigned 64-bit `long long`.
const char* SDL_PRILLu = "llu";
/// Printf format for a 64-bit `long long` in lowercase hexadecimal.
const char* SDL_PRILLx = "llx";
/// Printf format for a 64-bit `long long` in uppercase hexadecimal.
const char* SDL_PRILLX = "llX";
#endif

/// The code revision of the SDL library.
const char* SDL_REVISION = "SDL-release-3.4.16-0-gfa2c02bb6";
/// The name of the software renderer.
const char* SDL_SOFTWARE_RENDERER = "software";
/// The name of the GPU renderer.
const char* SDL_GPU_RENDERER = "gpu";
/// Pi as a double-precision constant.
const double SDL_PI_D = 3.141592653589793;
/// Android external storage is readable.
const SDL_ANDROID_EXTERNAL_STORAGE_READ = 0x01;
/// Android external storage is writable.
const SDL_ANDROID_EXTERNAL_STORAGE_WRITE = 0x02;
/// The asynchronous I/O operation structure.
struct SDL_AsyncIO {}
/// A queue of completed asynchronous I/O tasks.
struct SDL_AsyncIOQueue {}
/// The opaque handle that represents an audio stream.
struct SDL_AudioStream {}
/// The opaque structure used to identify an opened SDL camera.
struct SDL_Camera {}
/// A means to block multiple threads until a condition is satisfied.
struct SDL_Condition {}
/// The structure used to identify an SDL cursor.
struct SDL_Cursor {}
/// Internal display mode data.
struct SDL_DisplayModeData {}
/// A thread-safe set of environment variables.
struct SDL_Environment {}
/// An opaque handle to GL context state.
struct SDL_GLContextState {}
/// An opaque handle representing a buffer.
struct SDL_GPUBuffer {}
/// An opaque handle representing a command buffer.
struct SDL_GPUCommandBuffer {}
/// An opaque handle representing a compute pass.
struct SDL_GPUComputePass {}
/// An opaque handle representing a compute pipeline.
struct SDL_GPUComputePipeline {}
/// An opaque handle representing a copy pass.
struct SDL_GPUCopyPass {}
/// An opaque handle representing the SDL_GPU context.
struct SDL_GPUDevice {}
/// An opaque handle representing a fence.
struct SDL_GPUFence {}
/// An opaque handle representing a graphics pipeline.
struct SDL_GPUGraphicsPipeline {}
/// An opaque handle representing a render pass.
struct SDL_GPURenderPass {}
/// A custom GPU render state.
struct SDL_GPURenderState {}
/// An opaque handle representing a sampler.
struct SDL_GPUSampler {}
/// An opaque handle representing a compiled shader object.
struct SDL_GPUShader {}
/// An opaque handle representing a texture.
struct SDL_GPUTexture {}
/// An opaque handle representing a transfer buffer.
struct SDL_GPUTransferBuffer {}
/// The structure used to identify an SDL gamepad.
struct SDL_Gamepad {}
/// The haptic structure used to identify an SDL haptic.
struct SDL_Haptic {}
/// The read/write operation structure.
struct SDL_IOStream {}
/// The joystick structure used to identify an SDL joystick.
struct SDL_Joystick {}
/// A means to serialize access to a resource between threads.
struct SDL_Mutex {}
/// An opaque handle representing a system process.
struct SDL_Process {}
/// A mutex that allows read-only threads to run in parallel.
struct SDL_RWLock {}
/// An opaque handle to SDL's 2D rendering context for a window.
struct SDL_Renderer {}
/// A means to manage access to a resource, by count, between threads.
struct SDL_Semaphore {}
/// The opaque structure used to identify an opened SDL sensor.
struct SDL_Sensor {}
/// An opaque datatype that represents a loaded shared object.
struct SDL_SharedObject {}
/// An abstract interface for filesystem access.
struct SDL_Storage {}
/// The SDL thread object.
struct SDL_Thread {}
/// An opaque handle representing a toplevel system tray object.
struct SDL_Tray {}
/// An opaque handle representing an entry on a system tray object.
struct SDL_TrayEntry {}
/// An opaque handle representing a menu/submenu on a system tray object.
struct SDL_TrayMenu {}
/// The struct used as an opaque handle to a window.
struct SDL_Window {}
/// An opaque handle representing an open HID device.
struct SDL_hid_device {}
/// Internal iconv conversion state.
struct SDL_iconv_data_t {}
/// An X11 event.
struct _XEvent {}

/// Information about an assertion failure.
struct SDL_AssertData {
    bool always_ignore;
    c_uint trigger_count;
    char*? condition;
    char*? filename;
    c_int linenum;
    char*? function;
    SDL_AssertData*? next;
}
/// Information about a completed asynchronous I/O request.
struct SDL_AsyncIOOutcome {
    SDL_AsyncIO*? asyncio;
    SDL_AsyncIOTaskType type;
    SDL_AsyncIOResult result;
    void*? buffer;
    Uint64 offset;
    Uint64 bytes_requested;
    Uint64 bytes_transferred;
    void*? userdata;
}
/// A type representing an atomic integer value.
struct SDL_AtomicInt {
    c_int value;
}
/// A type representing an atomic unsigned 32-bit value.
struct SDL_AtomicU32 {
    Uint32 value;
}
/// Audio device event structure (event.adevice.*).
struct SDL_AudioDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_AudioDeviceID which;
    bool recording;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// Format specifier for audio data.
struct SDL_AudioSpec {
    SDL_AudioFormat format;
    c_int channels;
    c_int freq;
}
/// Camera device event structure (event.cdevice.*).
struct SDL_CameraDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_CameraID which;
}
/// The details of an output format for a camera device.
struct SDL_CameraSpec {
    SDL_PixelFormat format;
    SDL_Colorspace colorspace;
    c_int width;
    c_int height;
    c_int framerate_numerator;
    c_int framerate_denominator;
}
/// An event triggered when the clipboard contents have changed (event.clipboard.*).
struct SDL_ClipboardEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    bool owner;
    Sint32 num_mime_types;
    char*?[*]? mime_types;
}
/// A structure that represents a color as RGBA components.
struct SDL_Color {
    Uint8 r;
    Uint8 g;
    Uint8 b;
    Uint8 a;
}
/// Fields shared by every event.
struct SDL_CommonEvent {
    Uint32 type;
    Uint32 reserved;
    Uint64 timestamp;
}
/// Animated cursor frame info.
struct SDL_CursorFrameInfo {
    SDL_Surface*? surface;
    Uint32 duration;
}
/// A structure holding a calendar date and time broken down into its components.
struct SDL_DateTime {
    c_int year;
    c_int month;
    c_int day;
    c_int hour;
    c_int minute;
    c_int second;
    c_int nanosecond;
    c_int day_of_week;
    c_int utc_offset;
}
/// An entry for filters for file dialogs.
struct SDL_DialogFileFilter {
    char*? name;
    char*? pattern;
}
/// Display state change event data (event.display.*).
struct SDL_DisplayEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_DisplayID displayID;
    Sint32 data1;
    Sint32 data2;
}
/// The structure that defines a display mode.
struct SDL_DisplayMode {
    SDL_DisplayID displayID;
    SDL_PixelFormat format;
    c_int w;
    c_int h;
    float32 pixel_density;
    float32 refresh_rate;
    c_int refresh_rate_numerator;
    c_int refresh_rate_denominator;
    SDL_DisplayModeData*? internal;
}
/// An event used to drop text or request a file open by the system (event.drop.*).
struct SDL_DropEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    float32 x;
    float32 y;
    char*? source;
    char*? data;
}
/// A union of all SDL event types; use the member matching the type field.
union SDL_Event {
    Uint32 type;
    SDL_CommonEvent common;
    SDL_DisplayEvent display;
    SDL_WindowEvent window;
    SDL_KeyboardDeviceEvent kdevice;
    SDL_KeyboardEvent key;
    SDL_TextEditingEvent edit;
    SDL_TextEditingCandidatesEvent edit_candidates;
    SDL_TextInputEvent text;
    SDL_MouseDeviceEvent mdevice;
    SDL_MouseMotionEvent motion;
    SDL_MouseButtonEvent button;
    SDL_MouseWheelEvent wheel;
    SDL_JoyDeviceEvent jdevice;
    SDL_JoyAxisEvent jaxis;
    SDL_JoyBallEvent jball;
    SDL_JoyHatEvent jhat;
    SDL_JoyButtonEvent jbutton;
    SDL_JoyBatteryEvent jbattery;
    SDL_GamepadDeviceEvent gdevice;
    SDL_GamepadAxisEvent gaxis;
    SDL_GamepadButtonEvent gbutton;
    SDL_GamepadTouchpadEvent gtouchpad;
    SDL_GamepadSensorEvent gsensor;
    SDL_AudioDeviceEvent adevice;
    SDL_CameraDeviceEvent cdevice;
    SDL_SensorEvent sensor;
    SDL_QuitEvent quit;
    SDL_UserEvent user;
    SDL_TouchFingerEvent tfinger;
    SDL_PinchFingerEvent pinch;
    SDL_PenProximityEvent pproximity;
    SDL_PenTouchEvent ptouch;
    SDL_PenMotionEvent pmotion;
    SDL_PenButtonEvent pbutton;
    SDL_PenAxisEvent paxis;
    SDL_RenderEvent render;
    SDL_DropEvent drop;
    SDL_ClipboardEvent clipboard;
    Uint8[128] padding;
}
/// The bits of this structure can be directly reinterpreted as a float-packed color which uses the SDL_PIXELFORMAT_RGBA128_FLOAT format.
struct SDL_FColor {
    float32 r;
    float32 g;
    float32 b;
    float32 a;
}
/// The structure that defines a point (using floating point values).
struct SDL_FPoint {
    float32 x;
    float32 y;
}
/// A rectangle stored using floating point values.
struct SDL_FRect {
    float32 x;
    float32 y;
    float32 w;
    float32 h;
}
/// Data about a single finger in a multitouch event.
struct SDL_Finger {
    SDL_FingerID id;
    float32 x;
    float32 y;
    float32 pressure;
}
/// A structure containing parameters for a blit command.
struct SDL_GPUBlitInfo {
    SDL_GPUBlitRegion source;
    SDL_GPUBlitRegion destination;
    SDL_GPULoadOp load_op;
    SDL_FColor clear_color;
    SDL_FlipMode flip_mode;
    SDL_GPUFilter filter;
    bool cycle;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying a region of a texture used in the blit operation.
struct SDL_GPUBlitRegion {
    SDL_GPUTexture*? texture;
    Uint32 mip_level;
    Uint32 layer_or_depth_plane;
    Uint32 x;
    Uint32 y;
    Uint32 w;
    Uint32 h;
}
/// A structure specifying parameters in a buffer binding call.
struct SDL_GPUBufferBinding {
    SDL_GPUBuffer*? buffer;
    Uint32 offset;
}
/// A structure specifying the parameters of a buffer.
struct SDL_GPUBufferCreateInfo {
    SDL_GPUBufferUsageFlags usage;
    Uint32 size;
    SDL_PropertiesID props;
}
/// A structure specifying a location in a buffer.
struct SDL_GPUBufferLocation {
    SDL_GPUBuffer*? buffer;
    Uint32 offset;
}
/// A structure specifying a region of a buffer.
struct SDL_GPUBufferRegion {
    SDL_GPUBuffer*? buffer;
    Uint32 offset;
    Uint32 size;
}
/// A structure specifying the blend state of a color target.
struct SDL_GPUColorTargetBlendState {
    SDL_GPUBlendFactor src_color_blendfactor;
    SDL_GPUBlendFactor dst_color_blendfactor;
    SDL_GPUBlendOp color_blend_op;
    SDL_GPUBlendFactor src_alpha_blendfactor;
    SDL_GPUBlendFactor dst_alpha_blendfactor;
    SDL_GPUBlendOp alpha_blend_op;
    SDL_GPUColorComponentFlags color_write_mask;
    bool enable_blend;
    bool enable_color_write_mask;
    Uint8 padding1;
    Uint8 padding2;
}
/// A structure specifying the parameters of color targets used in a graphics pipeline.
struct SDL_GPUColorTargetDescription {
    SDL_GPUTextureFormat format;
    SDL_GPUColorTargetBlendState blend_state;
}
/// A structure specifying the parameters of a color target used by a render pass.
struct SDL_GPUColorTargetInfo {
    SDL_GPUTexture*? texture;
    Uint32 mip_level;
    Uint32 layer_or_depth_plane;
    SDL_FColor clear_color;
    SDL_GPULoadOp load_op;
    SDL_GPUStoreOp store_op;
    SDL_GPUTexture*? resolve_texture;
    Uint32 resolve_mip_level;
    Uint32 resolve_layer;
    bool cycle;
    bool cycle_resolve_texture;
    Uint8 padding1;
    Uint8 padding2;
}
/// A structure specifying the parameters of a compute pipeline state.
struct SDL_GPUComputePipelineCreateInfo {
    c_size_t code_size;
    Uint8[*]? code;
    char*? entrypoint;
    SDL_GPUShaderFormat format;
    Uint32 num_samplers;
    Uint32 num_readonly_storage_textures;
    Uint32 num_readonly_storage_buffers;
    Uint32 num_readwrite_storage_textures;
    Uint32 num_readwrite_storage_buffers;
    Uint32 num_uniform_buffers;
    Uint32 threadcount_x;
    Uint32 threadcount_y;
    Uint32 threadcount_z;
    SDL_PropertiesID props;
}
/// A structure specifying the parameters of the graphics pipeline depth stencil state.
struct SDL_GPUDepthStencilState {
    SDL_GPUCompareOp compare_op;
    SDL_GPUStencilOpState back_stencil_state;
    SDL_GPUStencilOpState front_stencil_state;
    Uint8 compare_mask;
    Uint8 write_mask;
    bool enable_depth_test;
    bool enable_depth_write;
    bool enable_stencil_test;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying the parameters of a depth-stencil target used by a render pass.
struct SDL_GPUDepthStencilTargetInfo {
    SDL_GPUTexture*? texture;
    float32 clear_depth;
    SDL_GPULoadOp load_op;
    SDL_GPUStoreOp store_op;
    SDL_GPULoadOp stencil_load_op;
    SDL_GPUStoreOp stencil_store_op;
    bool cycle;
    Uint8 clear_stencil;
    Uint8 mip_level;
    Uint8 layer;
}
/// A structure specifying the parameters of a graphics pipeline state.
struct SDL_GPUGraphicsPipelineCreateInfo {
    SDL_GPUShader*? vertex_shader;
    SDL_GPUShader*? fragment_shader;
    SDL_GPUVertexInputState vertex_input_state;
    SDL_GPUPrimitiveType primitive_type;
    SDL_GPURasterizerState rasterizer_state;
    SDL_GPUMultisampleState multisample_state;
    SDL_GPUDepthStencilState depth_stencil_state;
    SDL_GPUGraphicsPipelineTargetInfo target_info;
    SDL_PropertiesID props;
}
/// A structure specifying the descriptions of render targets used in a graphics pipeline.
struct SDL_GPUGraphicsPipelineTargetInfo {
    SDL_GPUColorTargetDescription[*]? color_target_descriptions;
    Uint32 num_color_targets;
    SDL_GPUTextureFormat depth_stencil_format;
    bool has_depth_stencil_target;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying the parameters of an indexed indirect draw command.
struct SDL_GPUIndexedIndirectDrawCommand {
    Uint32 num_indices;
    Uint32 num_instances;
    Uint32 first_index;
    Sint32 vertex_offset;
    Uint32 first_instance;
}
/// A structure specifying the parameters of an indexed dispatch command.
struct SDL_GPUIndirectDispatchCommand {
    Uint32 groupcount_x;
    Uint32 groupcount_y;
    Uint32 groupcount_z;
}
/// A structure specifying the parameters of an indirect draw command.
struct SDL_GPUIndirectDrawCommand {
    Uint32 num_vertices;
    Uint32 num_instances;
    Uint32 first_vertex;
    Uint32 first_instance;
}
/// A structure specifying the parameters of the graphics pipeline multisample state.
struct SDL_GPUMultisampleState {
    SDL_GPUSampleCount sample_count;
    Uint32 sample_mask;
    bool enable_mask;
    bool enable_alpha_to_coverage;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying the parameters of the graphics pipeline rasterizer state.
struct SDL_GPURasterizerState {
    SDL_GPUFillMode fill_mode;
    SDL_GPUCullMode cull_mode;
    SDL_GPUFrontFace front_face;
    float32 depth_bias_constant_factor;
    float32 depth_bias_clamp;
    float32 depth_bias_slope_factor;
    bool enable_depth_bias;
    bool enable_depth_clip;
    Uint8 padding1;
    Uint8 padding2;
}
/// A structure specifying the parameters of a GPU render state.
struct SDL_GPURenderStateCreateInfo {
    SDL_GPUShader*? fragment_shader;
    Sint32 num_sampler_bindings;
    SDL_GPUTextureSamplerBinding[*]? sampler_bindings;
    Sint32 num_storage_textures;
    SDL_GPUTexture*?[*]? storage_textures;
    Sint32 num_storage_buffers;
    SDL_GPUBuffer*?[*]? storage_buffers;
    SDL_PropertiesID props;
}
/// A structure specifying the parameters of a sampler.
struct SDL_GPUSamplerCreateInfo {
    SDL_GPUFilter min_filter;
    SDL_GPUFilter mag_filter;
    SDL_GPUSamplerMipmapMode mipmap_mode;
    SDL_GPUSamplerAddressMode address_mode_u;
    SDL_GPUSamplerAddressMode address_mode_v;
    SDL_GPUSamplerAddressMode address_mode_w;
    float32 mip_lod_bias;
    float32 max_anisotropy;
    SDL_GPUCompareOp compare_op;
    float32 min_lod;
    float32 max_lod;
    bool enable_anisotropy;
    bool enable_compare;
    Uint8 padding1;
    Uint8 padding2;
    SDL_PropertiesID props;
}
/// A structure specifying code and metadata for creating a shader object.
struct SDL_GPUShaderCreateInfo {
    c_size_t code_size;
    Uint8[*]? code;
    char*? entrypoint;
    SDL_GPUShaderFormat format;
    SDL_GPUShaderStage stage;
    Uint32 num_samplers;
    Uint32 num_storage_textures;
    Uint32 num_storage_buffers;
    Uint32 num_uniform_buffers;
    SDL_PropertiesID props;
}
/// A structure specifying the stencil operation state of a graphics pipeline.
struct SDL_GPUStencilOpState {
    SDL_GPUStencilOp fail_op;
    SDL_GPUStencilOp pass_op;
    SDL_GPUStencilOp depth_fail_op;
    SDL_GPUCompareOp compare_op;
}
/// A structure specifying parameters related to binding buffers in a compute pass.
struct SDL_GPUStorageBufferReadWriteBinding {
    SDL_GPUBuffer*? buffer;
    bool cycle;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying parameters related to binding textures in a compute pass.
struct SDL_GPUStorageTextureReadWriteBinding {
    SDL_GPUTexture*? texture;
    Uint32 mip_level;
    Uint32 layer;
    bool cycle;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
}
/// A structure specifying the parameters of a texture.
struct SDL_GPUTextureCreateInfo {
    SDL_GPUTextureType type;
    SDL_GPUTextureFormat format;
    SDL_GPUTextureUsageFlags usage;
    Uint32 width;
    Uint32 height;
    Uint32 layer_count_or_depth;
    Uint32 num_levels;
    SDL_GPUSampleCount sample_count;
    SDL_PropertiesID props;
}
/// A structure specifying a location in a texture.
struct SDL_GPUTextureLocation {
    SDL_GPUTexture*? texture;
    Uint32 mip_level;
    Uint32 layer;
    Uint32 x;
    Uint32 y;
    Uint32 z;
}
/// A structure specifying a region of a texture.
struct SDL_GPUTextureRegion {
    SDL_GPUTexture*? texture;
    Uint32 mip_level;
    Uint32 layer;
    Uint32 x;
    Uint32 y;
    Uint32 z;
    Uint32 w;
    Uint32 h;
    Uint32 d;
}
/// A structure specifying parameters in a sampler binding call.
struct SDL_GPUTextureSamplerBinding {
    SDL_GPUTexture*? texture;
    SDL_GPUSampler*? sampler;
}
/// A structure specifying parameters related to transferring data to or from a texture.
struct SDL_GPUTextureTransferInfo {
    SDL_GPUTransferBuffer*? transfer_buffer;
    Uint32 offset;
    Uint32 pixels_per_row;
    Uint32 rows_per_layer;
}
/// A structure specifying the parameters of a transfer buffer.
struct SDL_GPUTransferBufferCreateInfo {
    SDL_GPUTransferBufferUsage usage;
    Uint32 size;
    SDL_PropertiesID props;
}
/// A structure specifying a location in a transfer buffer.
struct SDL_GPUTransferBufferLocation {
    SDL_GPUTransferBuffer*? transfer_buffer;
    Uint32 offset;
}
/// A structure specifying a vertex attribute.
struct SDL_GPUVertexAttribute {
    Uint32 location;
    Uint32 buffer_slot;
    SDL_GPUVertexElementFormat format;
    Uint32 offset;
}
/// A structure specifying the parameters of vertex buffers used in a graphics pipeline.
struct SDL_GPUVertexBufferDescription {
    Uint32 slot;
    Uint32 pitch;
    SDL_GPUVertexInputRate input_rate;
    Uint32 instance_step_rate;
}
/// A structure specifying the parameters of a graphics pipeline vertex input state.
struct SDL_GPUVertexInputState {
    SDL_GPUVertexBufferDescription[*]? vertex_buffer_descriptions;
    Uint32 num_vertex_buffers;
    SDL_GPUVertexAttribute[*]? vertex_attributes;
    Uint32 num_vertex_attributes;
}
/// A structure specifying a viewport.
struct SDL_GPUViewport {
    float32 x;
    float32 y;
    float32 w;
    float32 h;
    float32 min_depth;
    float32 max_depth;
}
/// A structure specifying additional options when using Vulkan.
struct SDL_GPUVulkanOptions {
    Uint32 vulkan_api_version;
    void*? feature_list;
    void*? vulkan_10_physical_device_features;
    Uint32 device_extension_count;
    char*?[*]? device_extension_names;
    Uint32 instance_extension_count;
    char*?[*]? instance_extension_names;
}
/// An SDL_GUID is a 128-bit identifier for an input device that identifies that device across runs of SDL programs on the same platform.
struct SDL_GUID {
    Uint8[16] data;
}
/// Gamepad axis motion event structure (event.gaxis.*).
struct SDL_GamepadAxisEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 axis;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
    Sint16 value;
    Uint16 padding4;
}
/// A gamepad binding to a joystick axis.
struct SDL_GamepadBinding_input_axis {
    c_int axis;
    c_int axis_min;
    c_int axis_max;
}
/// A gamepad binding to a joystick hat.
struct SDL_GamepadBinding_input_hat {
    c_int hat;
    c_int hat_mask;
}
/// The joystick-side input of a gamepad binding.
union SDL_GamepadBinding_input {
    c_int button;
    SDL_GamepadBinding_input_axis axis;
    SDL_GamepadBinding_input_hat hat;
}
/// A gamepad binding to a gamepad axis.
struct SDL_GamepadBinding_output_axis {
    SDL_GamepadAxis axis;
    c_int axis_min;
    c_int axis_max;
}
/// The gamepad-side output of a gamepad binding.
union SDL_GamepadBinding_output {
    SDL_GamepadButton button;
    SDL_GamepadBinding_output_axis axis;
}
/// A mapping from a joystick input to a gamepad input.
struct SDL_GamepadBinding {
    SDL_GamepadBindingType input_type;
    SDL_GamepadBinding_input input;
    SDL_GamepadBindingType output_type;
    SDL_GamepadBinding_output output;
}
/// Gamepad button event structure (event.gbutton.*).
struct SDL_GamepadButtonEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 button;
    bool down;
    Uint8 padding1;
    Uint8 padding2;
}
/// Gamepad device event structure (event.gdevice.*).
struct SDL_GamepadDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
}
/// Gamepad sensor event structure (event.gsensor.*).
struct SDL_GamepadSensorEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Sint32 sensor;
    float32[3] data;
    Uint64 sensor_timestamp;
}
/// Gamepad touchpad event structure (event.gtouchpad.*).
struct SDL_GamepadTouchpadEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Sint32 touchpad;
    Sint32 finger;
    float32 x;
    float32 y;
    float32 pressure;
}
/// A structure containing a template for a Condition effect.
struct SDL_HapticCondition {
    SDL_HapticEffectType type;
    SDL_HapticDirection direction;
    Uint32 length;
    Uint16 delay;
    Uint16 button;
    Uint16 interval;
    Uint16[3] right_sat;
    Uint16[3] left_sat;
    Sint16[3] right_coeff;
    Sint16[3] left_coeff;
    Uint16[3] deadband;
    Sint16[3] center;
}
/// A structure containing a template for a Constant effect.
struct SDL_HapticConstant {
    SDL_HapticEffectType type;
    SDL_HapticDirection direction;
    Uint32 length;
    Uint16 delay;
    Uint16 button;
    Uint16 interval;
    Sint16 level;
    Uint16 attack_length;
    Uint16 attack_level;
    Uint16 fade_length;
    Uint16 fade_level;
}
/// A structure containing a template for the SDL_HAPTIC_CUSTOM effect.
struct SDL_HapticCustom {
    SDL_HapticEffectType type;
    SDL_HapticDirection direction;
    Uint32 length;
    Uint16 delay;
    Uint16 button;
    Uint16 interval;
    Uint8 channels;
    Uint16 period;
    Uint16 samples;
    Uint16[*]? data;
    Uint16 attack_length;
    Uint16 attack_level;
    Uint16 fade_length;
    Uint16 fade_level;
}
/// Structure that represents a haptic direction.
struct SDL_HapticDirection {
    SDL_HapticDirectionType type;
    Sint32[3] dir;
}
/// The generic template for any haptic effect.
union SDL_HapticEffect {
    SDL_HapticEffectType type;
    SDL_HapticConstant constant;
    SDL_HapticPeriodic periodic;
    SDL_HapticCondition condition;
    SDL_HapticRamp ramp;
    SDL_HapticLeftRight leftright;
    SDL_HapticCustom custom;
}
/// A structure containing a template for a Left/Right effect.
struct SDL_HapticLeftRight {
    SDL_HapticEffectType type;
    Uint32 length;
    Uint16 large_magnitude;
    Uint16 small_magnitude;
}
/// A structure containing a template for a Periodic effect.
struct SDL_HapticPeriodic {
    SDL_HapticEffectType type;
    SDL_HapticDirection direction;
    Uint32 length;
    Uint16 delay;
    Uint16 button;
    Uint16 interval;
    Uint16 period;
    Sint16 magnitude;
    Sint16 offset;
    Uint16 phase;
    Uint16 attack_length;
    Uint16 attack_level;
    Uint16 fade_length;
    Uint16 fade_level;
}
/// A structure containing a template for a Ramp effect.
struct SDL_HapticRamp {
    SDL_HapticEffectType type;
    SDL_HapticDirection direction;
    Uint32 length;
    Uint16 delay;
    Uint16 button;
    Uint16 interval;
    Sint16 start;
    Sint16 end;
    Uint16 attack_length;
    Uint16 attack_level;
    Uint16 fade_length;
    Uint16 fade_level;
}
/// Close and free any allocated resources.
struct SDL_IOStreamInterface {
    Uint32 version;
    Sint64(void*?)? size;
    Sint64(void*?, Sint64, SDL_IOWhence)? seek;
    c_size_t(void*?, void*?, c_size_t, SDL_IOStatus*?)? read;
    c_size_t(void*?, void*?, c_size_t, SDL_IOStatus*?)? write;
    bool(void*?, SDL_IOStatus*?)? flush;
    bool(void*?)? close;
}
/// A structure used for thread-safe initialization and shutdown.
struct SDL_InitState {
    SDL_AtomicInt status;
    SDL_ThreadID thread;
    void*? reserved;
}
/// Joystick axis motion event structure (event.jaxis.*).
struct SDL_JoyAxisEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 axis;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
    Sint16 value;
    Uint16 padding4;
}
/// Joystick trackball motion event structure (event.jball.*).
struct SDL_JoyBallEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 ball;
    Uint8 padding1;
    Uint8 padding2;
    Uint8 padding3;
    Sint16 xrel;
    Sint16 yrel;
}
/// Joystick battery level change event structure (event.jbattery.*).
struct SDL_JoyBatteryEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    SDL_PowerState state;
    c_int percent;
}
/// Joystick button event structure (event.jbutton.*).
struct SDL_JoyButtonEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 button;
    bool down;
    Uint8 padding1;
    Uint8 padding2;
}
/// Joystick device event structure (event.jdevice.*).
struct SDL_JoyDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
}
/// Joystick hat position change event structure (event.jhat.*).
struct SDL_JoyHatEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_JoystickID which;
    Uint8 hat;
    Uint8 value;
    Uint8 padding1;
    Uint8 padding2;
}
/// Keyboard device event structure (event.kdevice.*).
struct SDL_KeyboardDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_KeyboardID which;
}
/// Keyboard button event structure (event.key.*).
struct SDL_KeyboardEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    SDL_KeyboardID which;
    SDL_Scancode scancode;
    SDL_Keycode key;
    SDL_Keymod mod;
    Uint16 raw;
    bool down;
    bool repeat;
}
/// A struct to provide locale data.
struct SDL_Locale {
    char*? language;
    char*? country;
}
/// Individual button data.
struct SDL_MessageBoxButtonData {
    SDL_MessageBoxButtonFlags flags;
    c_int buttonID;
    char*? text;
}
/// RGB value used in a message box color scheme.
struct SDL_MessageBoxColor {
    Uint8 r;
    Uint8 g;
    Uint8 b;
}
/// A set of colors to use for message box dialogs.
struct SDL_MessageBoxColorScheme {
    SDL_MessageBoxColor[5] colors;
}
/// MessageBox structure containing title, text, window, etc.
struct SDL_MessageBoxData {
    SDL_MessageBoxFlags flags;
    SDL_Window*? window;
    char*? title;
    char*? message;
    c_int numbuttons;
    SDL_MessageBoxButtonData[*]? buttons;
    SDL_MessageBoxColorScheme*? colorScheme;
}
/// Mouse button event structure (event.button.*).
struct SDL_MouseButtonEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    SDL_MouseID which;
    Uint8 button;
    bool down;
    Uint8 clicks;
    Uint8 padding;
    float32 x;
    float32 y;
}
/// Mouse device event structure (event.mdevice.*).
struct SDL_MouseDeviceEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_MouseID which;
}
/// Mouse motion event structure (event.motion.*).
struct SDL_MouseMotionEvent {
    SDL_EventType type;
    Uint32 reserved;
    Uint64 timestamp;
    SDL_WindowID windowID;
    SDL_MouseID which;
    SDL_MouseButtonFlags state;
    float32 x;
    float32 y;
    float32 xrel;
    float32 yrel;
}
