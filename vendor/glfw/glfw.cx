const GLFW_IBEAM_CURSOR = 0x00036002;
/// The crosshair cursor shape.
const GLFW_CROSSHAIR_CURSOR = 0x00036003;
/// The pointing hand cursor shape.
const GLFW_POINTING_HAND_CURSOR = 0x00036004;
/// The horizontal resize/move arrow shape.
const GLFW_RESIZE_EW_CURSOR = 0x00036005;
/// The vertical resize/move arrow shape.
const GLFW_RESIZE_NS_CURSOR = 0x00036006;
/// The top-left to bottom-right diagonal resize/move arrow shape.
const GLFW_RESIZE_NWSE_CURSOR = 0x00036007;
/// The top-right to bottom-left diagonal resize/move arrow shape.
const GLFW_RESIZE_NESW_CURSOR = 0x00036008;
/// The omni-directional resize/move cursor shape.
const GLFW_RESIZE_ALL_CURSOR = 0x00036009;
/// The operation-not-allowed shape.
const GLFW_NOT_ALLOWED_CURSOR = 0x0003600A;
/// Legacy name for compatibility.
const GLFW_HRESIZE_CURSOR = GLFW_RESIZE_EW_CURSOR;
/// Legacy name for compatibility.
const GLFW_VRESIZE_CURSOR = GLFW_RESIZE_NS_CURSOR;
/// Legacy name for compatibility.
const GLFW_HAND_CURSOR = GLFW_POINTING_HAND_CURSOR;
/// Joystick connected state.
const GLFW_CONNECTED = 0x00040001;
/// Joystick disconnected state.
const GLFW_DISCONNECTED = 0x00040002;
/// Joystick hat buttons init hint.
const GLFW_JOYSTICK_HAT_BUTTONS = 0x00050001;
/// ANGLE rendering backend init hint.
const GLFW_ANGLE_PLATFORM_TYPE = 0x00050002;
/// Platform selection init hint.
const GLFW_PLATFORM = 0x00050003;
/// macOS specific init hint.
const GLFW_COCOA_CHDIR_RESOURCES = 0x00051001;
/// macOS specific init hint.
const GLFW_COCOA_MENUBAR = 0x00051002;
/// X11 specific init hint.
const GLFW_X11_XCB_VULKAN_SURFACE = 0x00052001;
/// Wayland specific init hint.
const GLFW_WAYLAND_LIBDECOR = 0x00053001;
/// Hint value that enables automatic platform selection.
const GLFW_ANY_PLATFORM = 0x00060000;
/// The Win32 platform.
const GLFW_PLATFORM_WIN32 = 0x00060001;
/// The Cocoa platform.
const GLFW_PLATFORM_COCOA = 0x00060002;
/// The Wayland platform.
const GLFW_PLATFORM_WAYLAND = 0x00060003;
/// The X11 platform.
const GLFW_PLATFORM_X11 = 0x00060004;
/// The null platform.
const GLFW_PLATFORM_NULL = 0x00060005;
/// No preference for a window hint.
const GLFW_DONT_CARE = -1;
/// Client API function pointer type.
using GLFWglproc = void();
/// Vulkan API function pointer type.
using GLFWvkproc = void();
/// Opaque monitor object.
struct GLFWmonitor {}
/// Opaque window object.
struct GLFWwindow {}
/// Opaque cursor object.
struct GLFWcursor {}
/// The function pointer type for memory allocation callbacks.
using GLFWallocatefun = void*?(c_size_t, void*?);
/// The function pointer type for memory reallocation callbacks.
using GLFWreallocatefun = void*?(void*, c_size_t, void*?);
/// The function pointer type for memory deallocation callbacks.
using GLFWdeallocatefun = void(void*, void*?);
/// The function pointer type for error callbacks.
using GLFWerrorfun = void(c_int, char*);
/// The function pointer type for window position callbacks.
using GLFWwindowposfun = void(GLFWwindow*, c_int, c_int);
/// The function pointer type for window size callbacks.
using GLFWwindowsizefun = void(GLFWwindow*, c_int, c_int);
/// The function pointer type for window close callbacks.
using GLFWwindowclosefun = void(GLFWwindow*);
/// The function pointer type for window content refresh callbacks.
using GLFWwindowrefreshfun = void(GLFWwindow*);
/// The function pointer type for window focus callbacks.
using GLFWwindowfocusfun = void(GLFWwindow*, c_int);
/// The function pointer type for window iconify callbacks.
using GLFWwindowiconifyfun = void(GLFWwindow*, c_int);
/// The function pointer type for window maximize callbacks.
using GLFWwindowmaximizefun = void(GLFWwindow*, c_int);
/// The function pointer type for framebuffer size callbacks.
using GLFWframebuffersizefun = void(GLFWwindow*, c_int, c_int);
/// The function pointer type for window content scale callbacks.
using GLFWwindowcontentscalefun = void(GLFWwindow*, float, float);
/// The function pointer type for mouse button callbacks.
using GLFWmousebuttonfun = void(GLFWwindow*, c_int, c_int, c_int);
/// The function pointer type for cursor position callbacks.
using GLFWcursorposfun = void(GLFWwindow*, double, double);
/// The function pointer type for cursor enter/leave callbacks.
using GLFWcursorenterfun = void(GLFWwindow*, c_int);
/// The function pointer type for scroll callbacks.
using GLFWscrollfun = void(GLFWwindow*, double, double);
/// The function pointer type for keyboard key callbacks.
using GLFWkeyfun = void(GLFWwindow*, c_int, c_int, c_int, c_int);
/// The function pointer type for Unicode character callbacks.
using GLFWcharfun = void(GLFWwindow*, c_uint);
/// The function pointer type for Unicode character with modifiers callbacks.
using GLFWcharmodsfun = void(GLFWwindow*, c_uint, c_int);
/// The function pointer type for path drop callbacks.
using GLFWdropfun = void(GLFWwindow*, c_int, char*[*]);
/// The function pointer type for monitor configuration callbacks.
using GLFWmonitorfun = void(GLFWmonitor*, c_int);
/// The function pointer type for joystick configuration callbacks.
using GLFWjoystickfun = void(c_int, c_int);
/// Video mode type.
struct GLFWvidmode {
    /// The width, in screen coordinates, of the video mode.
    c_int width;
    /// The height, in screen coordinates, of the video mode.
    c_int height;
    /// The bit depth of the red channel of the video mode.
    c_int redBits;
    /// The bit depth of the green channel of the video mode.
    c_int greenBits;
    /// The bit depth of the blue channel of the video mode.
    c_int blueBits;
    /// The refresh rate, in Hz, of the video mode.
    c_int refreshRate;
}
/// Gamma ramp.
struct GLFWgammaramp {
    /// An array of value describing the response of the red channel.
    c_ushort[*] red;
    /// An array of value describing the response of the green channel.
    c_ushort[*] green;
    /// An array of value describing the response of the blue channel.
    c_ushort[*] blue;
    /// The number of elements in each array.
    c_uint size;
}
/// Image data.
struct GLFWimage {
    /// The width, in pixels, of this image.
    c_int width;
    /// The height, in pixels, of this image.
    c_int height;
    /// The pixel data of this image, arranged left-to-right, top-to-bottom.
    c_uchar[*] pixels;
}
/// Gamepad input state.
struct GLFWgamepadstate {
    /// The states of each [gamepad button](@ref gamepad_buttons), `GLFW_PRESS` or `GLFW_RELEASE`.
    c_uchar[15] buttons;
    /// The states of each [gamepad axis](@ref gamepad_axes), in the range -1.0 to 1.0 inclusive.
    float[6] axes;
}
/// Custom heap memory allocator.
struct GLFWallocator {
    /// The memory allocation function.  See @ref GLFWallocatefun for details about allocation function.
    GLFWallocatefun allocate;
    /// The memory reallocation function.  See @ref GLFWreallocatefun for details about reallocation function.
    GLFWreallocatefun reallocate;
    /// The memory deallocation function.  See @ref GLFWdeallocatefun for details about deallocation function.
    GLFWdeallocatefun deallocate;
    /// The user pointer for this custom allocator.  This value will be passed to the allocator functions.
    void*? user;
}
