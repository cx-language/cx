// Generic 2D and 3D vectors for integer and floating-point elements.

/// A 2D vector.
struct Vector2<T>: Copyable {
    T x;
    T y;

    /// Returns the dot product.
    T dot(Vector2<T> other) {
        return x * other.x + y * other.y;
    }

    /// Returns the length.
    float64 length() {
        return sqrt(x * x + y * y);
    }

    /// Returns the vector scaled to unit length.
    /// Only meaningful for floating-point elements.
    Vector2<T> normalized() {
        var len = T(length());
        return Vector2(x / len, y / len);
    }
}

/// Returns the component-wise sum.
Vector2<T> operator+<T>(Vector2<T> a, Vector2<T> b) {
    return Vector2(a.x + b.x, a.y + b.y);
}

/// Returns the component-wise difference.
Vector2<T> operator-<T>(Vector2<T> a, Vector2<T> b) {
    return Vector2(a.x - b.x, a.y - b.y);
}

/// Returns the vector scaled by the given factor.
Vector2<T> operator*<T>(Vector2<T> v, T s) {
    return Vector2(v.x * s, v.y * s);
}

/// Returns the vector scaled by the given factor.
Vector2<T> operator*<T>(T s, Vector2<T> v) {
    return Vector2(v.x * s, v.y * s);
}

/// A 3D vector.
struct Vector3<T>: Copyable {
    T x;
    T y;
    T z;

    /// Returns the dot product.
    T dot(Vector3<T> other) {
        return x * other.x + y * other.y + z * other.z;
    }

    /// Returns the cross product.
    Vector3<T> cross(Vector3<T> other) {
        return Vector3(
            y * other.z - z * other.y,
            z * other.x - x * other.z,
            x * other.y - y * other.x
        );
    }

    /// Returns the length.
    float64 length() {
        return sqrt(x * x + y * y + z * z);
    }

    /// Returns the vector scaled to unit length.
    /// Only meaningful for floating-point elements.
    Vector3<T> normalized() {
        var len = T(length());
        return Vector3(x / len, y / len, z / len);
    }
}

/// Returns the component-wise sum.
Vector3<T> operator+<T>(Vector3<T> a, Vector3<T> b) {
    return Vector3(a.x + b.x, a.y + b.y, a.z + b.z);
}

/// Returns the component-wise difference.
Vector3<T> operator-<T>(Vector3<T> a, Vector3<T> b) {
    return Vector3(a.x - b.x, a.y - b.y, a.z - b.z);
}

/// Returns the vector scaled by the given factor.
Vector3<T> operator*<T>(Vector3<T> v, T s) {
    return Vector3(v.x * s, v.y * s, v.z * s);
}

/// Returns the vector scaled by the given factor.
Vector3<T> operator*<T>(T s, Vector3<T> v) {
    return Vector3(v.x * s, v.y * s, v.z * s);
}
