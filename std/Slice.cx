/// A non-owning reference to a contiguous array of elements.
struct Slice<Element>: Copyable {
    private Element[*] data;
    private int size;

    /// Initializes a Slice referring to an empty array.
    Slice() {
        data = undefined;
        size = 0;
    }

    /// Initializes a Slice referring to the elements of the given List.
    implicit Slice(List<Element>& list) {
        data = list.data();
        size = list.size();
    }

    /// Initializes a Slice referring to an array of the given size located at the given memory
    /// address.
    Slice(Element* data, int size) {
        this.data = data;
        this.size = size;
    }

    /// Returns true if the array has no elements.
    bool empty() {
        return size == 0;
    }

    /// Returns the number of elements in the array.
    int size() {
        return size;
    }

    /// Returns the first element in the array.
    Element& front() {
        if empty() indexOutOfBounds("front", 0);
        return data[0];
    }

    /// Returns a reference to the element at the given index.
    Element& operator[](int index) {
        if index < 0 || index >= size() indexOutOfBounds("operator[]", index);
        return data[index];
    }

    /// Returns a reference to the element at the given offset from the end.
    /// Offset 1 is the last element; offsets outside 1..size() abort.
    Element& operator[-](int index) {
        if index < 1 || index > size() indexOutOfBounds("operator[-]", index);
        return data[size() - index];
    }

    /// Returns a pointer to the first element.
    Element[*] data() {
        return data;
    }

    /// Returns an iterator over the elements.
    ArrayIterator<Element> iterator() {
        return ArrayIterator(this);
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find(bool(Element&) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find<T: Copyable>(bool(T) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    // TODO: Remove these once implicit into-iterator conversions have been implemented.
    /// Returns true if all elements satisfy the predicate.
    bool all(bool(Element&) predicate) { return all(iterator(), predicate); }
    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) {
        for index in 0..size() {
            if !predicate(this[index]) return false;
        }
        return true;
    }
    /// Returns true if any element satisfies the predicate.
    bool any(bool(Element&) predicate) { return any(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) {
        for index in 0..size() {
            if predicate(this[index]) return true;
        }
        return false;
    }
    /// Returns true if no element satisfies the predicate.
    bool none(bool(Element&) predicate) { return none(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) {
        for index in 0..size() {
            if predicate(this[index]) return false;
        }
        return true;
    }

    private void indexOutOfBounds(string function, int index) {
        abort("Slice.", function, ": index ", index, " is out of bounds, size is ", size());
    }
}

/// Returns true if both arrays have equal elements.
bool operator==<T>(Slice<T> a, Slice<T> b) {
    if a.size() != b.size() {
        return false;
    }

    for i in 0..a.size() {
        if a[i] != b[i] {
            return false;
        }
    }

    return true;
}
