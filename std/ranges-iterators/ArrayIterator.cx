/// Iterates over the elements of an array.
struct ArrayIterator<Element>: Iterator<Element&> {
    private Element[*] current;
    private Element[*] end;

    /// Initializes an iterator over the given array.
    ArrayIterator(Element[] array) {
        current = array.data();
        end = &array.data()[array.size()];
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return current != end;
    }

    /// Returns the current element.
    Element& value() {
        return *current;
    }

    /// Advances to the next element.
    void increment() {
        current++;
    }

    /// Collects the remaining elements into a list by copying them; only sound for Copyable elements.
    List<Element> toList() {
        var output = List<Element>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    Element sum() {
        return sumRemaining(*this, Element(0));
    }
}
