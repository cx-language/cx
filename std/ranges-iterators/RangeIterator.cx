/// Iterates over the values of a range.
struct RangeIterator<T>: Iterator<T>, Printable {
    private T current;
    private T end;

    /// Initializes an iterator over the given range.
    RangeIterator(Range<T> range) {
        current = range.start();
        end = range.end();
    }

    /// Returns true if there are more values.
    bool hasValue() {
        // Compare with `<` rather than `!=` so reversed ranges like `3..0`
        // are empty instead of iterating until the value wraps around.
        return current < end;
    }

    /// Returns the current value.
    T value() {
        return current;
    }

    /// Advances to the next value.
    void increment() {
        current++;
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }

    /// Collects the remaining values into a list.
    List<T> toList() {
        var output = List<T>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    T sum() {
        return sumRemaining(*this, T(0));
    }
}
