/// Lazily transforms the elements of another iterator.
/// Get one from map(); collect the results with toList().
struct MappedIterator<Output, Input, It, Transform>: Iterator<Output&>, Printable {
    private It source;
    private Transform transform;
    // None at start; a plain field would destroy garbage on first assign for owning outputs.
    private Output? current;

    /// Initializes an iterator transforming the source's elements.
    MappedIterator(It source, Transform transform) {
        this.source = source;
        this.transform = transform;
        this.current = None;
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return source.hasValue();
    }

    /// Returns the next transformed element.
    Output& value() {
        current = transform(*source.value());
        return &current!;
    }

    /// Advances to the next element.
    void increment() {
        source.increment();
    }

    /// Lazily transforms the elements.
    MappedIterator<Output2, Output, MappedIterator<Output, Input, It, Transform>, Output2(Output&)> map<Output2>(Output2(Output&) transform) {
        return MappedIterator<Output2, Output, MappedIterator<Output, Input, It, Transform>, Output2(Output&)>(*this, transform);
    }

    /// Lazily transforms the elements.
    MappedIterator<Output2, Output, MappedIterator<Output, Input, It, Transform>, Output2(T)> map<Output2, T: Copyable>(Output2(T) transform) {
        return MappedIterator<Output2, Output, MappedIterator<Output, Input, It, Transform>, Output2(T)>(*this, transform);
    }

    /// Lazily keeps the elements satisfying the predicate.
    FilterIterator<Output, MappedIterator<Output, Input, It, Transform>, bool(Output&)> filter(bool(Output&) include) {
        return FilterIterator<Output, MappedIterator<Output, Input, It, Transform>, bool(Output&)>(*this, include);
    }

    /// Lazily keeps the elements satisfying the predicate.
    FilterIterator<Output, MappedIterator<Output, Input, It, Transform>, bool(T)> filter<T: Copyable>(bool(T) include) {
        return FilterIterator<Output, MappedIterator<Output, Input, It, Transform>, bool(T)>(*this, include);
    }

    /// Lazily appends another iterator's elements.
    ChainIterator<Output, MappedIterator<Output, Input, It, Transform>, Other> chain<Other>(Other other) {
        return ChainIterator(*this, other);
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }

    /// Collects the remaining elements into a list by copying them; only sound for Copyable elements.
    List<Output> toList() {
        var output = List<Output>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    Output sum() {
        return sumRemaining(*this, Output(0));
    }
}
