/// An iterator is an object used to traverse the elements of a sequence.
interface Iterator<Element> {

    /// Returns true if there's at least one element remaining in the sequence, i.e. if calling
    /// `value()` is allowed.
    bool hasValue();

    /// Returns the next element from the sequence. Calling this function is not allowed if
    /// `hasValue()` returns false.
    Element value();

    /// Advances the iterator to the next element in the sequence. Calling this function is not
    /// allowed if `hasValue()` returns false.
    void increment();
}

/// Returns true if all remaining elements satisfy the predicate.
bool all<T, I>(I& it, bool(T&) predicate) {
    for ; it.hasValue(); it.increment() {
        if !predicate(it.value()) {
            return false;
        }
    }
    return true;
}

/// Returns true if all remaining elements satisfy the predicate.
bool all<T: Copyable, I>(I& it, bool(T) predicate) {
    for ; it.hasValue(); it.increment() {
        if !predicate(it.value()) {
            return false;
        }
    }
    return true;
}

/// Returns true if any remaining element satisfies the predicate.
bool any<T, I>(I& it, bool(T&) predicate) {
    for ; it.hasValue(); it.increment() {
        if predicate(it.value()) {
            return true;
        }
    }
    return false;
}

/// Returns true if any remaining element satisfies the predicate.
bool any<T: Copyable, I>(I& it, bool(T) predicate) {
    for ; it.hasValue(); it.increment() {
        if predicate(it.value()) {
            return true;
        }
    }
    return false;
}

/// Returns true if no remaining element satisfies the predicate.
bool none<T, I>(I& it, bool(T&) predicate) {
    for ; it.hasValue(); it.increment() {
        if predicate(it.value()) {
            return false;
        }
    }
    return true;
}

/// Returns true if no remaining element satisfies the predicate.
bool none<T: Copyable, I>(I& it, bool(T) predicate) {
    for ; it.hasValue(); it.increment() {
        if predicate(it.value()) {
            return false;
        }
    }
    return true;
}

/// Sums the remaining elements of the iterator, starting from the given zero value.
private T sumRemaining<T, I>(I& it, T zero) {
    var total = zero;
    while it.hasValue() {
        total += it.value();
        it.increment();
    }
    return total;
}

/// Prints the iterator's remaining values in list form, e.g. [1, 2, 3],
/// streaming them instead of collecting a temporary list. Takes the iterator
/// by value so printing never consumes the caller's iterator.
private void printRemaining<I: Copyable>(I it, OutputStream& stream) {
    stream.push('[');
    var first = true;
    while it.hasValue() {
        if !first {
            stream.append(", ");
        }
        first = false;
        it.value().print(stream);
        it.increment();
    }
    stream.push(']');
}
