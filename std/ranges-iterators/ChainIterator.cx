/// Lazily concatenates two iterators: yields all of the first's elements,
/// then all of the second's. Get one from chain(); collect with toList().
struct ChainIterator<Element, First, Second>: Iterator<Element&>, Printable {
    private First first;
    private Second second;

    /// Initializes an iterator yielding first's elements, then second's.
    ChainIterator(First first, Second second) {
        this.first = first;
        this.second = second;
    }

    /// Returns true if either iterator has more elements.
    bool hasValue() {
        return first.hasValue() || second.hasValue();
    }

    /// Returns the next element.
    Element& value() {
        if first.hasValue() {
            return first.value();
        }
        return second.value();
    }

    /// Advances to the next element.
    void increment() {
        if first.hasValue() {
            first.increment();
        } else {
            second.increment();
        }
    }

    /// Lazily appends another iterator's elements.
    ChainIterator<Element, ChainIterator<Element, First, Second>, Other> chain<Other>(Other other) {
        return ChainIterator(*this, other);
    }

    /// Lazily transforms the elements.
    MappedIterator<Output, Element, ChainIterator<Element, First, Second>, Pred> map<Output, Pred: Output(Element&)>(Pred transform) {
        return MappedIterator<Output, Element, ChainIterator<Element, First, Second>, Pred>(*this, transform);
    }

    /// Lazily transforms the elements.
    MappedIterator<Output, Element, ChainIterator<Element, First, Second>, Pred> map<Output, T: Copyable, Pred: Output(T)>(Pred transform) {
        return MappedIterator<Output, Element, ChainIterator<Element, First, Second>, Pred>(*this, transform);
    }

    /// Lazily keeps the elements satisfying the predicate.
    FilterIterator<Element, ChainIterator<Element, First, Second>, Pred> filter<Pred: bool(Element&)>(Pred include) {
        return FilterIterator<Element, ChainIterator<Element, First, Second>, Pred>(*this, include);
    }

    /// Lazily keeps the elements satisfying the predicate.
    FilterIterator<Element, ChainIterator<Element, First, Second>, Pred> filter<T: Copyable, Pred: bool(T)>(Pred include) {
        return FilterIterator<Element, ChainIterator<Element, First, Second>, Pred>(*this, include);
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }

    /// Collects the remaining elements into a list by copying them; only sound for Copyable elements.
    List<Element> toList() {
        var output = List<Element>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    Element sum() {
        return sumRemaining(*this, Element(0));
    }
}
