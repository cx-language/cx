/// Iterates over elements with their indices.
struct EnumeratedIterator<Element>: Iterator<EnumeratedIteratorEntry<Element>>, Printable {
    private ArrayIterator<Element> base;
    private int index;

    /// Initializes an iterator over the given iterator.
    EnumeratedIterator(ArrayIterator<Element> iterator) {
        base = iterator;
        index = 0;
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return base.hasValue();
    }

    /// Returns the current element with its index.
    EnumeratedIteratorEntry<Element> value() {
        return EnumeratedIteratorEntry(&base.value(), index);
    }

    /// Advances to the next element.
    void increment() {
        base.increment();
        index++;
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }
}

/// An element with its index.
struct EnumeratedIteratorEntry<Value> {
    /// The element.
    Value* value;
    /// The element's index.
    int index;
}
