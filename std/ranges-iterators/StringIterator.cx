/// Iterates over the characters of a string.
struct StringIterator: Iterator<char&>, Printable {
    private char[*] current;
    private char[*] end;

    /// Initializes an iterator over the given string.
    StringIterator(string s) {
        current = s.data();
        end = &s.data()[s.size()];
    }

    /// Returns true if there are more characters.
    bool hasValue() {
        return current != end;
    }

    /// Returns the current character.
    char& value() {
        return *current;
    }

    /// Advances to the next character.
    void increment() {
        current++;
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }

    /// Collects the remaining characters into a list.
    List<char> toList() {
        var output = List<char>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }
}
