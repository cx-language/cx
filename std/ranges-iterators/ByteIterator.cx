/// Iterates over the bytes of a string.
struct ByteIterator: Iterator<uint8>, Printable {
    private string stream;

    /// Initializes an iterator over the given string.
    ByteIterator(string stream) {
        this.stream = stream;
    }

    /// Returns true if there are more bytes.
    bool hasValue() {
        return !stream.empty();
    }

    /// Returns the current byte.
    uint8 value() {
        return uint8(stream.first());
    }

    /// Advances to the next byte.
    void increment() {
        stream = stream.substr(1);
    }

    /// Prints the remaining values in list form, e.g. [1, 2, 3].
    void print(OutputStream& stream) {
        printRemaining(*this, stream);
    }

    /// Collects the remaining bytes into a list.
    List<uint8> toList() {
        var output = List<uint8>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }

    /// Returns the sum of the remaining bytes, or zero if there are none.
    uint8 sum() {
        return sumRemaining(*this, uint8(0));
    }

    /// Returns itself.
    ByteIterator iterator() {
        return this;
    }
}
