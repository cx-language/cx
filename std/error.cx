/// Prints a stack trace and aborts.
never abortWrapper() {
    printStackTrace();
    setAbortBehavior();
    abort();
}

/// Aborts the program, printing the given values to stderr.
never abort<T: Printable>(T*... args) {
    for arg in args {
        stderr().write(arg);
    }
    stderr().write('\n');
    abortWrapper();
}

/// Aborts the program, marking the code as not implemented yet.
never todo() {
    abort("Not implemented");
}

/// Aborts the program with the given message, marking the code as not implemented yet.
never todo(string reason) {
    abort("Not implemented: ", reason);
}
