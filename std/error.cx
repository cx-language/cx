/// Prints a stack trace and aborts.
never abortWrapper() {
    printStackTrace();
    setAbortBehavior();
    abort();
}

/// Aborts the program, printing the given values to stderr.
never abort<T: Printable>(T*... args) {
    for arg in args {
        stderr().write(arg);
    }
    stderr().write('\n');
    abortWrapper();
}
