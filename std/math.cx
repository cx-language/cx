/// Returns the absolute value.
T abs<T>(T value) {
    if value < 0 {
        return -value;
    } else {
        return value;
    }
}

/// Constrains the value to the given range.
T clamp<T>(T value, T min, T max) {
    if value < min return min;
    if value > max return max;
    return value;
}

/// Ratio of a circle's circumference to its diameter.
const float pi = 3.14159265358979323846;

/// Base of the natural logarithm.
const float e = 2.71828182845904523536;

// Trigonometric functions.

/// Returns the sine of x.
extern float64 sin(float64 x);
/// Returns the sine of x.
extern float sinf(float x);
/// Returns the sine of x.
float sin(float x) { return sinf(x); }
/// Returns the sine of x.
float32 sin(float32 x) { return float32(sinf(float(x))); }

/// Returns the cosine of x.
extern float64 cos(float64 x);
/// Returns the cosine of x.
extern float cosf(float x);
/// Returns the cosine of x.
float cos(float x) { return cosf(x); }
/// Returns the cosine of x.
float32 cos(float32 x) { return float32(cosf(float(x))); }

/// Returns the tangent of x.
extern float64 tan(float64 x);
/// Returns the tangent of x.
extern float tanf(float x);
/// Returns the tangent of x.
float tan(float x) { return tanf(x); }
/// Returns the tangent of x.
float32 tan(float32 x) { return float32(tanf(float(x))); }

/// Returns the arc sine of x.
extern float64 asin(float64 x);
/// Returns the arc sine of x.
extern float asinf(float x);
/// Returns the arc sine of x.
float asin(float x) { return asinf(x); }
/// Returns the arc sine of x.
float32 asin(float32 x) { return float32(asinf(float(x))); }

/// Returns the arc cosine of x.
extern float64 acos(float64 x);
/// Returns the arc cosine of x.
extern float acosf(float x);
/// Returns the arc cosine of x.
float acos(float x) { return acosf(x); }
/// Returns the arc cosine of x.
float32 acos(float32 x) { return float32(acosf(float(x))); }

/// Returns the arc tangent of x.
extern float64 atan(float64 x);
/// Returns the arc tangent of x.
extern float atanf(float x);
/// Returns the arc tangent of x.
float atan(float x) { return atanf(x); }
/// Returns the arc tangent of x.
float32 atan(float32 x) { return float32(atanf(float(x))); }

/// Returns the arc tangent of y/x.
extern float64 atan2(float64 y, float64 x);
/// Returns the arc tangent of y/x.
extern float atan2f(float y, float x);
/// Returns the arc tangent of y/x.
float atan2(float y, float x) { return atan2f(y, x); }
/// Returns the arc tangent of y/x.
float32 atan2(float32 y, float32 x) { return float32(atan2f(float(y), float(x))); }

// Hyperbolic functions.

/// Returns the hyperbolic sine of x.
extern float64 sinh(float64 x);
/// Returns the hyperbolic sine of x.
extern float sinhf(float x);
/// Returns the hyperbolic sine of x.
float sinh(float x) { return sinhf(x); }
/// Returns the hyperbolic sine of x.
float32 sinh(float32 x) { return float32(sinhf(float(x))); }

/// Returns the hyperbolic cosine of x.
extern float64 cosh(float64 x);
/// Returns the hyperbolic cosine of x.
extern float coshf(float x);
/// Returns the hyperbolic cosine of x.
float cosh(float x) { return coshf(x); }
/// Returns the hyperbolic cosine of x.
float32 cosh(float32 x) { return float32(coshf(float(x))); }

/// Returns the hyperbolic tangent of x.
extern float64 tanh(float64 x);
/// Returns the hyperbolic tangent of x.
extern float tanhf(float x);
/// Returns the hyperbolic tangent of x.
float tanh(float x) { return tanhf(x); }
/// Returns the hyperbolic tangent of x.
float32 tanh(float32 x) { return float32(tanhf(float(x))); }

// Exponential and logarithmic functions.

/// Returns e raised to the power x.
extern float64 exp(float64 x);
/// Returns e raised to the power x.
extern float expf(float x);
/// Returns e raised to the power x.
float exp(float x) { return expf(x); }
/// Returns e raised to the power x.
float32 exp(float32 x) { return float32(expf(float(x))); }

/// Returns 2 raised to the power x.
extern float64 exp2(float64 x);
/// Returns 2 raised to the power x.
extern float exp2f(float x);
/// Returns 2 raised to the power x.
float exp2(float x) { return exp2f(x); }
/// Returns 2 raised to the power x.
float32 exp2(float32 x) { return float32(exp2f(float(x))); }

/// Returns the natural logarithm of x.
extern float64 log(float64 x);
/// Returns the natural logarithm of x.
extern float logf(float x);
/// Returns the natural logarithm of x.
float log(float x) { return logf(x); }
/// Returns the natural logarithm of x.
float32 log(float32 x) { return float32(logf(float(x))); }

/// Returns the base-2 logarithm of x.
extern float64 log2(float64 x);
/// Returns the base-2 logarithm of x.
extern float log2f(float x);
/// Returns the base-2 logarithm of x.
float log2(float x) { return log2f(x); }
/// Returns the base-2 logarithm of x.
float32 log2(float32 x) { return float32(log2f(float(x))); }

/// Returns the base-10 logarithm of x.
extern float64 log10(float64 x);
/// Returns the base-10 logarithm of x.
extern float log10f(float x);
/// Returns the base-10 logarithm of x.
float log10(float x) { return log10f(x); }
/// Returns the base-10 logarithm of x.
float32 log10(float32 x) { return float32(log10f(float(x))); }

// Power and root functions.

/// Returns x raised to the power y.
extern float64 pow(float64 x, float64 y);
/// Returns x raised to the power y.
extern float powf(float x, float y);
/// Returns x raised to the power y.
float pow(float x, float y) { return powf(x, y); }
/// Returns x raised to the power y.
float32 pow(float32 x, float32 y) { return float32(powf(float(x), float(y))); }

/// Returns the square root of x.
extern float64 sqrt(float64 x);
/// Returns the square root of x.
extern float sqrtf(float x);
/// Returns the square root of x.
float sqrt(float x) { return sqrtf(x); }
/// Returns the square root of x.
float32 sqrt(float32 x) { return float32(sqrtf(float(x))); }

/// Returns the cube root of x.
extern float64 cbrt(float64 x);
/// Returns the cube root of x.
extern float cbrtf(float x);
/// Returns the cube root of x.
float cbrt(float x) { return cbrtf(x); }
/// Returns the cube root of x.
float32 cbrt(float32 x) { return float32(cbrtf(float(x))); }

/// Returns the square root of the sum of the squares of x and y.
extern float64 hypot(float64 x, float64 y);
/// Returns the square root of the sum of the squares of x and y.
extern float hypotf(float x, float y);
/// Returns the square root of the sum of the squares of x and y.
float hypot(float x, float y) { return hypotf(x, y); }
/// Returns the square root of the sum of the squares of x and y.
float32 hypot(float32 x, float32 y) { return float32(hypotf(float(x), float(y))); }

// Rounding and remainder functions.

/// Rounds x up to an integer.
extern float64 ceil(float64 x);
/// Rounds x up to an integer.
extern float ceilf(float x);
/// Rounds x up to an integer.
float ceil(float x) { return ceilf(x); }
/// Rounds x up to an integer.
float32 ceil(float32 x) { return float32(ceilf(float(x))); }

/// Rounds x down to an integer.
extern float64 floor(float64 x);
/// Rounds x down to an integer.
extern float floorf(float x);
/// Rounds x down to an integer.
float floor(float x) { return floorf(x); }
/// Rounds x down to an integer.
float32 floor(float32 x) { return float32(floorf(float(x))); }

/// Rounds x toward zero to an integer.
extern float64 trunc(float64 x);
/// Rounds x toward zero to an integer.
extern float truncf(float x);
/// Rounds x toward zero to an integer.
float trunc(float x) { return truncf(x); }
/// Rounds x toward zero to an integer.
float32 trunc(float32 x) { return float32(truncf(float(x))); }

/// Rounds x to the nearest integer.
extern float64 round(float64 x);
/// Rounds x to the nearest integer.
extern float roundf(float x);
/// Rounds x to the nearest integer.
float round(float x) { return roundf(x); }
/// Rounds x to the nearest integer.
float32 round(float32 x) { return float32(roundf(float(x))); }

/// Returns the remainder of x/y.
extern float64 fmod(float64 x, float64 y);
/// Returns the remainder of x/y.
extern float fmodf(float x, float y);
/// Returns the remainder of x/y.
float fmod(float x, float y) { return fmodf(x, y); }
/// Returns the remainder of x/y.
float32 fmod(float32 x, float32 y) { return float32(fmodf(float(x), float(y))); }
