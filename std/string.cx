/// A non-owning string view.
struct string: Copyable, Comparable, Hashable, Printable {
    private ArrayRef<char> characters;

    /// Initializes a string of the given length at the given address.
    string(char* pointer, int length) {
        characters = ArrayRef(pointer, length);
    }

    /// Initializes a string referring to a null-terminated C-style string.
    ///
    /// __Note:__ This constructor has a time complexity of O(n) because it has to calculate the
    /// length of the argument string. If you know the length beforehand, consider using
    /// `string(char* pointer, int length)` instead.
    ///
    string(char* cString) {
        characters = ArrayRef(cString, int(strlen(cString)));
    }

    /// Initializes a string viewing the given buffer.
    string(StringBuffer* stringBuffer) {
        characters = ArrayRef(stringBuffer.data(), stringBuffer.size());
    }

    /// Returns true if the string has no characters.
    bool empty() {
        return characters.size() == 0;
    }

    /// Returns the number of characters.
    int size() {
        return characters.size();
    }

    /// Returns the first character.
    char front() {
        return characters.front();
    }

    /// Returns the character at the given index.
    char operator[](int index) {
        return characters[index];
    }

    /// Returns a pointer to the first character.
    char[*] data() {
        return characters.data();
    }

    /// Returns true if the string contains the given character.
    bool contains(char c) {
        return find(c, 0) != size();
    }

    /// Returns the index of the given character, or the size if it's not found.
    int find(char c) {
        return find(c, 0);
    }

    /// Returns the index of the given character, or the size if it's not found. Starts from `start`.
    private int find(char c, int start) {
        for i in start..size() {
            if characters[i] == c {
                return i;
            }
        }
        return size();
    }

    /// Returns the index of the given substring, or the size if it's not found.
    int find(string needle) {
        return find(needle, 0);
    }

    /// Returns the index of the given substring, or the size if it's not found. Starts from `start`.
    int find(string needle, int start) {
        for i in start..size() {
            if substr(i).startsWith(needle) {
                return i;
            }
        }
        return size();
    }

    /// Returns true if the string contains the given substring.
    bool contains(string needle) {
        return find(needle, 0) != size();
    }

    /// Returns the index of the given character, or the size if it's not found.
    int indexOf(char c) {
        return find(c, 0);
    }

    /// Returns the index of the given character, or the size if it's not found. Starts from `start`.
    int indexOf(char c, int start) {
        return find(c, start);
    }

    /// Returns the index of the given substring, or the size if it's not found.
    int indexOf(string needle) {
        return find(needle, 0);
    }

    /// Returns the index of the given substring, or the size if it's not found. Starts from `start`.
    int indexOf(string needle, int start) {
        return find(needle, start);
    }

    /// Returns true if the string starts with the given prefix.
    bool startsWith(string prefix) {
        if prefix.size() > size() {
            return false;
        }
        for index in 0..prefix.size() {
            if this[index] != prefix[index] {
                return false;
            }
        }
        return true;
    }

    /// Returns true if the string ends with the given suffix.
    bool endsWith(string suffix) {
        if suffix.size() > size() {
            return false;
        }
        for index in 0..suffix.size() {
            if this[size() - suffix.size() + index] != suffix[index] {
                return false;
            }
        }
        return true;
    }

    /// Returns the substring of the string starting from the given index, until the end of the string.
    string substr(int start) {
        if start < 0 || start > size() {
            indexOutOfBounds("substr", start);
        }
        return string(&characters.data()[start], size() - start);
    }

    /// Returns the substring of the string in the given range, [inclusive, exclusive]
    string substr(Range<int> range) {
        if range.start() < 0 || range.start() > size() {
            indexOutOfBounds("substr", range.start());
        }
        if range.end() < 0 || range.end() > size() {
            indexOutOfBounds("substr", range.end());
        }
        return string(&characters.data()[range.start()], range.size());
    }

    /// Supports using strings with sets and dicts
    uint64 hash() {
        uint64 hashValue = 5381;

        for index in 0..characters.size() {
            // djb2 wraps on overflow; compute in 128 bits and truncate instead.
            hashValue = uint64(uint128(hashValue << 5) + uint128(hashValue) + uint128(uint64(this[index])));
        }

        return hashValue;
    }

    /// Returns an iterator over the characters.
    StringIterator iterator() {
        return StringIterator(this);
    }

    /// Returns an iterator over each line in the string.
    LineIterator lines() {
        return LineIterator(this);
    }

    /// Returns an iterator over each byte in the string.
    ByteIterator bytes() {
        return ByteIterator(this);
    }

    /// Parses the string as an integer, or returns null.
    /// Supports an optional leading '+' or '-' sign and '0x', '0b', and '0o'
    /// base prefixes. Out-of-range values return null.
    int? parseInt() {
        if empty() {
            return null;
        }

        var index = 0;
        var negative = false;

        if this[index] == '+' || this[index] == '-' {
            negative = this[index] == '-';
            index++;
        }

        var base = 10;

        if index < size() && this[index] == '0' && index + 1 < size() {
            var prefix = this[index + 1];

            if prefix == 'x' || prefix == 'b' || prefix == 'o' {
                if prefix == 'x' {
                    base = 16;
                } else if prefix == 'b' {
                    base = 2;
                } else {
                    base = 8;
                }

                index += 2;
            }
        }

        // Accumulate a negative value so that int_min itself doesn't overflow.
        var limit = negative ? int_min : -int_max;
        var multmin = limit / base;
        var result = 0;
        var digits = 0;

        for i in index..size() {
            var c = this[i];
            var digit = -1;

            if c >= '0' && c <= '9' {
                digit = int(c - '0');
            } else if base == 16 && c >= 'a' && c <= 'f' {
                digit = int(c - 'a') + 10;
            } else if base == 16 && c >= 'A' && c <= 'F' {
                digit = int(c - 'A') + 10;
            }

            if digit < 0 || digit >= base {
                return null;
            }

            if result < multmin {
                return null;
            }

            result *= base;

            if result < limit + digit {
                return null;
            }

            result -= digit;
            digits++;
        }

        if digits == 0 {
            return null;
        }

        return negative ? result : -result;
    }

    // TODO: return iterator instead of eagerly allocating?
    /// Returns the string with special characters escaped.
    StringBuffer escape() {
        var result = StringBuffer();

        for c in this {
            switch c {
                case '\0': result += "\\0";
                case '\n': result += "\\n";
                case '\r': result += "\\r";
                case '\t': result += "\\t";
                case '\"': result += "\\\"";
                case '\\': result += "\\\\";
                default:   result += c;
            }
        }

        return result;
    }

    // TODO: Return non-allocating iterator instead of allocating a string buffer.
    /// Returns the string repeated the given number of times.
    StringBuffer repeat(int count) {
        var result = StringBuffer(capacity = this.size() * count);
        for _ in 0..count {
            result += this;
        }
        return result;
    }

    /// Writes this string to the given stream.
    void print(StringBuffer* stream) {
        stream.append(this);
    }

    /// Compares this string to another.
    Ordering compare(string* other) {
        for index in 0..min(size(), other.size()) {
            if this[index] < other[index] { return Ordering.Less; }
            if this[index] > other[index] { return Ordering.Greater; }
        }
        if size() < other.size() { return Ordering.Less; }
        if size() > other.size() { return Ordering.Greater; }
        return Ordering.Equal;
    }

    /// Returns true if all characters satisfy the predicate.
    bool all(bool(char) predicate) { return all(iterator(), predicate); }
    /// Returns true if any character satisfies the predicate.
    bool any(bool(char) predicate) { return any(iterator(), predicate); }
    /// Returns true if no character satisfies the predicate.
    bool none(bool(char) predicate) { return none(iterator(), predicate); }

    private void indexOutOfBounds(string function, int index) {
        abort("string.", function, ": index ", index, " is out of bounds, size is ", size());
    }
}

/// Returns true if both strings are equal.
bool operator==(string a, string b) {
    if a.size() != b.size() {
        return false;
    }

    for index in 0..a.size() {
        if a[index] != b[index] {
            return false;
        }
    }

    return true;
}

/// Returns true if both strings are equal.
bool operator==(char* a, string b) {
    return string(a) == b;
}

/// Returns true if both strings are equal.
bool operator==(string a, char* b) {
    return a == string(b);
}
