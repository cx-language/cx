/// A resizable string buffer.
struct StringBuf: Comparable, Hashable, Printable {
    // Stored characters, including a trailing null.
    private List<char> characters;

    /// Initializes an empty string.
    StringBuf() {
        characters = List();
        characters.push('\0');
    }

    /// Initializes an empty string with pre-allocated capacity.
    StringBuf(public int capacity) {
        init();
        characters.reserve(capacity + 1);
    }

    /// Initializes a string with the contents of the given string.
    StringBuf(string s) {
        characters = List(capacity = s.size() + 1);

        for ch in s {
            characters.push(ch);
        }

        characters.push('\0');
    }

    /// Initializes a string with the characters from a character array of known length.
    StringBuf(char* pointer, int length) {
        init(string(pointer, length));
    }

    /// Initializes a string with the contents of a null-terminated C-style string.
    ///
    /// __Note:__ This constructor has a time complexity of O(n) because it has to calculate the
    /// length of the argument string. If you know the length beforehand, consider using
    /// `StringBuf(char* pointer, int length)` instead.
    ///
    StringBuf(char* cString) {
        init(string(cString, int(strlen(cString))));
    }

    /// Initializes the buffer to contain the given number of uninitialized bytes.
    StringBuf(public int uninitializedSize) {
        characters = List(uninitializedSize = uninitializedSize + 1);
        characters[uninitializedSize] = '\0';
    }

    /// Returns the number of characters.
    int size() {
        return characters.size() - 1;
    }

    /// Returns the character at the given index.
    char operator[](int index) {
        if index < 0 || index >= size() indexOutOfBounds("operator[]", index);
        return characters[index];
    }

    /// Returns the character at the given offset from the end.
    /// Offset 1 is the last character; offsets outside 1..size() abort.
    char operator[-](int index) {
        if index < 1 || index > size() indexOutOfBounds("operator[-]", index);
        return characters[size() - index];
    }

    /// Sets the character at the given index.
    void operator[]=(int index, char c) {
        if index < 0 || index >= size() indexOutOfBounds("operator[]=", index);
        characters[index] = c;
    }

    /// Sets the character at the given offset from the end.
    /// Offset 1 is the last character; offsets outside 1..size() abort.
    void operator[-]=(int index, char c) {
        if index < 1 || index > size() indexOutOfBounds("operator[-]=", index);
        characters[size() - index] = c;
    }

    /// Returns the string as a C-style, i.e. null-terminated, string.
    /// Modifying `this` after calling this function invalidates the returned pointer.
    char* cString() {
        return data();
    }

    /// Returns a pointer to the first character in the string.
    char[*] data() {
        return characters.data();
    }

    /// Returns true if the string has no characters.
    bool empty() {
        return size() == 0;
    }

    /// Adds the given character to the end of the string.
    void push(char c) {
        characters[size()] = c;
        characters.push('\0');
    }

    /// Appends the given string.
    void append(string s) {
        // TODO: Optimize
        for ch in s {
            push(ch);
        }
    }

    /// Appends the printed form of the given value.
    void append<T: Printable>(T& value) {
        value.print(OutputStream(&this));
    }

    /// Appends the repetition without allocating a temporary.
    void append(RepeatIterator<string> repetitions) {
        for chunk in repetitions {
            append(chunk);
        }
    }

    /// Returns the number of characters the string can store without allocating more memory.
    int capacity() {
        return characters.capacity() - 1;
    }

    /// Ensures that the capacity is large enough to store the given number of characters.
    void reserve(int minimumCapacity) {
        characters.reserve(minimumCapacity + 1);
    }

    /// Removes all characters from the string, keeping the allocated buffer.
    void clear() {
        characters.clear();
        characters.push('\0');
    }

    /// Returns the first character.
    char first() {
        if empty() indexOutOfBounds("first", 0);
        return characters[0];
    }

    /// Returns the last character.
    char last() {
        if empty() indexOutOfBounds("last", 0);
        return characters[size() - 1];
    }

    /// Removes the first character from the string and returns it.
    /// Other characters are moved towards the beginning of the string by one index.
    char removeFirst() {
        if empty() indexOutOfBounds("removeFirst", 0);
        return characters.removeFirst();
    }

    /// Removes and returns the last character.
    char pop() {
        if empty() indexOutOfBounds("pop", 0);
        return characters.removeAt(characters.size() - 2);
    }

    /// Supports using strings with sets and dicts
    uint64 hash() {
        return string(this).hash();
    }

    /// Returns an iterator over the characters.
    StringIterator iterator() {
        return StringIterator(this);
    }

    /// Returns true if the string contains the given character.
    bool contains(char c) {
        return indexOf(c, 0) != null;
    }

    /// Returns the index of the given character, or null if it's not found.
    int? indexOf(char c) {
        return indexOf(c, 0);
    }

    /// Returns the index of the given character, or null if it's not found. Starts from `start`.
    int? indexOf(char c, int start) {
        for i in start..size() {
            if characters[i] == c {
                return i;
            }
        }
        return null;
    }

    /// Returns the substring of the string starting from the given index, until the end of the string.
    string substr(int start) {
        if start < 0 || start > size() {
            indexOutOfBounds("substr", start);
        }
        return string(&characters.data()[start], size() - start);
    }

    /// Returns the substring of the string in the given range, [inclusive, exclusive]
    string substr(Range<int> range) {
        if range.start() < 0 || range.start() > size() {
            indexOutOfBounds("substr", range.start());
        }
        if range.end() < 0 || range.end() > size() {
            indexOutOfBounds("substr", range.end());
        }
        return string(&characters.data()[range.start()], range.size());
    }

    // Splits the string by the given delimiter
    /// Splits the string by the given delimiter.
    List<string> split(char delim) {
        var tokens = List<string>();
        var prev = 0;
        var pos = 0;

        while true {
            pos = indexOf(delim, prev) ?? size();
            var token = substr(prev..pos);
            tokens.push(token);
            prev = pos + 1;

            if pos > size() || prev > size() {
                break;
            }
        }

        return tokens;
    }

    // Splits the string by whitespace
    /// Splits the string by spaces.
    List<string> split() {
        return split(' ');
    }

    /// Parses the string as an integer, or returns null.
    int? parseInt() {
        return string(this).parseInt();
    }

    /// Returns the string with special characters escaped.
    StringBuf escape() {
        return string(this).escape();
    }

    /// Writes this string to the given stream.
    void print(OutputStream& stream) {
        stream.append(string(this));
    }

    /// Compares this string to another.
    Ordering compare(StringBuf& other) {
        return string(this).compare(string(other));
    }

    // TODO: Remove these once implicit into-iterator conversions have been implemented.
    /// Returns true if all characters satisfy the predicate.
    bool all(bool(char&) predicate) { return all(iterator(), predicate); }
    /// Returns true if any character satisfies the predicate.
    bool any(bool(char&) predicate) { return any(iterator(), predicate); }
    /// Returns true if no character satisfies the predicate.
    bool none(bool(char&) predicate) { return none(iterator(), predicate); }

    private void indexOutOfBounds(string function, int index) {
        abort("StringBuf.", function, ": index ", index, " is out of bounds, size is ", size());
    }
}

/// Concatenates the two strings.
StringBuf operator+(string a, string b) {
    var result = StringBuf();

    for ch in a {
        result.push(ch);
    }

    for ch in b {
        result.push(ch);
    }

    return result;
}

/// Concatenates the string and the character.
StringBuf operator+(string a, char b) {
    return a + string(&b, 1);
}

/// Concatenates the two strings.
StringBuf operator+(string a, char[*] b) {
    return a + string(b);
}

/// Concatenates the two strings.
StringBuf operator+(StringBuf a, string b) {
    var result = a; // TODO: Workaround until parameters can be mutated.

    for ch in b {
        result.push(ch);
    }

    return result;
}

/// Concatenates the two strings.
StringBuf operator+(string a, StringBuf b) {
    var result = StringBuf(a);

    for ch in b {
        result.push(ch);
    }

    return result;
}

/// Concatenates the two strings.
StringBuf operator+(StringBuf a, StringBuf b) {
    var result = a; // TODO: Workaround until parameters can be mutated.

    for ch in b {
        result.push(ch);
    }

    return result;
}

/// Concatenates the string and the character.
StringBuf operator+(StringBuf a, char b) {
    var result = a; // TODO: Workaround until parameters can be mutated.
    result.push(b);
    return result;
}

/// Concatenates the two strings.
StringBuf operator+(StringBuf a, char[*] b) {
    return a + string(b);
}

/// Concatenates the repetition and the string.
StringBuf operator+(RepeatIterator<string> a, string b) {
    var result = StringBuf();
    for chunk in a {
        result.append(chunk);
    }
    result.append(b);
    return result;
}

/// Concatenates the string and the repetition.
StringBuf operator+(string a, RepeatIterator<string> b) {
    var result = StringBuf(a);
    for chunk in b {
        result.append(chunk);
    }
    return result;
}

/// Concatenates two repetitions.
StringBuf operator+(RepeatIterator<string> a, RepeatIterator<string> b) {
    var result = StringBuf();
    for chunk in a {
        result.append(chunk);
    }
    for chunk in b {
        result.append(chunk);
    }
    return result;
}

/// Returns true if both strings are equal.
bool operator==(StringBuf& a, StringBuf& b) {
    return string(a) == string(b);
}

/// Returns true if both strings are equal.
bool operator==(StringBuf& a, string b) {
    return string(a) == b;
}

/// Returns true if both strings are equal.
bool operator==(string a, StringBuf& b) {
    return a == string(b);
}

/// Returns true if both strings are equal.
bool operator==(char[*] a, StringBuf& b) {
    return string(a) == string(b);
}

/// Returns true if both strings are equal.
bool operator==(StringBuf& a, char[*] b) {
    return string(a) == string(b);
}
