/// Prints the given value followed by a newline.
void println<T>(T* value) {
    print(value);
    print('\n');
}

/// Prints the given value followed by a newline.
void println<T: Copyable>(T value) {
    print(value);
    print('\n');
}

/// Prints the given value followed by a newline.
void println(const char[*]? value) {
    print(value);
    print('\n');
}

/// Prints the given value followed by a newline.
void println(char[*]? value) {
    print(value);
    print('\n');
}

/// Prints the given value without allocating.
void print<T: Printable>(T value) {
    var stream = OutputStream();
    value.print(stream);
}

/// Prints the repetition without allocating a temporary.
void print(RepeatIterator<string> repetitions) {
    for chunk in repetitions {
        printf("%.*s", chunk.size(), chunk.data());
    }
}

/// Prints the given value without allocating.
void print<T: Printable>(T* value) {
    var stream = OutputStream();
    value.print(stream);
}

/// Prints the given value.
void print<T: Printable>(List<T>* list) {
    print(Slice(list));
}

/// Joins the array elements into a string with the given separator.
StringBuffer join<T: Printable>(Slice<T> array, string separator) {
    var result = StringBuffer();

    for index in 0..array.size() {
        if index != 0 {
            result.append(separator);
        }
        array[index].print(OutputStream(result));
    }

    return result;
}

/// Joins the list elements into a string with the given separator.
StringBuffer join<T: Printable>(List<T>* list, string separator) {
    return join(Slice(list), separator);
}

/// Returns the sum of the array elements, aborting on empty arrays.
T sum<T: Addable>(Slice<T> array) {
    if array.empty() {
        abort("Called sum() on empty array");
    }
    var total = array[0];

    for index in 1..array.size() {
        total += array[index];
    }

    return total;
}

/// Returns the sum of the list elements, aborting on empty lists.
T sum<T: Addable>(List<T>* list) {
    return sum(Slice(list));
}

/// Prints the given value.
void print<T: Printable>(Slice<T> array) {
    print('[');

    for index in 0..array.size() {
        print(array[index]);

        if index != array.size() - 1
            print(", ");
    }

    print(']');
}

/// Prints the given value without allocating.
void print(const char[*]? cString) {
    if cString {
        printf("%s", cString);
    } else {
        printf("null");
    }
}

/// Prints the given value without allocating.
void print(char[*]? cString) {
    if cString {
        printf("%s", cString);
    } else {
        printf("null");
    }
}

/// Prints the given values followed by a newline.
///
/// Copyable arguments pass by value so that a char prints as a single character
/// instead of decaying to a C string in print(). Calls with non-Copyable
/// arguments use the pointer overload below.
void println<T: Copyable>(T... args) {
    for arg in args {
        print(arg);
    }
    print('\n');
}

/// Prints the given values followed by a newline.
void println<T: Printable>(T*... args) {
    for arg in args {
        print(arg);
    }
    print('\n');
}

/// Reads a line from stdin.
StringBuffer readLine() {
    var line = StringBuffer();

    while true {
        var c = getchar();

        if c == '\n' || c < 0 {
            break;
        }

        line.append(char(c));
    }

    return line;
}

/// An error reading a file.
enum FileError : Printable {
    CouldNotOpen,

    /// Writes the error as text.
    void print(OutputStream* stream) {
        switch this {
            case CouldNotOpen: stream.append("couldn't open file");
        }
    }
}

/// Reads the entire file into a string, or returns an error if the file can't be opened.
Result<StringBuffer, FileError> readFile(string path) {
    var file = fopen(StringBuffer(path).cString(), "rb");
    if !file return Err(FileError.CouldNotOpen);
    defer fclose(file);

    fseek(file, 0, SEEK_END);
    var size = ftell(file);
    fseek(file, 0, SEEK_SET);

    var content = StringBuffer(uninitializedSize = int(size));
    fread(content.data(), sizeof(char), uint64(size), file);

    return Ok(content);
}

/// Writes the string to the named file.
bool writeFile(string path, string content) {
    var file = fopen(StringBuffer(path).cString(), "wb");
    if !file return false;
    defer fclose(file);

    fwrite(content.data(), sizeof(char), uint64(content.size()), file);
    return true;
}

/// Deletes the named file, returning true on success.
bool removeFile(string path) {
    return remove(StringBuffer(path).cString()) == 0;
}

/// Prints the message to stderr and aborts.
void assertFail(const char* message) {
    var stream = fdopen(2, "w");
    if stream {
        fprintf(stream, "%s", message);
        fclose(stream);
    }
    abortWrapper();
}
