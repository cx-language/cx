// TODO: Remove code duplication by declaring an 'Integer' interface that implements the 'compare'
// function for all integer types.

private void printSigned(int64 value, OutputStream& stream) {
    if value < 0 {
        stream.append('-');
        // Negate via value + 1 so that int64.min doesn't overflow.
        printUnsigned(uint64(-(value + 1)) + uint64(1), stream);
    } else {
        printUnsigned(uint64(value), stream);
    }
}

private void printUnsigned(uint64 value, OutputStream& stream) {
    char[20] digits = undefined;
    var count = 0;

    while true {
        digits[count] = char(uint64('0') + value % 10);
        value /= 10;
        count++;

        if value == 0 {
            break;
        }
    }

    while count > 0 {
        count--;
        stream.append(digits[count]);
    }
}

/// A signed integer.
struct int: Copyable, Comparable, Printable, Hashable, Addable {
    /// Largest value of this type.
    const int max = 2147483647;
    /// Smallest value of this type.
    const int min = -2147483648;

    /// Compares this value to another.
    Ordering compare(int& other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream.
    void print(OutputStream& stream) {
        printSigned(int64(this), stream);
    }

    /// Returns the hash of this value.
    uint64 hash() {
        return uint64(this);
    }
}

/// An 8-bit signed integer.
struct int8: Copyable, Comparable, Printable, Hashable, Addable {
    /// Largest value of this type.
    const int8 max = 127;
    /// Smallest value of this type.
    const int8 min = -128;

    /// Compares this value to another.
    Ordering compare(int8& other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream.
    void print(OutputStream& stream) {
        printSigned(int64(this), stream);
    }

    /// Returns the hash of this value.
    uint64 hash() {
        return uint64(this);
    }
}

