/// An 8-bit signed integer.
using sbyte = int8;

/// A 32-bit signed integer, the default type for integer literals.
using int = int32;

/// A 32-bit unsigned integer.
using uint = uint32;

/// An 8-bit unsigned integer.
using byte = uint8;
