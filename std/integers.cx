/// An unsigned integer.
struct uint: Copyable, Comparable, Printable, Hashable, Addable {
    /// Largest value of this type.
    const uint max = 4294967295;
    /// Smallest value of this type.
    const uint min = 0;

    /// Compares this value to another.
    Ordering compare(uint& other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream.
    void print(OutputStream& stream) {
        printUnsigned(uint64(this), stream);
    }

    /// Returns the hash of this value.
    uint64 hash() {
        return uint64(this);
    }
}

