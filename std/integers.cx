// TODO: Convert these to static members of the corresponding integer type:
/// Largest value of type int.
const int int_max = 2147483647;
/// Largest value of type int8.
const int8 int8_max = 127;
/// Largest value of type int16.
const int16 int16_max = 32767;
/// Largest value of type int32.
const int32 int32_max = 2147483647;
/// Largest value of type int64.
const int64 int64_max = 9223372036854775807;

/// Smallest value of type int.
const int int_min = -2147483648;
/// Smallest value of type int8.
const int8 int8_min = -128;
/// Smallest value of type int16.
const int16 int16_min = -32768;
/// Smallest value of type int32.
const int32 int32_min = -2147483648;
/// Smallest value of type int64.
const int64 int64_min = -9223372036854775808;

/// Largest value of type uint.
const uint uint_max = 4294967295;
/// Largest value of type uint8.
const uint8 uint8_max = 255;
/// Largest value of type uint16.
const uint16 uint16_max = 65535;
/// Largest value of type uint32.
const uint32 uint32_max = 4294967295;
/// Largest value of type uint64.
const uint64 uint64_max = 18446744073709551615;

/// Smallest value of type uint.
const uint uint_min = 0;
/// Smallest value of type uint8.
const uint8 uint8_min = 0;
/// Smallest value of type uint16.
const uint16 uint16_min = 0;
/// Smallest value of type uint32.
const uint32 uint32_min = 0;
/// Smallest value of type uint64.
const uint64 uint64_min = 0;

// TODO: Remove code duplication by declaring an 'Integer' interface that implements the 'compare'
// function for all integer types.

// TODO: Improve print() implementations: optimize + don't depend on libc.

private void printSigned(int64 value, StringBuffer* stream) {
    char[22] result = undefined;
    sprintf(result, "%lld", value);
    stream.write(string(result));
}

private void printUnsigned(uint64 value, StringBuffer* stream) {
    char[22] result = undefined;
    sprintf(result, "%llu", value);
    stream.write(string(result));
}

/// A signed integer.
struct int: Copyable, Comparable, Printable, Hashable {
    /// Compares this value to another.
    Ordering compare(int* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream.
    void print(StringBuffer* stream) {
        printSigned(int64(this), stream);
    }

    /// Returns the hash of this value.
    uint64 hash() {
        return uint64(this);
    }
}

