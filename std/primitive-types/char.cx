/// A single character.
struct char: Comparable, Printable, Hashable {
    /// Returns true if this is a letter.
    bool isAlpha() {
        return (this >= 'A' && this <= 'Z') || (this >= 'a' && this <= 'z');
    }

    /// Returns true if this is a digit.
    bool isDigit() {
        return this >= '0' && this <= '9';
    }

    /// Returns true if this is whitespace.
    bool isWhitespace() {
        return this == ' ' || (this >= char(0x9) && this <= char(0xD));
    }

    /// Returns the uppercase version of this character (ASCII only;
    /// other characters are returned unchanged).
    char toUpper() {
        if this >= 'a' && this <= 'z' {
            return char(int(this - 'a') + int('A'));
        }
        return this;
    }

    /// Returns the lowercase version of this character (ASCII only;
    /// other characters are returned unchanged).
    char toLower() {
        if this >= 'A' && this <= 'Z' {
            return char(int(this - 'A') + int('a'));
        }
        return this;
    }

    /// Compares this value to another.
    Ordering compare(char& other) {
        return int(this).compare(int(other));
    }

    /// Writes this value to the given stream.
    void print(OutputStream& stream) {
        stream.push(this);
    }

    /// Returns the hash of this value.
    uint64 hash() {
        return uint64(this);
    }
}
