// File system operations: existence checks, directories, renaming,
// the current directory, and directory listing.
// Lexical path manipulation without file system access lives in path.cx.

#if Windows
import "io.h";
#else
import "dirent.h";
#endif

#if Windows
private extern int _access(const char* path, int mode);
private extern int _mkdir(const char* path);
private extern int _rmdir(const char* path);
private extern char*? _getcwd(char*? buffer, uint64 size);
private extern int _chdir(const char* path);
#else
private extern int access(const char* path, int mode);
private extern int mkdir(const char* path, int mode);
private extern int rmdir(const char* path);
private extern char*? getcwd(char*? buffer, uint64 size);
private extern int chdir(const char* path);
#endif
private extern int rename(const char* oldName, const char* newName);

#if Windows
private bool pathExists(const char* path) { return _access(path, 0) == 0; }
#else
// The mode 0 is F_OK: check for existence without checking permissions.
private bool pathExists(const char* path) { return access(path, 0) == 0; }
#endif

/// Returns true if a file or directory exists at the path.
bool exists(string path) {
    return pathExists(StringBuffer(path).cString());
}

#if Windows
/// Creates a single directory, returning true on success.
bool createDirectory(string path) {
    return _mkdir(StringBuffer(path).cString()) == 0;
}
/// Removes an empty directory, returning true on success.
bool removeDirectory(string path) {
    return _rmdir(StringBuffer(path).cString()) == 0;
}
#else
/// Creates a single directory, returning true on success.
bool createDirectory(string path) {
    return mkdir(StringBuffer(path).cString(), 493) == 0; // 493 is 0o755.
}
/// Removes an empty directory, returning true on success.
bool removeDirectory(string path) {
    return rmdir(StringBuffer(path).cString()) == 0;
}
#endif

/// Removes the file, returning true on success.
bool remove(string path) {
    return remove(StringBuffer(path).cString()) == 0;
}

/// Renames a file or directory, returning true on success.
bool rename(string oldPath, string newPath) {
    return rename(StringBuffer(oldPath).cString(), StringBuffer(newPath).cString()) == 0;
}

#if Windows
/// Returns the current working directory.
StringBuffer currentDirectory() {
    var buffer = _getcwd(null, 0);
    if !buffer abort("couldn't get the current directory");
    defer free(cast<void*>(buffer));
    return StringBuffer(buffer);
}
/// Changes the current working directory, returning true on success.
bool changeDirectory(string path) {
    return _chdir(StringBuffer(path).cString()) == 0;
}
#else
/// Returns the current working directory.
StringBuffer currentDirectory() {
    var buffer = getcwd(null, 0);
    if !buffer abort("couldn't get the current directory");
    defer free(cast<void*>(buffer));
    return StringBuffer(buffer);
}
/// Changes the current working directory, returning true on success.
bool changeDirectory(string path) {
    return chdir(StringBuffer(path).cString()) == 0;
}
#endif

/// Returns the size of the file, or null if it can't be opened.
int64? fileSize(string path) {
    var file = fopen(StringBuffer(path).cString(), "rb");
    if !file return null;
    defer fclose(file);

    fseek(file, 0, SEEK_END);
    var size = ftell(file);
    return size;
}

#if Windows
/// Returns the names in the directory, sorted, or an empty list if it can't be opened.
List<StringBuffer> listDirectory(string path) {
    var result = List<StringBuffer>();
    var pattern = StringBuffer(path) + "/*";
    _finddata_t data = undefined;
    var handle = _findfirst(pattern.cString(), &data);
    if handle == -1 return result;
    defer _findclose(handle);

    while true {
        if data.name != "." && data.name != ".." {
            result.push(StringBuffer(data.name));
        }
        if _findnext(handle, &data) != 0 break;
    }

    sort(result);
    return result;
}
#else
/// Returns the names in the directory, sorted, or an empty list if it can't be opened.
List<StringBuffer> listDirectory(string path) {
    var result = List<StringBuffer>();
    var dir = opendir(StringBuffer(path).cString());
    if !dir return result;
    defer closedir(dir);

    while var entry = readdir(dir) {
        if entry.d_name == "." || entry.d_name == ".." continue;
        result.push(StringBuffer(entry.d_name));
    }

    sort(result);
    return result;
}
#endif
