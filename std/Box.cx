/// Owns a heap-allocated value.
struct Box<T> {
    /// Pointer to the owned value.
    private T* pointer;

    /// Moves the given value onto the heap.
    Box(T value) {
        this.pointer = allocate(value);
    }

//    Box(T* pointer) {
//        this.pointer = pointer;
//    }

    /// Frees the owned value.
    ~Box() {
        deallocate(pointer);
    }

    /// Returns a pointer to the owned value.
    T* get() {
        return pointer;
    }
}
