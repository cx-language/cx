/// A set of unique values.
struct Set<Key: Hashable> {
    private Map<Key, bool> map;

    /// Initializes an empty set
    Set() {
        map = Map();
    }

    /// Inserts an element into the set. If the element exists already, nothing is done.
    void insert(Key key) {
        if !map.contains(key) {
            map.insert(key, false);
        }
    }

    /// Removes an element from the set, returning true if it was there.
    bool remove(Key& key) {
        return map.remove(key) != null;
    }

    /// Removes all elements from the set.
    void clear() {
        map.clear();
    }

    /// Ensures that the bucket count is at least the given number.
    void reserve(int minimumCapacity) {
        map.reserve(minimumCapacity);
    }

    /// Returns true if all elements satisfy the predicate.
    bool all(bool(Key&) predicate) { return all(iterator(), predicate); }

    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any(bool(Key&) predicate) { return any(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none(bool(Key&) predicate) { return none(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    /// Checks if e is part of the set.
    bool contains(Key& key) {
        return map.contains(key);
    }

    /// Returns the number of elements.
    int size() {
        return map.size();
    }

    /// Returns true if the set has no elements.
    bool empty() {
        return map.empty();
    }

    /// Returns an iterator over the elements.
    SetIterator<Key> iterator() {
        return SetIterator(this);
    }
}

/// Iterates over the elements of a set.
struct SetIterator<Element>: Copyable, Iterator<Element&> {
    private MapIterator<Element, bool> iterator;

    /// Initializes an iterator over the given set.
    SetIterator(Set<Element>& set) {
        iterator = MapIterator(set.map);
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return iterator.hasValue();
    }

    /// Returns the current element.
    Element& value() {
        return iterator.value().key;
    }

    /// Advances to the next element.
    void increment() {
        iterator.increment();
    }
}
