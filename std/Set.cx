/// A set of unique values.
struct Set<Key: Hashable> {
    /// Underlying map.
    private Map<Key, bool> map;

    /// Initializes an empty set
    Set() {
        map = Map();
    }

    /// Inserts an element into the set. If the element exists already, nothing is done.
    void insert(Key key) {
        map.insert(key, false);
    }

    /// Removes an element from the set, if it exists there.
    void remove(Key* key) {
        map.remove(key);
    }

    /// Checks if e is part of the set.
    bool contains(Key* key) {
        return map.contains(key);
    }

    /// Returns the number of elements.
    int size() {
        return map.size();
    }

    /// Returns true if the set has no elements.
    bool empty() {
        return map.empty();
    }

    /// Returns an iterator over the elements.
    SetIterator<Key> iterator() {
        return SetIterator(this);
    }
}

/// Iterates over the elements of a set.
struct SetIterator<Element>: Copyable, Iterator<Element*> {
    /// Underlying map iterator.
    private MapIterator<Element, bool> iterator;

    /// Initializes an iterator over the given set.
    SetIterator(Set<Element>*  set) {
        iterator = MapIterator(set.map);
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return iterator.hasValue();
    }

    /// Returns the current element.
    Element* value() {
        return iterator.value().key;
    }

    /// Advances to the next element.
    void increment() {
        iterator.increment();
    }
}
