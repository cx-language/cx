/// Iterates over the bytes of a string.
struct ByteIterator: Copyable, Iterator<uint8> {
    private string stream;

    /// Initializes an iterator over the given string.
    ByteIterator(string stream) {
        this.stream = stream;
    }

    /// Returns true if there are more bytes.
    bool hasValue() {
        return !stream.empty();
    }

    /// Returns the current byte.
    uint8 value() {
        return uint8(stream.front());
    }

    /// Advances to the next byte.
    void increment() {
        stream = stream.substr(1);
    }

    /// Collects the remaining bytes into a list.
    List<uint8> toList() {
        var output = List<uint8>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }

    /// Returns itself.
    ByteIterator iterator() {
        return this;
    }
}
