// Lazily keeps the elements of another iterator that satisfy a predicate.
// Get one from filter(); collect the results with toList().
struct FilterIterator<Input, It>: Iterator<Input*> {
    private It source;
    private bool(Input) include;

    /// Initializes an iterator keeping the source's matching elements.
    FilterIterator(It source, bool(Input) include) {
        this.source = source;
        this.include = include;
    }

    /// Returns true if there are more matching elements.
    bool hasValue() {
        while source.hasValue() {
            if include(*source.value()) {
                return true;
            }
            source.increment();
        }
        return false;
    }

    /// Returns the next matching element.
    Input* value() {
        return source.value();
    }

    /// Advances past the current element.
    void increment() {
        source.increment();
    }

    /// Lazily transforms the elements.
    MappedIterator<Output, Input, FilterIterator<Input, It>> map<Output>(Output(Input) transform) {
        return MappedIterator(*this, transform);
    }

    /// Collects the remaining elements into a list.
    List<Input> toList() {
        var output = List<Input>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }
}
