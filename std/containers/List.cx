/// A resizable array.
//
// Move-out paths (pop, removeAt/removeFirst, reserve) never destroy the
// abandoned source slot. For owned Element the extraction moves, leaving
// the slot dead; for Copyable Element the live copy left behind is
// trivially destructible (Copyable types declare no destructor and hold
// no destructible fields), so there is nothing to run. The old buffer in
// reserve is always freed wholesale.
struct List<Element> {
    private Element[*] buffer;
    private int size;
    private int capacity;

    /// Initializes an empty list.
    List() {
        buffer = undefined;
        size = 0;
        capacity = 0;
    }

    /// Initializes an empty list with pre-allocated capacity.
    List(public int capacity) {
        init();
        reserve(capacity);
    }

    /// Initializes a list containing `size` copies of the given value.
    List(int size, Element value) {
        init(capacity = size);

        for i in 0..size {
            push(value);
        }
    }

    /// Initializes a list containing copies of the elements of the given array.
    /// The element type must be Copyable; push owning values one at a time.
    List(Element[] elements) {
        init(capacity = elements.size());
        append(elements);
    }

    /// Initializes the list to contain the given number of uninitialized elements.
    List(public int uninitializedSize) {
        buffer = allocate<Element>(uninitializedSize);
        size = uninitializedSize;
        capacity = uninitializedSize;
    }

    /// Frees the elements and backing storage.
    ~List() {
        if capacity != 0 {
            for element in this {
                element.deinit();
            }
            deallocate(buffer);
        }
    }

    /// Moves the list out, leaving an empty list in its place.
    List<Element> take() {
        return takeFrom(&this, List());
    }

    /// Returns the number of elements in the list.
    int size() {
        return size;
    }

    /// Writes the elements to the given stream.
    void print(OutputStream& stream) {
        Slice(this).print(stream);
    }

    /// Returns true if the list has no elements, otherwise false
    bool empty() {
        return size == 0;
    }

    /// Returns the number of elements the list can store without allocating more memory.
    int capacity() {
        return capacity;
    }

    /// Returns the element at the given index.
    /// Returns the element at the given index.
    Element& operator[](int index) {
        assert(index >= 0 && index < size, "List index out of bounds");

        return buffer[index];
    }

    /// Returns a reference to the element at the given offset from the end.
    /// Offset 1 is the last element; out-of-bounds access aborts in debug and release-safe builds.
    Element& operator[-](int index) {
        assert(index >= 1 && index <= size, "List index out of bounds");

        return buffer[size - index];
    }

    /// Sets the element at the given index.
    void operator[]=(int index, Element element) {
        assert(index >= 0 && index < size, "List index out of bounds");
        buffer[index] = element;
    }

    /// Sets the element at the given offset from the end.
    /// Offset 1 is the last element; out-of-bounds access aborts in debug and release-safe builds.
    void operator[-]=(int index, Element element) {
        assert(index >= 1 && index <= size, "List index out of bounds");
        buffer[size - index] = element;
    }

    /// Returns the first element.
    Element& first() {
        assert(size != 0, "Called first() on empty List");
        return buffer[0];
    }

    /// Returns the last element.
    Element& last() {
        assert(size != 0, "Called last() on empty List");
        return buffer[size - 1];
    }

    /// Returns a pointer to the first element.
    Element[*] data() {
        return buffer;
    }

    /// Adds the given element to the end of the list, returning a reference to it.
    Element& push(Element element) {
        if size == capacity {
            grow();
        }

        buffer[size].init(element);
        size++;
        return buffer[size - 1];
    }

    /// Adds all elements from the given array to the end of the list.
    /// Copies each element, so the element type must be Copyable.
    // TODO: this function should only be available if Element is Copyable.
    void append(Element[] elements) {
        assert(uint64(size) + uint64(elements.size()) <= uint64(int.max), "List size overflow");
        reserve(size + elements.size());
        memcpy(&buffer[size], elements.data(), c_size_t(sizeof(Element) * elements.size()));
        size += elements.size();
    }

    /// Ensures that the capacity is large enough to store the given number of elements.
    void reserve(int minimumCapacity) {
        if minimumCapacity > capacity {
            var newBuffer = allocate<Element>(count = minimumCapacity);
            memcpy(newBuffer, buffer, c_size_t(sizeof(Element) * size));
            if capacity != 0 {
                deallocate(buffer);
            }
            buffer = newBuffer;
            capacity = minimumCapacity;
        }
    }

    /// Removes the first element from the list and returns it.
    /// Other elements are moved towards the beginning of the list by one index.
    Element removeFirst() {
        assert(size != 0, "Called removeFirst() on empty List");
        return unsafeRemoveAt(0);
    }

    /// Removes the first element satisfying the given condition and returns it, or null if none matches.
    Element? removeFirst(bool(Element&) shouldRemove) {
        for index in 0..size {
            if shouldRemove(this[index]) {
                return unsafeRemoveAt(index);
            }
        }

        return null;
    }

    /// Removes the first element satisfying the given condition and returns it, or null if none matches.
    Element? removeFirst<T: Copyable>(bool(T) shouldRemove) {
        for index in 0..size {
            if shouldRemove(this[index]) {
                return unsafeRemoveAt(index);
            }
        }

        return null;
    }

    /// Removes and returns the last element.
    Element pop() {
        assert(size != 0, "Called pop() on empty List");
        size--;
        return buffer[size];
    }

    /// Removes the last element from the list.
    void removeLast() {
        assert(size != 0, "Called removeLast() on empty List");
        size--;
        buffer[size].deinit();
    }

    /// Removes all elements from the list, keeping the allocated buffer.
    void clear() {
        for i in 0..size {
            buffer[i].deinit();
        }
        size = 0;
    }

    /// Removes the element at the given index from the list and returns it.
    /// Elements following the removed element are moved towards the beginning of the list by one index.
    Element removeAt(int index) {
        assert(index >= 0 && index < size, "List index out of bounds");

        return unsafeRemoveAt(index);
    }

    private Element unsafeRemoveAt(int index) {
        var removed = buffer[index];

        for i in (index + 1)..size {
            var source = &buffer[i];
            var target = &buffer[i - 1];
            target.init(*source);
        }

        size--;
        return removed;
    }

    /// Returns true if the list contains an element equal to the given value.
    bool contains(Element& value) {
        return indexOf(value) != null;
    }

    /// Returns the index of the first element equal to the given value, or null if it's not found.
    int? indexOf(Element& value) {
        for i in 0..size {
            if buffer[i] == value {
                return i;
            }
        }
        return null;
    }

    /// Returns an iterator over the elements.
    ArrayIterator<Element> iterator() {
        return ArrayIterator(this);
    }

    /// Returns an iterator over the elements with their indices.
    EnumeratedIterator<Element> enumerate() {
        return EnumeratedIterator(iterator());
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find(bool(Element&) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find<T: Copyable>(bool(T) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, ArrayIterator<Element>, Output(Element&)> map<Output>(Output(Element&) transform) {
        return MappedIterator<Output, Element, ArrayIterator<Element>, Output(Element&)>(iterator(), transform);
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, ArrayIterator<Element>, Output(T)> map<Output, T: Copyable>(Output(T) transform) {
        return MappedIterator<Output, Element, ArrayIterator<Element>, Output(T)>(iterator(), transform);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, ArrayIterator<Element>, bool(Element&)> filter(bool(Element&) include) {
        return FilterIterator<Element, ArrayIterator<Element>, bool(Element&)>(iterator(), include);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, ArrayIterator<Element>, bool(T)> filter<T: Copyable>(bool(T) include) {
        return FilterIterator<Element, ArrayIterator<Element>, bool(T)>(iterator(), include);
    }

    /// Lazily appends another iterator's elements. Collect the results with toList().
    ChainIterator<Element, ArrayIterator<Element>, Other> chain<Other>(Other other) {
        return ChainIterator(iterator(), other);
    }

    // TODO: Remove these once implicit into-iterator conversions have been implemented.
    /// Returns the sum of the elements, or zero if there are none.
    Element sum() { return iterator().sum(); }

    /// Returns true if all elements satisfy the predicate.
    bool all(bool(Element&) predicate) { return all(iterator(), predicate); }
    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any(bool(Element&) predicate) { return any(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none(bool(Element&) predicate) { return none(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    private void grow() {
        if capacity == 0 {
            reserve(1);
        } else {
            assert(capacity <= int.max / 2, "List capacity overflow");
            reserve(capacity * 2);
        }
    }

}

/// Returns true if both lists have equal elements.
bool operator==<T>(List<T>& a, List<T>& b) {
    return Slice(a) == Slice(b);
}
