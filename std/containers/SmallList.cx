/// A resizable array that stores up to `N` elements inline, spilling to the heap
/// when it grows past that. Like `List`, but avoids heap allocation while small.
//
// Move-out paths (pop, removeAt/removeFirst, reserve) never destroy the
// abandoned source slot: the extraction moves owned payloads out (see
// moveOut), and Copyable payloads left behind are trivially destructible
// (Copyable types declare no destructor and hold no destructible fields),
// so there is nothing to run.
struct SmallList<Element, int N> {
    // Inline slots; the first `size` hold live values while inline, the rest
    // are uninitialized. Manually destroyed: the destructor deinits only the
    // live prefix.
    @manuallyDestroy private Element[N] inlineStorage;
    // Heap spill buffer, allocated once size exceeds N. Undefined while inline.
    private Element[*] heapBuffer;
    private int size;
    // Heap capacity, or 0 while using inline storage.
    private int heapCapacity;

    /// Initializes an empty list.
    SmallList() {
        inlineStorage = undefined;
        heapBuffer = undefined;
        size = 0;
        heapCapacity = 0;
    }

    /// Initializes a list containing `size` copies of the given value.
    SmallList(int size, Element value) {
        init();
        reserve(size);
        for i in 0..size {
            push(value);
        }
    }

    /// Initializes a list containing the elements of the given array.
    /// Copies each element, so the element type must be Copyable.
    SmallList(Element[] elements) {
        init();
        append(elements);
    }

    /// Frees the elements and backing storage.
    ~SmallList() {
        clear();
        if onHeap() {
            deallocate(heapBuffer);
        }
    }

    /// Moves the list out, leaving an empty list in its place.
    SmallList<Element, N> take() {
        return takeFrom(&this, SmallList());
    }

    /// Returns the number of elements in the list.
    int size() {
        return size;
    }

    /// Writes the elements to the given stream.
    void print(OutputStream& stream) {
        stream.push('[');
        for elem, index in this {
            if index != 0 {
                stream.append(", ");
            }
            elem.print(stream);
        }
        stream.push(']');
    }

    /// Returns true if the list has no elements, otherwise false.
    bool empty() {
        return size == 0;
    }

    /// Returns the number of elements the list can store without allocating more memory.
    int capacity() {
        return onHeap() ? heapCapacity : N;
    }

    /// Returns the element at the given index.
    Element& operator[](int index) {
        assert(index >= 0 && index < size, "SmallList index out of bounds");
        return *slot(index);
    }

    /// Sets the element at the given index.
    void operator[]=(int index, Element element) {
        assert(index >= 0 && index < size, "SmallList index out of bounds");
        *slot(index) = element;
    }

    /// Returns a reference to the element at the given offset from the end.
    /// Offset 1 is the last element; out-of-bounds access aborts in debug and release-safe builds.
    Element& operator[-](int index) {
        assert(index >= 1 && index <= size, "SmallList index out of bounds");

        return this[size - index];
    }

    /// Sets the element at the given offset from the end.
    /// Offset 1 is the last element; out-of-bounds access aborts in debug and release-safe builds.
    void operator[-]=(int index, Element element) {
        assert(index >= 1 && index <= size, "SmallList index out of bounds");
        this[size - index] = element;
    }

    /// Returns the first element.
    Element& first() {
        assert(size != 0, "Called first() on empty SmallList");
        return this[0];
    }

    /// Returns the last element.
    Element& last() {
        assert(size != 0, "Called last() on empty SmallList");
        return this[size - 1];
    }

    /// Returns a pointer to the first element.
    Element[*] data() {
        if onHeap() {
            return heapBuffer;
        }
        return inlineStorage.data();
    }

    /// Adds the given element to the end of the list, returning a reference to it.
    Element& push(Element element) {
        if size == capacity() {
            grow();
        }
        slot(size).init(element);
        size++;
        return this[size - 1];
    }

    /// Removes and returns the last element.
    Element pop() {
        assert(size != 0, "Called pop() on empty SmallList");
        size--;
        return moveOut(size);
    }

    /// Adds all elements from the given array to the end of the list.
    /// Copies each element, so the element type must be Copyable.
    void append(Element[] elements) {
        if elements.empty() return;
        reserve(size + elements.size());
        for element in elements {
            push(element);
        }
    }

    /// Ensures that the capacity is large enough to store the given number of elements.
    void reserve(int minimumCapacity) {
        if minimumCapacity <= capacity() return;

        var newBuffer = allocate<Element>(count = minimumCapacity);

        for i in 0..size {
            (&newBuffer[i]).init(*slot(i));
        }

        if onHeap() {
            deallocate(heapBuffer);
        }

        heapBuffer = newBuffer;
        heapCapacity = minimumCapacity;
    }

    /// Removes the first element from the list and returns it.
    /// Other elements are moved towards the beginning of the list by one index.
    Element removeFirst() {
        assert(size != 0, "Called removeFirst() on empty SmallList");
        return unsafeRemoveAt(0);
    }

    /// Removes the first element satisfying the given condition and returns it, or null if none matches.
    Element? removeFirst(bool(Element&) shouldRemove) {
        for index in 0..size {
            if shouldRemove(this[index]) {
                return unsafeRemoveAt(index);
            }
        }

        return null;
    }

    /// Removes the first element satisfying the given condition and returns it, or null if none matches.
    Element? removeFirst<T: Copyable>(bool(T) shouldRemove) {
        for index in 0..size {
            if shouldRemove(this[index]) {
                return unsafeRemoveAt(index);
            }
        }

        return null;
    }

    /// Removes the last element from the list.
    void removeLast() {
        assert(size != 0, "Called removeLast() on empty SmallList");
        size--;
        (*slot(size)).deinit();
    }

    /// Removes all elements from the list, keeping the allocated buffer.
    void clear() {
        for element in this {
            element.deinit();
        }
        size = 0;
    }

    /// Removes the element at the given index from the list and returns it.
    /// Elements following the removed element are moved towards the beginning of the list by one index.
    Element removeAt(int index) {
        assert(index >= 0 && index < size, "SmallList index out of bounds");

        return unsafeRemoveAt(index);
    }

    private Element unsafeRemoveAt(int index) {
        var removed = moveOut(index);

        for i in (index + 1)..size {
            slot(i - 1).init(*slot(i));
        }

        size--;
        return removed;
    }

    /// Returns true if the list contains an element equal to the given value.
    bool contains(Element& value) {
        return indexOf(value) != null;
    }

    /// Returns the index of the first element equal to the given value, or null if it's not found.
    int? indexOf(Element& value) {
        for i in 0..size {
            if this[i] == value {
                return i;
            }
        }
        return null;
    }

    /// Returns an iterator over the elements.
    SmallListIterator<Element, N> iterator() {
        return SmallListIterator(this);
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find(bool(Element&) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find<T: Copyable>(bool(T) predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, SmallListIterator<Element, N>, Output(Element&)> map<Output>(Output(Element&) transform) {
        return MappedIterator<Output, Element, SmallListIterator<Element, N>, Output(Element&)>(iterator(), transform);
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, SmallListIterator<Element, N>, Output(T)> map<Output, T: Copyable>(Output(T) transform) {
        return MappedIterator<Output, Element, SmallListIterator<Element, N>, Output(T)>(iterator(), transform);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, SmallListIterator<Element, N>, bool(Element&)> filter(bool(Element&) include) {
        return FilterIterator<Element, SmallListIterator<Element, N>, bool(Element&)>(iterator(), include);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, SmallListIterator<Element, N>, bool(T)> filter<T: Copyable>(bool(T) include) {
        return FilterIterator<Element, SmallListIterator<Element, N>, bool(T)>(iterator(), include);
    }

    /// Lazily appends another iterator's elements. Collect the results with toList().
    ChainIterator<Element, SmallListIterator<Element, N>, Other> chain<Other>(Other other) {
        return ChainIterator(iterator(), other);
    }

    // TODO: Remove these once implicit into-iterator conversions have been implemented.
    /// Returns the sum of the elements, or zero if there are none.
    Element sum() { return iterator().sum(); }

    /// Returns true if all elements satisfy the predicate.
    bool all(bool(Element&) predicate) { return all(iterator(), predicate); }
    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any(bool(Element&) predicate) { return any(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none(bool(Element&) predicate) { return none(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    /// Returns a pointer to the slot holding the element at the given index.
    private Element* slot(int index) {
        if onHeap() {
            return &heapBuffer[index];
        }
        return &inlineStorage[index];
    }

    /// Moves the element out of its slot. The caller must shrink the live
    /// range past the slot, as the shift in removeAt does. (Explicit `*`
    /// moves are rejected; only placement `init` may move out of a
    /// dereference, so this copies bytes instead.)
    private Element moveOut(int index) {
        Element value = undefined;
        memcpy(&value, slot(index), c_size_t(sizeof(Element)));
        return value;
    }

    private bool onHeap() {
        return heapCapacity != 0;
    }

    private void grow() {
        reserve(capacity() == 0 ? 1 : capacity() * 2);
    }

}

/// Iterates over the elements of a small list.
struct SmallListIterator<Element, int N>: Iterator<Element&> {
    private SmallList<Element, N>* list;
    private int index;

    /// Initializes an iterator over the given list.
    SmallListIterator(SmallList<Element, N>& list) {
        this.list = &list;
        this.index = 0;
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return index < list.size();
    }

    /// Returns the current element.
    Element& value() {
        return list[index];
    }

    /// Advances to the next element.
    void increment() {
        index++;
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    Element sum() {
        return sumRemaining(*this, Element(0));
    }

    /// Collects the remaining elements into a list by copying them; only sound for Copyable elements.
    List<Element> toList() {
        var output = List<Element>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }
}

/// Returns true if both lists have equal elements.
bool operator==<T, int M, int N>(SmallList<T, M>& a, SmallList<T, N>& b) {
    if a.size() != b.size() return false;
    for x, i in a {
        if x != b[i] return false;
    }
    return true;
}
