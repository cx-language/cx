/// A non-owning reference to a contiguous array of elements.
struct Slice<Element> {
    private Element[*] data;
    private int size;

    /// Initializes a Slice referring to an empty array.
    Slice() {
        data = undefined;
        size = 0;
    }

    /// Initializes a Slice referring to the elements of the given List.
    implicit Slice(List<Element>& list) {
        data = list.data();
        size = list.size();
    }

    /// Initializes a Slice referring to an array of the given size located at the given memory
    /// address.
    Slice(Element* data, int size) {
        this.data = data;
        this.size = size;
    }

    /// Returns true if the array has no elements.
    bool empty() {
        return size == 0;
    }

    /// Returns the number of elements in the array.
    int size() {
        return size;
    }

    /// Returns the first element in the array.
    Element& first() {
        assert(!empty(), "Called first() on empty Slice");
        return data[0];
    }

    /// Returns the last element in the array.
    Element& last() {
        assert(!empty(), "Called last() on empty Slice");
        return data[size() - 1];
    }

    /// Returns true if the array contains an element equal to the given value.
    bool contains(Element& value) {
        return indexOf(value) != null;
    }

    /// Returns the index of the first element equal to the given value, or null if it's not found.
    int? indexOf(Element& value) {
        for i in 0..size() {
            if data[i] == value {
                return i;
            }
        }
        return null;
    }

    /// Returns a reference to the element at the given index.
    Element& operator[](int index) {
        assert(index >= 0 && index < size(), "Slice index out of bounds");
        return data[index];
    }

    /// Returns a reference to the element at the given offset from the end.
    /// Offset 1 is the last element; out-of-bounds access aborts in debug and release-safe builds.
    Element& operator[-](int index) {
        assert(index >= 1 && index <= size(), "Slice index out of bounds");
        return data[size() - index];
    }

    /// Returns a pointer to the first element.
    Element[*] data() {
        return data;
    }

    /// Returns an iterator over the elements.
    ArrayIterator<Element> iterator() {
        return ArrayIterator(this);
    }

    /// Writes the elements to the given stream.
    void print(OutputStream& stream) {
        stream.push('[');
        for elem, index in this {
            if index != 0 {
                stream.append(", ");
            }
            elem.print(stream);
        }
        stream.push(']');
    }

    /// Returns an iterator over the elements with their indices.
    EnumeratedIterator<Element> enumerate() {
        return EnumeratedIterator(iterator());
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, ArrayIterator<Element>, Pred> map<Output, Pred: Output(Element&)>(Pred transform) {
        return MappedIterator<Output, Element, ArrayIterator<Element>, Pred>(iterator(), transform);
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, Element, ArrayIterator<Element>, Pred> map<Output, T: Copyable, Pred: Output(T)>(Pred transform) {
        return MappedIterator<Output, Element, ArrayIterator<Element>, Pred>(iterator(), transform);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, ArrayIterator<Element>, Pred> filter<Pred: bool(Element&)>(Pred include) {
        return FilterIterator<Element, ArrayIterator<Element>, Pred>(iterator(), include);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<Element, ArrayIterator<Element>, Pred> filter<T: Copyable, Pred: bool(T)>(Pred include) {
        return FilterIterator<Element, ArrayIterator<Element>, Pred>(iterator(), include);
    }

    /// Lazily appends another iterator's elements. Collect the results with toList().
    ChainIterator<Element, ArrayIterator<Element>, Other> chain<Other>(Other other) {
        return ChainIterator<Element, ArrayIterator<Element>, Other>(iterator(), other);
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find<Pred: bool(Element&)>(Pred predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Returns the first element satisfying the predicate, or null.
    Element&? find<T: Copyable, Pred: bool(T)>(Pred predicate) {
        for i in 0..size() {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    // TODO: Remove these once implicit into-iterator conversions have been implemented.
    /// Returns the sum of the elements, or zero if there are none.
    Element sum() { return iterator().sum(); }

    /// Returns true if all elements satisfy the predicate.
    bool all<Pred: bool(Element&)>(Pred predicate) { return all(iterator(), predicate); }
    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable, Pred: bool(T)>(Pred predicate) { return all(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any<Pred: bool(Element&)>(Pred predicate) { return any(iterator(), predicate); }
    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable, Pred: bool(T)>(Pred predicate) { return any(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none<Pred: bool(Element&)>(Pred predicate) { return none(iterator(), predicate); }
    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable, Pred: bool(T)>(Pred predicate) { return none(iterator(), predicate); }

}

/// Returns true if both arrays have equal elements.
bool operator==<T>(Slice<T> a, Slice<T> b) {
    if a.size() != b.size() {
        return false;
    }

    for x, i in a {
        if x != b[i] {
            return false;
        }
    }

    return true;
}
