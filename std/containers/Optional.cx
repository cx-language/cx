/// A value that may be absent.
enum Optional<T> {
    None,
    Some(T value),

    /// Writes the value, or null if there is none, to the given stream.
    void print(OutputStream& stream) {
        switch this {
            case None:
                stream.append("null");
            case Some value:
                value.print(stream);
        }
    }

    /// Moves the optional out, leaving None in its place.
    /// Always call this on a pointer (`(&opt).take()`): a plain `opt.take()`
    /// unwraps and takes the payload instead, or fails to compile if the
    /// payload has no `take()` method.
    Optional<T> take() {
        Optional<T> none = None;
        return takeFrom(this, none);
    }
}

/// Returns true if both optionals are equal.
bool operator== <T: Comparable>(Optional<T>& a, Optional<T>& b) {
    if ((*a == null) != (*b == null)) return false;
    if (*b == null) return true;
    return (*a)! == (*b)!;
}

/// Returns true if the optional holds a value equal to b.
bool operator== <T: Comparable>(Optional<T>& a, T& b) {
    if (*a == null) return false;
    return (*a)! == *b;
}

/// Returns true if the optional holds a value equal to a.
bool operator== <T: Comparable>(T& a, Optional<T>& b) {
    if (*b == null) return false;
    return *a == (*b)!;
}

/// Returns true if the optional pointer is non-null and points to a value equal to b.
bool operator== <T: Comparable>(Optional<T*>& a, T& b) {
    if (*a == null) return false;
    return *(*a) == *b;
}

/// Returns true if the optional pointer is non-null and points to a value equal to a.
bool operator== <T: Comparable>(T& a, Optional<T*>& b) {
    if (*b == null) return false;
    return *a == *(*b);
}

/// Returns true if the optional borrow is non-null and borrows a value equal to b.
bool operator== <T: Comparable>(T&? a, T& b) {
    // The null check narrows `a` to the payload, so no unwrap is needed.
    if a == null return false;
    return a == *b;
}

/// Returns true if the optional borrow is non-null and borrows a value equal to a.
bool operator== <T: Comparable>(T& a, T&? b) {
    // The null check narrows `b` to the payload, so no unwrap is needed.
    if b == null return false;
    return *a == b;
}

/// Prints the given value.
void print<T: Printable>(Optional<T>& optional) {
    var stream = OutputStream();
    optional.print(stream);
}

/// Prints the given optional borrow.
void print<T: Printable>(T&? optional) {
    var stream = OutputStream();
    if optional == null {
        stream.append("null");
    } else {
        optional.print(stream);
    }
}

/// Prints the given optional borrow followed by a newline.
void println<T: Printable>(T&? optional) {
    print(optional);
    print('\n');
}
