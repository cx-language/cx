/// A key-value pair stored in a map.
struct MapEntry<Key: Hashable, Value> {
    /// The entry's key.
    Key key;
    /// The entry's value.
    Value value;
}

/// A hash map from keys to values.
struct Map<Key: Hashable, Value> {
    private List<List<MapEntry<Key, Value>>> hashTable;
    private int size;

    /// Initializes an empty map
    Map() {
        size = 0;
        hashTable = createTable(128);
    }

    /// Allocates a bucket table, constructing each bucket in place. Buckets
    /// cannot come from the fill constructor: moving one value into every
    /// bucket would consume it on the first iteration.
    private List<List<MapEntry<Key, Value>>> createTable(int bucketCount) {
        var table = List<List<MapEntry<Key, Value>>>();
        table.reserve(bucketCount);
        for i in 0..bucketCount {
            table.push(List());
        }
        return table;
    }

    /// Moves the map out, leaving an empty map in its place.
    Map<Key, Value> take() {
        return takeFrom(&this, Map());
    }

    /// Inserts an element into the map. The key must not already be in the map.
    void insert(Key key, Value value) {
        assert(!contains(key));

        var hashValue = convertHash(key.hash()) % capacity();
        hashTable[hashValue].push(MapEntry(key, value));
        size++;

        if loadFactor() > 0.66 {
            resize();
        }
    }

    /// Inserts, or updates an existing value.
    void set(Key key, Value value) {
        if this[key] == null {
            insert(key, value);
        } else {
            *this[key]! = value;
            // The key moves into the map on the other path; consume it here too, since
            // values moved on only one path are still destroyed at scope end.
            drop(key);
        }
    }

    /// Removes an element from the map, returning its value, or null if it isn't there.
    Value? remove(Key& e) {
        var hashValue = convertHash(e.hash()) % capacity();
        var slot = &hashTable[hashValue];

        for entry, i in slot {
            if entry.key == *e {
                // Move the value out of the removed entry in place: naming the
                // entry would require `.take()`, which generic values may not provide.
                size--;
                return slot.removeAt(i).value;
            }
        }

        return null;
    }

    /// Removes all entries from the map, keeping the allocated buckets.
    void clear() {
        for i in 0..hashTable.size() {
            hashTable[i].clear();
        }
        size = 0;
    }

    /// Ensures that the bucket count is at least the given number.
    void reserve(int minimumCapacity) {
        while capacity() < minimumCapacity {
            resize();
        }
    }

    /// Returns true if all entries satisfy the predicate.
    bool all(bool(MapEntry<Key, Value>&) predicate) { return all(iterator(), predicate); }

    /// Returns true if all entries satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }

    /// Returns true if any entry satisfies the predicate.
    bool any(bool(MapEntry<Key, Value>&) predicate) { return any(iterator(), predicate); }

    /// Returns true if any entry satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }

    /// Returns true if no entry satisfies the predicate.
    bool none(bool(MapEntry<Key, Value>&) predicate) { return none(iterator(), predicate); }

    /// Returns true if no entry satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    /// Returns the number of entries.
    int size() {
        return size;
    }

    /// Returns the number of buckets.
    int capacity() {
        return hashTable.size();
    }

    /// Resizes the map. This includes copying the old table into a new, bigger one
    void resize() {
        var newCapacity = capacity() * 2;
        var newTable = createTable(newCapacity);

        for i in 0..capacity() {
            var slot = &hashTable[i];

            // Drain each slot with pop(), moving elements out. Copying them
            // would alias the old table's elements, which its destructor frees.
            while slot.size() > 0 {
                var el = slot.pop();
                newTable[convertHash(el.key.hash()) % newCapacity].push(el);
            }
        }

        hashTable = newTable;
    }

    /// Returns the value for the given key, or null.
    Value&? operator[](Key& e) {
        var hashValue = convertHash(e.hash()) % capacity();
        var slot = &hashTable[hashValue];

        for element in slot {
            if element.key == *e {
                return element.value;
            }
        }

        return null;
    }

    /// Checks if e is part of the map.
    bool contains(Key& e) {
        var hashValue = convertHash(e.hash()) % capacity();
        var slot = &hashTable[hashValue];

        for element in slot {
            if element.key == *e {
                return true;
            }
        }

        return false;
    }

    /// Returns true if the map has no entries.
    bool empty() {
        return size == 0;
    }

    /// Returns the load factor for the map. This is used to increase the map size once
    /// the load factor gets too big.
    float64 loadFactor() {
        return float64(size) / (float64(capacity()));
    }

    /// Iterate over the map
    MapIterator<Key, Value> iterator() {
        return MapIterator(this);
    }
}

/// Converts a hash into a bucket index.
private int convertHash(uint64 hash) {
    return int(hash) & int.max;
}

/// Iterates over the entries of a map.
struct MapIterator<Key, Value>: Iterator<MapEntry<Key, Value>&> {
    private ArrayIterator<List<MapEntry<Key, Value>>> hashTableIterator;
    private MapEntry<Key, Value>[*] current;

    /// Initializes an iterator over the given map.
    MapIterator(Map<Key, Value>& map) {
        hashTableIterator = map.hashTable.iterator();
        current = undefined;
        skipEmptySlots();
    }

    /// Returns true if there are more entries.
    bool hasValue() {
        return hashTableIterator.hasValue();
    }

    /// Returns the current entry.
    MapEntry<Key, Value>& value() {
        return *current;
    }

    /// Advances to the next entry.
    void increment() {
        var slot = &hashTableIterator.value();
        var slotEnd = &slot.data()[slot.size()];
        current++;

        if current == slotEnd {
            hashTableIterator.increment();
            skipEmptySlots();
        }
    }

    private void skipEmptySlots() {
        while hashTableIterator.hasValue() {
            if hashTableIterator.value().size() != 0 {
                current = hashTableIterator.value().data();
                break;
            }
            hashTableIterator.increment();
        }
    }
}
