// File system operations: existence checks, directories, renaming,
// the current directory, directory listing, and whole-file reading/writing.
// Lexical path manipulation without file system access lives in path.cx.

#if Windows
private extern c_int _access(char* path, c_int mode);
private extern c_int _mkdir(char* path);
private extern c_int _rmdir(char* path);
private extern char*? _getcwd(char*? buffer, c_size_t size);
private extern c_int _chdir(char* path);
#else
private extern c_int access(char* path, c_int mode);
private extern c_int mkdir(char* path, c_int mode);
private extern c_int rmdir(char* path);
private extern char*? getcwd(char*? buffer, c_size_t size);
private extern c_int chdir(char* path);
#endif

#if Windows
private bool pathExists(char* path) { return _access(path, 0) == 0; }
#else
// The mode 0 is F_OK: check for existence without checking permissions.
private bool pathExists(char* path) { return access(path, 0) == 0; }
#endif

/// Returns true if a file or directory exists at the path.
bool exists(string path) {
    var pathBuf = toCString(path);
    return pathExists(pathBuf.data());
}

#if Windows
/// Creates a single directory, returning true on success.
bool createDirectory(string path) {
    var pathBuf = toCString(path);
    return _mkdir(pathBuf.data()) == 0;
}
/// Removes an empty directory, returning true on success.
bool removeDirectory(string path) {
    var pathBuf = toCString(path);
    return _rmdir(pathBuf.data()) == 0;
}
#else
/// Creates a single directory, returning true on success.
bool createDirectory(string path) {
    var pathBuf = toCString(path);
    return mkdir(pathBuf.data(), 493) == 0; // 493 is 0o755.
}
/// Removes an empty directory, returning true on success.
bool removeDirectory(string path) {
    var pathBuf = toCString(path);
    return rmdir(pathBuf.data()) == 0;
}
#endif

/// Removes the file, returning true on success.
bool remove(string path) {
    var pathBuf = toCString(path);
    return remove(pathBuf.data()) == 0;
}

/// Renames a file or directory, returning true on success.
bool rename(string oldPath, string newPath) {
    var oldBuf = toCString(oldPath);
    var newBuf = toCString(newPath);
    return rename(oldBuf.data(), newBuf.data()) == 0;
}

#if Windows
/// Returns the current working directory.
StringBuf currentDirectory() {
    var buffer = _getcwd(null, 0);
    if !buffer abort("couldn't get the current directory");
    defer free(cast<void*>(buffer));
    return StringBuf(buffer);
}
/// Changes the current working directory, returning true on success.
bool changeDirectory(string path) {
    var pathBuf = toCString(path);
    return _chdir(pathBuf.data()) == 0;
}
#else
/// Returns the current working directory.
StringBuf currentDirectory() {
    var buffer = getcwd(null, 0);
    if !buffer abort("couldn't get the current directory");
    defer free(cast<void*>(buffer));
    return StringBuf(buffer);
}
/// Changes the current working directory, returning true on success.
bool changeDirectory(string path) {
    var pathBuf = toCString(path);
    return chdir(pathBuf.data()) == 0;
}
#endif

/// An error reading a file.
enum FileError : Printable {
    CouldNotOpen,

    /// Writes the error as text.
    void print(OutputStream& stream) {
        switch this {
            case CouldNotOpen: stream.append("couldn't open file");
        }
    }
}

/// Reads the entire file into a string, or returns an error if the file can't be opened.
Result<StringBuf, FileError> readFile(string path) {
    var pathBuf = toCString(path);
    var file = fopen(pathBuf.data(), "rb");
    if !file return Err(FileError.CouldNotOpen);
    defer fclose(file);

    fseek(file, 0, SEEK_END);
    var size = ftell(file);
    fseek(file, 0, SEEK_SET);

    var content = StringBuf(uninitializedSize = int(size));
    fread(content.data(), sizeof(char), c_size_t(size), file);

    return Ok(content);
}

/// Writes the string to the named file.
bool writeFile(string path, string content) {
    var pathBuf = toCString(path);
    var file = fopen(pathBuf.data(), "wb");
    if !file return false;
    defer fclose(file);

    fwrite(content.data(), sizeof(char), c_size_t(content.size()), file);
    return true;
}

/// Returns the size of the file, or null if it can't be opened.
int64? fileSize(string path) {
    var pathBuf = toCString(path);
    var file = fopen(pathBuf.data(), "rb");
    if !file return null;
    defer fclose(file);

    fseek(file, 0, SEEK_END);
    var size = ftell(file);
    if size < 0 return null;
    return size;
}

#if Windows
/// Returns the names in the directory, sorted, or an empty list if it can't be opened.
///
/// Names come from the shell, so a name containing a line break is split in two.
List<StringBuf> listDirectory(string path) {
    return readDirectoryListing(StringBuf("dir /b ") + quotedPath(path) + " 2>nul", true);
}
#else
/// Returns the names in the directory, sorted, or an empty list if it can't be opened.
///
/// Names come from the shell, so a name containing a line break is split in two.
List<StringBuf> listDirectory(string path) {
    return readDirectoryListing(StringBuf("ls -1 -- ") + quotedPath(path) + " 2>/dev/null", false);
}
#endif

#if Windows
private StringBuf quotedPath(string path) {
    return StringBuf("\"") + path + "\"";
}
#else
// Single-quote for POSIX shells so double quotes, dollar signs, and backticks
// in the path are passed literally. A single quote in the path closes the
// quoting, adds an escaped quote, and reopens it.
private StringBuf quotedPath(string path) {
    var result = StringBuf("'");
    for ch in path {
        if ch == '\'' {
            result += "'\\''";
        } else {
            result += ch;
        }
    }
    result += "'";
    return result;
}
#endif

private List<StringBuf> readDirectoryListing(StringBuf command, bool stripCarriageReturns) {
    var pipe = popen(command.cString(), "r");
    if !pipe return List<StringBuf>();
    defer pclose(pipe);

    var result = List<StringBuf>();
    var current = StringBuf();
    while true {
        var c = fgetc(pipe);
        if c < 0 || c == '\n' {
            if stripCarriageReturns && !current.empty() && current[current.size() - 1] == '\r' {
                current.pop();
            }
            if !current.empty() {
                result.push(StringBuf(string(current)));
            }
            current = StringBuf();
            if c < 0 break;
        } else {
            current.push(char(c));
        }
    }

    sort(result);
    return result;
}
