/// Public members

/// Gives a reference to the maximum of the two elements.
/// Like C++ std::max, the result borrows one of the arguments, so don't store
/// it past temporaries (e.g. `var m = max(f(), g())` dangles).
T& max<T: Comparable>(T& a, T& b) {
    if a >= b {
        return a;
    }
    return b;
}

/// Gives a reference to the minimum of the two elements.
/// Like C++ std::min, the result borrows one of the arguments, so don't store
/// it past temporaries (e.g. `var m = min(f(), g())` dangles).
T& min<T: Comparable>(T& a, T& b) {
    if a < b {
        return a;
    }
    return b;
}

/// Gives the minimum and maximum of the two elements.
(T min, T max) minmax<T: Copyable + Comparable>(T& a, T& b) {
    if a < b {
        return (min = a, max = b);
    }
    return (min = b, max = a);
}

/// Swaps two items in place. Takes pointers because it mutates its arguments.
void swap<E>(E* a, E* b) {
    var t = *a;
    *a = *b;
    *b = t;
}

// TODO: Use Slice instead of List.
/// Sorts a array. Uses insertion sort if the array is small enough, and quickSort otherwise.
void sort<E: Comparable>(List<E>& array) {
    if array.size() <= 32 {
        insertionSort(array);
    } else {
        quickSort(array, 0, array.size() - 1);
    }
}

/// Private members

// TODO: Use Slice instead of List.
private int partition<E: Comparable>(List<E>& arr, int low, int high) {
    var pivot = &arr[high];
    var i = low - 1;

    for j in low..high {
        if arr[j] < *pivot {
            i++;
            swap(&arr[i], &arr[j]);
        }
    }
    if arr[high] < arr[i+1] {
        swap(&arr[i + 1], &arr[high]);
    }
    return i + 1;
}

// TODO: Use Slice instead of List.
// Not stable.
private void quickSort<E: Comparable>(List<E>& arr, int low, int high) {
    if low < high {
        var index = partition(arr, low, high);

        if low < index {
            quickSort(arr, low, index - 1);
        }
        if index < high {
            quickSort(arr, index + 1, high);
        }
    }
}

// TODO: Use Slice instead of List.
// Good for small arrays.
private void insertionSort<E: Comparable>(List<E>& arr) {
    var i = 1;
    while i < arr.size() {
        var j = i;
        while j > 0 && arr[j-1] > arr[j] {
            swap(&arr[j], &arr[j-1]);
            j--;
        }
        i++;
    }
}
