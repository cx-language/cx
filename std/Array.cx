/// A fixed-size array holding `N` elements of type `T`.
///
/// Unlike `List`, the size is part of the type, so arrays of different sizes
/// are different types. Array literals convert to arrays when the size matches.
/// The compiler lowers this fieldless declaration to the native fixed-array
/// representation, so `Array<T, N>` and `T[N]` denote the same type.
struct Array<T, int N> {
    /// Returns the number of elements.
    int size() {
        return N;
    }

    /// Returns a pointer to the first element.
    T[*] data() {
        return this;
    }

    /// Returns the first element.
    T& first() {
        if N == 0 abort("Called first() on empty Array\n");
        return this[0];
    }

    /// Returns the last element.
    T& last() {
        if N == 0 abort("Called last() on empty Array\n");
        return this[N - 1];
    }

    /// Returns true if the array contains an element equal to the given value.
    bool contains(T& value) {
        return indexOf(value) != null;
    }

    /// Returns the index of the first element equal to the given value, or null if it's not found.
    int? indexOf(T& value) {
        for i in 0..N {
            if this[i] == value {
                return i;
            }
        }
        return null;
    }

    /// Returns an iterator over the elements.
    ArrayIterator<T> iterator() {
        return ArrayIterator(this);
    }

    /// Returns an iterator over the elements with their indices.
    EnumeratedIterator<T> enumerate() {
        return EnumeratedIterator(iterator());
    }

    /// Returns the first element satisfying the predicate, or null.
    T&? find(bool(T&) predicate) {
        for i in 0..N {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Returns the first element satisfying the predicate, or null.
    T&? find<U: Copyable>(bool(U) predicate) {
        for i in 0..N {
            if predicate(this[i]) {
                return this[i];
            }
        }

        return null;
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, T, ArrayIterator<T>, Output(T&)> map<Output>(Output(T&) transform) {
        return MappedIterator<Output, T, ArrayIterator<T>, Output(T&)>(iterator(), transform);
    }

    /// Lazily transforms the elements. Collect the results with toList().
    MappedIterator<Output, T, ArrayIterator<T>, Output(U)> map<Output, U: Copyable>(Output(U) transform) {
        return MappedIterator<Output, T, ArrayIterator<T>, Output(U)>(iterator(), transform);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<T, ArrayIterator<T>, bool(T&)> filter(bool(T&) include) {
        return FilterIterator<T, ArrayIterator<T>, bool(T&)>(iterator(), include);
    }

    /// Lazily keeps the elements satisfying the predicate. Collect the results with toList().
    FilterIterator<T, ArrayIterator<T>, bool(U)> filter<U: Copyable>(bool(U) include) {
        return FilterIterator<T, ArrayIterator<T>, bool(U)>(iterator(), include);
    }

    /// Lazily appends another iterator's elements. Collect the results with toList().
    ChainIterator<T, ArrayIterator<T>, Other> chain<Other>(Other other) {
        return ChainIterator<T, ArrayIterator<T>, Other>(iterator(), other);
    }

    /// Returns true if all elements satisfy the predicate.
    bool all(bool(T&) predicate) { return all(iterator(), predicate); }

    /// Returns true if all elements satisfy the predicate.
    bool all<U: Copyable>(bool(U) predicate) { return all(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any(bool(T&) predicate) { return any(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any<U: Copyable>(bool(U) predicate) { return any(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none(bool(T&) predicate) { return none(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none<U: Copyable>(bool(U) predicate) { return none(iterator(), predicate); }

    /// Returns the dot product of this array and `other`.
    T dot(T[N] other) {
        T sum = 0;
        for i in 0..N {
            sum += this[i] * other[i];
        }
        return sum;
    }

    /// Returns the Euclidean length of this array.
    float64 length() {
        return sqrt(float64(dot(this)));
    }

    /// Returns this array scaled to unit length.
    /// Only meaningful for floating-point elements.
    T[N] normalized() {
        // Inferred `var result = this` would alias the receiver; annotate to copy.
        T[N] result = this;
        return result / T(length());
    }
}

/// Returns the cross product of two 3-element arrays.
T[3] cross<T>(T[3] a, T[3] b) {
    return [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0],
    ];
}
