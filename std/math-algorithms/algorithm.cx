/// Public members

/// Gives a reference to the maximum of the two elements.
/// Like C++ std::max, the result borrows one of the arguments, so it must not
/// outlive them. Calls with a `const` argument, or with only temporaries, use
/// the by-value overload below instead, which copies.
T& max<T: Comparable>(T& a, T& b) {
    if a >= b {
        return a;
    }
    return b;
}

/// Gives the maximum of the two elements, copying `Copyable` arguments.
/// Unlike the by-reference overload, this accepts `const`s, and temporaries
/// are safe to pass since the result is a copy.
T max<T: Copyable + Comparable>(T a, T b) {
    if a >= b {
        return a;
    }
    return b;
}

/// Gives the greater of the two pointers, comparing memory addresses.
T* max<T>(T* a, T* b) {
    if a >= b {
        return a;
    }
    return b;
}

/// Gives a reference to the minimum of the two elements.
/// Like C++ std::min, the result borrows one of the arguments, so it must not
/// outlive them. Calls with a `const` argument, or with only temporaries, use
/// the by-value overload below instead, which copies.
T& min<T: Comparable>(T& a, T& b) {
    if a < b {
        return a;
    }
    return b;
}

/// Gives the minimum of the two elements, copying `Copyable` arguments.
/// Unlike the by-reference overload, this accepts `const`s, and temporaries
/// are safe to pass since the result is a copy.
T min<T: Copyable + Comparable>(T a, T b) {
    if a < b {
        return a;
    }
    return b;
}

/// Gives the lesser of the two pointers, comparing memory addresses.
T* min<T>(T* a, T* b) {
    if a < b {
        return a;
    }
    return b;
}

/// Gives references to the minimum and maximum of the two elements.
/// Like C++ std::minmax, the result borrows the arguments, so it must not
/// outlive them. Calls with a `const` argument, or with only temporaries, use
/// the by-value overload below instead, which copies.
(T& min, T& max) minmax<T: Comparable>(T& a, T& b) {
    if a < b {
        return (min = a, max = b);
    }
    return (min = b, max = a);
}

/// Gives the minimum and maximum of the two elements, copying `Copyable`
/// arguments. Unlike the by-reference overload, this accepts `const`s.
(T min, T max) minmax<T: Copyable + Comparable>(T a, T b) {
    if a < b {
        return (min = a, max = b);
    }
    return (min = b, max = a);
}

/// Gives the lesser and greater of the two pointers, comparing memory addresses.
(T* min, T* max) minmax<T>(T* a, T* b) {
    if a < b {
        return (min = a, max = b);
    }
    return (min = b, max = a);
}

/// Swaps two items in place.
void swap<E>(E& a, E& b) {
    if &a == &b return;
    @manuallyDestroy E t = undefined;
    memcpy(&t, &a, sizeof(E));
    memcpy(&a, &b, sizeof(E));
    memcpy(&b, &t, sizeof(E));
}

/// Sorts an array. Uses insertion sort if the array is small enough, and quickSort otherwise.
void sort<E: Comparable>(E[] array) {
    if array.size() <= 32 {
        insertionSort(array);
    } else {
        quickSort(array, 0, array.size() - 1);
    }
}

/// Private members

private int partition<E: Comparable>(E[] arr, int low, int high) {
    var pivot = &arr[high];
    var i = low - 1;

    for j in low..high {
        if arr[j] < *pivot {
            i++;
            swap(arr[i], arr[j]);
        }
    }
    if arr[high] < arr[i+1] {
        swap(arr[i + 1], arr[high]);
    }
    return i + 1;
}

// Not stable.
private void quickSort<E: Comparable>(E[] arr, int low, int high) {
    if low < high {
        var index = partition(arr, low, high);

        if low < index {
            quickSort(arr, low, index - 1);
        }
        if index < high {
            quickSort(arr, index + 1, high);
        }
    }
}

// Good for small arrays.
private void insertionSort<E: Comparable>(E[] arr) {
    var i = 1;
    while i < arr.size() {
        var j = i;
        while j > 0 && arr[j-1] > arr[j] {
            swap(arr[j], arr[j-1]);
            j--;
        }
        i++;
    }
}
