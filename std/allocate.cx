#if LeakCheck
// Size header for leak tracking. Stored immediately before the user pointer;
// the header size is rounded up to 16 bytes so the user pointer stays 16-aligned.
private struct LeakHeader {
    uint64 size;
}

private int leakCount = 0;
private uint64 leakBytes = 0;

private uint64 leakHeaderSize() {
    return (sizeof(LeakHeader) + 15) / 16 * 16;
}

private void*? cxMalloc(c_size_t size) {
    var headerSize = leakHeaderSize();
    var userSize = uint64(size);
    if userSize == 0 {
        // malloc(0) may return null; keep zero-size allocations non-null.
        userSize = 1;
    }
    if userSize > uint64(-1) - headerSize {
        return null;
    }
    var raw = malloc(c_size_t(headerSize + userSize));
    if raw == null {
        return null;
    }
    var header = cast<LeakHeader*>(raw);
    header.init(LeakHeader(size = userSize));
    leakCount++;
    leakBytes += userSize;
    var bytes = cast<uint8[*]>(raw);
    return cast<void*>(&bytes[headerSize]);
}

private void cxFree(void*? ptr) {
    if ptr == null {
        return;
    }
    var headerSize = leakHeaderSize();
    var header = cast<LeakHeader*>(cast<uint64>(ptr) - headerSize);
    leakCount--;
    leakBytes -= header.size;
    free(header);
}

// Called by the compiler at the end of main in debug builds. Reports leaks
// to stderr and exits with status 1 (no stack trace: the program already ran
// to completion, and aborting here would dump JIT compiler frames under cx run).
// ponytail: single-threaded only; add a lock if cx gains threads. Reports
// totals only, upgrade by capturing caller location per allocation.
private void checkLeaks() {
    if leakCount != 0 {
        fflush(null);
        var err = stderr();
        err.write("memory leak: ");
        err.write(leakCount);
        err.write(" allocation(s), ");
        err.write(leakBytes);
        err.write(" byte(s) leaked");
        err.write('\n');
        exit(c_int(1));
    }
}
#else
private void*? cxMalloc(c_size_t size) {
    // malloc(0) may return null; keep zero-size allocations non-null.
    if size == 0 {
        size = c_size_t(1);
    }
    return malloc(size);
}

private void cxFree(void*? ptr) {
    free(ptr);
}
#endif

// Computes `sizeof(T) * count` into `size`, returning false if it overflows.
private bool checkedArraySize<T>(uint64 count, uint64& size) {
    var elementSize = sizeof(T);
    if count != 0 && elementSize > uint64(-1) / count {
        return false;
    }
    *size = elementSize * count;
    return true;
}

/// Allocates uninitialized storage for `count` values and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the size overflows or the allocation fails, the program aborts.
///
T[*] allocate<T>(uint64 count) {
    var size = uint64(0);
    assert(checkedArraySize<T>(count, size), "allocation size overflow");
    return cast<T[*]>(cxMalloc(c_size_t(size))!);
}

/// Allocates uninitialized storage for `count` values and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the size overflows or the allocation fails, null is returned.
///
T[*]? tryAllocate<T>(uint64 count) {
    var size = uint64(0);
    if !checkedArraySize<T>(count, size) {
        return null;
    }
    var allocation = cxMalloc(c_size_t(size));
    if allocation == null {
        return null;
    }
    return cast<T[*]>(allocation);
}

/// Moves the given value into newly allocated dynamic memory and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the memory allocation fails, the program aborts.
///
T* allocateValue<T>(T value) {
    var allocation = cast<T*>(cxMalloc(c_size_t(sizeof(T)))!);
    allocation.init(value);
    return allocation;
}

/// Moves the given value into newly allocated dynamic memory and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the memory allocation fails, null is returned.
///
T*? tryAllocateValue<T>(T value) {
    var allocation = cast<T*?>(cxMalloc(c_size_t(sizeof(T))));
    if allocation != null {
        allocation.init(value);
    }
    return allocation;
}

/// Deallocates a block of dynamic memory that was previously allocated by a call to `allocate`,
/// `tryAllocate`, `allocateValue`, or `tryAllocateValue`. If the argument is null, no operation
/// is performed.
void deallocate<T>(T allocation) {
    cxFree(allocation);
}
