#if Windows

private extern uint _set_abort_behavior(uint flags, uint mask);
/// Flag disabling the crash dialog.
const _CALL_REPORTFAULT = 0x2;

/// Prints the current stack trace.
void printStackTrace() {
    // TODO: Implement stack trace on Windows.
    // Reference Range so IR emission matches posix (its printStackTrace uses
    // `for i in 0..frames`), keeping snapshot output consistent across platforms.
    for _ in 0..0 {
    }
}

/// Disables the crash dialog on abort.
void setAbortBehavior() {
    // Disable "*.exe has stopped working" popup window which prevents testing the output of the program.
    _set_abort_behavior(0, _CALL_REPORTFAULT);
}

#endif
