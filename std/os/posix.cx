#if !Windows

#if hasInclude("execinfo.h")

private extern int backtrace(void** array, int size);
private extern char*[*]? backtrace_symbols(void** array, int size);

/// Prints the current stack trace.
void printStackTrace() {
    void*[128] callstack = undefined;
    var frames = backtrace(&callstack[0], callstack.size());
    var strings = backtrace_symbols(&callstack[0], frames);

    if strings == null {
        return;
    }

    for i in 0..frames {
        printf("%s\n", strings[i]);
    }

    // abort() doesn't flush stdio buffers on all platforms; flush now so the
    // trace isn't lost.
    fflush(null);
    free(cast<void*>(strings));
}

#else

/// Prints the current stack trace.
void printStackTrace() {
}

#endif

/// Configures abort behavior. Does nothing on this platform.
void setAbortBehavior() {
}

#endif
