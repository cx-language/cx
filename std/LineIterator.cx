/// Iterates over the lines of a string.
struct LineIterator: Copyable, Iterator<string> {
    private string stream;
    private int end;

    /// Initializes an iterator over the given string.
    LineIterator(string stream) {
        this.stream = stream;
        end = stream.indexOf('\n') ?? stream.size();
    }

    /// Returns true if there are more lines.
    bool hasValue() {
        return !stream.empty();
    }

    /// Returns the current line.
    string value() {
        return stream.substr(0..end);
    }

    /// Advances to the next line.
    void increment() {
        if end >= stream.size() {
            stream = "";
        } else {
            stream = stream.substr(end + 1);
        }
        end = stream.indexOf('\n') ?? stream.size();
    }

    /// Collects the remaining lines into a list.
    List<string> toList() {
        var output = List<string>();
        while hasValue() {
            output.push(value());
            increment();
        }
        return output;
    }

    /// Returns itself.
    LineIterator iterator() {
        return this;
    }
}
