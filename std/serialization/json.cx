namespace Json;

/// A JSON value: a tagged union of all JSON types.
///
/// Whole numbers that fit in 64 bits parse as `Integer`; fractional and
/// overlarge numbers parse as `Number`. Objects preserve insertion order and
/// allow duplicate keys.
enum Value : Printable {
    String(StringBuf value),
    Integer(int64 value),
    Number(float64 value),
    Boolean(bool value),
    Null,
    Array(List<Json.Value> value),
    Object(List<Json.Member> value),

    /// Writes the value in compact JSON form.
    ///
    /// Printable's `toString()` renders this same form.
    void print(OutputStream& stream) {
        Json.write(stream, this, 0, false);
    }

    /// Renders the value as JSON, indented with 2 spaces per level when
    /// `pretty` is true and on one line otherwise.
    ///
    /// Numbers print in the shortest form that parses back to the same value.
    /// Non-finite `Number` values abort; JSON has no spelling for them.
    StringBuf toString(bool pretty) {
        var out = StringBuf();
        var stream = OutputStream(out);
        Json.write(stream, this, 0, pretty);
        return out;
    }
}

/// One key-value pair of a JSON object.
struct Member {
    /// The member's key.
    StringBuf key;
    /// The member's value.
    Json.Value value;
}

/// A JSON parse error: what went wrong and the byte offset where parsing stopped.
enum Error: Printable {
    UnexpectedCharacter(int offset),
    InvalidLiteral(int offset),
    ExpectedStringKey(int offset),
    ExpectedColon(int offset),
    ExpectedCommaOrBrace(int offset),
    ExpectedCommaOrBracket(int offset),
    UnterminatedString(int offset),
    UnterminatedEscape(int offset),
    InvalidEscape(int offset),
    InvalidUnicodeEscape(int offset),
    UnpairedSurrogate(int offset),
    UnescapedControlCharacter(int offset),
    InvalidNumber(int offset),
    NumberOutOfRange(int offset),
    UnexpectedTrailingCharacters(int offset),
    MaximumDepthExceeded(int offset),

    /// Writes the error as text, with its byte offset.
    void print(OutputStream& stream) {
        switch this {
            case UnexpectedCharacter e: Json.writeMessage(stream, "unexpected character", e);
            case InvalidLiteral e: Json.writeMessage(stream, "invalid literal", e);
            case ExpectedStringKey e: Json.writeMessage(stream, "expected string key", e);
            case ExpectedColon e: Json.writeMessage(stream, "expected ':'", e);
            case ExpectedCommaOrBrace e: Json.writeMessage(stream, "expected ',' or '}'", e);
            case ExpectedCommaOrBracket e: Json.writeMessage(stream, "expected ',' or ']'", e);
            case UnterminatedString e: Json.writeMessage(stream, "unterminated string", e);
            case UnterminatedEscape e: Json.writeMessage(stream, "unterminated escape", e);
            case InvalidEscape e: Json.writeMessage(stream, "invalid escape", e);
            case InvalidUnicodeEscape e: Json.writeMessage(stream, "invalid unicode escape", e);
            case UnpairedSurrogate e: Json.writeMessage(stream, "unpaired surrogate", e);
            case UnescapedControlCharacter e: Json.writeMessage(stream, "unescaped control character", e);
            case InvalidNumber e: Json.writeMessage(stream, "invalid number", e);
            case NumberOutOfRange e: Json.writeMessage(stream, "number out of range", e);
            case UnexpectedTrailingCharacters e: Json.writeMessage(stream, "unexpected trailing characters", e);
            case MaximumDepthExceeded e: Json.writeMessage(stream, "maximum nesting depth exceeded", e);
        }
    }
}

/// Parses the JSON document in `text`.
///
/// Surrounding whitespace is allowed, but trailing characters are an error.
/// Whole numbers that fit in 64 bits become `Integer`; other numbers become
/// `Number`, with out-of-range numbers an error. Inputs nested more than 1000
/// levels deep are rejected. On failure returns which error occurred and at
/// which byte offset.
Result<Json.Value, Json.Error> parse(string text) {
    var parser = Json.Parser(text);
    var r = parser.parseValue(0);
    if r == Ok {
        parser.skipWhitespace();
        if parser.pos < text.size() {
            return Err(Json.Error.UnexpectedTrailingCharacters(parser.pos));
        }
    }
    return r;
}

private const int maxDepth = 1000;

private void writeMessage(OutputStream& stream, string text, int offset) {
    stream.append(text);
    stream.append(" at offset ");
    offset.print(stream);
}

private struct Parser {
    string input;
    int pos = 0;

    char peek() {
        if pos < input.size() {
            return input[pos];
        }
        return '\0';
    }

    void skipWhitespace() {
        while true {
            // JSON whitespace is exactly these four characters.
            char c = peek();
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                pos++;
            } else {
                return;
            }
        }
    }

    Result<Json.Value, Json.Error> parseValue(int depth) {
        skipWhitespace();
        char c = peek();
        if c == '{' {
            return parseObject(depth);
        } else if c == '[' {
            return parseArray(depth);
        } else if c == '"' {
            var r = parseString();
            switch (r) {
                case Ok s: return Ok(Json.Value.String(s));
                case Err e: return Err(e);
            }
        } else if c == 't' {
            return parseLiteral("true", Json.Value.Boolean(true));
        } else if c == 'f' {
            return parseLiteral("false", Json.Value.Boolean(false));
        } else if c == 'n' {
            return parseLiteral("null", Json.Value.Null);
        } else if c == '-' || c.isDigit() {
            return parseNumber();
        }
        return Err(Json.Error.UnexpectedCharacter(pos));
    }

    Result<Json.Value, Json.Error> parseLiteral(string word, Json.Value value) {
        for c in word {
            if pos >= input.size() || input[pos] != c {
                return Err(Json.Error.InvalidLiteral(pos));
            }
            pos++;
        }
        return Ok(value);
    }

    Result<Json.Value, Json.Error> parseObject(int depth) {
        if depth >= Json.maxDepth {
            return Err(Json.Error.MaximumDepthExceeded(pos));
        }
        pos++; // '{'
        var members = List<Json.Member>();
        skipWhitespace();
        if peek() == '}' {
            pos++;
            return Ok(Json.Value.Object(members));
        }
        while true {
            skipWhitespace();
            if peek() != '"' {
                return Err(Json.Error.ExpectedStringKey(pos));
            }
            var key = parseString();
            switch (key) {
                case Ok k:
                    skipWhitespace();
                    if peek() != ':' {
                        return Err(Json.Error.ExpectedColon(pos));
                    }
                    pos++;
                    var value = parseValue(depth + 1);
                    switch (value) {
                        case Ok v: members.push(Json.Member(k, v));
                        case Err e: return Err(e);
                    }
                case Err e: return Err(e);
            }
            skipWhitespace();
            if peek() == ',' {
                pos++;
            } else if peek() == '}' {
                pos++;
                return Ok(Json.Value.Object(members));
            } else {
                return Err(Json.Error.ExpectedCommaOrBrace(pos));
            }
        }
        abort("unreachable");
    }

    Result<Json.Value, Json.Error> parseArray(int depth) {
        if depth >= Json.maxDepth {
            return Err(Json.Error.MaximumDepthExceeded(pos));
        }
        pos++; // '['
        var elements = List<Json.Value>();
        skipWhitespace();
        if peek() == ']' {
            pos++;
            return Ok(Json.Value.Array(elements));
        }
        while true {
            var r = parseValue(depth + 1);
            switch (r) {
                case Ok v: elements.push(v);
                case Err e: return Err(e);
            }
            skipWhitespace();
            if peek() == ',' {
                pos++;
            } else if peek() == ']' {
                pos++;
                return Ok(Json.Value.Array(elements));
            } else {
                return Err(Json.Error.ExpectedCommaOrBracket(pos));
            }
        }
        abort("unreachable");
    }

    Result<StringBuf, Json.Error> parseString() {
        pos++; // opening quote
        var out = StringBuf();
        while true {
            if pos >= input.size() {
                return Err(Json.Error.UnterminatedString(pos));
            }
            char c = input[pos];
            if c == '"' {
                pos++;
                return Ok(out);
            } else if c == '\\' {
                pos++;
                if pos >= input.size() {
                    return Err(Json.Error.UnterminatedEscape(pos));
                }
                char e = input[pos];
                pos++;
                if e == '"' {
                    out.push('"');
                } else if e == '\\' {
                    out.push('\\');
                } else if e == '/' {
                    out.push('/');
                } else if e == 'b' {
                    out.push(char(8));
                } else if e == 'f' {
                    out.push(char(12));
                } else if e == 'n' {
                    out.push('\n');
                } else if e == 'r' {
                    out.push('\r');
                } else if e == 't' {
                    out.push('\t');
                } else if e == 'u' {
                    int code = parseHex4();
                    if code < 0 {
                        return Err(Json.Error.InvalidUnicodeEscape(pos));
                    }
                    if code >= 0xD800 && code <= 0xDBFF {
                        if pos + 6 > input.size() || input[pos] != '\\' || input[pos + 1] != 'u' {
                            return Err(Json.Error.UnpairedSurrogate(pos));
                        }
                        pos += 2;
                        int lo = parseHex4();
                        if lo < 0xDC00 || lo > 0xDFFF {
                            return Err(Json.Error.UnpairedSurrogate(pos));
                        }
                        code = 0x10000 + ((code - 0xD800) << 10) + (lo - 0xDC00);
                    } else if code >= 0xDC00 && code <= 0xDFFF {
                        return Err(Json.Error.UnpairedSurrogate(pos));
                    }
                    Json.pushUtf8(out, code);
                } else {
                    return Err(Json.Error.InvalidEscape(pos));
                }
            } else if Json.byteValue(c) < 32 {
                return Err(Json.Error.UnescapedControlCharacter(pos));
            } else {
                out.push(c);
                pos++;
            }
        }
        abort("unreachable");
    }

    // Parses 4 hex digits at pos, advancing past them. Returns -1 if invalid.
    int parseHex4() {
        if pos + 4 > input.size() {
            return -1;
        }
        int start = pos;
        int code = 0;
        for _ in 0..4 {
            int digit = Json.hexValue(input[pos]);
            if digit < 0 {
                pos = start;
                return -1;
            }
            code = code * 16 + digit;
            pos++;
        }
        return code;
    }

    Result<Json.Value, Json.Error> parseNumber() {
        int start = pos;
        if peek() == '-' {
            pos++;
        }
        if peek() == '0' {
            pos++;
        } else if peek() >= '1' && peek() <= '9' {
            while peek().isDigit() {
                pos++;
            }
        } else {
            return Err(Json.Error.InvalidNumber(pos));
        }
        bool isFloat = false;
        if peek() == '.' {
            isFloat = true;
            pos++;
            if !peek().isDigit() {
                return Err(Json.Error.InvalidNumber(pos));
            }
            while peek().isDigit() {
                pos++;
            }
        }
        if peek() == 'e' || peek() == 'E' {
            isFloat = true;
            pos++;
            if peek() == '+' || peek() == '-' {
                pos++;
            }
            if !peek().isDigit() {
                return Err(Json.Error.InvalidNumber(pos));
            }
            while peek().isDigit() {
                pos++;
            }
        }
        string lexeme = input.substr(start..pos);
        if !isFloat {
            int64 integer = 0;
            bool negative = lexeme[0] == '-';
            int i = negative ? 1 : 0;
            bool overflow = false;
            while i < lexeme.size() {
                int64 digit = int64(int(lexeme[i]) - int('0'));
                if negative {
                    if integer < (int64.min + digit) / 10 {
                        overflow = true;
                        break;
                    }
                    integer = integer * 10 - digit;
                } else {
                    if integer > (int64.max - digit) / 10 {
                        overflow = true;
                        break;
                    }
                    integer = integer * 10 + digit;
                }
                i++;
            }
            if !overflow {
                return Ok(Json.Value.Integer(integer));
            }
        }
        var text = toCString(lexeme);
        float64 value = strtod(text.data(), null);
        // Only infinite values equal their own half.
        if value != 0.0 && value / 2.0 == value {
            return Err(Json.Error.NumberOutOfRange(start));
        }
        return Ok(Json.Value.Number(value));
    }
}

// Numeric value of a byte. Goes through uint8 because plain char may be
// signed, which would make bytes above 127 negative.
private int byteValue(char c) {
    return int(uint8(c));
}

private int hexValue(char c) {
    if c >= '0' && c <= '9' {
        return int(c) - int('0');
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10;
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10;
    }
    return -1;
}

private void pushUtf8(StringBuf& out, int code) {
    if code < 0x80 {
        out.push(char(code));
    } else if code < 0x800 {
        out.push(char(0xC0 + (code >> 6)));
        out.push(char(0x80 + (code & 0x3F)));
    } else if code < 0x10000 {
        out.push(char(0xE0 + (code >> 12)));
        out.push(char(0x80 + ((code >> 6) & 0x3F)));
        out.push(char(0x80 + (code & 0x3F)));
    } else {
        out.push(char(0xF0 + (code >> 18)));
        out.push(char(0x80 + ((code >> 12) & 0x3F)));
        out.push(char(0x80 + ((code >> 6) & 0x3F)));
        out.push(char(0x80 + (code & 0x3F)));
    }
}

private void writeIndent(OutputStream& out, int count) {
    int i = 0;
    while i < count {
        out.push(' ');
        i++;
    }
}

private void writeQuoted(OutputStream& out, StringBuf& s) {
    out.push('"');
    for c in s {
        int code = Json.byteValue(c);
        if code == 34 {
            out.append("\\\"");
        } else if code == 92 {
            out.append("\\\\");
        } else if code == 8 {
            out.append("\\b");
        } else if code == 12 {
            out.append("\\f");
        } else if code == 10 {
            out.append("\\n");
        } else if code == 13 {
            out.append("\\r");
        } else if code == 9 {
            out.append("\\t");
        } else if code < 32 {
            out.append("\\u00");
            out.push("0123456789abcdef"[code >> 4]);
            out.push("0123456789abcdef"[code & 15]);
        } else {
            out.push(c);
        }
    }
    out.push('"');
}

// Renders the shortest spelling that parses back to `value`. 17 significant
// digits always suffice for 64-bit floats; shorter widths win when they match.
private void writeNumber(OutputStream& out, float64 value) {
    // NaN is the only value that doesn't equal itself. (Spelled this way
    // because `value != value` is false for NaN.) Only infinite values equal
    // their own half.
    if !(value == value) || (value != 0.0 && value / 2.0 == value) {
        abort("Json.Value.Number must be finite");
    }
    char[32] result = undefined;
    int bestPrecision = 17;
    uint64 bestLength = 32;
    for precision in 1..18 {
        sprintf(result, "%.*g", precision, value);
        uint64 length = strlen(result);
        if strtod(result, null) == value && length < bestLength {
            bestPrecision = precision;
            bestLength = length;
        }
    }
    sprintf(result, "%.*g", bestPrecision, value);
    out.append(string(result));
}

private void write(OutputStream& out, Json.Value& value, int level, bool indented) {
    switch (value) {
        case String s: Json.writeQuoted(out, s);
        case Integer n: n.print(out);
        case Number f: Json.writeNumber(out, f);
        case Boolean b:
            if b {
                out.append("true");
            } else {
                out.append("false");
            }
        case Null: out.append("null");
        case Array a:
            if a.empty() {
                out.append("[]");
            } else {
                out.push('[');
                bool first = true;
                for element in a {
                    if !first {
                        out.push(',');
                    }
                    first = false;
                    if indented {
                        out.push('\n');
                        Json.writeIndent(out, (level + 1) * 2);
                    }
                    Json.write(out, element, level + 1, indented);
                }
                if indented {
                    out.push('\n');
                    Json.writeIndent(out, level * 2);
                }
                out.push(']');
            }
        case Object o:
            if o.empty() {
                out.append("\{}");
            } else {
                out.push('{');
                bool first = true;
                for member in o {
                    if !first {
                        out.push(',');
                    }
                    first = false;
                    if indented {
                        out.push('\n');
                        Json.writeIndent(out, (level + 1) * 2);
                    }
                    Json.writeQuoted(out, member.key);
                    out.push(':');
                    if indented {
                        out.push(' ');
                    }
                    Json.write(out, member.value, level + 1, indented);
                }
                if indented {
                    out.push('\n');
                    Json.writeIndent(out, level * 2);
                }
                out.push('}');
            }
    }
}
