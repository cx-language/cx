// Lazily keeps the elements of another iterator that satisfy a predicate.
// Get one from filter(); collect the results with toList().
// Takes the predicate by value; for borrows use FilterIterator.
struct FilterValueIterator<Input, It>: Iterator<Input*> {
    private It source;
    private bool(Input) include;

    /// Initializes an iterator keeping the source's matching elements.
    FilterValueIterator(It source, bool(Input) include) {
        this.source = source;
        this.include = include;
    }

    /// Returns true if there are more matching elements.
    bool hasValue() {
        while source.hasValue() {
            if include(*source.value()) {
                return true;
            }
            source.increment();
        }
        return false;
    }

    /// Returns the next matching element.
    Input* value() {
        return source.value();
    }

    /// Advances past the current element.
    void increment() {
        source.increment();
    }

    /// Lazily transforms the elements.
    MappedIterator<Output, Input, FilterValueIterator<Input, It>> map<Output>(Output(Input&) transform) {
        return MappedIterator(*this, transform);
    }

    /// Lazily transforms the elements.
    MappedValueIterator<Output, Input, FilterValueIterator<Input, It>> map<Output, T>(Output(T) transform) {
        return MappedValueIterator(*this, transform);
    }

    /// Lazily appends another iterator's elements.
    ChainIterator<Input, FilterValueIterator<Input, It>, Other> chain<Other>(Other other) {
        return ChainIterator(*this, other);
    }

    /// Collects the remaining elements into a list.
    List<Input> toList() {
        var output = List<Input>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }
}
