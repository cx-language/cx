// TODO: Convert into enum once generic enums are supported.
/// A value that may be absent.
struct Optional<T> {
    /// Whether a value is present.
    bool hasValue;
    /// The contained value, if present.
    T value;

    /// Initializes an empty optional.
    Optional() {
        hasValue = false;
        value = undefined;
    }

    /// Initializes an optional holding the given value.
    Optional(T value) {
        hasValue = true;
        this.value = value;
    }
}

/// Returns true if both optionals are equal.
bool operator== <T: Comparable>(Optional<T>* a, Optional<T>* b) {
    if a.hasValue != b.hasValue return false;
    if !b.hasValue return true;
    return a.value == b.value;
}

/// Returns true if both optionals differ.
bool operator!= <T: Comparable>(Optional<T>* a, Optional<T>* b) {
    return !(*a == *b);
}

/// Returns true if the optional holds a value equal to b.
bool operator== <T: Comparable>(Optional<T>* a, T* b) {
    if !a.hasValue return false;
    return a.value == *b;
}

/// Returns true if the optional holds a value differing from b.
bool operator!= <T: Comparable>(Optional<T>* a, T* b) {
    return !(*a == *b);
}
