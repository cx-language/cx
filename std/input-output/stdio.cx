/// Prints the given value followed by a newline.
void println<T>(T& value) {
    print(value);
    print('\n');
}

/// Prints the given value followed by a newline.
void println<T: Copyable>(T value) {
    print(value);
    print('\n');
}

/// Prints the given value followed by a newline.
void println(char[*]? value) {
    print(value);
    print('\n');
}

/// Prints the given value without allocating. Values that aren't copyable must be borrowed
/// explicitly, so printing never moves from them.
void print<T: Printable + Copyable>(T value) {
    var stream = OutputStream();
    value.print(stream);
}

/// Prints the given value without allocating.
void print<T: Printable>(T& value) {
    var stream = OutputStream();
    value.print(stream);
}

/// Prints the repetition without allocating a temporary.
void print(RepeatIterator<string> repetitions) {
    for chunk in repetitions {
        printf("%.*s", chunk.size(), chunk.data());
    }
}

/// Prints the given value without allocating.
void print<T: Printable>(T* value) {
    var stream = OutputStream();
    value.print(stream);
}

/// Prints the given value.
void print<T: Printable>(List<T>& list) {
    var stream = OutputStream();
    list.print(stream);
}

/// Prints the given value.
void print<T: Printable, int N>(SmallList<T, N>& list) {
    var stream = OutputStream();
    list.print(stream);
}

/// Joins the array elements into a string with the given separator.
StringBuf join<T: Printable>(T[] array, string separator) {
    var result = StringBuf();

    for elem, index in array {
        if index != 0 {
            result.append(separator);
        }
        elem.print(OutputStream(result));
    }

    return result;
}

/// Joins the list elements into a string with the given separator.
StringBuf join<T: Printable>(List<T>& list, string separator) {
    return join(Slice(list), separator);
}

/// Prints the given value.
void print<T: Printable>(T[] array) {
    var stream = OutputStream();
    array.print(stream);
}

/// Prints the given value without allocating.
void print(char[*]? cString) {
    if cString {
        printf("%s", cString);
    } else {
        printf("null");
    }
}

/// Prints the given values.
///
/// Copyable arguments pass by value so that a char prints as a single character
/// instead of decaying to a C string in print(). Calls with non-Copyable
/// arguments use the borrow overload below.
void print<T: Printable + Copyable>(T... args) {
    for arg in args {
        print(arg);
    }
}

/// Prints the given values.
void print<T: Printable>(T&... args) {
    for arg in args {
        print(arg);
    }
}

/// Prints the given values followed by a newline.
///
/// Copyable arguments pass by value so that a char prints as a single character
/// instead of decaying to a C string in print(). Calls with non-Copyable
/// arguments use the borrow overload below.
void println<T: Copyable>(T... args) {
    for arg in args {
        print(arg);
    }
    print('\n');
}

/// Prints the given values followed by a newline.
void println<T: Printable>(T&... args) {
    for arg in args {
        print(arg);
    }
    print('\n');
}

/// Prints the given value to stderr without allocating. Values that aren't copyable must be borrowed
/// explicitly, so printing never moves from them.
void eprint<T: Printable + Copyable>(T value) {
    stderr().write(value);
}

/// Prints the given value to stderr without allocating.
void eprint<T: Printable>(T& value) {
    stderr().write(value);
}

/// Prints the repetition to stderr without allocating a temporary.
void eprint(RepeatIterator<string> repetitions) {
    var err = stderr();
    for chunk in repetitions {
        err.write(chunk);
    }
}

/// Prints the given value to stderr without allocating.
void eprint<T: Printable>(T* value) {
    stderr().write(*value);
}

/// Prints the given value to stderr.
void eprint<T: Printable>(List<T>& list) {
    var rendered = StringBuf();
    list.print(OutputStream(rendered));
    stderr().write(rendered);
}

/// Prints the given value to stderr.
void eprint<T: Printable, int N>(SmallList<T, N>& list) {
    var rendered = StringBuf();
    list.print(OutputStream(rendered));
    stderr().write(rendered);
}

/// Prints the given value to stderr.
void eprint<T: Printable>(T[] array) {
    var rendered = StringBuf();
    array.print(OutputStream(rendered));
    stderr().write(rendered);
}

/// Prints the given value to stderr without allocating.
void eprint(char[*]? cString) {
    if cString {
        stderr().write(string(cast<char*>(cString)));
    } else {
        stderr().write("null");
    }
}

/// Prints the given values to stderr.
///
/// Copyable arguments pass by value so that a char prints as a single character
/// instead of decaying to a C string in eprint(). Calls with non-Copyable
/// arguments use the borrow overload below.
void eprint<T: Printable + Copyable>(T... args) {
    for arg in args {
        eprint(arg);
    }
}

/// Prints the given values to stderr.
void eprint<T: Printable>(T&... args) {
    for arg in args {
        eprint(arg);
    }
}

/// Prints the given value to stderr followed by a newline.
void eprintln<T>(T& value) {
    eprint(value);
    eprint('\n');
}

/// Prints the given value to stderr followed by a newline.
void eprintln<T: Copyable>(T value) {
    eprint(value);
    eprint('\n');
}

/// Prints the given value to stderr followed by a newline.
void eprintln(char[*]? value) {
    eprint(value);
    eprint('\n');
}

/// Prints the given values to stderr followed by a newline.
///
/// Copyable arguments pass by value so that a char prints as a single character
/// instead of decaying to a C string in eprint(). Calls with non-Copyable
/// arguments use the borrow overload below.
void eprintln<T: Copyable>(T... args) {
    for arg in args {
        eprint(arg);
    }
    eprint('\n');
}

/// Prints the given values to stderr followed by a newline.
void eprintln<T: Printable>(T&... args) {
    for arg in args {
        eprint(arg);
    }
    eprint('\n');
}

/// Reads a line from stdin.
StringBuf readLine() {
    var line = StringBuf();

    while true {
        var c = getchar();

        if c == '\n' || c < 0 {
            break;
        }

        line.push(char(c));
    }

    return line;
}

/// Prints the message to stderr and aborts.
private never assertFail(char* message) {
    var stream = fdopen(2, "w");
    if stream {
        fprintf(stream, "%s", message);
        fclose(stream);
    }
    abortWrapper();
}
