/// Writes formatted output to a file.
struct OutputFileStream {
    private FILE*? file;
    private bool ownsFile;

    /// Opens the given file descriptor for writing.
    OutputFileStream(public int fileDescriptor) {
        file = fdopen(fileDescriptor, "w");

        if !file { // TODO: Error handling
            println("Couldn't open file descriptor ", fileDescriptor, " for writing");
            abort();
        }
        ownsFile = true;
    }

    private OutputFileStream(FILE* file, public bool ownsFile) {
        this.file = file;
        this.ownsFile = ownsFile;
    }

    /// Closes the file.
    ~OutputFileStream() {
        if ownsFile && file {
            fclose(file!);
        }
    }

    /// Writes the given value to the file without allocating.
    void write<T: Printable>(T& value) {
        var stream = OutputStream(file!);
        value.print(stream);
        fflush(file);
    }

    /// Writes the given values to the file, followed by a newline.
    /// Each write is flushed, unlike println, so output appears live when redirected.
    void writeln<T: Printable>(T&... args) {
        for arg in args {
            this.write(arg);
        }
        this.write("\n");
    }
}

private FILE*? stdoutFile = null;
private FILE*? stderrFile = null;

/// Opens the standard file descriptor on first use, caching the result so repeated calls share one file.
private FILE* openStandardFile(FILE*?* cachedFile, int fileDescriptor) {
    if !*cachedFile {
        *cachedFile = fdopen(fileDescriptor, "w");

        if !*cachedFile { // TODO: Error handling
            println("Couldn't open file descriptor ", fileDescriptor, " for writing");
            abort();
        }
    }
    return (*cachedFile)!;
}

/// Returns a stream writing to standard output.
OutputFileStream stdout() {
    return OutputFileStream(openStandardFile(&stdoutFile, 1), false);
}

/// Returns a stream writing to standard error.
OutputFileStream stderr() {
    return OutputFileStream(openStandardFile(&stderrFile, 2), false);
}
