/// A (possibly stateful) memory allocator: allocation and deallocation function
/// pointers plus an opaque state pointer passed to both. Function pointers
/// instead of an interface because interfaces cannot be stored in variables.
struct Allocator {
    void*? state;
    void*?(void*?, c_size_t) alloc;
    void(void*?, void*?) free;
}

/// The ambient context: process-wide settings implicitly used by the standard
/// library. Like in Odin and Jai, library code allocates through the
/// allocator found here instead of calling malloc directly.
struct Context {
    Allocator allocator;
}

// The ambient context, initialized to the default context on first use.
// ponytail: plain global, threads would need this to be thread-local instead.
private Context? ambientContext = null;

/// Returns the ambient context, creating it on first use.
Context& context() {
    if ambientContext == null {
        ambientContext = Context(defaultAllocator());
    }
    return ambientContext!;
}

/// Returns the default allocator, which allocates with malloc and frees with free.
Allocator defaultAllocator() {
    return Allocator(state = null, alloc = defaultAlloc, free = defaultFree);
}

private void*? defaultAlloc(void*? state, c_size_t size) {
    return malloc(size);
}

private void defaultFree(void*? state, void*? ptr) {
    free(ptr);
}

/// Runs `body` with the given allocator installed in the ambient context,
/// restoring the previous allocator afterwards.
void withAllocator(Allocator allocator, void() body) {
    var old = context().allocator;
    context().allocator = allocator;
    body();
    context().allocator = old;
}

/// Allocates through the ambient context's allocator. The returned pointer
/// must be 16-aligned; custom allocators must uphold that.
private void*? rawAlloc(c_size_t size) {
    var allocator = context().allocator;
    return allocator.alloc(allocator.state, size);
}

/// Frees through the ambient context's allocator. Must tolerate null like free.
/// Each allocation must be freed with the same allocator that allocated it.
private void rawFree(void*? ptr) {
    var allocator = context().allocator;
    allocator.free(allocator.state, ptr);
}

#if LeakCheck
// Size header for leak tracking. Stored immediately before the user pointer;
// the header size is rounded up to 16 bytes so the user pointer stays 16-aligned.
// The magic tells live allocations from anything else, so double frees (and
// frees of foreign pointers) abort with a message instead of corrupting the
// counts or crashing inside malloc. The mark cannot distinguish the two:
// malloc reuses freed blocks for its own bookkeeping, clobbering any
// would-be "freed" marker. A pointer freed, reallocated, and freed again
// looks live and is not caught.
private const uint64 allocatedMagic = 0x4C4956454C495645; // "LIVE" x2

private struct LeakHeader {
    uint64 size;
    uint64 magic;
}

private int leakCount = 0;
private uint64 leakBytes = 0;

private uint64 leakHeaderSize() {
    return (uint64(sizeof(LeakHeader)) + 15) / 16 * 16;
}

private void*? cxMalloc(c_size_t size) {
    var headerSize = leakHeaderSize();
    var userSize = uint64(size);
    if userSize == 0 {
        // malloc(0) may return null; keep zero-size allocations non-null.
        userSize = 1;
    }
    if userSize > uint64(-1) - headerSize {
        return null;
    }
    var raw = rawAlloc(c_size_t(headerSize + userSize));
    if raw == null {
        return null;
    }
    var header = cast<LeakHeader*>(raw);
    header.init(LeakHeader(size = userSize, magic = allocatedMagic));
    leakCount++;
    leakBytes += userSize;
    var bytes = cast<uint8[*]>(raw);
    return cast<void*>(&bytes[headerSize]);
}

private void cxFree(void*? ptr) {
    if ptr == null {
        return;
    }
    var headerSize = leakHeaderSize();
    var header = cast<LeakHeader*>(cast<uint64>(ptr) - headerSize);
    if header.magic != allocatedMagic {
        abort("double free or invalid free detected");
    }
    leakCount--;
    leakBytes -= header.size;
    rawFree(header);
}

// Called by the compiler at the end of main in debug builds. Reports leaks
// to stderr and exits with status 1 (no stack trace: the program already ran
// to completion, and aborting here would dump JIT compiler frames under cx run).
// ponytail: single-threaded only; add a lock if cx gains threads. Reports
// totals only, upgrade by capturing caller location per allocation.
private void checkLeaks() {
    if leakCount != 0 {
        fflush(null);
        var err = stderr();
        err.write("memory leak: ");
        err.write(leakCount);
        err.write(" allocation(s), ");
        err.write(leakBytes);
        err.write(" byte(s) leaked");
        err.write('\n');
        exit(c_int(1));
    }
}
#else
private void*? cxMalloc(c_size_t size) {
    // malloc(0) may return null; keep zero-size allocations non-null.
    if size == 0 {
        size = c_size_t(1);
    }
    return rawAlloc(size);
}

private void cxFree(void*? ptr) {
    if ptr == null {
        return;
    }
    rawFree(ptr);
}
#endif

// Computes `sizeof(T) * count` into `size`, returning false for negative counts or on overflow.
private bool checkedArraySize<T>(int64 count, uint64& size) {
    if count < 0 {
        return false;
    }
    var elementSize = uint64(sizeof(T));
    var ucount = uint64(count);
    if ucount != 0 && elementSize > uint64(-1) / ucount {
        return false;
    }
    *size = elementSize * ucount;
    return true;
}

/// Allocates uninitialized storage for `count` values and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// The allocation goes through the ambient context's allocator.
///
/// If the count is negative, the size overflows, or the allocation fails, the program aborts.
///
T[*] allocate<T>(int64 count) {
    var size = uint64(0);
    // Aborts rather than asserts: proceeding with an unchecked size would corrupt the heap in release builds.
    if !checkedArraySize<T>(count, size) {
        abort("allocation size overflow");
    }
    return cast<T[*]>(cxMalloc(c_size_t(size))!);
}

/// Allocates uninitialized storage for `count` values and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the count is negative, the size overflows, or the allocation fails, null is returned.
///
T[*]? tryAllocate<T>(int64 count) {
    var size = uint64(0);
    if !checkedArraySize<T>(count, size) {
        return null;
    }
    var allocation = cxMalloc(c_size_t(size));
    if allocation == null {
        return null;
    }
    return cast<T[*]>(allocation);
}

/// Moves the given value into newly allocated dynamic memory and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the memory allocation fails, the program aborts.
///
T* allocateValue<T>(T value) {
    var allocation = cast<T*>(cxMalloc(c_size_t(sizeof(T)))!);
    allocation.init(value);
    return allocation;
}

/// Moves the given value into newly allocated dynamic memory and returns a pointer to it.
/// The block can be freed by passing the returned pointer to `deallocate`.
///
/// If the memory allocation fails, null is returned.
///
T*? tryAllocateValue<T>(T value) {
    var allocation = cast<T*?>(cxMalloc(c_size_t(sizeof(T))));
    if allocation != null {
        allocation.init(value);
    }
    return allocation;
}

/// Deallocates a block of dynamic memory that was previously allocated by a call to `allocate`,
/// `tryAllocate`, `allocateValue`, or `tryAllocateValue`. If the argument is null, no operation
/// is performed. The ambient context's allocator must be the same one that allocated the block.
void deallocate<T>(T allocation) {
    cxFree(allocation);
}
