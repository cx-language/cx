// TODO: Remove code duplication by declaring a 'FloatingPoint' interface that implements the
// 'compare' function for all floating-point types.

private void printFloat(float64 value, StringBuffer* stream) {
    // NaN has an implementation-defined sign; print all NaNs the same.
    if value != value {
        stream.write("nan");
        return;
    }
    // Maximum length from https://stackoverflow.com/a/1701272/3425536
    char[1080] result = undefined;
    // Shortest representation that parses back to the same value. 17 significant
    // digits always round-trip for 64-bit floats, so some precision always matches
    // (except NaN, which falls back to the full-precision rendering below).
    int bestPrecision = 17;
    uint64 bestLength = 1080;
    for precision in 1..18 {
        sprintf(result, "%.*g", precision, value);
        uint64 length = strlen(result);
        if strtod(result, null) == value && length < bestLength {
            bestPrecision = precision;
            bestLength = length;
        }
    }
    sprintf(result, "%.*g", bestPrecision, value);
    stream.append(string(result));
}

private void printFloat32(float32 value, StringBuffer* stream) {
    // NaN has an implementation-defined sign; print all NaNs the same.
    if value != value {
        stream.write("nan");
        return;
    }
    char[1080] result = undefined;
    // Shortest representation that parses back to the same value; 9 significant
    // digits always round-trip for 32-bit floats.
    int bestPrecision = 9;
    uint64 bestLength = 1080;
    for precision in 1..10 {
        sprintf(result, "%.*g", precision, float64(value));
        uint64 length = strlen(result);
        if strtof(result, null) == value && length < bestLength {
            bestPrecision = precision;
            bestLength = length;
        }
    }
    sprintf(result, "%.*g", bestPrecision, float64(value));
    stream.append(string(result));
}

private void printFloat16(float16 value, StringBuffer* stream) {
    // NaN has an implementation-defined sign; print all NaNs the same.
    if value != value {
        stream.write("nan");
        return;
    }
    char[1080] result = undefined;
    // Shortest representation that parses back to the same value; 5 significant
    // digits always round-trip for 16-bit floats.
    int bestPrecision = 5;
    uint64 bestLength = 1080;
    for precision in 1..6 {
        sprintf(result, "%.*g", precision, float64(value));
        uint64 length = strlen(result);
        if float16(strtof(result, null)) == value && length < bestLength {
            bestPrecision = precision;
            bestLength = length;
        }
    }
    sprintf(result, "%.*g", bestPrecision, float64(value));
    stream.append(string(result));
}

/// A floating-point number.
struct float: Copyable, Comparable, Printable {
    /// Compares this value to another.
    Ordering compare(float* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream, using the shortest
    /// representation that parses back to the same value.
    void print(StringBuffer* stream) {
        printFloat32(this, stream);
    }
}

/// A 16-bit floating-point number.
struct float16: Copyable, Comparable, Printable {
    /// Compares this value to another.
    Ordering compare(float16* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream, using the shortest
    /// representation that parses back to the same value.
    void print(StringBuffer* stream) {
        printFloat16(this, stream);
    }
}

/// A 32-bit floating-point number.
struct float32: Copyable, Comparable, Printable {
    /// Compares this value to another.
    Ordering compare(float32* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream, using the shortest
    /// representation that parses back to the same value.
    void print(StringBuffer* stream) {
        printFloat32(this, stream);
    }
}

/// A 64-bit floating-point number.
struct float64: Copyable, Comparable, Printable {
    /// Compares this value to another.
    Ordering compare(float64* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }

    /// Writes this value to the given stream, using the shortest
    /// representation that parses back to the same value.
    void print(StringBuffer* stream) {
        printFloat(this, stream);
    }
}

/// An 80-bit floating-point number.
struct float80: Copyable, Comparable {
    /// Compares this value to another.
    Ordering compare(float80* other) {
        return this < other ? Ordering.Less : this > other ? Ordering.Greater : Ordering.Equal;
    }
}
