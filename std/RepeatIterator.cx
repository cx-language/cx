// Lazily repeats a value a number of times without allocating.
// Get one from repeat(); collect the results with toList().
struct RepeatIterator<T: Copyable>: Copyable, Iterator<T&> {
    private T value;
    private int count;
    private int index;

    /// Initializes an iterator yielding value count times.
    RepeatIterator(T value, int count) {
        this.value = value;
        this.count = count < 0 ? 0 : count;
        this.index = 0;
    }

    /// Returns true if there are repetitions remaining.
    bool hasValue() {
        return index < count;
    }

    /// Returns the repeated value.
    T& value() {
        return value;
    }

    /// Advances to the next repetition.
    void increment() {
        index++;
    }

    /// Collects the repetitions into a list.
    List<T> toList() {
        var output = List<T>();
        while hasValue() {
            output.push(*value());
            increment();
        }
        return output;
    }
}
