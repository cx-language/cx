/// The result of an operation that can fail: either success (`Ok`) holding the produced value,
/// or failure (`Err`) holding the error.
enum Result<T, E> {
    Ok(T value),
    Err(E error),

    /// Borrows the success value, aborting with the error if the result is `Err`.
    /// To move the value out, match with `switch` instead.
    T& unwrap() {
        return switch this {
            case Ok value: value,
            case Err error: abort("called unwrap() on Err: ", *error),
        };
    }

    /// Writes the result to the given stream.
    void print(OutputStream& stream) {
        switch this {
            case Ok value:
                stream.append("Ok(");
                value.print(stream);
                stream.push(')');
            case Err error:
                stream.append("Err(");
                error.print(stream);
                stream.push(')');
        }
    }
}

/// Prints the given result.
void print<T: Printable, E: Printable>(Result<T, E>& result) {
    var stream = OutputStream();
    result.print(stream);
}
