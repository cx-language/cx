// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// Bare blocks introduce a scope: names can be shadowed and locals are
// destroyed at the end of the block.

struct C {
    int i;
    ~C() {
        println("dtor");
    }
}

void main() {
    int x = 1;
    {
        int x = 2;
        println(x); // CHECK:2
    }
    println(x); // CHECK-NEXT:1
    {
        var c = C(i = 1);
        println("inner"); // CHECK-NEXT:inner
        println(c.i); // CHECK-NEXT:1
        // CHECK-NEXT:dtor
    }
    println("outer"); // CHECK-NEXT:outer
}
