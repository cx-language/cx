// RUN: check_exit_status 0 %cx run %s
// RUN: check_exit_status 0 %cx run --backend=c %s

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

Outcome<int> parseDigit(char c) {
    if c >= '0' && c <= '9' {
        return Ok(int(c) - int('0'));
    }
    return Err(404);
}

int unwrapOr(Outcome<int>& outcome, int defaultValue) {
    switch (*outcome) {
        case Ok value:
            return value;
        case Err:
            return defaultValue;
    }
}

void main() {
    Outcome<int> a = Ok(7);
    Outcome<int> b = Err(404);
    assert(unwrapOr(a, -1) == 7);
    assert(unwrapOr(b, -1) == -1);
    assert(a == Ok);
    assert(a != Err);
    assert(b == Err);
    assert(b != Ok);

    var c = parseDigit('3');
    assert(unwrapOr(c, -1) == 3);
    assert(unwrapOr(parseDigit('x'), -1) == -1);

    Optional<int> absent = None;
    assert(absent == null);
    int? d = None;
    assert(d == null);
    int? present = Some(5);
    assert(present! == 5);

    Result<int, string> e = Ok(1);
    assert(e.unwrap() == 1);

    Outcome<Outcome<int> > nested = Ok(Err(500));
    switch (nested) {
        case Ok inner:
            assert(unwrapOr(inner, -2) == -2);
        case Err:
            assert(false);
    }

    var f = parseDigit('7');
    f = Err(503);
    assert(unwrapOr(f, -1) == -1);

    var qualified = Outcome.Ok(9);
    assert(unwrapOr(qualified, -1) == 9);
}
