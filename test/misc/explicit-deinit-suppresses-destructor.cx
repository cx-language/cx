// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

struct C {
    int i;
    ~C() {
        println("dtor");
    }
}

void main() {
    var c = C(i = 1);
    c.deinit(); // CHECK:dtor
    println("after"); // CHECK-NEXT:after

    var d = C(i = 2);
    println("done"); // CHECK-NEXT:done

    var e = C(i = 3);
    var pe = &e;
    pe.deinit(); // CHECK-NEXT:dtor
    println("pointer done"); // CHECK-NEXT:pointer done

    var a = [C(i = 4)];
    var pa = &a;
    C[*] s = pa;
    s.deinit();
    println("slice done"); // CHECK-NEXT:slice done
    // CHECK-NEXT:dtor
    // CHECK-NEXT:dtor
}
