// RUN: %not %cx run -Wno-unused %s 2>&1 | %FileCheck %s
// UNSUPPORTED: windows
// UCRT routes every bad descriptor through the invalid parameter handler
// (Watson crash) instead of returning null like POSIX, so the message below
// never prints there.

void main() {
    // CHECK: Couldn't open file descriptor 999 for writing
    var s = OutputFileStream(999);
}
