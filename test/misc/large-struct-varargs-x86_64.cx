// REQUIRES: x86_64
// RUN: %cx -print-llvm %s | %FileCheck %s

extern void sink(...);

struct Big {
    int a;
    int b;
    int c;
    int d;
    int e;
}

void main() {
    var b = Big(1, 2, 3, 4, 5);
    sink(b);
}

// AArch64 passes the struct as a pointer instead; that shape is pinned in
// driver/extern-struct-abi-aarch64.cx.
// CHECK: call void (...) @sink(%Big %{{[0-9]+}})
