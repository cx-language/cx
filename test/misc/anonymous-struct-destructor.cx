// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s

struct Logger {
    string prefix;
    ~Logger() {
        println(prefix, " closed");
    }
}

struct Wrapper {
    (Logger log, int tag) t;
}

void withAnonymousStruct() {
    var _t = (log = Logger(prefix = "anon"), tag = 0);
    println("working anon");
}

void withWrapper() {
    var _w = Wrapper(t = (log = Logger(prefix = "wrapped"), tag = 0));
    println("working wrapped");
}

void withReassignment() {
    var t = (log = Logger(prefix = "first"), tag = 0);
    t = (log = Logger(prefix = "second"), tag = 0);
    println("end");
}

void main() {
    // CHECK:working anon
    // CHECK-NEXT:anon closed
    withAnonymousStruct();
    // CHECK-NEXT:working wrapped
    // CHECK-NEXT:wrapped closed
    withWrapper();
    // CHECK-NEXT:first closed
    // CHECK-NEXT:end
    // CHECK-NEXT:second closed
    withReassignment();
}
