// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

int counter = 0;

int next() {
    counter = counter + 1;
    return counter;
}

void greet(public string name = "world") {
    println(name);
}

void count(int x = next()) {
    println(x);
}

struct S {
    int x;
    int y;
    S(public int x, public int y = 10) {
        this.x = x;
        this.y = y;
    }
}

void main() {
    greet(); // CHECK:world
    greet(name = "cx"); // CHECK-NEXT:cx
    count(); // CHECK-NEXT:1
    count(); // CHECK-NEXT:2
    count(10); // CHECK-NEXT:10

    var s = S(x = 1);
    println(s.y); // CHECK-NEXT:10
}
