// RUN: %cx --backend=c --print-c %s | %FileCheck %s

// Unreferenced parameters (including `this`) spill like any other parameter.

// CHECK-LABEL: 1C1fE{{.*}} this) {
// CHECK-NEXT: struct {{.*}}* this0;
// CHECK-NEXT: *(&this0) = this;

struct C {
    int i;

    int f() {
        return 42;
    }
}

void main() {
    var c = C(i = 1);
    println(c.f());
}
