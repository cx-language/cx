// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s

enum E {
    Some(int),
    None,
}

enum Multi {
    Pair(int, string),
    Arr(int[2]),
    None,
}

void main() {
    var e = E.Some(42);
    if e is Some {
        println("some"); // CHECK:some
    } else {
        println("none");
    }
    var a = Multi.Pair(1, "x");
    var b = Multi.Arr([7, 8]);
    if a is Pair && b is Arr {
        println("all"); // CHECK-NEXT:all
    } else {
        println("none");
    }
}
