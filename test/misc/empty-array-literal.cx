// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx --backend=c --print-c %s | %FileCheck --check-prefix=PRINT %s
// CHECK-NOT: empty-array-literal.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
// MSVC rejects zero-size arrays, so the C backend over-allocates one element.
// PRINT: z1[1];

int count(string[] parts) {
    var n = 0;
    for _ in parts {
        n++;
    }
    return n;
}

void main() {
    string[] e = [];
    // CHECK:0
    println(e.size());
    // CHECK-NEXT:0
    println(count([]));
    string[0] z = [];
    // CHECK-NEXT:0
    println(count(z));
    // CHECK-NEXT:0
    println(z.size());
    for _ in z {
        println("unreachable");
    }
    // CHECK-NEXT:done
    println("done");
}

// CHECK-NOT: empty-array-literal.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
