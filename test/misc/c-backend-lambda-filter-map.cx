// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:[0, 4, 8]
// CHECK-NEXT:[4, 6]
// CHECK-NEXT:[0, 2, 4]

// Passing a lambda to filter must not corrupt IR emission for the enclosing
// function: temporaries created after the lambda argument (such as the
// intermediate list of a filter/map chain) belong to the caller, not to the
// lambda. The C backend emits each function body linearly, so a misplaced
// temporary produces uncompilable C.

void main() {
    var doubled = List([0, 1, 2, 3, 4]).filter(n => n % 2 == 0).map(n => n * 2).toList();
    println(doubled);

    var filtered = List([0, 1, 2, 3, 4, 5, 6]).filter(n => n % 2 == 0 && n > 2).toList();
    println(filtered);

    var even = List([0, 1, 2, 3, 4]).filter(n => n % 2 == 0).toList();
    println(even);
}
