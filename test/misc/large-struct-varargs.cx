// RUN: %cx -print-llvm %s | %FileCheck %s

extern void sink(...);

struct Big {
    int a;
    int b;
    int c;
    int d;
    int e;
}

void main() {
    var b = Big(1, 2, 3, 4, 5);
    sink(b);
}

// CHECK-NOT: large-struct-varargs.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
// CHECK: call void (...) @sink(%Big %{{[0-9]+}})
// CHECK-NOT: large-struct-varargs.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
