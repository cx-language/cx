// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

struct Loud {
    string s;
    ~Loud() {
        println("dtor");
    }
}

void takesArrayList(List<int[2]> x) {
}

void main() {
    // Fixed-array element types demand-check List's destructor.
    var empty = List<int[2]>();
    takesArrayList(empty);

    // Explicit deinit destroys each element and suppresses scope-exit destruction.
    var arr = [Loud(s = "a"), Loud(s = "b")];
    arr.deinit(); // CHECK:dtor
    // CHECK-NEXT:dtor
    println("after"); // CHECK-NEXT:after

    // List destruction destroys fixed-array elements (a leak would fail the run).
    if (true) {
        var a = List<string[2]>();
        a.push(["aa", "bb"]);
    }
    println("done"); // CHECK-NEXT:done
}

// CHECK-NOT: dtor
