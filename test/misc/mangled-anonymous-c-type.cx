// RUN: %cx --print-ir %s 2>&1 | %FileCheck %s

import "inputs/mangled-anonymous-c-type.h";

// Anonymous C types mangle by their generated name. The same type spells
// the same name in all three positions.
// CHECK: _CX1N4main5identIM42inputs_2Fmangled_2Danonymous_2Dc_2Dtype__h16AnonymousRecord0EEM42inputs_2Fmangled_2Danonymous_2Dc_2Dtype__h16AnonymousRecord01_M42inputs_2Fmangled_2Danonymous_2Dc_2Dtype__h16AnonymousRecord0

T ident<T>(T x) { return x; }

void main() {
    var o = getOuter();
    print(ident(o.inner).x);
}

