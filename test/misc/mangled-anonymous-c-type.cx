// RUN: %cx --print-ir %s 2>&1 | %FileCheck %s

import "inputs/mangled-anonymous-c-type.h";

// Anonymous C types have no name to mangle; a creation-order index tells
// them apart. The same type spells the same index in all three positions.
// CHECK: _CX1N4main5identI0[[N:[0-9]+]]_EE0[[N]]_1_0[[N]]_

T ident<T>(T x) { return x; }

void main() {
    var o = getOuter();
    print(ident(o.inner).x);
}

