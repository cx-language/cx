// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:2
// CHECK-NEXT:5
// CHECK-NEXT:5
// CHECK-NEXT:42
// CHECK-NEXT:42
// CHECK-NEXT:9

// Assignments evaluate to the left-hand side and associate to the right,
// so `a = b = 1` assigns both.

int assignTwice() {
    int a = 0;
    int b = 0;
    a = b = 1;
    return a + b;
}

void main() {
    println(assignTwice());
    int a = 0;
    var x = a = 5;
    println(x);
    println(a);
    var arr = [0, 0];
    var y = arr[0] = 42;
    println(y);
    println(arr[0]);
    int b = 4;
    var z = b += 5;
    println(z);
}
