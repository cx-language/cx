// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

struct S {
    int x;
};

struct Wrap<T> {
    T value;
};

enum E {
    A,
    B
};

interface I {
    void f();
};

void main() {
    var s = S(x = 1);
    println(s.x); // CHECK:1
    var b = Wrap<int>(value = 1);
    println(b.value); // CHECK-NEXT:1
    println(int(E.B)); // CHECK-NEXT:1
}
