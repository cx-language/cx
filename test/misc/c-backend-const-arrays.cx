// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:[2.5, 3.5, 4.5]
// CHECK-NEXT:[0.875, 0.875, 0.875]
// CHECK-NEXT:[1.5, 3, 4.5]
// CHECK-NEXT:0.75

// Array literals nested in expressions and const globals with non-trivial
// initializers must not emit declarations inside C expressions.
const float[3] white = [1.0, 1.0, 1.0];
const float quarter = 1.0 - 0.75;
const float tripleQuarter = quarter * 3.0;

float[3] blend(float t, float s) {
    return [1.0, 2.0, 3.0] * t + [4.0, 5.0, 6.0] * s;
}

float[3] shade(float[3] c) {
    return c * quarter + white * (1.0 - quarter);
}

void main() {
    println(blend(0.5, 0.5));
    println(shade([0.5, 0.5, 0.5]));
    println([2.0, 4.0, 6.0] * (quarter * 3.0));
    println(tripleQuarter);
}
