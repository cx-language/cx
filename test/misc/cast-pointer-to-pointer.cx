// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s

import "stdlib.h";

void main() {
    var p = malloc(8)!;
    int* ip = cast<int*>(p);
    *ip = 42;
    // Pointers reinterpret between any two pointee types without going through void*.
    uint* up = cast<uint*>(ip);
    println(*up); // CHECK:42
    float* fp = cast<float*>(ip);
    var cp = cast<uint8*>(p);
    var s = cast<char*>(cp);
    _ = fp;
    _ = s;
    println("ok"); // CHECK:ok
    free(p);
}
