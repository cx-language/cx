// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s

struct S {
    float[3] arr;
}

S makeS() {
    return S([1.0, 2.0, 3.0]);
}

float[3] maybeArray(bool b) {
    if b {
        return [1.0, 2.0, 3.0];
    }
    return undefined;
}

void main() {
    // Extracting an array-typed field needs a copy, C arrays don't assign.
    var x = makeS().arr;
    println(x[0] + x[1] + x[2]); // CHECK:6

    // Returning undefined must compile (zeroed) rather than crash codegen.
    println(maybeArray(false)[0]); // CHECK-NEXT:0
}
