// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK-NOT: overload-empty-array-literal.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

string pick(string[] parts) { return "array"; }
string pick(List<string>* parts) { return "list"; }

void main() {
    // CHECK:array
    println(pick([]));
    var list = List<string>();
    // CHECK-NEXT:list
    println(pick(&list));
}

// CHECK-NOT: overload-empty-array-literal.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
