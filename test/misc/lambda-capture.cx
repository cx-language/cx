// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
void capturesParam(int p) {
    var d = 3;
    var b = (int c) => c + p + d;
    println(b(1));
}

struct S {
    int d;

    int get(int c) {
        var b = (int x) => x + c + d;
        return b(1);
    }

    int callMethod(int c) {
        var b = (int x) => x + helper(c);
        return b(1);
    }

    int helper(int y) {
        return y * 2;
    }
}

void nested() {
    var a = 1;
    a = 41;
    var outer = (int b) {
        var inner = (int c) => a + b + c;
        return inner(100);
    };
    println(outer(10));
}

void capturesAreCopies() {
    var a = 1;
    var b = (int c) => c + a;
    a = 99;
    println(b(0));
}

void loopCapture() {
    for i in 0..3 {
        var f = (int c) => c + i * 10;
        println(f(1));
    }
}

void stringAndOptional() {
    var s = "hi";
    int? o = 5;
    var h = () => s;
    println(h());
    var j = () => o;
    println(j());
}

void pointerSeesMutations() {
    var a = 1;
    var p = &a;
    var f = () => *p + 1;
    a = 10;
    println(f());
}

void closureCallsClosure() {
    var a = 1;
    var f = (int c) => c + a;
    var g = (int c) => f(c) * 2;
    println(g(10));
}

void callIt<T>(T f, int x) {
    println(f(x));
}

struct Point {
    int x;
    int y;
}

void structCapture() {
    var p = Point(x = 1, y = 2);
    var f = (int c) => p.x + p.y + c;
    println(f(10));
}

struct Tracer {
    int id;

    ~Tracer() {
        println("deinit ", id);
    }
}

void destructorRunsOnce() {
    var t = Tracer(id = 7);
    var f = () => t.id;
    println("call ", f());
    println("call ", f());
    println("end");
}

struct Counter {
    int n;

    void bump(int times) {
        var f = () {
            n = n + 1;
        };
        for i in 0..times {
            f();
        }
    }
}

struct CopyableCounter {
    int n;

    void bump() {
        var f = () {
            n = 5;
        };
        f();
    }

    void bumpNested() {
        var g = () {
            var f = () {
                n = 7;
            };
            f();
        };
        g();
    }
}

void captureStoreIsLocal() {
    var a = 1;
    var f = () {
        a = 5;
    };
    f();
    println(a);
}

struct CopyablePoint {
    int x;
    int y;
}

void structFieldStoreIsLocal() {
    var p = CopyablePoint(x = 1, y = 2);
    var f = () {
        p.x = 9;
    };
    f();
    println(p.x);
}

void main() {
    capturesParam(100); // CHECK:104
    var s = S(d = 5);
    println(s.get(1)); // CHECK-NEXT:7
    println(s.callMethod(21)); // CHECK-NEXT:43
    nested(); // CHECK-NEXT:151
    capturesAreCopies(); // CHECK-NEXT:1
    // CHECK-NEXT:1
    // CHECK-NEXT:11
    // CHECK-NEXT:21
    loopCapture();
    // CHECK-NEXT:hi
    // CHECK-NEXT:5
    stringAndOptional();
    pointerSeesMutations(); // CHECK-NEXT:11
    closureCallsClosure(); // CHECK-NEXT:22
    var a = 10;
    var f = (int c) => c + a;
    callIt(f, 1); // CHECK-NEXT:11
    var g = f;
    println(g(2)); // CHECK-NEXT:12
    structCapture(); // CHECK-NEXT:13
    // CHECK-NEXT:call 7
    // CHECK-NEXT:call 7
    // CHECK-NEXT:end
    // CHECK-NEXT:deinit 7
    destructorRunsOnce();
    var c = Counter(n = 0);
    c.bump(3);
    println(c.n); // CHECK-NEXT:3
    var cc = CopyableCounter(n = 0);
    cc.bump();
    println(cc.n); // CHECK-NEXT:5
    cc.bumpNested();
    println(cc.n); // CHECK-NEXT:7
    captureStoreIsLocal(); // CHECK-NEXT:1
    structFieldStoreIsLocal(); // CHECK-NEXT:1
}
