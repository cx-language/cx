// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK-NOT: numeric-type-aliases.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    // CHECK:127
    sbyte a = sbyte.max;
    println(a);
    // CHECK-NEXT:-128
    println(sbyte.min);
    // CHECK-NEXT:32767
    int16 b = int16.max;
    println(b);
    // CHECK-NEXT:-32768
    println(int16.min);
    // CHECK-NEXT:65535
    uint16 c = uint16.max;
    println(c);
    // CHECK-NEXT:0
    println(uint16.min);
    // CHECK-NEXT:9223372036854775807
    int64 d = int64.max;
    println(d);
    // CHECK-NEXT:-9223372036854775808
    println(int64.min);
    // CHECK-NEXT:18446744073709551615
    uint64 e = uint64.max;
    println(e);
    // CHECK-NEXT:0
    println(uint64.min);
    // CHECK-NEXT:2
    println(sizeof(int16));
    // CHECK-NEXT:8
    println(sizeof(int64));
    // CHECK-NEXT:8
    println(sizeof(uint64));
    // CHECK-NEXT:8
    println(sizeof(double));
    // CHECK-NEXT:1.5
    double f = 1.5;
    println(f);
    // CHECK-NEXT:2.5
    println(double(2) + 0.5);
    // CHECK-NEXT:-5
    int8 g = sbyte(-5);
    println(g);
    // CHECK-NEXT:70000
    int64 h = int64(70000);
    println(h);
    // CHECK-NEXT:0.5
    float64 i = double(0.5);
    println(i);
    // CHECK-NEXT:2147483647
    int32 i32 = int.max;
    println(i32);
    // CHECK-NEXT:-2147483648
    int j = int32.min;
    println(j);
    // CHECK-NEXT:4294967295
    uint32 u32 = uint.max;
    println(u32);
    // CHECK-NEXT:255
    uint8 u8 = byte.max;
    println(u8);
    // CHECK-NEXT:2.5
    float flt = 2.5;
    float32 f32 = flt;
    println(f32);
    // CHECK-NEXT:3
    List<int> list = List([1, 2]);
    List<int32> same = list;
    println(same.size() + 1);
}
// CHECK-NOT: numeric-type-aliases.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
