// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// Array sizes accept named constants and member access on them, at top
// level and inside functions. Locals shadow globals; signatures and generic
// instantiations resolve in their own scope.

const N = 8;
const M = N * 2;
const res = [800, 600];
const alias = res;
const e = 5;
const e2 = 600;
const res2 = [e, e2];

uint8[res.x * res.y * 3] pixels = undefined;
uint8[N] a = undefined;
uint8[M + 1] b = undefined;
uint8[res.y] c = undefined;
uint8[N > 0 ? N : 1] d = undefined;
uint8[alias.x] f = undefined;
uint8[res2.x] g = undefined;

struct S {
    uint8[N] buf;
}

struct G<int K> {
    uint8[K] buf;
}

struct B<int K> {
    uint8[K + 1] buf;
}

using Buf = uint8[N * 2];

uint8[N] glob() {
    uint8[8] buf = undefined;
    return buf;
}

void takeSized(uint8[N] x) {
    println(x.size());
}

uint8[M + 1] useBufSize<T>(T x) {
    uint8[M + 1] buf = undefined;
    return buf;
}

uint8[M + K] mixSize<int K>() {
    uint8[M + K] buf = undefined;
    return buf;
}

void takeBuf<T>(uint8[M + 1] x, T y) {
    println(x.size());
}


void main() {
    println(pixels.size()); // CHECK:1440000
    println(a.size()); // CHECK-NEXT:8
    println(b.size()); // CHECK-NEXT:17
    println(c.size()); // CHECK-NEXT:600
    println(d.size()); // CHECK-NEXT:8
    var s = S([0, 0, 0, 0, 0, 0, 0, 0]);
    println(s.buf.size()); // CHECK-NEXT:8
    Buf t = undefined;
    println(t.size()); // CHECK-NEXT:16
    println(f.size()); // CHECK-NEXT:800
    println(g.size()); // CHECK-NEXT:5
    var h = G<4>([0, 0, 0, 0]);
    println(h.buf.size()); // CHECK-NEXT:4
    println(glob().size()); // CHECK-NEXT:8
    takeSized([0, 0, 0, 0, 0, 0, 0, 0]); // CHECK-NEXT:8
    {
        const N = 100;
        const M = 100;
        takeSized([0, 0, 0, 0, 0, 0, 0, 0]); // CHECK-NEXT:8
        println(useBufSize(0).size()); // CHECK-NEXT:17
        uint8[N] shadowed = undefined;
        println(shadowed.size()); // CHECK-NEXT:100
    }
    const N = 5;
    uint8[N] la = undefined;
    println(la.size()); // CHECK-NEXT:5
    uint8[N * 2] lb = undefined;
    println(lb.size()); // CHECK-NEXT:10
    uint8[res.x] lc = undefined;
    println(lc.size()); // CHECK-NEXT:800
    uint8[N > 0 ? N : 1] ld = undefined;
    println(ld.size()); // CHECK-NEXT:5
    var b4 = B<4>([0, 0, 0, 0, 0]);
    println(b4.buf.size()); // CHECK-NEXT:5
    println(mixSize<4>().size()); // CHECK-NEXT:20
    takeBuf(useBufSize(0), 0); // CHECK-NEXT:17
}
