// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// Borrows auto-deref in conditions and switches; &this gives a storable pointer.

string yesNo(bool& value) {
    if value {
        return "yes";
    }
    return "no";
}

bool negate(bool& value) {
    return !value;
}

bool both(bool& a, bool& b) {
    return a && b;
}

void drain(int& remaining) {
    while remaining > 0 {
        println(remaining);
        *remaining = *remaining - 1;
    }
}

string describe(int& value) {
    switch value {
        case 1: return "one";
        case 2: return "two";
        default: return "other";
    }
}

enum Color {
    Red,
    Green,
    Blue,

    string name() {
        switch this {
            case Red: return "red";
            case Green: return "green";
            case Blue: return "blue";
        }
    }
}

enum Outcome {
    Ok,
    Fail,

    bool isOk() {
        return this is Ok;
    }
}

enum Request {
    Found(int code),
    Missing,

    bool isFound() {
        return this is Found;
    }
}

struct Node {
    int id;

    Node* self() {
        return &this;
    }

    bool isSelf(Node* other) {
        return &this == other;
    }
}

void main() {
    var flag = true;
    println(yesNo(flag)); // CHECK:yes
    flag = false;
    println(yesNo(flag)); // CHECK-NEXT:no
    println(negate(true)); // CHECK-NEXT:false
    println(negate(false)); // CHECK-NEXT:true
    println(both(true, true)); // CHECK-NEXT:true
    println(both(true, false)); // CHECK-NEXT:false
    var fuel = 3;
    // CHECK-NEXT:3
    // CHECK-NEXT:2
    // CHECK-NEXT:1
    drain(fuel);
    println(fuel); // CHECK-NEXT:0
    println(describe(2)); // CHECK-NEXT:two
    var color = Color.Green;
    println(color.name()); // CHECK-NEXT:green
    println(Outcome.Ok.isOk()); // CHECK-NEXT:true
    println(Outcome.Fail.isOk()); // CHECK-NEXT:false
    var found = Request.Found(200);
    println(found.isFound()); // CHECK-NEXT:true
    println(Request.Missing.isFound()); // CHECK-NEXT:false
    var node = Node(7);
    println(node.isSelf(node.self())); // CHECK-NEXT:true
    println(node.isSelf(&node)); // CHECK-NEXT:true
    var other = Node(8);
    println(node.isSelf(&other)); // CHECK-NEXT:false
}
