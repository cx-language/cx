// RUN: %cx run -Werror %S/../../examples/entity-handles.cx 2>&1 | %FileCheck -match-full-lines %s
// RUN: %cx run -Werror --backend=c %S/../../examples/entity-handles.cx 2>&1 | %FileCheck -match-full-lines %s

// CHECK-NOT: entity-handles.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
