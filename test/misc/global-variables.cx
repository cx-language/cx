// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:41
// CHECK-NEXT:1.5
// CHECK-NEXT:true
// CHECK-NEXT:4
// CHECK-NEXT:42
// CHECK-NEXT:42

// Global initializers may reference later declarations.
const usesLater = definedLater * 2;
const definedLater = 21;

int gi = 41;
float gf = 1.5;
bool gb = true;
var si = sizeof(int);

int addOne(int x) {
    return x + 1;
}

var f = addOne;

void main() {
    println(gi);
    println(gf);
    println(gb);
    println(si);
    println(f(gi));
    println(usesLater);
}
