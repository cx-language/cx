// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s

// Global initializers may reference later declarations.
const usesLater = definedLater * 2;
const definedLater = 21;

int gi = 41;
float gf = 1.5;
bool gb = true;
var si = sizeof(int);

int addOne(int x) {
    return x + 1;
}

var f = addOne;

void main() {
    println(gi); // CHECK:41
    println(gf); // CHECK-NEXT:1.5
    println(gb); // CHECK-NEXT:true
    println(si); // CHECK-NEXT:4
    println(f(gi)); // CHECK-NEXT:42
    println(usesLater); // CHECK-NEXT:42
}
