// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    var x = 1;
    var c = true;
    if c {
        var x = 2;
        println(x); // CHECK:2
    } else {
        var x = 3;
        println(x);
    }
    println(x); // CHECK-NEXT:1
    // CHECK-NEXT:0
    // CHECK-NEXT:1
    for i in 0..2 {
        var y = i;
        println(y);
    }
    // CHECK-NEXT:0
    for i in 0..1 {
        var y = i;
        println(y);
    }
}
