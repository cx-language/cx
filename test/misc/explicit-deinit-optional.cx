// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

int deaths = 0;

struct S {
    int x;
    ~S() {
        deaths++;
    }
}

void main() {
    // deinit through a dereferenced optional buffer destroys the payload once.
    var buf = allocate<S?>(1);
    buf[0] = S(x = 5);
    var before = deaths;
    (*buf).deinit();
    println(deaths - before); // CHECK:1
    deallocate(buf);

    // Same for non-optional pointees: deinit destroys in place, so moving
    // out of the dereference is not involved.
    var buf2 = allocate<S>(1);
    buf2[0] = S(x = 6);
    before = deaths;
    (*buf2).deinit();
    println(deaths - before); // CHECK-NEXT:1
    deallocate(buf2);

    // deinit on an optional local destroys the payload and suppresses the scope destructor.
    {
        S? o = S(x = 5);
        before = deaths;
        o.deinit();
        println(deaths - before); // CHECK-NEXT:1
    }
    println(deaths - before); // CHECK-NEXT:1
}
