// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    int?? d = 5;
    println(d!!); // CHECK:5
    int??? t = 7;
    println(t!!!); // CHECK-NEXT:7
    int? o = 5;
    int?? w = o;
    println(w!!); // CHECK-NEXT:5
    int? mid = d!;
    println(mid!); // CHECK-NEXT:5
    println(d! != null); // CHECK-NEXT:true
}
