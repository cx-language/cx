// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    if (1 == 1) { println("a"); } // CHECK:a
    if (1 == 2) { println("b"); }
    if (0 != 1) { println("c"); } // CHECK-NEXT:c
    if (0 != 0) { println("d"); }
    if (1 <  2) { println("e"); } // CHECK-NEXT:e
    if (1 <  1) { println("f"); }
    if (1 >  0) { println("g"); } // CHECK-NEXT:g
    if (0 >  0) { println("h"); }
    if (0 <= 0) { println("i"); } // CHECK-NEXT:i
    if (0 <=-1) { println("j"); }
    if (0 >= 0) { println("k"); } // CHECK-NEXT:k
    if (0 >= 1) { println("l"); }
}
