// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    var x = if true then 1 else 2;
    println(x); // CHECK:1

    var nested = if true then if false then 1 else 2 else 3;
    println(nested); // CHECK-NEXT:2

    if true then println("yes") else println("no"); // CHECK-NEXT:yes

    int? c = 5;
    println(if c then 1 else 0); // CHECK-NEXT:1

    if (true) then println("p") else println("q"); // CHECK-NEXT:p
    println(if true then 1 else 2); // CHECK-NEXT:1
}
