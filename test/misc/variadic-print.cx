// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

enum MouseButton { Left, Middle, Right }

void main() {
    print("a", "b", "c"); // CHECK:abc
    print('\n');
    print('x', 'y'); // Chars print as characters, not C strings.
    print('\n'); // CHECK-NEXT:xy
    print(1, 2, 3);
    print('\n'); // CHECK-NEXT:123
    var first = StringBuf();
    first.append("buf1");
    var second = StringBuf();
    second.append("buf2");
    print(first, second);
    print('\n'); // CHECK-NEXT:buf1buf2
    // Mixing a borrow-typed loop variable with values used to be ambiguous between
    // the by-value and borrow variadic overloads.
    for button in MouseButton {
        print(button, 'x');
        print('\n'); // CHECK-NEXT:Leftx
        // Dead branch, but still typechecked: locks the abort pair resolving too.
        if false {
            abort(button, 'x');
        }
    } // CHECK-NEXT:Middlex
    // CHECK-NEXT:Rightx
    for button in MouseButton {
        println(button, 120); // CHECK-NEXT:Left120
    } // CHECK-NEXT:Middle120
    // CHECK-NEXT:Right120
    for button in MouseButton {
        println(">", button); // CHECK-NEXT:>Left
    } // CHECK-NEXT:>Middle
    // CHECK-NEXT:>Right
}
