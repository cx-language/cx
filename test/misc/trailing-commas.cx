// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

enum E {
    A,
    B,
}

void add(int a, int b,) {
    println(a + b);
}

void useAnonymousStruct((int a, float b,) t) {
    println(t.a);
}

void main() {
    add(1, 2,); // CHECK:3
    add(a = 1, b = 2,); // CHECK-NEXT:3
    var array = [1, 2,];
    println(array[0] + array[1]); // CHECK-NEXT:3
    var single = [1,];
    println(single[0]); // CHECK-NEXT:1
    var anonymousStruct = (a = 1, b = 2,);
    println(anonymousStruct.a + anonymousStruct.b); // CHECK-NEXT:3
    println((1,)); // CHECK-NEXT:1
    useAnonymousStruct((a = 1, b = 2.5,)); // CHECK-NEXT:1
}
