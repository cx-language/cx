// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run -Werror --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:8
// CHECK-NEXT:7
// CHECK-NEXT:4
// CHECK-NEXT:16
// CHECK-NEXT:8
// CHECK-NEXT:12
// CHECK-NEXT:12
// CHECK-NEXT:8
// CHECK-NEXT:true

struct Pair {
    int a;
    int b;
}

// First use of Inner as a sizeof operand is the field below.
struct Inner {
    int x;
    int y;
    int z;
}

struct Holder {
    uint8[sizeof(Inner)] buf;
}

uint8[sizeof(Pair)] g = undefined;

int scratchSize<E>() {
    uint8[sizeof(E)] scratch = undefined;
    return scratch.size();
}

void main() {
    // Sizeof sizes fold with target layout on both backends.
    uint8[sizeof(Pair)] buf = undefined;
    println(buf.size());
    buf[0] = 7;
    println(buf[0]);

    // Aliased scalars fold in sema like any constant size.
    uint8[sizeof(int)] tiny = undefined;
    println(tiny.size());

    // Generic operands resolve per instantiation.
    println(scratchSize<StringBuf>());
    println(scratchSize<Pair>());

    // Struct fields, globals, and narrowed optionals work too.
    Holder h = undefined;
    h.buf[0] = 12;
    println(h.buf.size());
    println(h.buf[0]);
    g[0] = 3;
    println(g.size());
    uint8[sizeof(Pair)]? o = null;
    println(o == null);
}
