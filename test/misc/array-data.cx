void main() {
    float[4] arr = [4.0, 5.0, 6.0, 7.0];
    var p = arr.data();
    println(p[0]);
    p[1] = 50.0;
    println(arr[1]);
    println(p[3]);
    float[*] u = arr.data();
    println(u.data()[0]);
}
