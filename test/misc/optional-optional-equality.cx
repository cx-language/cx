// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// Two nullables with the same wrapped type compare without unwrapping: null
// equals null, and two non-null values compare their wrapped values with
// whatever == the wrapped type has (memberwise included). Each side with
// side effects still evaluates once.

struct Box {
    int x;
}

struct Custom {
    int x;
}

bool operator==(Custom& a, Custom& b) {
    println("explicit");
    return a.x == b.x;
}

int calls = 0;

Box? getBox(int x) {
    calls = calls + 1;
    return Box(x);
}

void main() {
    Box? a = Box(1);
    Box? b = Box(1);
    Box? c = Box(2);
    Box? nil = null;
    Box? nil2 = null;
    println(a == b); // CHECK:true
    println(a == c); // CHECK-NEXT:false
    println(a != c); // CHECK-NEXT:true
    println(a != b); // CHECK-NEXT:false
    println(nil == nil2); // CHECK-NEXT:true
    println(nil != nil2); // CHECK-NEXT:false
    println(a == nil); // CHECK-NEXT:false
    println(a != nil); // CHECK-NEXT:true
    println(nil == a); // CHECK-NEXT:false
    println(getBox(1) == getBox(1)); // CHECK-NEXT:true
    println(calls); // CHECK-NEXT:2
    println(getBox(1) != getBox(2)); // CHECK-NEXT:true
    println(calls); // CHECK-NEXT:4
    Custom? x = Custom(1);
    Custom? y = Custom(1);
    // CHECK-NEXT:explicit
    println(x == y); // CHECK-NEXT:true
    int?? n1 = 1;
    int?? n2 = 1;
    int?? n3 = null;
    println(n1 == n2); // CHECK-NEXT:true
    println(n1 == n3); // CHECK-NEXT:false
    println(n3 == n3); // CHECK-NEXT:true
    println(n1 != n3); // CHECK-NEXT:true
    println(n1 != n2); // CHECK-NEXT:false
}
