// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

struct S {
    int x;
}

bool operator==(S a, int b) {
    return a.x == b;
}

bool operator!=(S a, int b) {
    return a.x != b;
}

void main() {
    println(S(x = 1) == 1); // CHECK:true
    println(1 == S(x = 1)); // CHECK-NEXT:true
    println(S(x = 1) != 2); // CHECK-NEXT:true
    println(2 != S(x = 1)); // CHECK-NEXT:true
}
