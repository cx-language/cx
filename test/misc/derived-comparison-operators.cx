// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// !=, >, >=, and <= derive from == and < so only those need overloads.
// An explicit overload still wins over a derived one.

struct V {
    int x;
}

bool operator==(V& a, V& b) {
    return a.x == b.x;
}

bool operator<(V& a, V& b) {
    return a.x < b.x;
}

struct W {
    int x;
}

bool operator==(W& a, W& b) {
    return a.x == b.x;
}

bool operator!=(W& a, W& b) {
    println("explicit");
    return a.x != b.x;
}

void main() {
    var v = V(1);
    var w = V(2);
    println(v != w); // CHECK:true
    println(v > w); // CHECK-NEXT:false
    println(w > v); // CHECK-NEXT:true
    println(v >= w); // CHECK-NEXT:false
    println(w >= v); // CHECK-NEXT:true
    println(v <= w); // CHECK-NEXT:true
    println(w <= v); // CHECK-NEXT:false
    println(v >= v); // CHECK-NEXT:true
    println(v <= v); // CHECK-NEXT:true
    var a = W(1);
    var b = W(2);
    // CHECK-NEXT:explicit
    println(a != b); // CHECK-NEXT:true
}
