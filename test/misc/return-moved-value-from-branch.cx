// RUN: %cx run --no-leak-check %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --no-leak-check --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// Leak check disabled: Result payloads never run destructors (enums lack
// destructor handling), so the parsed StringBuf leaks until that is fixed.
// CHECK:[hello]
// CHECK-NEXT:got 1
// CHECK-NEXT:dtor 1
// CHECK-NEXT:got 2
// CHECK-NEXT:dtor 2
// CHECK-NEXT:dtor 1

Result<StringBuf, StringBuf> parse(string input) {
    int pos = 1;
    var out = StringBuf();
    while true {
        if pos >= input.size() {
            return Err(StringBuf("unterminated"));
        }
        char c = input[pos];
        if c == '"' {
            pos++;
            return Ok(out);
        } else {
            out.push(c);
            pos++;
        }
    }
    assert(false);
}

struct C {
    int i;
    ~C() {
        println("dtor ", i);
    }
}

C f(bool b) {
    var c = C(i = 1);
    if b {
        return c;
    }
    return C(i = 2);
}

void main() {
    var r = parse("\"hello\"");
    switch (r) {
        case Ok s: println("[", s, "]");
        case Err e: println("err: ", e);
    }

    var t = f(true);
    println("got ", t.i);
    var s = f(false);
    println("got ", s.i);
}
