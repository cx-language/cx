// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK-NOT: return-moved-value-from-branch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
// CHECK:[hello]
// CHECK-NEXT:got 1
// CHECK-NEXT:dtor 1
// CHECK-NEXT:got 2
// CHECK-NEXT:dtor 2
// CHECK-NEXT:dtor 1
// CHECK-NOT: return-moved-value-from-branch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

Result<StringBuffer, StringBuffer> parse(string input) {
    int pos = 1;
    var out = StringBuffer();
    while true {
        if pos >= input.size() {
            return Err(StringBuffer("unterminated"));
        }
        char c = input[pos];
        if c == '"' {
            pos++;
            return Ok(out);
        } else {
            out.push(c);
            pos++;
        }
    }
    assert(false);
}

struct C {
    int i;
    ~C() {
        println("dtor ", i);
    }
}

C f(bool b) {
    var c = C(i = 1);
    if b {
        return c;
    }
    return C(i = 2);
}

void main() {
    var r = parse("\"hello\"");
    switch (r) {
        case Ok s: println("[", s.value, "]");
        case Err e: println("err: ", e.error);
    }

    var t = f(true);
    println("got ", t.i);
    var s = f(false);
    println("got ", s.i);
}
