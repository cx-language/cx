// CHECK: int32 main() {
// CHECK: void _CX1N4mainM4main3Box4initE4void1_M3std5int32(
// CHECK: int32 _CX1N4main8identityIM3std5int32EEM3std5int321_M3std5int32(int32 x) {
// CHECK: bool _CX1N4main8identityIM3std4boolEEM3std4bool1_M3std4bool(
// CHECK: int32 _CX1N4main{{[0-9]+}}____lambda{{[0-9]+}}EM3std5int321_M3std5int32C1_M3std5int32(
// CHECK: int32 _CX1N4mainM4main3Box3getEM3std5int320_(
// CHECK: void _CX1N4mainM4main3Box4mainE4void0_(
// CHECK: void _CX1N4mainM4main7WrapperIM3std5int32E4initE4void1_M3std5int32(
// CHECK: int32 _CX1N4mainM4main7WrapperIM3std5int32E3getEM3std5int320_(

struct Box {
    int x
    int get() { return x; }
    void main() { print("method main"); }
}

struct Wrapper<T> {
    T value
    T get() { return value; }
}

int add(int a, int b) { return a + b; }
int add(int a) { return a; }
void takeConst(const int x) { print(x); }
void takeMut(int x) { print(x); }
T identity<T>(T x) { return x; }
bool operator==(Box& a, Box& b) { return a.x == b.x; }
void move(public int x) { print(x); }
void move(public int y) { print(y); }
int first((int a, int b) t) { return t.a; }
int apply(int(int) f, int x) { return f(x); }
int fixedSum(int[3] a) { return a[0]; }
int optVal(int? o) { return o ?? 0; }
void ptrFn(int* p) { print(*p); }
void borrowFn(int& r) { print(r); }
void sliceFn(int[] s) { print(s.size()); }
void arrayPtrFn(int[*] p) { print(p[0]); }

var counter = 0;

int one(int x) { return x; }

void main() {
    var b = Box(3);
    print(add(1, 2));
    print(add(1));
    takeConst(1);
    takeMut(2);
    print(identity(3));
    print(identity(true));
    print(b == b);
    move(x = 1);
    move(y = 2);
    print(first((a = 1, b = 2)));
    print(apply(one, 4));
    int[3] arr = [1, 2, 3];
    print(fixedSum(arr));
    print(optVal(5));
    int v = 6;
    ptrFn(&v);
    borrowFn(v);
    int[] sl = [7, 8];
    sliceFn(sl);
    arrayPtrFn(arr);
    var f = (int x) => x + v;
    print(f(1));
    counter = b.get();
    b.main();
    var w = Wrapper(9);
    print(w.get());
    print(counter);
}

