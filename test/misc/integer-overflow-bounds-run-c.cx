// RUN: %cx run -Werror --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// UNSUPPORTED: windows

// MSVC doesn't support __int128, which the C backend emits for int128.

void main() {
    int max = 2147483647;
    println(max + 0); // CHECK:2147483647
    println(max - 0); // CHECK-NEXT:2147483647
    println(max * 1); // CHECK-NEXT:2147483647
    println(max * 0); // CHECK-NEXT:0
    int min = -2147483648;
    println(min + 1); // CHECK-NEXT:-2147483647
    println(min * 1); // CHECK-NEXT:-2147483648
    println(min - -1); // CHECK-NEXT:-2147483647
    uint umax = 4294967295;
    println(umax + uint(0)); // CHECK-NEXT:4294967295
    println(umax * uint(1)); // CHECK-NEXT:4294967295
    println(uint(0) - uint(0)); // CHECK-NEXT:0
    int64 big = 9223372036854775807;
    println(big + 0); // CHECK-NEXT:9223372036854775807
    println(big * 1); // CHECK-NEXT:9223372036854775807
    uint64 ubig = 18446744073709551615;
    println(ubig); // CHECK-NEXT:18446744073709551615
    int8 s8 = 127;
    println(s8 + int8(0)); // CHECK-NEXT:127
    println(byte(200) + byte(55)); // CHECK-NEXT:255
    println(int(char(65) + char(33))); // CHECK-NEXT:98
    int n = 0;
    n += 5;
    println(n); // CHECK-NEXT:5

    int128 a = int128(1) << int128(64);
    int128 b = int128(1) << int128(62);
    println(a * int128(2) == b * int128(8)); // CHECK-NEXT:true
    println(a + a == b * int128(8)); // CHECK-NEXT:true
    int128 max128 = int128(-1) - (int128(1) << int128(127));
    println(max128 + int128(0) == max128); // CHECK-NEXT:true
    println(max128 * int128(0) == int128(0)); // CHECK-NEXT:true
    uint128 half = uint128(1) << uint128(127);
    uint128 umax128 = half | (half - uint128(1));
    println(umax128 - umax128 == uint128(0)); // CHECK-NEXT:true
    println(umax128 * uint128(0) == uint128(0)); // CHECK-NEXT:true
}
