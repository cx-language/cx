// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

void printAll<T: Printable>(T&... args) {
    for arg in args {
        print(arg);
    }
    print('\n');
}

void printFirstAndRest<T: Printable, U: Printable>(T& first, U&... rest) {
    print(first);
    print("|");
    for arg in rest {
        print(arg);
    }
    print('\n');
}

// Fixed generic + concrete (non-generic) pack: instantiations must be keyed by
// pack arity as well, so calls with different rest counts get distinct bodies.
void showCount<T: Printable>(T& first, int... rest) {
    print(first);
    print("|");
    for arg in rest {
        print(arg);
    }
    print('\n');
}

void printIndexed<T: Printable>(T&... args) {
    for arg, i in args {
        print(i);
        print(arg);
    }
    print('\n');
}

void main() {
    printAll("a", 1, "b", 2); // CHECK:a1b2
    printAll("single"); // CHECK:single
    printAll(); // CHECK-EMPTY:
    printFirstAndRest("a", 1, 2); // CHECK:a|12
    printIndexed("a", "b", "c"); // CHECK:0a1b2c
    showCount("a", 1); // CHECK:a|1
    showCount("a", 1, 2, 3); // CHECK:a|123
    showCount("b"); // CHECK:b|
}
