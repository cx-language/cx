// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

void bar(int*?* pp) {
    int*? p = *pp;
    println(p!); // CHECK:42
}

void barPlain(int** pp) {
    int* p = *pp;
    println(*p); // CHECK-NEXT:43
}

void fooAddr(int*? p) {
    if (p == null) {
        return;
    }
    bar(&p);
}

void fooAddrPlain(int* p) {
    barPlain(&p);
}

void main() {
    int x = 42;
    fooAddr(&x);
    int y = 43;
    fooAddrPlain(&y);
}
