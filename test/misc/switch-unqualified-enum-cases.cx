// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

enum Color {
    Red,
    Green,
    Blue
}

enum Shape {
    Circle(float radius),
    Rect(float width, float height),
}

void plain(Color c) {
    switch (c) {
    case Red:
        println("red");
    case Green:
        println("green");
    case Blue:
        println("blue");
    }
}

void bound(Shape s) {
    switch (s) {
    case Circle c:
        println("circle ", c);
    case Rect r:
        println("rect ", r.width, " ", r.height);
    }
}

void equality(Shape s) {
    if (s == Shape.Circle(radius = 1)) {
        println("eq");
    } else {
        println("ne");
    }
    if (s != Shape.Circle(radius = 1)) {
        println("ne");
    } else {
        println("eq");
    }
}

void mixed(Color c) {
    switch (c) {
    case Color.Red:
        println("red");
    case Green:
        println("green");
    default:
        println("other");
    }
}

void shadowing() {
    // A bare case name denotes the enum case even when a variable with the same name is in scope.
    var Red = Color.Blue;
    switch (Color.Red) {
    case Red:
        println("case");
    default:
        println("variable");
    }
}

void main() {
    plain(Color.Red); // CHECK:red
    plain(Color.Green); // CHECK-NEXT:green
    plain(Color.Blue); // CHECK-NEXT:blue
    bound(Shape.Circle(radius = 2)); // CHECK-NEXT:circle 2
    bound(Shape.Rect(width = 3, height = 4)); // CHECK-NEXT:rect 3 4
    mixed(Color.Red); // CHECK-NEXT:red
    mixed(Color.Green); // CHECK-NEXT:green
    mixed(Color.Blue); // CHECK-NEXT:other
    shadowing(); // CHECK-NEXT:case
    // CHECK-NEXT:eq
    // CHECK-NEXT:eq
    equality(Shape.Circle(radius = 1));
    // CHECK-NEXT:ne
    // CHECK-NEXT:ne
    equality(Shape.Rect(width = 1, height = 2));
}
