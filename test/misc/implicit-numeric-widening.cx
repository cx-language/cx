// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    int x = 5;
    int64 y = x;
    println(y); // CHECK:5

    int8 s = -8;
    int t = s;
    println(t); // CHECK-NEXT:-8

    uint8 u = 200;
    int64 v = u;
    println(v); // CHECK-NEXT:200

    float64 d = x;
    println(d); // CHECK-NEXT:5

    int64 big = 10000000000;
    println(s + big); // CHECK-NEXT:9999999992

    float f = 1.5;
    float64 g = f + 2;
    println(g); // CHECK-NEXT:3.5

    char c = 'A';
    float h = c;
    println(h); // CHECK-NEXT:65
}
