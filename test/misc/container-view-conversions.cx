// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

int sum(Slice<int> values) {
    int total = 0;
    for x in values { total += x; }
    return total;
}

int stringSize(string s) { return s.size(); }

Slice<int> asRef(List<int>* list) { return *list; }

void main() {
    var list = List<int>();
    list.push(10);
    list.push(20);
    Slice<int> ref = list;
    // CHECK:2
    println(ref.size());
    // CHECK-NEXT:30
    println(sum(list));
    list[0] = 100;
    // CHECK-NEXT:120
    println(sum(ref));
    // CHECK-NEXT:2
    println(asRef(&list).size());

    StringBuffer buffer = StringBuffer("hello");
    string s = buffer;
    // CHECK-NEXT:5
    println(s.size());
    // CHECK-NEXT:hello
    println(s);
    // CHECK-NEXT:5
    println(stringSize(buffer));
}
