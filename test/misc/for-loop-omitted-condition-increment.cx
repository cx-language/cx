// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    // CHECK:0
    // CHECK-NEXT:1
    // CHECK-NEXT:2
    for (var i = 0;; i++) {
        if (i >= 3) {
            break;
        }
        println(i);
    }
    // CHECK-NEXT:0
    // CHECK-NEXT:1
    // CHECK-NEXT:2
    for (var j = 0; j < 3;) {
        println(j);
        j++;
    }
    // CHECK-NEXT:0
    // CHECK-NEXT:1
    for (var k = 0;;) {
        if (k >= 2) {
            break;
        }
        println(k);
        k++;
    }
    // CHECK-NEXT:2
    for (var s = 0;; s++) {
        if (s < 2) {
            continue;
        }
        if (s >= 3) {
            break;
        }
        println(s);
    }
}
