// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:true
// CHECK-NEXT:false
// CHECK-NEXT:false
// CHECK-NEXT:true
// CHECK-NEXT:true
// CHECK-NEXT:true
// CHECK-NEXT:false
// CHECK-NEXT:false
// CHECK-NEXT:6
// CHECK-NEXT:false
// CHECK-NEXT:true
// CHECK-NEXT:true
// CHECK-NEXT:false

void main() {
    float[3]? n = null;
    float[3]? s = [1.0, 2.0, 3.0];
    println(n == null);
    println(n != null);
    println(s == null);
    println(s != null);
    println(null == n);
    println(null != s);
    println(null == s);
    println(null != n);
    if s {
        println(s[0] + s[1] + s[2]);
    }

    // Pointers compare by address, not element-wise.
    float[3] a = [1.0, 2.0, 3.0];
    float[3] b = [1.0, 2.0, 3.0];
    var p1 = &a;
    var p2 = &b;
    println(p1 == p2);
    println(p1 == p1);
    float[3]*? q = null;
    println(q == null);
    println(p1 == q);
}
