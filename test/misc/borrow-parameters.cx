// RUN: check_exit_status 0 %cx run %s
// RUN: check_exit_status 0 %cx run --backend=c %s

void bump(int* x) {
    *x += 1;
}

int plusOne(int& x) {
    return *x + 1;
}

int strLen(string& s) {
    return s.size();
}

void bumpForwarded(int* x) {
    bump(x);
}

int copyOut(int& p) {
    int r = p;
    r = 100;
    return r;
}

int aliasOut(int& p) {
    var r = p;
    *r = 100;
    return *r;
}

bool equal(int& a, int& b) {
    return a == b;
}

bool less(int& a, int& b) {
    return a < b;
}

int* borrowAddr(int& x) {
    return &x;
}

int getOrNegOne(int&? o) {
    if o {
        return *o;
    }
    return -1;
}

int&? maybeBorrow(bool b, int& x) {
    if (b) {
        return x;
    }
    return null;
}

int pickOverload(int& r) {
    return 1;
}

int pickOverload(int&? o) {
    return 2;
}

void main() {
    // Values bind to borrows; mutation takes an explicit '&' at the call site.
    var x = 1;
    bump(&x);
    assert(x == 2);

    // Temporaries and literals bind to borrows.
    assert(plusOne(41) == 42);
    assert(strLen("hello") == 5);

    // Stored pointers are dereferenced explicitly to borrow the pointee.
    int* p = &x;
    assert(plusOne(*p) == 3);
    bump(p);
    assert(x == 3);

    // Pointers forward without copying.
    bumpForwarded(&x);
    assert(x == 4);

    // An explicit type still copies a borrow out; an inferred `var` aliases it.
    assert(copyOut(x) == 100);
    assert(x == 4);
    var a = 1;
    assert(aliasOut(a) == 100);
    assert(a == 100);

    // Taking the address of a borrow exposes the borrowed address.
    assert(borrowAddr(x) == &x);
    assert(*borrowAddr(x) == 4);

    // Borrow comparison is transparent: it compares values, not addresses.
    var y = 4;
    var z = 5;
    assert(equal(x, y));
    assert(!equal(x, z));
    assert(less(x, z));
    assert(!less(z, x));

    // Dereference explicitly when comparing a pointer with a value;
    // two pointers compare addresses.
    var u = uint(4);
    uint* q = &u;
    assert(*q == 4);
    assert(*q == u);
    assert(*p == x);
    var w = 4;
    int* r = &w;
    assert(!(p == r));
    assert(p == p);
    assert(p != r);

    // Nullable borrows accept lvalues, temporaries, and null.
    assert(getOrNegOne(x) == 4);
    assert(getOrNegOne(7) == 7);
    assert(getOrNegOne(null) == -1);

    // Nullable borrows work as locals, inferred or explicit; writes alias.
    var ib = maybeBorrow(true, x);
    assert(ib != null);
    if (ib) {
        *ib = 42;
    }
    assert(x == 42);
    var nb = maybeBorrow(false, x);
    assert(nb == null);
    int&? ex = maybeBorrow(true, x);
    assert(ex != null);
    ex = null;
    assert(ex == null);

    // Direct initialization borrows; copies and rebinds alias the referent.
    int&? direct = x;
    assert(getOrNegOne(direct) == 42);
    direct = y;
    assert(getOrNegOne(direct) == 4);
    int&? aliasCopy = direct;
    if (aliasCopy) {
        *aliasCopy = 7;
    }
    assert(y == 7);

    // Overload resolution prefers the non-nullable borrow when both match.
    assert(pickOverload(x) == 1);
    assert(pickOverload(null) == 2);
}
