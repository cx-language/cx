// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

char* foo() { return "foo"; }
char*? foo_opt() { return "foo_opt"; }
char[*] foo_array() { return "foo_array"; }
char[*]? foo_array_opt() { return "foo_array_opt"; }
string bar() { return "bar"; }

void main() {
    puts(foo()); // CHECK:foo
    println(bar()); // CHECK-NEXT:bar
    puts("baz"); // CHECK-NEXT:baz
    println("qux"); // CHECK-NEXT:qux
    println(foo()); // CHECK-NEXT:foo
    println(foo_opt()); // CHECK-NEXT:foo_opt
    println(foo_array()); // CHECK-NEXT:foo_array
    println(foo_array_opt()); // CHECK-NEXT:foo_array_opt
    // CHECK-NEXT:foo_opt
    print(foo_opt());
    print('\n');
    StringBuf sb = StringBuf(uninitializedSize = 3);
    sb[0] = 'h';
    sb[1] = 'i';
    sb[2] = char(0);
    println(sb.data()); // CHECK-NEXT:hi
    char*? n = null;
    println(n); // CHECK-NEXT:null
    StringBuf sb2 = StringBuf(uninitializedSize = 3);
    sb2[0] = 'h';
    sb2[1] = 'i';
    sb2[2] = char(0);
    println(sb2.cString()); // CHECK-NEXT:hi
}
