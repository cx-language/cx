// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:foo
// CHECK-NEXT:bar
// CHECK-NEXT:baz
// CHECK-NEXT:qux
// CHECK-NEXT:foo
// CHECK-NEXT:foo_opt
// CHECK-NEXT:foo_array
// CHECK-NEXT:foo_array_opt
// CHECK-NEXT:foo_opt
// CHECK-NEXT:hi
// CHECK-NEXT:null
// CHECK-NEXT:hi

const char* foo() { return "foo"; }
const char*? foo_opt() { return "foo_opt"; }
const char[*] foo_array() { return "foo_array"; }
const char[*]? foo_array_opt() { return "foo_array_opt"; }
string bar() { return "bar"; }

void main() {
    puts(foo());
    println(bar());
    puts("baz");
    println("qux");
    println(foo());
    println(foo_opt());
    println(foo_array());
    println(foo_array_opt());
    print(foo_opt());
    print('\n');
    StringBuf sb = StringBuf(uninitializedSize = 3);
    sb[0] = 'h';
    sb[1] = 'i';
    sb[2] = char(0);
    println(sb.data());
    char*? n = null;
    println(n);
    StringBuf sb2 = StringBuf(uninitializedSize = 3);
    sb2[0] = 'h';
    sb2[1] = 'i';
    sb2[2] = char(0);
    println(sb2.cString());
}
