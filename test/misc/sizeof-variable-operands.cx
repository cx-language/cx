// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s

struct S {
    int x;
    int y;
}

int g = 42;

void checkParam(int p) {
    println(sizeof(p) == sizeof(int));
}

void main() {
    var x = 42;
    println(sizeof(x) == sizeof(int)); // CHECK:true
    println(sizeof(g) == sizeof(int)); // CHECK-NEXT:true
    var s = S(x = 1, y = 2);
    println(sizeof(s) == sizeof(S)); // CHECK-NEXT:true
    var px = &x;
    println(sizeof(px) == sizeof(int*)); // CHECK-NEXT:true
    checkParam(7); // CHECK-NEXT:true
}
