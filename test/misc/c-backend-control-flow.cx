// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:89
// CHECK-NEXT:16
// CHECK-NEXT:10
// CHECK-NEXT:20
// CHECK-NEXT:false
// CHECK-NEXT:true
// CHECK-NEXT:0
// CHECK-NEXT:100
// CHECK-NEXT:200
// CHECK-NEXT:300
// CHECK-NEXT:120

// Exercises control flow through both C code generation modes: the default
// one using gotos and the goto-free dispatch mode (--c-dispatch) used by the
// web playground toolchain. Short-circuit operators and ternaries use basic
// block parameters, which the C backend declares with valid identifiers.

int fib(int n) {
    var a = 0;
    var b = 1;
    for (var i = 0; i < n; i++) {
        var next = a + b;
        a = b;
        b = next;
    }
    return b;
}

int sumOdd(int n) {
    var sum = 0;
    var i = 0;
    while (i < n) {
        i++;
        if (i % 2 == 0) {
            continue;
        }
        if (i > 7) {
            break;
        }
        sum += i;
    }
    return sum;
}

int pick(int x) {
    var y = x > 0 ? 10 : 20;
    return y;
}

int classify(int x) {
    switch (x) {
    case 1:
        return 100;
    case 2:
        return 200;
    default:
        return 300;
    }
}

int factorial(int n) {
    var result = 1;
    var i = 1;
    while (i <= n) {
        result *= i;
        i++;
    }
    return result;
}

void main() {
    println(fib(10));
    println(sumOdd(10));
    println(pick(5));
    println(pick(-5));
    println(true && false);
    println(true || false);
    println(!(5 > 3) ? 1 : 0);
    println(classify(1));
    println(classify(2));
    println(classify(9));
    println(factorial(5));
}
