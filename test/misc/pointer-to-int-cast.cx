// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    int x = 42;
    int* p = &x;

    uint64 addr = cast<uint64>(p);
    println(addr != 0); // CHECK:true

    int* q = cast<int*>(addr);
    println(q == p); // CHECK-NEXT:true
    println(*q); // CHECK-NEXT:42

    int*? n = null;
    println(cast<uint64>(n)); // CHECK-NEXT:0

    int[3] a = [1, 2, 3];
    int[*] s = a;
    println(cast<uint64>(s) != 0); // CHECK-NEXT:true
    println(cast<uint64>(s) == cast<uint64>(&a[0])); // CHECK-NEXT:true

    uint32 narrow = cast<uint32>(p);
    println(narrow == uint32(addr)); // CHECK-NEXT:true
}
