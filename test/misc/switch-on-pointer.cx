// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:red
// CHECK-NEXT:1
// CHECK-NEXT:a
// CHECK-NEXT:one
// CHECK-NEXT:b
// CHECK-NEXT:null
// CHECK-NEXT:one
// CHECK-NEXT:other

enum Color {
    Red,
    Green,
    Blue
}

void foo(Color* c) {
    switch (c) {
    case Color.Red:
        println("red");
    case Color.Green:
        println("green");
    default:
        println("other");
    }
}

void bar(int* i) {
    switch (i) {
    case 1:
        println(1);
    default:
        println(2);
    }
}

void baz(char* c) {
    switch (c) {
    case 'a':
        println("a");
    default:
        println("other");
    }
}

void qux(int*? i) {
    switch (i) {
    case 1:
        println("one");
    default:
        println("other");
    }
}

void quux(char*? c) {
    if (c == null) {
        println("null");
        return;
    }
    switch (c) {
    case 'b':
        println("b");
    default:
        println("other");
    }
}

void quuz(int*? i) {
    switch (i) {
    case null:
        println("null");
    case 1:
        println("one");
    default:
        println("other");
    }
}

void main() {
    Color c = Color.Red;
    foo(&c);
    int i = 1;
    bar(&i);
    char ch = 'a';
    baz(&ch);
    int*? o = &i;
    qux(o);
    char ch2 = 'b';
    char*? oc = &ch2;
    quux(oc);
    quuz(null);
    quuz(o);
    int j = 2;
    int*? t = &j;
    quuz(t);
}
