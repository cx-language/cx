// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c --c-dispatch %s | %FileCheck -match-full-lines -strict-whitespace %s

enum Color {
    Red,
    Green,
    Blue
}

void foo(Color* c) {
    switch (*c) {
    case Color.Red:
        println("red");
    case Color.Green:
        println("green");
    default:
        println("other");
    }
}

void bar(int* i) {
    switch (*i) {
    case 1:
        println(1);
    default:
        println(2);
    }
}

void baz(char* c) {
    switch (*c) {
    case 'a':
        println("a");
    default:
        println("other");
    }
}

void qux(int*? i) {
    switch (*i!) {
    case 1:
        println("one");
    default:
        println("other");
    }
}

void quux(char*? c) {
    if (c == null) {
        println("null");
        return;
    }
    switch (*c) {
    case 'b':
        println("b");
    default:
        println("other");
    }
}

void quuz(int*? i) {
    if (i == null) {
        println("null");
        return;
    }
    switch (*i) {
    case 1:
        println("one");
    default:
        println("other");
    }
}

void main() {
    Color c = Color.Red;
    foo(&c); // CHECK:red
    int i = 1;
    bar(&i); // CHECK-NEXT:1
    char ch = 'a';
    baz(&ch); // CHECK-NEXT:a
    int*? o = &i;
    qux(o); // CHECK-NEXT:one
    char ch2 = 'b';
    char*? oc = &ch2;
    quux(oc); // CHECK-NEXT:b
    quuz(null); // CHECK-NEXT:null
    quuz(o); // CHECK-NEXT:one
    int j = 2;
    int*? t = &j;
    quuz(t); // CHECK-NEXT:other
}
