// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// do-while runs its body before the first condition check, so the body
// always runs at least once. break and continue work as in other loops.

void main() {
    int i = 0;
    do {
        i += 1;
    } while (i < 3);
    println(i); // CHECK:3

    int j = 0;
    do {
        j += 1;
    } while (false);
    println(j); // CHECK-NEXT:1

    int k = 0;
    do {
        k += 1;
        if (k == 2) {
            continue;
        }
        if (k == 4) {
            break;
        }
    } while (k < 10);
    println(k); // CHECK-NEXT:4

    int m = 0;
    do m += 1; while (m < 2);
    println(m); // CHECK-NEXT:2
}
