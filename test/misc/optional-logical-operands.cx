// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// Like if conditions, && and || operands may be optionals, testing for
// non-null. A null-checked operand is narrowed on the right side.

int calls = 0;

bool tick(bool v) {
    calls++;
    return v;
}

bool bothPresent(int? a, int? b) {
    return a && b && a == b;
}

void main() {
    int? o = 5;
    int? n = null;
    println(o && true); // CHECK:true
    println(n && true); // CHECK-NEXT:false
    println(o || false); // CHECK-NEXT:true
    println(n || false); // CHECK-NEXT:false
    println(o && n); // CHECK-NEXT:false
    println(o || n); // CHECK-NEXT:true
    println(bothPresent(3, 3)); // CHECK-NEXT:true
    println(bothPresent(3, 4)); // CHECK-NEXT:false
    println(bothPresent(null, 3)); // CHECK-NEXT:false
    int x = 5;
    int*? p = &x;
    int*? q = null;
    println((p && q) || p); // CHECK-NEXT:true
    println(q && p); // CHECK-NEXT:false
    if (o && o == 5) {
        println("narrowed"); // CHECK-NEXT:narrowed
    }
    println(false && tick(true)); // CHECK-NEXT:false
    println(calls); // CHECK-NEXT:0
}
