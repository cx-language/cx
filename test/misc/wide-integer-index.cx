// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

void main() {
    int[3] a = [10, 20, 30];
    int64 i = 1;
    uint64 u = 2;
    int16 s = 0;
    println(a[i]); // CHECK:20
    println(a[u]); // CHECK-NEXT:30
    println(a[s]); // CHECK-NEXT:10
    a[i] = 99;
    println(a[1]); // CHECK-NEXT:99
}
