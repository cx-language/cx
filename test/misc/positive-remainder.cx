// RUN: %cx run %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c %s | %FileCheck -match-full-lines -strict-whitespace %s

// %% is the positive remainder: the result takes the sign of the divisor.

void main() {
    println(-7 %% 3); // CHECK:2
    println(7 %% 3); // CHECK-NEXT:1
    println(7 %% -3); // CHECK-NEXT:-2
    println(-7 %% -3); // CHECK-NEXT:-1
    println(6 %% 3); // CHECK-NEXT:0
    println(uint(7) %% uint(3)); // CHECK-NEXT:1
    int a = -7;
    int b = 3;
    println(a %% b); // CHECK-NEXT:2
}
