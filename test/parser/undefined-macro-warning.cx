// RUN: %cx -typecheck %s -Wundef -DDEFINED 2>&1 | %FileCheck %s
// RUN: %cx -typecheck %s -DDEFINED -Werror
// CHECK-NOT: undefined-macro-warning.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

// CHECK: [[@LINE+1]]:5: warning: undefined macro 'UNDEFINEDMACRO', assuming false
#if UNDEFINEDMACRO
var a = 1;
#endif

// CHECK: [[@LINE+1]]:6: warning: undefined macro 'ANOTHERUNDEFINED', assuming false
#if !ANOTHERUNDEFINED
var b = 2;
#endif

#if DEFINED
var c = 3;
#endif

void main() {
    println(b + c);
}

// CHECK-NOT: undefined-macro-warning.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
