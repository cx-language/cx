// RUN: %not %cx -parse %s 2>&1 | %FileCheck %s

const M = 8;

// Generic returns don't resolve globals (a parameter could shadow them).
// CHECK: [[@LINE+1]]:7: error: array size must be a constant integer expression
uint8[M + 1] f<T>(T x) {
    uint8[9] buf = undefined;
    return buf;
}

void main() {
}
