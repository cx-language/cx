// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s

int main() {
    if (true)
        if (false)
            return 1;
        // CHECK: [[@LINE+1]]:9: warning: add explicit braces to avoid dangling else
        else
            return 0;

    if (true) {
        if (false)
            return 1;
        else
            return 0;
    }

    if (true)
        return 1;
    else if (false)
        return 0;
    else
        return 2;

    return 3;
}
