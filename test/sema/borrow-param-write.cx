// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

struct Inner {
    int v;
}

struct Outer {
    Inner inner;
}

void derefWrite(int& x) {
    // CHECK: [[@LINE+1]]:5: warning: writing to reference parameter 'x' of type 'int&' hides the mutation from the call site; take 'int*' instead
    *x = 1;
}

void derefCompound(int& x) {
    // CHECK: [[@LINE+1]]:5: warning: writing to reference parameter 'x' of type 'int&' hides the mutation from the call site; take 'int*' instead
    *x += 1;
}

void incDecWrite(int& x) {
    // CHECK: [[@LINE+1]]:6: warning: writing to reference parameter 'x' of type 'int&' hides the mutation from the call site; take 'int*' instead
    (*x)++;
    // CHECK: [[@LINE+1]]:6: warning: writing to reference parameter 'x' of type 'int&' hides the mutation from the call site; take 'int*' instead
    (*x)--;
}

void incBorrowParam(int& x) {
    // CHECK: [[@LINE+1]]:5: error: cannot increment reference parameter 'x' (take 'int*' instead and write '(*x)++')
    x++;
}

void decBorrowParam(int& x) {
    // CHECK: [[@LINE+1]]:5: error: cannot decrement reference parameter 'x' (take 'int*' instead and write '(*x)--')
    x--;
}

void constBorrowReadOnly(const Outer& o) {
    // CHECK: [[@LINE+1]]:5: error: cannot assign to immutable variable 'v' of type 'int'
    o.inner.v = 1;
}

void optionalBorrowDerefWrite(int&? o) {
    // CHECK: [[@LINE+1]]:5: warning: writing to reference parameter 'o' of type 'int&?' hides the mutation from the call site; take 'int*' instead
    *o = 1;
    // CHECK: [[@LINE+1]]:5: warning: writing to reference parameter 'o' of type 'int&?' hides the mutation from the call site; take 'int*' instead
    *o! = 1;
    // CHECK: [[@LINE+1]]:6: warning: writing to reference parameter 'o' of type 'int&?' hides the mutation from the call site; take 'int*' instead
    (*o!)++;
}

void unwrapRebind(int&? o, int* other) {
    // CHECK: [[@LINE+1]]:5: error: cannot rebind reference parameter 'o' of type 'int&' (take 'int*' instead and write '*o')
    o! = other;
}

void unwrapInc(int&? o) {
    // CHECK: [[@LINE+1]]:5: error: cannot increment reference parameter 'o' (take 'int*' instead and write '(*o)++')
    o!++;
}

struct OptInner {
    int v;
}

struct OptOuter {
    OptInner? opt;
}

// The cases below stay silent: field and element writes through a borrow are
// fine; only whole-value reassignment warns. Any warning here fails via
// implicit-check-not.
void projectionWrite(Outer& o) {
    o.inner.v = 1;
}

void explicitDerefFieldWrite(Outer& o) {
    (*o).inner.v = 1;
}

void indexWrite(List<int>& items) {
    items[0] = 1;
}

void compoundWrite(Outer& o) {
    o.inner.v += 1;
}

void memberIncDec(Outer& o) {
    o.inner.v++;
    o.inner.v--;
}

void arrayIndexWrite(int[4]& a) {
    a[0] = 1;
}

void incListItem(List<int>& items, int i) {
    items[i]++;
}

void nestedOptionalWrite(OptOuter& o) {
    // The null check runs in a later pass that this file's errors skip; the
    // borrow warning no longer fires through the implicit unwrap either, and
    // only the null warning fires in borrow-param-write-optional.cx.
    o.opt.v = 1;
}

struct HasMethod {
    int x;
    void touch() {
        this.x = 1;
    }
}

void localBorrowSilent() {
    var o = Outer(Inner(0));
    Outer& r = o;
    r.inner.v = 1;
}

void rawPointerSilent(int* p) {
    *p = 1;
}

// Known limitation: rebinding the borrow to a local hides later writes from the warning.
void launderedBorrowSilent(Outer& p) {
    Outer& r = p;
    r.inner.v = 1;
}
