// RUN: %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck -allow-empty %s
// Top-level const is not part of a value's type: copying a const value into a
// mutable (or const) destination never fails for constness reasons. Const still
// constrains aliases (pointers, borrows, views) and reassignment.

enum E { A, B }

void enumToConst() {
    const int x = E.A;
}

void ternaryJoinsConst() {
    const c = 5;
    int t = true ? E.A : c;
}

int switchArmsJoinConst(int n) {
    const c = 5;
    return switch n {
        case 0: E.A
        default: c
    };
}

void switchCaseConstOptional() {
    const int? o = 5;
    int? d = 3;
    switch (d) {
        case o: break;
        default: break;
    }
}

void arrayLiteralCopiesConst() {
    const c = 5;
    int[2] a = [1, c];
    int[2] b = [c, c];
    b[0] = 9;
}

void structLiteralCopiesConst() {
    const c = 5;
    var s = (x = c, y = 0);
    s.x = 6;
}

void arrayCopyFromConst() {
    const int[2] a = [1, 2];
    int[2] b = a;
    b[0] = 9;
}

void mutateParam<T, int N>(T[N] a) {
    a[0] = a[0];
}

void genericArrayParamCopies() {
    const int[2] a = [1, 2];
    mutateParam(a);
}

T ident<T>(T x) {
    return x;
}

void genericBindsUnqualified() {
    const c = 5;
    int y = ident(c);
}

int pickInt(int x) {
    return x;
}

string pickInt(string x) {
    return x;
}

int pickConcrete(int x) {
    return x;
}

T pickConcrete<T>(T x) {
    return x;
}

void overloadsIgnoreTopConst() {
    const c = 5;
    int n = pickInt(c);
    int m = pickConcrete(c);
}

void swizzleCopyIsMutable() {
    const float[3] v = [1.0, 2.0, 3.0];
    var u = v.xy;
    u[0] = 9.0;
}

void takesSlice<T>(T[] s) {}

void sliceCallDecays() {
    int[3] m = [1, 2, 3];
    takesSlice(m);
}

// Storing a const-derived iterator into a callee-owned slot only replaces
// the slot: by-value holders and locals never designate caller storage.
struct IterCache {
    FilterIterator<int, ArrayIterator<int>, bool(int&)>? saved = null;
}

void fillCopy(FilterIterator<int, ArrayIterator<int>, bool(int&)> it, IterCache c) {
    c.saved = it;
}

void byValueHolderStore() {
    const arr = [1, 2, 3];
    fillCopy(arr.filter(n => *n > 0), IterCache());
}

struct SlotBox {
    int[3] data = [1, 2, 3];
    void reshuffle() {
        var w = [&data[0]];
        w[0] = &data[1];
    }
}

void localArraySlotStore() {
    const o = SlotBox();
    o.reshuffle();
}

struct OptBox {
    int v = 0;
    void bump() { v++; }
}

struct OptHolder {
    int[3] data = [1, 2, 3];
    void adjust() {
        OptBox? o = OptBox(1);
        o!.v = 99;
        o!.bump();
    }
}

void optionalHolderUnwrapStore() {
    const o = OptHolder();
    o.adjust();
}

struct SelfBox {
    int* p;
}

struct SelfHolder {
    int[3] data = [1, 2, 3];
    void relink() {
        var b = SelfBox(&data[0]);
        b.p = b.p;
    }
}

void transparentMemberSelfStore() {
    const o = SelfHolder();
    o.relink();
}
