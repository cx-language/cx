// RUN: %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s
// Top-level const is not part of a value's type: copying a const value into a
// mutable (or const) destination never fails for constness reasons. Const still
// constrains aliases (pointers, borrows, views) and reassignment.

enum E { A, B }

void unwrapToConst() {
    int? o = 3;
    // CHECK: [[@LINE+1]]:19: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    const int x = o;
    int? p = 4;
    const int y = p!;
}

void enumToConst() {
    const int x = E.A;
}

void ternaryJoinsConst() {
    const c = 5;
    int t = true ? E.A : c;
}

int switchArmsJoinConst(int n) {
    const c = 5;
    return switch n {
        case 0: E.A
        default: c
    };
}

void switchCaseConstOptional() {
    const int? o = 5;
    int? d = 3;
    switch (d) {
        case o: break;
        default: break;
    }
}

void arrayLiteralCopiesConst() {
    const c = 5;
    int[2] a = [1, c];
    int[2] b = [c, c];
    b[0] = 9;
}

void structLiteralCopiesConst() {
    const c = 5;
    var s = (x = c);
    s.x = 6;
}

void arrayCopyFromConst() {
    const int[2] a = [1, 2];
    int[2] b = a;
    b[0] = 9;
}

void mutateParam<T, int N>(T[N] a) {
    a[0] = a[0];
}

void genericArrayParamCopies() {
    const int[2] a = [1, 2];
    mutateParam(a);
}

T ident<T>(T x) {
    return x;
}

void genericBindsUnqualified() {
    const c = 5;
    int y = ident(c);
}

void genericPointeeKeepsConst<T>(T* p) {}

void genericPointeeBinds(const int* p) {
    genericPointeeKeepsConst(p);
}

int pickInt(int x) {
    return x;
}

string pickInt(string x) {
    return x;
}

int pickConcrete(int x) {
    return x;
}

T pickConcrete<T>(T x) {
    return x;
}

void overloadsIgnoreTopConst() {
    const c = 5;
    int n = pickInt(c);
    int m = pickConcrete(c);
}

void inferValueAndPointee<T>(T x, T* p) {}
void inferPointeeAndValue<T>(T* p, T x) {}

void genericInferenceOrderIndependent(const int* p) {
    const c = 5;
    inferValueAndPointee(c, p);
    inferPointeeAndValue(p, c);
}

void swizzleCopyIsMutable() {
    const float[3] v = [1.0, 2.0, 3.0];
    var u = v.xy;
    u[0] = 9.0;
}

struct Wrap<T> {
    T v;
}

void takeWrap<T>(Wrap<T*> w) {}

void nestedPointeeBinds(Wrap<const int*> w) {
    takeWrap(w);
}

void takesSlice<T>(T[] s) {}

void sliceCallDecays() {
    int[3] m = [1, 2, 3];
    takesSlice(m);
    const int[3] c = [4, 5, 6];
    takesSlice(c);
}

void takesPtrView(const int*[*] v) {}

void ptrLiteralKeepsPointee(const int* p) {
    takesPtrView([p, p]);
}

// T-from-pointee keeps const for aliases, but a mutable T local stays assignable.
T pick<T>(T* p) {
    T t = *p;
    t = t;
    return t;
}

T mix<T>(T x, T* p) {
    T t = x;
    t = t;
    x = t;
    return t;
}

// Substituted const inside a fixed array folds to the canonical outer-const
// form, so a mutable binding strips it and elements stay assignable.
void arrElem<T>(T* p) {
    T[2] t = [*p, *p];
    t[0] = *p;
}

void genericConstPointeeLocals(const int* cp) {
    pick(cp);
    mix(1, cp);
    arrElem(cp);
}
