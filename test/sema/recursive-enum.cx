// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

// CHECK: [[@LINE+1]]:6: error: 'E' has infinite size because it contains itself
enum E {
    A(S s)
}

// CHECK: [[@LINE+1]]:8: error: 'S' has infinite size because it contains itself
struct S {
    E e;
}

// Using the type must not crash the compiler.
void f(S s) {}

void main() {
    // CHECK: [[@LINE+1]]:5: error: unknown identifier 'nosuchcall'
    nosuchcall();
}
