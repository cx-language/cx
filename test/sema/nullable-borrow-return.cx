// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s


// Borrows may be returned, e.g. find returns an optional borrow into the container.
// Returning a borrow of a local is rejected since the local won't exist after the call.
int&? returnsNullableBorrow() {
    var x = 1;
    // CHECK: [[@LINE+1]]:12: error: cannot return 'int&?' derived from local variable 'x' (local variables will not exist after the function returns)
    return x;
}

void main() {
}

// CHECK: 6:7: warning: unused declaration 'returnsNullableBorrow'
