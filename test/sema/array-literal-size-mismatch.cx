// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: array-literal-size-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    // CHECK: [[@LINE+1]]:22: error: cannot assign 'int[3]' to 'int[2]'
    int[2] tooMany = [1, 2, 3];
    // CHECK: [[@LINE+1]]:21: error: cannot assign 'int[1]' to 'int[2]'
    int[2] tooFew = [1];
}
