// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck -allow-empty %s
// Literals and foldable expressions bind to borrow parameters through a
// temporary; only const-rooted sources are rejected (see borrow-const-rejected).

void takesBorrow(int& x) {}

const c = 5;

void main() {
    takesBorrow(5);
    takesBorrow(c + 1);
    takesBorrow(-c);
    // Constants that need a borrow bind to a local first.
    var tmp = c;
    takesBorrow(tmp);
}
