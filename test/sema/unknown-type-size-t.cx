// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

void main() {
    int x = 1;
    int* p = &x;
    // CHECK: [[@LINE+1]]:18: error: unknown type 'size_t' (did you mean 'c_size_t'?)
    var s = cast<size_t>(p);
    // CHECK: [[@LINE+1]]:5: error: unknown type 'size_t' (did you mean 'c_size_t'?)
    size_t t = 5;
}

