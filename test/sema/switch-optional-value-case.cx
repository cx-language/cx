// RUN: %not %cx -typecheck %s | %FileCheck %s
// CHECK-NOT: switch-optional-value-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    int? o = 1;
    switch (o) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'int' doesn't match switch condition type 'int?'
        case 1: break;
    }
}

