// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

struct S {}

void bar(S s) {}
void baz(S s) {}

void foo(bool b, S s) {
    if (b) {
        bar(s);
    } else {
        baz(s);
    }

    // CHECK: [[@LINE+1]]:9: error: use of moved value 's'
    bar(s);
}

void singleBranchMoveIsAllowed(bool b, S s, S t) {
    if (b) {
        bar(s);
    }
    bar(s);

    if (b) {
    } else {
        baz(t);
    }
    baz(t);
}
