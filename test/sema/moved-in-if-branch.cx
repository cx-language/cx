// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

struct S {
    int n;
    ~S() {}
}

void bar(S s) {}
void baz(S s) {}
void sinkArr(S[2] a) {}

void foo(bool b, S s) {
    if (b) {
        bar(s);
    } else {
        baz(s);
    }

    // CHECK: [[@LINE+1]]:9: error: use of moved value 's'
    bar(s);
}

void secondMoveAfterMaybeMoveErrors(bool b, S s) {
    if (b) {
        // CHECK: [[@LINE+1]]:13: warning: value 's' is moved in the 'then' branch but there is no 'else' branch; it may leak when the condition is false (add 'else { drop(s); }' if this was intended)
        bar(s);
    }
    // CHECK: [[@LINE+1]]:9: warning: use of possibly-moved value 's'
    bar(s);
    // CHECK: [[@LINE+1]]:9: error: use of moved value 's'
    bar(s);
}

void elseOnlyMoveAfterDivergingThen(bool b, S s) {
    if (b) {
        return;
    } else {
        bar(s);
    }

    // CHECK: [[@LINE+1]]:9: error: use of moved value 's'
    bar(s);
}

void thenOnlyMoveAfterDivergingElse(bool b, S s) {
    if (b) {
        bar(s);
    } else {
        return;
    }

    // CHECK: [[@LINE+1]]:9: error: use of moved value 's'
    bar(s);
}

void memberAssignToMovedErrors(S s) {
    bar(s);
    // CHECK: [[@LINE+1]]:5: error: use of moved value 's'
    s.n = 1;
}

void indexAssignToMovedErrors() {
    var a = [S(n = 1), S(n = 2)];
    sinkArr(a);
    // CHECK: [[@LINE+1]]:5: error: use of moved value 'a'
    a[0] = S(n = 3);
}
