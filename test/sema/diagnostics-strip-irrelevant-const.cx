// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

// Top-level 'const' is noise in operand-kind diagnostics: the issue is never
// the constness. (Nested const, such as a pointee, is preserved.)

enum E { A, B }

struct NoIndex { int x; }

void derefConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: cannot dereference non-pointer type 'int'
    _ = *c;
}

void wrappingNegConst() {
    const f = 1.5;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-%' to type 'float'
    _ = -%f;
}

void unaryPointerConst(int* p) {
    const cp = p;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-' to pointer of type 'int*'; dereference it explicitly (e.g. '-*p')
    _ = -cp;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-%' to pointer of type 'int*'; dereference it explicitly (e.g. '-%*p')
    _ = -%cp;
    // CHECK: [[@LINE+1]]:5: error: cannot increment pointer of type 'int*'; dereference it explicitly (e.g. '(*p)++')
    cp++;
}

void pointeeConstKept(const int* p) {
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-' to pointer of type 'const int*'; dereference it explicitly (e.g. '-*p')
    _ = -p;
}

void rebindConstRef(const int& r) {
    // CHECK: [[@LINE+1]]:5: error: cannot rebind reference parameter 'r' of type 'const int&' (take 'const int*' instead and write '*r')
    r = 5;
}

void illegalCastConst() {
    const arr = [1, 2];
    // CHECK: [[@LINE+1]]:9: error: illegal cast from 'int[2]' to 'void*' (cannot cast away immutability; use 'const void*' instead)
    _ = cast<void*>(arr);
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: redundant cast to same type 'int'
    _ = cast<int>(c);
    // CHECK: [[@LINE+1]]:9: error: illegal cast from 'int' to 'string'
    _ = cast<string>(c);
}

void nullHintConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: invalid operands 'int' and 'null' to '==' (non-optional type 'int' cannot be null)
    _ = c == null;
}

void noMemberConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: no member named 'foo' in 'int'
    _ = c.foo;
}

void indexOperatorStructConst() {
    const s = NoIndex(x = 1);
    // CHECK: [[@LINE+1]]:9: error: 'NoIndex' doesn't provide an operator[]
    _ = s[0];
}

void arrayMethodConst() {
    const a = [1, 2];
    // CHECK: [[@LINE+1]]:9: error: type 'int[2]' has no member function 'foo'
    _ = a.foo();
}

void invalidOperandsConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: invalid operands 'int' and 'float' to '&'
    _ = c & 1.5;
}

void elementWiseConst() {
    const a = [1, 2];
    const b = [1, 2, 3];
    // CHECK: [[@LINE+1]]:9: error: array sizes must match for element-wise '+' (got 'int[2]' and 'int[3]')
    _ = a + b;
}

void distinctPointersConst(int* p, float* q) {
    const cp = p;
    // CHECK: [[@LINE+1]]:9: error: comparison of distinct pointer types ('int*' and 'float*')
    _ = cp == q;
}

void illegalIndexConst() {
    const c = [1, 2];
    const i = true;
    // CHECK: [[@LINE+1]]:11: error: illegal index type 'bool', expected integer type
    _ = c[i];
}

void boolConvertibleConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: type 'int' is not convertible to boolean
    if (c) {}
}

void isConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: left side of 'is' must be an enum, got 'int'
    _ = c is E.A;
    const e = E.A;
    // CHECK: [[@LINE+1]]:14: error: right side of 'is' must be a case of enum 'E'
    _ = e is 5;
}

void unwrapConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: type 'int' is not optional and has no 'unwrap' method
    _ = c!;
}

void swizzleBoundsConst() {
    const v = [1.0, 2.0];
    // CHECK: [[@LINE+1]]:9: error: swizzle 'w' indexes out of bounds for 'float[2]'
    _ = v.w;
}

void indexOperatorConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: 'int' doesn't provide an index operator
    _ = c[0];
}

void nullCoalescingLhsConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:9: error: left operand of '??' must be an optional, got 'int'
    _ = c ?? 0;
}

void indexOptionalConst() {
    const int[2]? o = [1, 2];
    // CHECK: [[@LINE+1]]:9: error: cannot index into optional type 'int[2]?' (narrow it with 'if' or unwrap it with '!' first)
    _ = o[0];
}

void swizzleOptionalConst() {
    const float[3]? o = [1.0, 2.0, 3.0];
    // CHECK: [[@LINE+1]]:9: error: cannot access swizzle 'x' of optional type 'float[3]?' (narrow it with 'if' or unwrap it with '!' first)
    _ = o.x;
}

void rvalueConst() {
    const c = 5;
    // CHECK: [[@LINE+1]]:11: error: cannot take address of rvalue of type 'int'
    _ = &(c + 1);
    // CHECK: [[@LINE+1]]:6: error: cannot increment rvalue of type 'int'
    (true ? c : c)++;
    // CHECK: [[@LINE+1]]:6: error: cannot assign to expression of type 'int'
    (true ? c : c) = 5;
}

void unknownConst() {
    // CHECK: [[@LINE+1]]:11: error: unknown type 'Nope'
    const Nope x = 1;
}

void switchConditionConst() {
    const f = 1.5;
    // CHECK: [[@LINE+1]]:13: error: switch condition must have integer, char, string, or enum type, got 'float'
    switch (f) {
        default: break;
    }
}

void switchConditionPointerConst(int* p) {
    const cp = p;
    // CHECK: [[@LINE+1]]:13: error: switch condition must have integer, char, string, or enum type, got 'int*'; dereference it explicitly (e.g. 'switch (*p)')
    switch (cp) {
        default: break;
    }
}

int switchExprDefaultConst(int n) {
    const m = n;
    // CHECK: [[@LINE+1]]:12: error: switch expression on 'int' must have a default case
    return switch m {
        case 0: 1
    };
}

void writeThroughPointee<T>(T* p) {
    // The pointee const is the reason: the diagnostic names the pointer, which
    // can show the const, rather than the value type, which cannot.
    // CHECK: [[@LINE+1]]:5: error: cannot assign through const-pointer of type 'const int*'
    *p = 5;
}

void writeThroughPointeeCall(const int* q) {
    writeThroughPointee(q);
}

void optPtrUnwrapKeepsPointee(const int*? o) {
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'const int*?' to 'int*'
    int* p = o;
}

void writeSliceFirst<T>(T[] s) {
    // CHECK: [[@LINE+1]]:5: error: cannot assign to immutable array of type 'const int[*]'
    s.data()[0] = 1;
}

void writeSliceFirstCall() {
    int[3] m = [1, 2, 3];
    writeSliceFirst(m);
    const int[3] c = [4, 5, 6];
    writeSliceFirst(c);
}

void ptrLiteralNoLaunder(const int* p) {
    // CHECK: [[@LINE+1]]:17: error: cannot assign 'const int*[2]' to 'int*[2]'
    int*[2] a = [p, p];
}
