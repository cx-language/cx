// RUN: %not %cx -typecheck %s | %FileCheck %s
// CHECK-NOT: arg-validation-notes.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void greet(string name, int times) {
    println(name);
}

void point(int x, int y) {
    println(x);
}

void main() {
    badType();
    badName();
}

void badType() {
    greet("ok", 1);
    // CHECK: [[@LINE+1]]:16: error: invalid argument #2 type 'string' to 'greet', expected 'int'
    greet("x", "y");
    // CHECK: 4:6: note: 'greet' declared here
}

void badName() {
    point(x = 1, y = 2);
    // CHECK: [[@LINE+1]]:11: error: invalid argument name 'z' for parameter 'x'
    point(z = 1, y = 2);
    // CHECK: 8:6: note: 'point' declared here
}

// CHECK-NOT: arg-validation-notes.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
