// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void greet(string name, int times) {
    println(name);
}

void point(int x, int y) {
    println(x);
}

void main() {
    badType();
    badName();
}

void badType() {
    greet("ok", 1);
    // CHECK: [[@LINE+1]]:16: error: invalid argument #2 type 'string' to 'greet', expected 'int'
    greet("x", "y");
    // CHECK: 3:6: note: 'greet' declared here
}

void badName() {
    point(x = 1, y = 2);
    // CHECK: [[@LINE+1]]:11: error: invalid argument name 'z'
    point(z = 1, y = 2);
    // CHECK: 7:6: note: 'point' declared here
}

