// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s


struct Point {
    int x;
    int y;
    ~Point() {}
}

void main() {
    var p = Point(x = 1, y = 2);
    var f = () {
        // CHECK: [[@LINE+1]]:17: error: cannot move from captured variable 'p'
        var q = p;
        return q.x;
    };
    _ = f();
}

struct NC {
    int x;
    ~NC() {}
}

void take(NC v) {
}

void run(void() body) {
    body();
}

// The lambda is checked twice (overload probe, then validation); the second
// check must not crash on the unset return type left by the first failure.
int recheckAfterError() {
    var n = NC(1);
    run(() => {
        // CHECK: [[@LINE+1]]:14: error: cannot move from captured variable 'n'
        take(n);
    });
    return 0;
}

