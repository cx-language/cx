// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s


struct Point {
    int x;
    int y;
}

void main() {
    var p = Point(x = 1, y = 2);
    var f = () {
        // CHECK: [[@LINE+1]]:17: error: cannot move from captured variable 'p'
        var q = p;
        return q.x;
    };
    _ = f();
}

