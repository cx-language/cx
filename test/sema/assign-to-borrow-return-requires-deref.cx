// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: assign-to-borrow-return-requires-deref.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void g() {
    var a = List([1, 2, 3]);
    // CHECK: [[@LINE+1]]:7: error: cannot assign to expression of type 'int&'
    a.first() = 99;
    // CHECK: [[@LINE+1]]:7: error: cannot assign to expression of type 'int&'
    a.first() += 1;
    *a.first() = 99;
    *a.first() += 1;
}

// CHECK-NOT: assign-to-borrow-return-requires-deref.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
