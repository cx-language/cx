// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

int x = 1;

// CHECK: [[@LINE+1]]:9: error: global variable initializer must be a constant expression
int y = x;

enum E { a, b(int value) }

// CHECK: [[@LINE+1]]:11: error: global variable initializer must be a constant expression
var v = E.b;

int getAnswer() {
    return 42;
}

// CHECK: [[@LINE+1]]:9: error: global variable initializer must be a constant expression
int z = getAnswer();

// CHECK: [[@LINE+1]]:15: error: global variable initializer must be a constant expression
int w = x > 1 ? 2 : 3;

const int* p = &x;

// CHECK: [[@LINE+1]]:16: error: global variable initializer must be a constant expression
const int* q = &*p;
