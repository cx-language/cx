// RUN: %not %cx -typecheck %s | %FileCheck %s
// CHECK-NOT: switch-duplicate-null-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    int*? p = null;
    switch (p) {
        case null: break;
        // CHECK: [[@LINE+1]]:14: error: duplicate 'case null'
        case null: break;
    }
}

// CHECK-NOT: switch-duplicate-null-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
