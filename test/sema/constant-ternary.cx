// RUN: check_exit_status 0 %cx run -Werror %s

void main() {
    assert((true ? 1 : 2) == 1);
    assert((false ? 1 : 2) == 2);
    assert(((1 < 2) ? 10 : 20) == 10);
    assert(((1 > 2) ? 10 : 20) == 20);
    assert(((true && false) ? 1 : 3) == 3);
    assert(((1 == 1 ? 2 == 2 ? 5 : 6 : 7)) == 5);
    const flag = true;
    assert((flag ? 8 : 9) == 8);
    // Optional conditions aren't foldable; they must emit branches, not crash the folder.
    const int? maybe = 5;
    assert((maybe ? 1 : 2) == 1);
    assert((maybe && true) == true);
    const int? none = null;
    assert((none ? 1 : 2) == 2);
}
