// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s
// RUN: %cx -typecheck %s 2>&1 | %FileCheck %p/mod/a.cx
// RUN: %cx -typecheck %s 2>&1 | %FileCheck %p/mod/a.cx -check-prefix=CHECK-PRIVATE-IN-PUBLIC-DECL
import mod;

void main() {
    // CHECK-DAG: [[@LINE+1]]:5: warning: 'A' is private
    A a = undefined;

    // CHECK-DAG: [[@LINE+1]]:9: warning: 'A' is private
    a = A();

    // Imported declarations check on use; exercise mod's public API so its
    // signature warnings (checked in mod/a.cx) still fire.
    m(undefined);
    o(null);
    p();
    E? _e = null;
}

// CHECK-DAG: [[@LINE+1]]:8: warning: 'A' is private
void f(A a) {}

// CHECK-DAG: [[@LINE+1]]:8: warning: 'A' is private
void g(A*? a) {}

// CHECK-DAG: [[@LINE+1]]:1: warning: 'A' is private
A*? h() {
    return null;
}

struct B {
    // CHECK-DAG: [[@LINE+1]]:5: warning: 'A' is private
    A a;
}
