// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: pointer-invariance.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void bar(int*?* pp) {
}

void barConst(const int** pp) {
}

void barArr(int?* p) {
}

void barConstChar(const char* p) {
}

void barVoid(void* p) {
}

void barPlain(int** pp) {
}

void nullabilityWidening() {
    int x = 42;
    int* p = &x;
    // CHECK: [[@LINE+1]]:9: error: invalid argument #1 type 'int32**' to 'bar', expected 'int32*?*'
    bar(&p);
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'int32**' to 'int32*?*'
    int*?* q = &p;
}

void constUnderPointer() {
    int x = 42;
    int* p = &x;
    // CHECK: [[@LINE+1]]:14: error: invalid argument #1 type 'int32**' to 'barConst', expected 'const int32**'
    barConst(&p);
}

void arrayElementWidening() {
    int[4] a = [1, 2, 3, 4];
    // CHECK: [[@LINE+1]]:12: error: invalid argument #1 type 'int32[4]' to 'barArr', expected 'int32?*'
    barArr(a);
    // CHECK: [[@LINE+1]]:12: error: invalid argument #1 type 'int32[4]*' to 'barArr', expected 'int32?*'
    barArr(&a);
}

void stillAllowed() {
    int x = 42;
    int* p = &x;
    // CHECK-NOT: [[@LINE+1]]:{{[0-9]+}}: {{(warning|error)}}:
    barPlain(&p);
    char c = 'a';
    char* pc = &c;
    // CHECK-NOT: [[@LINE+1]]:{{[0-9]+}}: {{(warning|error)}}:
    barConstChar(pc);
    // CHECK-NOT: [[@LINE+1]]:{{[0-9]+}}: {{(warning|error)}}:
    barVoid(p);
}

// CHECK: 5:6: warning: unused declaration 'bar'
// CHECK: 8:6: warning: unused declaration 'barConst'
// CHECK: 11:6: warning: unused declaration 'barArr'
// CHECK: 23:6: warning: unused declaration 'nullabilityWidening'
// CHECK: 32:6: warning: unused declaration 'constUnderPointer'
// CHECK: 39:6: warning: unused declaration 'arrayElementWidening'
// CHECK: 47:6: warning: unused declaration 'stillAllowed'
// CHECK-NOT: pointer-invariance.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
