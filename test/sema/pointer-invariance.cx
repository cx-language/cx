// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s


void bar(int*?* pp) {
}

void barArr(int?* p) {
}

void barChar(char* p) {
}

void barVoid(void* p) {
}

void barPlain(int** pp) {
}

void nullabilityWidening() {
    int x = 42;
    int* p = &x;
    // CHECK: [[@LINE+1]]:9: error: invalid argument #1 type 'int**' to 'bar', expected 'int*?*'
    bar(&p);
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'int**' to 'int*?*'
    int*?* q = &p;
}

void arrayElementWidening() {
    int[4] a = [1, 2, 3, 4];
    // CHECK: [[@LINE+1]]:12: error: invalid argument #1 type 'int[4]' to 'barArr', expected 'int?*'
    barArr(a);
    // CHECK: [[@LINE+1]]:12: error: invalid argument #1 type 'int[4]*' to 'barArr', expected 'int?*'
    barArr(&a);
}

void stillAllowed() {
    int x = 42;
    int* p = &x;
    barPlain(&p);
    char c = 'a';
    char* pc = &c;
    barChar(pc);
    barVoid(p);
}

// CHECK: 4:6: warning: unused declaration 'bar'
// CHECK: 7:6: warning: unused declaration 'barArr'
// CHECK: 19:6: warning: unused declaration 'nullabilityWidening'
// CHECK: 28:6: warning: unused declaration 'arrayElementWidening'
// CHECK: 36:6: warning: unused declaration 'stillAllowed'
