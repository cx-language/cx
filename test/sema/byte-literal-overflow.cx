// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: uint8-literal-overflow.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    // CHECK: [[@LINE+1]]:14: error: 300 is out of range for type 'uint8'
    byte b = 300;
}

