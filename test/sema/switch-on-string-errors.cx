// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void nonConstantCase() {
    string s = "a";
    string t = "b";
    switch (s) {
        // CHECK: [[@LINE+1]]:14: error: case value must be constant
        case t: println("t"); break;
        default: break;
    }
}

void mismatchedCase() {
    string s = "a";
    switch (s) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'int' doesn't match switch condition type 'string'
        case 1: println("one"); break;
        default: break;
    }
}

void main() {
    nonConstantCase();
    mismatchedCase();
}

