// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

struct S {
    int x;
}

bool operator==(S& a, S& b) {
    return true;
}

bool operator==(S& a, const S& b) {
    return false;
}

// Ambiguous overloads still report instead of silently falling back to the
// default memberwise ==.
void main() {
    // CHECK: [[@LINE+1]]:18: error: ambiguous reference to '=='
    println(S(1) == S(2));
}
