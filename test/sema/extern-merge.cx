// RUN: %cx --print-ir %s 2>&1 | %FileCheck %s

import "inputs/extern-merge-a.h";
import "inputs/extern-merge-b.h";

// Same C name, ABI-compatible spellings (c_int vs c_uint): one symbol, no error.
// CHECK: call pick(c_int 1)
// CHECK: call pick(c_uint

void main() {
    print(pick(1));
    uint u = 2;
    print(pick(u));
}

