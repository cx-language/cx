// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: warning
// CHECK-NOT: error

void f(int, string s) {
    println(s);
}

void main() {
    // CHECK: [[@LINE+1]]:7: error: invalid argument name 'x', parameter #1 is unnamed
    f(x = 1, s = "hi");
}

// CHECK: [[@LINE-9]]:6: warning: unused declaration 'f'

// CHECK-NOT: error
// CHECK-NOT: warning
