// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: sizeof-pointer-not-constant.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    uint64 x = 8;
    switch (x) {
        // CHECK: [[@LINE+1]]:14: error: case value must be constant
        case sizeof(int*): println("eight"); break;
        default: println("other"); break;
    }
}

// CHECK-NOT: sizeof-pointer-not-constant.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
