// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: generic-enum-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:21: error: too few arguments to 'Ok', expected 1
    var x = Outcome.Ok();
}

// CHECK-NOT: generic-enum-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
