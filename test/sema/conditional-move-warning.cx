// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void sink(StringBuf s) {}
int use(StringBuf s) {
    return 1;
}

enum E { A(StringBuf v), B }

void thenOnlyMoveNoWarning(bool b, StringBuf x) {
    if b {
        sink(x);
    }
}

void thenOnlyMoveWithElseNoWarning(bool b, StringBuf x) {
    if b {
        sink(x);
    } else {
    }
}

void elseOnlyMoveNoWarning(bool b, StringBuf x) {
    if b {
    } else {
        sink(x);
    }
}

void elseIfChainNoWarning(int c, StringBuf x) {
    if c == 1 {
        sink(x);
    } else if c == 2 {
        println("two");
    } else {
        println("other");
    }
}

void nestedMoveNoWarning(bool a, bool b, StringBuf x) {
    if a {
        if b {
            sink(x);
        }
    }
}

void captureInBranchNoWarning(bool b, StringBuf x) {
    if b {
        var f = () => string(x);
        println(f());
    }
}

void switchOneArmNoWarning(int c, StringBuf x) {
    switch c {
        case 1:
            sink(x);
        default:
            println("d");
    }
}

void switchNoDefaultNoWarning(int c, StringBuf x) {
    switch c {
        case 1:
            sink(x);
        case 2:
            drop(x);
    }
}

void switchExprWarns(int c, StringBuf x) {
    // CHECK: [[@LINE+2]]:21: warning: value 'x' is moved in only some arms of this 'switch' expression; it may leak on the other paths (move it on every path if this was intended)
    var n = switch c {
        case 1: use(x),
        default: 0,
    };
    println(n);
}

void bindingMoveNoWarningSubject(E e, bool b) {
    if e is A name {
        if b {
            sink(name);
        }
    }
}

void switchBindingNoWarningSubject(E e) {
    switch e {
        case A name:
            sink(name);
        case B:
            println("b");
    }
}

void switchBreakPathNoWarning(int c, bool b, StringBuf x) {
    switch c {
        case 1:
            if b {
                sink(x);
                break;
            } else {
                println("e");
            }
        default:
            println("d");
    }
}

void switchAllBreakPathsMoveIsSilent(int c, bool b, StringBuf x) {
    // No check line: any warning here fails via implicit-check-not.
    switch c {
        case 1:
            if b {
                sink(x);
                break;
            } else {
                drop(x);
                break;
            }
        default:
            drop(x);
            break;
    }
    // x moved on every path reaching past the switch: no warning, no use.
}

void switchNestedBreakIsolation(int c, int d, StringBuf x) {
    switch c {
        case 1:
            switch d {
                case 1:
                    sink(x);
                    break;
                default:
                    drop(x);
                    break;
            }
            break;
        default:
            drop(x);
            break;
    }
    // Inner-switch breaks target the inner switch only; x moved on every
    // outer path, so silence here is also covered by implicit-check-not.
}

void ternaryBothArmsWarn(bool b, StringBuf a, StringBuf c) {
    // CHECK: [[@LINE+2]]:17: warning: value 'a' is moved in the 'then' arm of this ternary but not the 'else' arm; it may leak when the condition is false (use 'a.take()' if this was intended)
    // CHECK: [[@LINE+1]]:21: warning: value 'c' is moved in the 'else' arm of this ternary but not the 'then' arm; it may leak when the condition is true (use 'c.take()' if this was intended)
    var t = b ? a : c;
    println(string(t));
}

void nestedTernaryWarnsOnceEach(bool b1, bool b2, StringBuf a, StringBuf d, StringBuf e) {
    // CHECK-COUNT-1: warning: value 'a' is moved in the 'then' arm of this ternary
    // CHECK-COUNT-1: warning: value 'd' is moved in the 'else' arm of this ternary
    // CHECK-COUNT-1: warning: value 'e' is moved in the 'else' arm of this ternary
    var t = b1 ? (b2 ? a : d) : e;
    println(string(t));
}

void siblingBranchTernariesWarnTwice(bool c, bool b1, bool b2, StringBuf a) {
    if c {
        // CHECK: [[@LINE+1]]:23: warning: value 'a' is moved in the 'then' arm of this ternary but not the 'else' arm; it may leak when the condition is false (use 'a.take()' if this was intended)
        var t1 = b1 ? a : StringBuf("x");
        println(string(t1));
    } else {
        // CHECK: [[@LINE+1]]:23: warning: value 'a' is moved in the 'then' arm of this ternary but not the 'else' arm; it may leak when the condition is false (use 'a.take()' if this was intended)
        var t2 = b2 ? a : StringBuf("y");
        println(string(t2));
    }
}
