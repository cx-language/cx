// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void f(bool* a) {
    var p = a;
    // CHECK: [[@LINE+1]]:6: error: cannot increment pointer of type 'bool*'; dereference it explicitly (e.g. '(*p)++')
    p++;
    // CHECK: [[@LINE+1]]:6: error: cannot decrement pointer of type 'bool*'; dereference it explicitly (e.g. '(*p)--')
    p--;
}

void g(int* a) {
    (*a)++;
    (*a)--;
}

