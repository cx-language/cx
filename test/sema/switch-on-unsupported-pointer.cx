// RUN: %not %cx -typecheck %s | %FileCheck %s

enum Color {
    Red
}

enum E {
    A,
    B(int i)
}

void doublePointer(int** p) {
    // CHECK: [[@LINE+1]]:13: error: switch condition must have integer, char, or enum type, got 'int**'
    switch (p) {
    default:
        break;
    }
}

void optionalPointer(Color*? c) {
    // CHECK: [[@LINE+1]]:13: error: switch condition must have integer, char, or enum type, got 'Color*?'
    switch (c) {
    default:
        break;
    }
}

void associatedValueEnumPointer(E* e) {
    // CHECK: [[@LINE+1]]:13: error: switch condition must have integer, char, or enum type, got 'E*'
    switch (e) {
    default:
        break;
    }
}
