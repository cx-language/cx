// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: logical-operator-mixing.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    var a = true;
    var b = false;
    var c = true;
    // CHECK: [[@LINE+1]]:15: warning: mixing '&&' and '||' without parentheses; add parentheses to clarify
    println(a && b || c);
    // CHECK: [[@LINE+1]]:20: warning: mixing '&&' and '||' without parentheses; add parentheses to clarify
    println(a || b && c);
    println((a && b) || c);
    println(a && (b || c));
    println(a && b && c);
    println(a || b || c);
}
// CHECK-NOT: logical-operator-mixing.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
