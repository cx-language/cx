// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: static-const-redefinition.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

struct S {
    int x;
    // CHECK: [[@LINE+1]]:11: error: redefinition of 'x'
    const x = 5;
}

enum E {
    A,
    // CHECK: [[@LINE+1]]:11: error: redefinition of 'A'
    const A = 1;
}
// CHECK-NOT: static-const-redefinition.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
