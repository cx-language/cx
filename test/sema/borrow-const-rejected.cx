// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

void takesBorrow(int& x) {}

struct S {
    const MAX = 5;
}

const c = 5;

void main() {
    // CHECK: error: cannot bind 'int&' to constant 'int' in argument #1 to 'takesBorrow'
    takesBorrow(c);
    // CHECK: error: cannot bind 'int&' to constant 'int' in argument #1 to 'takesBorrow'
    takesBorrow(S.MAX);
}
