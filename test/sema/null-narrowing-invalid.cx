// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

void takesInt(int i) {}

struct S {
    int x;
}

void redundantUnwrap(int? v) {
    if v {
        // CHECK: [[@LINE+1]]:17: warning: 'v' is already non-null; remove the '!'
        var x = v!;
    }
}

void redundantNullCheck(int? v) {
    if v {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if v == null {
        }
    }
}

void redundantNegation(int? v) {
    if v {
        // CHECK: [[@LINE+1]]:13: warning: value cannot be null here; null check can be removed
        if !v {
        }
    }
}

void redundantTruthiness(int? v) {
    if (v != null) {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if v {
        }
    }
}

void useAfterNullAssignment(int? v) {
    if v {
        v = null;
        // CHECK: [[@LINE+1]]:11: error: no matching operator '+' with arguments 'int?' and 'int'
        v + 1;
    }
}

void useAfterOptionalAssignment(int? v, int? w) {
    if v {
        v = w;
        // CHECK: [[@LINE+1]]:11: error: no matching operator '+' with arguments 'int?' and 'int'
        v + 1;
    }
}

void useAfterBranchAssignment(int? v, bool c) {
    if v {
        if c {
            v = null;
        }
        // CHECK: [[@LINE+1]]:11: error: no matching operator '+' with arguments 'int?' and 'int'
        v + 1;
    }
}

void inferredVarIsNonOptional(int? v) {
    if v {
        var c = v;
        // CHECK: [[@LINE+1]]:9: error: cannot assign 'null' to 'int'
        c = null;
    }
}

void useAfterLoopAssignment(int? v, bool c) {
    if v {
        while c {
            // CHECK: [[@LINE+1]]:15: error: no matching operator '+' with arguments 'int?' and 'int'
            v + 1;
            v = null;
        }
        // CHECK: [[@LINE+1]]:11: error: no matching operator '+' with arguments 'int?' and 'int'
        v + 1;
    }
}

void useAfterSwitchAssignment(int? v, int c) {
    if v {
        switch c {
        case 1:
            v = null;
        }
        // CHECK: [[@LINE+1]]:11: error: no matching operator '+' with arguments 'int?' and 'int'
        v + 1;
    }
}

void useAfterLogicalAnd(int? v, bool y) {
    var b = v != null && y;
    // CHECK: [[@LINE+1]]:7: error: no matching operator '+' with arguments 'int?' and 'int'
    v + 1;
}

void useInDefer(int? v) {
    if v {
        // CHECK: [[@LINE+1]]:17: error: no matching operator '+' with arguments 'int?' and 'int'
        defer v + 1;
    }
}

void redundantNullCheckAfterNotEqual(int? v) {
    if (v != null) {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if v == null {
        }
    }
}

void redundantNotEqualAfterNotEqual(int? v) {
    if (v != null) {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if v != null {
        }
    }
}

void redundantStructNullCheck(S? v) {
    if (v != null) {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if v == null {
        }
    }
}

void redundantListNullCheck(List<int>? r) {
    if r == null {
        return;
    }
    // CHECK: [[@LINE+1]]:8: warning: value cannot be null here; null check can be removed
    if r != null {
    }
}

void redundantPointerOptionalCheck(int*? p) {
    if p == null {
        return;
    }
    // CHECK: [[@LINE+1]]:8: warning: value cannot be null here; null check can be removed
    if p != null {
    }
}

void redundantNullOnLeft(int? v) {
    if (v != null) {
        // CHECK: [[@LINE+1]]:12: warning: value cannot be null here; null check can be removed
        if null == v {
        }
    }
}

void explicitUnwrapVsNullStillErrors(int? v) {
    if (v != null) {
        // CHECK: [[@LINE+2]]:12: warning: 'v' is already non-null; remove the '!'
        // CHECK: [[@LINE+1]]:12: error: invalid operands 'int' and 'null' to '==' (non-optional type 'int' cannot be null)
        if v! == null {
        }
    }
}

