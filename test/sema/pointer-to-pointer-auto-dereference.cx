// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

extern void f(int* i);

void a(int* p) {
    var q = p;
    // CHECK: [[@LINE+1]]:7: error: invalid argument #1 type 'int**' to 'f', expected 'int*'
    f(&q);
    // CHECK: [[@LINE+1]]:7: error: invalid argument #1 type 'int**' to 'f', expected 'int*'
    f(&p);
}
