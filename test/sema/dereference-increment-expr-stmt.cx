// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: dereference-increment-expr-stmt.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void f(int* p) {
    var a = p;

    // CHECK: [[@LINE+1]]:8: error: cannot increment pointer of type 'int*'; dereference it explicitly (e.g. '(*p)++')
    *(a++);
}

// CHECK-NOT: dereference-increment-expr-stmt.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
