// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: null-coalescing.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    int a = 1;
    // CHECK: [[@LINE+1]]:13: error: left operand of '??' must be an optional, got 'int32'
    println(a ?? 2);

    // CHECK: [[@LINE+1]]:13: error: left operand of '??' must be an optional, got 'null'
    println(null ?? 5);

    int? o = null;
    float? f = null;
    // CHECK: [[@LINE+1]]:15: error: incompatible operand types ('int32?' and 'float32?')
    println(o ?? f);

    // CHECK: [[@LINE+1]]:15: error: incompatible operand types ('int32?' and 'string')
    println(o ?? "s");
}

// CHECK-NOT: null-coalescing.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
