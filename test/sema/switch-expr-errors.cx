// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

enum Outcome {
    Ok(int value),
    Err(int code),
    Pending,
}

// CHECK: [[@LINE+2]]:12: error: switch expression must handle all cases of enum 'Outcome' (missing: Pending)
int nonExhaustive(Outcome* o) {
    return switch *o {
        case Ok value: value
        case Err: -1
    };
}

// CHECK: [[@LINE+2]]:12: error: switch expression on 'int' must have a default case
int intWithoutDefault(int n) {
    return switch n {
        case 0: 1
    };
}

// CHECK: [[@LINE+2]]:13: error: switch expression arms must produce a value; use a switch statement for side effects
void voidArms(int n) {
    var x = switch n {
        case 0: println("zero")
        default: println("many")
    };
}

// CHECK: [[@LINE+2]]:12: error: incompatible arm types ('int' and 'string')
int incompatibleArms(int n) {
    return switch n {
        case 0: 1
        default: "many"
    };
}

// CHECK: [[@LINE+2]]:19: error: switch condition must have integer, char, or enum type, got 'int*'; dereference it explicitly (e.g. 'switch (*p)')
int switchOnPointer(int* p) {
    return switch p {
        case 0: 1
        default: 2
    };
}
