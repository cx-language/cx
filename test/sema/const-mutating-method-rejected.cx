// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

struct Counter {
    int count = 0;
    void bump() { this.count = this.count + 1; }
    void bumpBare() { count = count + 1; }
    void bumpTwice() { this.bump(); this.bump(); }
    void reset() { this.count = 0; }
    void tick() { this.count++; }
    void add(int n) { this.count += n; }
    void badRecurse() {
        this.count = this.count - 1;
        if (this.count > 0) {
            this.badRecurse();
        }
    }
    int read() { return this.count; }
    int compute() { return this.read() + 1; }
}

void fill(int* p) {
    *p = 1;
}

void apply(void(string) f, string s) { f(s); }

struct Box {
    int v = 0;
    void poke() { fill(&this.v); }
    int get() { return this.v; }
}

struct LambdaLocal {
    int v = 0;
    // Writing lambda over the method's own locals: no rooted input binds.
    int f() {
        var l = [1, 2, 3];
        l.map(m => { var w = m; *w = 1; return *w; });
        return v;
    }
    int g() {
        var t = "local";
        apply(u => { u.data()[0] = char(88); }, t);
        return v;
    }
}

struct LambdaRootedField {
    int[] items = [];
    // Lambda over a rooted field: the parameter binds root storage, and a
    // local copied from it is tainted the same round.
    void h() {
        items.map(m => {
            var w = m;
            *w = 1;
            return *w;
        });
    }
}

struct LambdaRootedCoarg {
    string name = "";
    // Rooted co-argument binds the lambda parameter like a rooted receiver.
    int k() {
        apply(u => { u.data()[0] = char(88); }, name);
        return 1;
    }
    // Rootedness discovered after the call still binds: the prepass
    // fixpoint re-evaluates the call once `t` is marked.
    int q() {
        var t = "local";
        apply(u => { u.data()[0] = char(88); }, t);
        t = name;
        return 1;
    }
}

void direct() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'bump' on a constant: it mutates the receiver
    c.bump();
}

void bareField() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'bumpBare' on a constant: it mutates the receiver
    c.bumpBare();
}

void transitive() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'bumpTwice' on a constant: it mutates the receiver
    c.bumpTwice();
}

void compoundAndInc() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'reset' on a constant: it mutates the receiver
    c.reset();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'tick' on a constant: it mutates the receiver
    c.tick();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'add' on a constant: it mutates the receiver
    c.add(2);
}

void recursive() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'badRecurse' on a constant: it mutates the receiver
    c.badRecurse();
}

void borrowEscape() {
    const b = Box();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'poke' on a constant: it mutates the receiver
    b.poke();
}

void reinit() {
    const c = Counter();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'init' on a constant: it mutates the receiver
    c.init(Counter(5));
}

void lambdaOverRootedField() {
    const o = LambdaRootedField([1, 2, 3]);
    // CHECK: [[@LINE+1]]:5: error: cannot call 'h' on a constant: it mutates the receiver
    o.h();
}

void lambdaOverRootedCoarg() {
    const o = LambdaRootedCoarg("x");
    // CHECK: [[@LINE+1]]:5: error: cannot call 'k' on a constant: it mutates the receiver
    o.k();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'q' on a constant: it mutates the receiver
    o.q();
}

void readsPass() {
    const c = Counter(41);
    println(c.read());
    println(c.compute());
    println(c);
    const b = Box();
    println(b.get());
    const l = LambdaLocal(7);
    println(l.f());
    println(l.g());
}

struct Inner {
    int v = 0;
    void bump() { v++; }
}

void shake(Inner& i) { i.bump(); }

struct Outer {
    Inner inner;
    void g() { shake(inner); }
}

void borrowParamPropagates() {
    const o = Outer(Inner(0));
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct LitBox {
    int[3] data = [1, 2, 3];
    void g() {
        var w = [&data[0]];
        *(w[0]) = 99;
    }
}

void literalSmuggle() {
    const o = LitBox();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct SliceMemberBox {
    int[*] p;
}

struct SliceMemberHolder {
    int[3] data = [1, 2, 3];
    void g() {
        var b = SliceMemberBox(data.data());
        b.p[1] = 99;
    }
}

void transparentSliceMemberIndex() {
    const o = SliceMemberHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct InnerBox {
    Inner* p;
}

struct InnerHolder {
    Inner inner = Inner(0);
    void g() {
        var b = InnerBox(&inner);
        b.p.v = 99;
    }
}

void transparentPtrMemberChain() {
    const o = InnerHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct AddrofHolder {
    int[3] data = [1, 2, 3];
    void g() {
        (&data)[1] = 99;
    }
}

void addrofIndex() {
    const o = AddrofHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct NestedIdxHolder {
    int[3] data = [1, 2, 3];
    void g() {
        var w = [data.data()];
        w[0][1] = 99;
    }
}

void nestedIndexThroughLocal() {
    const o = NestedIdxHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct ReassignIdxHolder {
    int[3] data = [1, 2, 3];
    void g() {
        var z = [0, 0, 0];
        var w = [z.data()];
        w[0] = data.data();
        w[0][1] = 99;
    }
}

void reassignIndexThroughLocal() {
    const o = ReassignIdxHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}

struct FieldBox {
    int*? p = null;
}

struct FieldSlotHolder {
    FieldBox b = FieldBox();
    void g() {
        int q = 1;
        b.p = &q;
    }
}

void rootedFieldTransparentSlot() {
    const o = FieldSlotHolder();
    // CHECK: [[@LINE+1]]:5: error: cannot call 'g' on a constant: it mutates the receiver
    o.g();
}
