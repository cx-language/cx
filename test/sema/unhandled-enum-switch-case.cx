// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s


enum Color {
    Red,
    Green,
    Blue
}

void foo(Color c) {
    // CHECK: [[@LINE+1]]:13: warning: enumeration value 'Blue' not handled in switch
    switch (c) {
    case Color.Red:
        break;
    case Color.Green:
        break;
    }
}

void bar(Color c) {
    switch (c) {
    case Color.Red:
        break;
    }
}

void baz(Color c) {
    switch (c) {
    case Color.Red:
        break;
    default:
        break;
    }
}

void unqualified(Color c) {
    // CHECK: [[@LINE+1]]:13: warning: enumeration value 'Blue' not handled in switch
    switch (c) {
    case Red:
        break;
    case Green:
        break;
    }
}

void unqualifiedFullyCovered(Color c) {
    switch (c) {
    case Red:
        break;
    case Green:
        break;
    case Blue:
        break;
    }
}

void main() {
    foo(Color.Red);
    bar(Color.Red);
    baz(Color.Red);
    unqualified(Color.Red);
    unqualifiedFullyCovered(Color.Red);
}

