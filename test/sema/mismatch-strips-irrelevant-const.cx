// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

const gci = 1;
const cf = 1.5;

struct S {
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'float' to 'uint64'
    uint64 f = cf;
}

void genericDefault<T>(T p = gci) {}

void takesUint64(uint64 p) {}

int getIndex() {
    return 0;
}

uint64 returnMismatch() {
    const x = [1];
    // CHECK: [[@LINE+1]]:12: error: mismatching return type 'int', expected 'uint64'
    return x[0];
}

void keepConst() {
    const x = [1, 2];
    int i = getIndex();
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int' to 'int&' (cannot bind immutable value to mutable borrow; use 'const int&' instead)
    int& r = x[i];
}

void main() {
    const x = [1];
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'int' to 'uint64'
    uint64 y = x[0];
    uint64 a = 0;
    // CHECK: [[@LINE+1]]:5: error: cannot assign 'int' to 'uint64'
    a = x[0];
    var arr = [1, 2];
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'float' to 'int'
    arr[0] = cf;
    // CHECK: [[@LINE+1]]:5: error: cannot assign 'int' to 'bool'
    genericDefault<bool>();
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'int' to 'takesUint64', expected 'uint64'
    takesUint64(x[0]);
}

void constTarget() {
    // CHECK: [[@LINE+1]]:20: error: cannot assign 'int' to 'char' (use 'char(...)' to convert explicitly)
    const char c = 5;
}

void switchConst() {
    const c = 5;
    switch (c) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'bool' doesn't match switch condition type 'int'
        case false: break;
    }
    switch (c) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'null' doesn't match switch condition type 'int'
        case null: break;
        default: break;
    }
    const int? o = 5;
    switch (o) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'int' doesn't match switch condition type 'int?'
        case 1: break;
        default: break;
    }
}

void ternaryConst() {
    const c = 1;
    // CHECK: [[@LINE+1]]:9: error: incompatible operand types ('int' and 'string')
    _ = true ? c : "s";
    // CHECK: [[@LINE+1]]:9: error: incompatible operand types ('string' and 'int')
    _ = true ? "s" : c;
}

enum E { A, B }

void nullCoalescingConst() {
    const int? o = 5;
    // CHECK: [[@LINE+1]]:9: error: incompatible operand types ('int?' and 'string')
    _ = o ?? "s";
}

int armsConst(int n) {
    const c = 1;
    return switch n {
        // CHECK: [[@LINE+1]]:17: error: incompatible arm types ('int' and 'string')
        case 0: c
        default: "many"
    };
}

int switchExprConst(int n) {
    const m = n;
    return switch m {
        // CHECK: [[@LINE+1]]:14: error: case value type 'bool' doesn't match switch condition type 'int'
        case false: 1
        default: 0
    };
}
