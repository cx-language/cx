// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

int pick(int& x) {
    return 1;
}

int pick(int* x) {
    return 0;
}

int deref(int& x) {
    return x;
}

int pickPtr(int*& x) {
    return 1;
}

int pickPtr(int* x) {
    return 0;
}

int getOrNegOne(int&? o) {
    if o {
        return *o;
    }
    return -1;
}

int main() {
    var v = 1;
    int* p = &v;
    // An exact pointer match is still chosen where one exists...
    if pick(p) != 0 return 1;
    // ...while plain lvalues still borrow.
    if pick(v) != 1 return 1;
    // Pointers no longer convert to borrows implicitly; dereference explicitly.
    // CHECK: [[@LINE+1]]:14: error: invalid argument #1 type 'int*' to 'deref', expected 'int&'
    if deref(p) != 1 return 1;
    // A direct borrow of a pointer variable still beats by-value.
    if pickPtr(p) != 1 return 1;
    // Explicit dereference borrows the pointee.
    if deref(*p) != 1 return 1;
    // Nullable pointers no longer convert to nullable borrows either.
    int*? q = &v;
    // CHECK: [[@LINE+1]]:20: error: invalid argument #1 type 'int*?' to 'getOrNegOne', expected 'int&?'
    if getOrNegOne(q) != 1 return 1;
    return 0;
}
