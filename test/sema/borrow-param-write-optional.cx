// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

struct Inner {
    int v;
}

struct Outer {
    Inner? opt;
}

// Only the may-be-null warning fires here; field writes through a borrow no
// longer warn, so the borrow warning from the old behavior is gone.
void nestedOptionalWrite(Outer& o) {
    // CHECK: [[@LINE+1]]:5: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    o.opt.v = 1;
}
