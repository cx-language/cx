// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-payload-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:33: error: invalid argument #1 type 'string' to 'Ok', expected 'int'
    Outcome<int> r = Outcome.Ok(value = "s");
}

// CHECK-NOT: generic-enum-payload-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
