// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-payload-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Result<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:31: error: invalid argument #1 type 'string' to 'Ok', expected 'int'
    Result<int> r = Result.Ok(value = "s");
}

// CHECK-NOT: generic-enum-payload-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
