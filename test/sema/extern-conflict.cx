// RUN: %not %cx --print-ir %s 2>&1 | %FileCheck %s
// CHECK-NOT: {{(warning|error)}}:

import "inputs/extern-conflict-a.h";
import "inputs/extern-conflict-b.h";

// CHECK: extern-conflict-b.h:1:5: error: conflicting declaration of extern function 'picks'
// CHECK: extern-conflict-a.h:1:5: note: previous definition here

void main() {
    print(picks(1));
    print(picks(1, 2));
}

// CHECK-NOT: {{(warning|error)}}:
