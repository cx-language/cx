// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

struct Box<T> {
    T value;
}

Box<T> Box<T>(T a) {
    abort("unreachable");
}

void main() {
    // CHECK: 17:13: error: ambiguous reference to 'Box<int32>' constructor
    // CHECK: 3:8: note: candidate function:
    // CHECK-NEXT: struct Box<T> {
    // CHECK: 7:8: note: candidate function:
    // CHECK-NEXT: Box<T> Box<T>(T a) {
    var b = Box<int>(1);
}
