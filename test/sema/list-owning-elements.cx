// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

// The array constructor moves elements out, so an owning array is consumed
// while Copyable arrays (and all literals) keep working.

void owningArrayIsConsumed() {
    var a = [StringBuf("x")];
    var l = List(a);
    // CHECK: error: use of moved value 'a' (type 'StringBuf[1]' is not Copyable because it holds 'List<char>', which has a destructor)
    println(a.size());
}

void owningSmallListArrayIsConsumed() {
    var a = [StringBuf("x")];
    var l = SmallList<StringBuf, 4>(a);
    // CHECK: error: use of moved value 'a' (type 'StringBuf[1]' is not Copyable because it holds 'List<char>', which has a destructor)
    println(a.size());
}

void copyableArraySurvives() {
    // No error: Copyable arrays are copied, not moved.
    var b = [1, 2];
    var l = List(b);
    println(b.size());
}
