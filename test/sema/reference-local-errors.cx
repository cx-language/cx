// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: reference-local-errors.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

var g = 1;
// CHECK: [[@LINE+1]]:1: error: reference type 'int&' may only appear as a function parameter, return type, local variable, or interface argument
int& gr = g;

void missingInitializer() {
    // CHECK: [[@LINE+1]]:10: error: reference variable 'r' must be initialized (borrows cannot be rebound)
    int& r;
}

void rebindLocal() {
    var x = 1;
    var y = 2;
    int& r = x;
    // CHECK: [[@LINE+1]]:5: error: cannot rebind borrow of type 'int&' (use '*' to write through it explicitly)
    r = y;
}

void bindTemporary() {
    var x = 1;
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'int' to 'int&'
    int& r = x + 1;
}

// CHECK-NOT: reference-local-errors.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
