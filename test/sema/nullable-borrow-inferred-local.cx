// RUN: %cx -typecheck %s -Wno-unused

void fromParam(int&? o) {
    var r = o;
    if (r != null) {
        *r += 1;
        println(*r);
    }
}

void main() {
    var counts = Map<string, int>();
    string key = "a";
    var count = counts[key];
    if (count != null) {
        *count += 1;
        println(*count);
    }
}
