// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void main() {
    const int[2] a = [1, 2];
    // CHECK: [[@LINE+1]]:16: error: cannot call 'data' on a constant: it returns 'int[*]', which would alias frozen storage
    int[*] p = a.data();
}

void optionalDecay() {
    const int[3]? o = [1, 2, 3];
    // CHECK: [[@LINE+1]]:17: error: cannot assign 'int[3]?' to 'int[*]?'
    int[*]? p = o;
}

void noLaunderToVoid() {
    const int[3] a = [1, 2, 3];
    // CHECK: [[@LINE+1]]:15: error: cannot call 'data' on a constant: it returns 'int[*]', which would alias frozen storage
    void* v = a.data();
}

void borrowReturnRejected() {
    const arr = [1, 2, 3];
    // CHECK: [[@LINE+1]]:13: error: cannot call 'first' on a constant: it returns 'int&', which would alias frozen storage
    var f = arr.first();
    // CHECK: [[@LINE+1]]:13: error: cannot call 'find' on a constant: it returns 'int&?', which would alias frozen storage
    var x = arr.find(n => *n > 1);
}

void takePtr(int* p) {}
void takeView(int[*] p) {}

void mutableThroughView(int[3] arr) {
    int[*] v = arr.data();
    int* p = &arr[0];
    int[*]? o = arr.data();
    takePtr(o);
    takeView(v);
}
