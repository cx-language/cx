// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void main() {
    const int[2] a = [1, 2];
    // CHECK: [[@LINE+1]]:16: error: cannot assign 'const int[*]' to 'int[*]'
    int[*] p = a.data();
}

void optionalDecay() {
    const int[3]? o = [1, 2, 3];
    // CHECK: [[@LINE+1]]:17: error: cannot assign 'int[3]?' to 'int[*]?'
    int[*]? p = o;
    const int[*]? q = o; // fine: const view of const storage
}

void noLaunderToVoid() {
    const int[3] a = [1, 2, 3];
    // CHECK: [[@LINE+1]]:15: error: cannot assign 'const int[*]' to 'void*'
    void* v = a.data();
    const void* w = a.data(); // fine
}

void takeConstPtr(const int* p) {}
void takeConstView(const int[*] p) {}
void takePtr(int* p) {}
void takeView(int[*] p) {}

void constThroughView(int[3] arr) {
    int[*] v = arr.data();
    int* p = &arr[0];
    takeConstPtr(v); // fine: view to const pointer
    takeConstView(p); // fine: pointer to const view
    int[*]? o = arr.data();
    takePtr(o); // fine: unwrap and view compose
    takeConstPtr(o); // fine: unwrap, view, and const compose
    takeConstView(o); // fine: unwrap and const-widen compose
}

void noDropConstThroughView(int[3] arr) {
    const int[*] cv = arr.data();
    // CHECK: [[@LINE+1]]:13: error: invalid argument #1 type 'const int[*]' to 'takePtr', expected 'int*'
    takePtr(cv);
    // CHECK: [[@LINE+1]]:14: error: invalid argument #1 type 'const int[*]' to 'takeView', expected 'int[*]'
    takeView(cv);
    const int[*]? co = arr.data();
    // CHECK: [[@LINE+1]]:13: error: invalid argument #1 type 'const int[*]?' to 'takePtr', expected 'int*'
    takePtr(co);
    // CHECK: [[@LINE+1]]:14: error: invalid argument #1 type 'const int[*]?' to 'takeView', expected 'int[*]'
    takeView(co);
}
