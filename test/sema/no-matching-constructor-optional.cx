// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: no-matching-constructor-optional.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    // Optional is an enum; construct values with Optional.Some/Optional.None instead.
    // CHECK: [[@LINE+1]]:14: error: no matching constructor 'Optional(int32)'
    int? x = Optional(2);
}

// CHECK-NOT: no-matching-constructor-optional.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
