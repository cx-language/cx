// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s -allow-empty

// CHECK-NOT: enum-associated-value-order.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum E {
    A(int a, int b)
}

void main() {
    var _a = E.A(b = 1, a = 2);
}

// CHECK-NOT: enum-associated-value-order.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
