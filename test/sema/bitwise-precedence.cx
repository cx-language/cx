// RUN: check_exit_status 0 %cx run -Werror %s

// Bitwise operators bind tighter than comparisons:
// `a & b != 0` parses as `(a & b) != 0`.
void main() {
    var a = 6;
    var b = 5;
    assert(a & b != 0);
    assert(a & b == 4);
    assert(a | b == 7);
    assert(a ^ b == 3);
    assert(a << 1 == 12);
    assert(a >> 1 == 3);
    assert(a << 1 < 16);
}
