// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: no-implicit-deref.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void takeInt(int x) {}

int borrowPassthrough(int& r) {
    int a = r;
    takeInt(r);
    a += r;
    return r;
}

int derefRequired(int* p) {
    // CHECK: [[@LINE+1]]:13: error: cannot assign 'int32*' to 'int32' (use '*' to dereference explicitly)
    int a = p;
    // CHECK: [[@LINE+1]]:13: error: invalid argument #1 type 'int32*' to 'takeInt', expected 'int32' (use '*' to dereference explicitly)
    takeInt(p);
    // CHECK: [[@LINE+1]]:7: error: invalid operands 'int32' and 'int32*' to '+'; pointer arithmetic is not supported; dereference with '*' to operate on the pointed-to value
    a += p;
    // CHECK: [[@LINE+1]]:15: error: invalid operands 'int32' and 'int32*' to '*'; pointer arithmetic is not supported; dereference with '*' to operate on the pointed-to value
    int b = a * p;
    // CHECK: [[@LINE+1]]:16: error: invalid operands 'int32*' and 'int32' to '<'; to compare the pointed-to value, dereference with '*'
    bool c = p < a;
    // CHECK: [[@LINE+1]]:5: error: mismatching return type 'int32*', expected 'int32'
    return p;
}

// CHECK-NOT: no-implicit-deref.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
