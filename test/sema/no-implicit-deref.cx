// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void takeInt(int x) {}

int borrowPassthrough(int& r) {
    int a = r;
    takeInt(r);
    a += r;
    return r;
}

int derefRequired(int* p) {
    // CHECK: [[@LINE+1]]:13: error: cannot assign 'int*' to 'int' (use '*' to dereference explicitly)
    int a = p;
    // CHECK: [[@LINE+1]]:13: error: invalid argument #1 type 'int*' to 'takeInt', expected 'int' (use '*' to dereference explicitly)
    takeInt(p);
    // CHECK: [[@LINE+1]]:7: error: invalid operands 'int' and 'int*' to '+'; pointer arithmetic is not supported; dereference with '*' to operate on the pointed-to value
    a += p;
    // CHECK: [[@LINE+1]]:15: error: invalid operands 'int' and 'int*' to '*'; pointer arithmetic is not supported; dereference with '*' to operate on the pointed-to value
    int b = a * p;
    // CHECK: [[@LINE+1]]:16: error: invalid operands 'int*' and 'int' to '<'; to compare the pointed-to value, dereference with '*'
    bool c = p < a;
    // CHECK: [[@LINE+1]]:5: error: mismatching return type 'int*', expected 'int'
    return p;
}

