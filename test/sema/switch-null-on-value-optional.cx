// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: switch-null-on-value-optional.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    int? o = 1;
    switch (o) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'null' doesn't match switch condition type 'int?'
        case null: break;
    }
}

// CHECK-NOT: switch-null-on-value-optional.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
