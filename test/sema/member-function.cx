// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: member-function.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

struct Foo {
    int i;
    void bar() {
        // CHECK: [[@LINE+1]]:18: error: cannot assign 'Foo&' to 'Foo*' (use '&' to take the address explicitly)
        Foo* f = this;
    }
}
