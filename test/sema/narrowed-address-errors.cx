// RUN: %not %cx -typecheck -error-limit 0 %s -Wno-unused 2>&1 | %FileCheck %s

struct S { int x; }
void takePayload(S* s) {}
void takeOptional(S?* s) {}
void takeOptPtrOpt(S?*? s) {}
void borrowOptional(S?& s) {}
void takeVoidPtr(void* p) {}
void takeIntPtrPtr(int** p) {}
extern "C" void vt(void* p, ...);

void nullBranch() {
    S? s = S(1);
    if s == null {
        // CHECK: [[@LINE+1]]:21: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
        takePayload(&s);
    }
}

void plainPointer() {
    S? s = S(1);
    if s == null { return; }
    S?* p = &s;
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(p);
}

void constSource() {
    const S? s = S(1);
    if s == null { return; }
    // CHECK: [[@LINE+1]]:18: error: cannot take address of constant 's'
    takePayload(&s);
}

void invalidatedByAssign() {
    S? s = S(1);
    if s == null { return; }
    s = null;
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);
}

void invalidatedByCall() {
    S? s = S(1);
    if s == null { return; }
    takeOptional(&s);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);

    S? t = S(2);
    if t == null { return; }
    borrowOptional(t);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&t);
}

void invalidatedByReborrow() {
    S? s = S(1);
    if s == null { return; }
    borrowOptional(&s);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);
}

void invalidatedByWrap() {
    S? s = S(1);
    if s == null { return; }
    takeOptPtrOpt(&s);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);
}

void invalidatedByVariadic() {
    S? s = S(1);
    if s == null { return; }
    int x = 0;
    vt(&x, &s);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);
}

void invalidatedByVoidPointer() {
    S? s = S(1);
    if s == null { return; }
    takeVoidPtr(&s);
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&s);
}

void invalidatedByPointerOptionalPayloadCall() {
    // Pointer-implemented optionals share the payload address, so even a
    // payload-pointer call can null them.
    int i = 7;
    int*? o = &i;
    if o == null { return; }
    takeIntPtrPtr(&o);
    // CHECK: [[@LINE+1]]:19: error: invalid argument #1 type 'int*?*' to 'takeIntPtrPtr', expected 'int**'
    takeIntPtrPtr(&o);
}

S? g = null;

void globalCase() {
    if g == null { return; }
    // Globals never narrow, so the address keeps the declared type.
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'S?*' to 'takePayload', expected 'S*'
    takePayload(&g);
}

enum E { A(int x), B }
void takeInt(int* p) {}
void takeE(E* e) {}

void enumNarrowing() {
    E e = E.A(1);
    if e == E.A {
        // Only optional narrowing converts; enum payloads still need explicit handling.
        // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'E*' to 'takeInt', expected 'int*'
        takeInt(&e);
    }
}

void enumInvalidatedByCall() {
    E e = E.A(1);
    if e == E.A {
        takeE(&e);
        // CHECK: [[@LINE+1]]:17: error: no member named 'x' in 'E'
        println(e.x);
    }
}
