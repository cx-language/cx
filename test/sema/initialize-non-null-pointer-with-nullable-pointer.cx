// RUN: %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

extern int*? foo();

void main() {
    // CHECK: [[@LINE+1]]:14: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    int* f = foo();
}

void explicitlyUnwrapped() {
    int* f = foo()!;
}

void checkedBeforeUnwrap() {
    int*? x = foo();
    if (x != null) {
        int* y = x;
    }
    if (x) {
        int* z = x;
    }
}
