// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void main() {
    for i in 0..1 {
        // CHECK-NOT: [[@LINE+1]]:9: error
        break;
    }
    if (false) {
        // CHECK: [[@LINE+1]]:9: error: 'break' is only allowed inside 'while', 'do-while', 'for', and 'switch' statements
        break;
    }
}
