// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: switch-case-null-error.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    int x = 1;
    switch (x) {
        // CHECK: [[@LINE+1]]:14: error: case value type 'null' doesn't match switch condition type 'int32'
        case null: break;
        default: break;
    }
}

// CHECK-NOT: switch-case-null-error.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
