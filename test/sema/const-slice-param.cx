// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

int sum(const int[] s) {
    // No error: reads through a const-element slice are fine.
    return s[0] + s[1] + s[2];
}

void dataStaysConst(const int[] s) {
    // CHECK: [[@LINE+1]]:18: error: cannot assign 'const int[*]' to 'int[*]'
    int[*] bad = s.data();
}

void dataFlowsToConstTarget(const int[] s) {
    // No error.
    const int[*] ok = s.data();
}

void noWriteThroughData(const int[] s) {
    // CHECK: [[@LINE+1]]:5: error: cannot assign to immutable array of type 'const int[*]'
    s.data()[0] = 1;
}

void mutableDecaysToConst(int[] m) {
    // No error: a mutable slice converts to a const-element slice.
    sum(m);
}

int nested(const int[][] m) {
    // No error.
    return m[0][0];
}

void nestedSpellingIsOuterConst(int[][] m) {
    // CHECK: [[@LINE+1]]:12: error: invalid argument #1 type 'Slice<int>' to 'nested', expected 'Slice<const Slice<int>>'
    nested(m[0]);
}

void genericConstSlice<T>(const T[] s) {
    // CHECK: [[@LINE+1]]:5: error: cannot assign to immutable array of type 'const int[*]'
    s.data()[0] = 1;
}

void instantiateGenericConstSlice(int[] m) {
    genericConstSlice(m);
}
