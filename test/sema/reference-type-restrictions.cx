// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: reference-type-restrictions.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

struct S {
    // CHECK: [[@LINE+1]]:5: error: reference type 'int&' may only appear as a function parameter, return type, or interface
    int& field;
}

// Borrows may be returned, e.g. element accessors return borrows into the container.
// Returning a borrow of a local still warns since the local won't exist after the call.
int& returnsBorrow() {
    var x = 1;
    // CHECK: [[@LINE+1]]:12: warning: returning pointer to local variable (local variables will not exist after the function returns)
    return x;
}

// Nullable borrows are still just borrows, so they are allowed in parameter position.
// CHECK-NOT: [[@LINE+1]]:{{[0-9]+}}: {{(warning|error)}}:
void optionalBorrow(int&? o) {
}

void localBorrow() {
    var x = 1;
    // CHECK: [[@LINE+1]]:5: error: reference type 'int&' may only appear as a function parameter, return type, or interface
    int& r = x;
}

// CHECK: 12:6: warning: unused declaration 'returnsBorrow'
// CHECK: 20:6: warning: unused declaration 'optionalBorrow'
// CHECK: 23:6: warning: unused declaration 'localBorrow'
// CHECK-NOT: reference-type-restrictions.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
