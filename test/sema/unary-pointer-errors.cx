// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

void f(int* p, int[*] s) {
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-' to pointer of type 'int*'; dereference it explicitly (e.g. '-*p')
    _ = -p;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '+' to pointer of type 'int*'; dereference it explicitly (e.g. '+*p')
    _ = +p;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '~' to pointer of type 'int*'; dereference it explicitly (e.g. '~*p')
    _ = ~p;
    // CHECK: [[@LINE+1]]:9: error: cannot apply unary '-' to pointer of type 'int[*]'; dereference it explicitly (e.g. '-*p')
    _ = -s;
}

void g(int* p, int x) {
    _ = -*p;
    _ = -x;
    _ = ~x;
}

