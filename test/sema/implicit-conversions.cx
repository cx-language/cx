// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

struct U {
    int x;

    implicit U(V v) {
        this.x = v.x;
    }
}

struct V {
    int x;

    implicit V(int v) {
        this.x = v;
    }

    implicit U toU() {
        return U(x);
    }
}

void takeU(U u) {
}

struct Tiny {
    int8 x;

    implicit Tiny(int8 v) {
        this.x = v;
    }
}

U makeU(V v) {
    // CHECK: [[@LINE+1]]:12: error: mismatching return type 'V', expected 'U' (ambiguous implicit conversion)
    return v;
}

void main() {
    var v = V(1);
    // CHECK: [[@LINE+1]]:11: error: invalid argument #1 type 'V' to 'takeU', expected 'U' (ambiguous implicit conversion)
    takeU(v);
    // CHECK: [[@LINE+1]]:11: error: cannot assign 'V' to 'U' (ambiguous implicit conversion)
    U u = v;
    // CHECK: [[@LINE+1]]:5: error: cannot assign 'V' to 'U' (ambiguous implicit conversion)
    u = v;
    // Unambiguous uses still work: explicit construction and unrelated conversions.
    takeU(U(v));
    V w = 5;
    // Out-of-range literals report the range, not a generic mismatch.
    // CHECK: [[@LINE+1]]:14: error: 1000 is out of range for type 'int8'
    Tiny t = 1000;
}

void constArrayDoesNotConvertToSlice() {
    const a = [5, 4, 3, 2, 1];
    // CHECK: [[@LINE+1]]:10: error: cannot convert 'int[5]' to 'int[]' over a constant in argument #1 to 'sort' (use 'var' instead of 'const')
    sort(a);
    // CHECK: [[@LINE+1]]:15: error: cannot convert 'int[5]' to 'int[]' over a constant (use 'var' instead of 'const')
    int[] s = a;
}

int[] constArrayReturn() {
    const a = [5, 4, 3, 2, 1];
    // CHECK: [[@LINE+1]]:12: error: cannot convert 'int[5]' to 'int[]' over a constant in return value (use 'var' instead of 'const')
    return a;
}

