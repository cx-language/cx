// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

float[3] getVec() { return [1.0, 2.0, 3.0]; }

void main() {
    float[3] v = [1.0, 2.0, 3.0];
    // CHECK: [[@LINE+1]]:5: error: cannot increment rvalue of type 'float'
    v.xy.x++;
    // CHECK: [[@LINE+1]]:5: error: cannot increment rvalue of type 'float'
    v.xy[0]++;
    // CHECK: [[@LINE+1]]:5: error: cannot increment rvalue of type 'float'
    getVec()[0]++;
    // CHECK: [[@LINE+1]]:5: error: cannot increment rvalue of type 'float'
    getVec().x++;
    // CHECK: [[@LINE+1]]:5: error: cannot decrement rvalue of type 'float'
    v.xy.x--;

    var i = 0;
    i++;
    i--;
    v.x++;
    v[0]++;
}

