// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: enum-destructor-rejected.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum E {
    A,
    // CHECK: [[@LINE+1]]:5: error: enums cannot have destructors
    ~E() {}
}

// CHECK-NOT: enum-destructor-rejected.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
