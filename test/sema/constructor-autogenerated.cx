// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void main() {
    // CHECK: [[@LINE+1]]:13: error: too few arguments to 'S', expected 2
    var a = S();

    // CHECK: [[@LINE+1]]:13: error: too few arguments to 'S', expected 2
    var b = S(1);

    // CHECK: [[@LINE+1]]:15: error: invalid argument #1 type 'float32' to 'S', expected 'int32'
    var c = S(5.4, 1);
}

struct S {
    int x;
    int y;
}
