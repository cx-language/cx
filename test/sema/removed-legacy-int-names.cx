// RUN: %not %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// CHECK-NOT: removed-legacy-int-names.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void f() {
    // CHECK: [[@LINE+1]]:5: error: unknown type 'short'
    short a = 1;
    // CHECK: [[@LINE+1]]:5: error: unknown type 'ushort'
    ushort b = 1;
    // CHECK: [[@LINE+1]]:5: error: unknown type 'long'
    long c = 1;
    // CHECK: [[@LINE+1]]:5: error: unknown type 'ulong'
    ulong d = 1;
}

// CHECK-NOT: removed-legacy-int-names.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
