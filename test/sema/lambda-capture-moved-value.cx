// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: warning

struct Point {
    int x;
    int y;
}

void main() {
    var p = Point(x = 1, y = 2);
    var q = p;
    // CHECK: [[@LINE+1]]:19: error: use of moved value 'p'
    var f = () => p.x;
}

// CHECK-NOT: error
// CHECK-NOT: warning
