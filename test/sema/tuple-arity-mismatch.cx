// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: tuple-arity-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

(int? a, int b) make() {
    // CHECK: [[@LINE+1]]:5: error: mismatching return type '(int a, int b, int c)', expected '(int? a, int b)'
    return (a = 1, b = 2, c = 3);
}

// CHECK-NOT: tuple-arity-mismatch.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    make();
}
