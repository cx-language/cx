// RUN: %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

struct S {
    void f() {}
}

struct T {
    int x;
    S? y;
}

void clobberField(S?* field) {}
void clobberOther(int* field) {}

void fieldClobberWarns(T* t) {
    if t.y == null {
        return;
    }
    clobberField(&t.y);
    // CHECK: [[@LINE+1]]:5: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    t.y.f();
}

void otherFieldNoWarn(T* t) {
    if t.y == null {
        return;
    }
    clobberOther(&t.x);
    t.y.f();
}

S? g = S();

void takesNothing() {}

void globalClobberWarns() {
    if g == null {
        return;
    }
    takesNothing();
    // CHECK: [[@LINE+1]]:5: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    g.f();
}
