// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

// CHECK-NOT: {{(warning|error)}}:
void foo(int*? p) {
    if (p == null) {
        return;
    }
    defer println("foo");
    // CHECK: [[@LINE+1]]:16: warning: unwrapping non-optional type 'int32*' has no effect
    var a = *(p!);
}

// CHECK-NOT: {{(warning|error)}}:
