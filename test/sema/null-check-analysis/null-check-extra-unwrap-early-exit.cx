// RUN: %not %cx -typecheck %s -Wno-unused | %FileCheck %s

// CHECK-NOT: {{(warning|error)}}:
void foo(int*? p) {
    if (p == null) {
        return;
    }
    defer println("foo");
    // CHECK: [[@LINE+1]]:16: error: cannot unwrap non-optional type 'int*'
    var a = *(p!);
}

// CHECK-NOT: {{(warning|error)}}:
