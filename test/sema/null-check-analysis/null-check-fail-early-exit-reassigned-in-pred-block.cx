// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s

extern int*? bar();

void foo(int*? a) {
    int*? p = a;

    if (p == null) {
        return;
    } else {
        p = bar();
    }

    // CHECK: [[@LINE+1]]:13: warning: dereferenced pointer may be null; unwrap it with a postfix '!' to silence this warning
    var i = *p;
}
