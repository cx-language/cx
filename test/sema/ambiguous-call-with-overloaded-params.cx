// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

void foo(public int a) { }
void foo(public int b) { }

void mix(char a, int& b) { }
void mix(char& a, int b) { }

void sob(string a, int& b) { }
void sob(string& a, int b) { }

void main() {
    // CHECK: [[@LINE+6]]:5: error: ambiguous reference to 'foo'
    // CHECK: 3:6: note: candidate function:
    // CHECK-NEXT: void foo(public int a) { }
    // CHECK: 4:6: note: candidate function:
    // CHECK-NEXT: void foo(public int b) { }
    // CHECK-NOT: note
    foo(1)

    // Char constants bind to borrows conversion-free like ints, so neither
    // overload wins the no-conversion tie-break here.
    // CHECK: [[@LINE+6]]:5: error: ambiguous reference to 'mix'
    // CHECK: 6:6: note: candidate function:
    // CHECK-NEXT: void mix(char a, int& b) { }
    // CHECK: 7:6: note: candidate function:
    // CHECK-NEXT: void mix(char& a, int b) { }
    // CHECK-NOT: note
    mix('a', 1)

    // String literals bind to borrows conversion-free too.
    // CHECK: [[@LINE+6]]:5: error: ambiguous reference to 'sob'
    // CHECK: 9:6: note: candidate function:
    // CHECK-NEXT: void sob(string a, int& b) { }
    // CHECK: 10:6: note: candidate function:
    // CHECK-NEXT: void sob(string& a, int b) { }
    // CHECK-NOT: note
    sob("a", 1)
}
