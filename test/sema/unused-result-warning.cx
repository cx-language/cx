// RUN: %cx -typecheck %s -Wunused-result 2>&1 | %FileCheck %s
// RUN: %cx -typecheck %s -Werror

@discardableResult
int maybeIgnored() { return 42; }

@discardableResult
T genericIdent<T>(T value) { return value; }

struct Counter {
    int n;
    @discardableResult
    int bump() {
        n++;
        return n;
    }
    @discardableResult
    T echo<T>(T value) { return value; }
}

int compute() { return 42; }
void doWork() {}

void main() {
    // CHECK: [[@LINE+1]]:5: warning: unused result of type 'int'
    compute();
    doWork();
    int x = 1;
    x = 5;
    x++;
    x += 2;
    int[2] a = [1, 2];
    a[0] = 9;
    // CHECK: [[@LINE+1]]:5: warning: unused result of type 'int'
    x + 1;
    _ = compute();
    // CHECK: [[@LINE+1]]:11: warning: unused result of type 'int'
    defer compute();
    todo();
    println(x);
    const arr = [1, 2];
    // CHECK: [[@LINE+1]]:5: warning: unused result of type 'int'
    arr[0];
    maybeIgnored();
    genericIdent(5);
    var counter = Counter(n = 0);
    counter.bump();
    counter.echo(5);
    var list = List<int>();
    list.push(1);
    list.pop();
}

