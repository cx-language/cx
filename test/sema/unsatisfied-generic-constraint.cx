// RUN: %not %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

interface Fooable {
    void foo()
}

struct F: Copyable {
    int foo() { return 1 }
}

void main() {
    F f = undefined;

    // CHECK: 15:5: error: type 'F' doesn't implement interface 'Fooable'
    bar(f);
}

void bar<T: Fooable>(T t) {
    t.foo()
}
