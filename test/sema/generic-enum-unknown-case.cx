// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-unknown-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Result<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:20: error: enum 'Result' has no case named 'Bogus'
    var x = Result.Bogus;
}

// CHECK-NOT: generic-enum-unknown-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
