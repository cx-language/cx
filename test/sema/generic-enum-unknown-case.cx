// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: generic-enum-unknown-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:21: error: enum 'Outcome' has no case named 'Bogus'
    var x = Outcome.Bogus;
}

// CHECK-NOT: generic-enum-unknown-case.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
