// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// CHECK:compute
// CHECK-NEXT:deferred
// CHECK-NEXT:dtor
// CHECK-NEXT:dtor

struct S {
    int x;
    ~S() {
        println("dtor");
    }
}

int compute() {
    println("compute");
    return 42;
}

int f() {
    var _s = S(x = 1);
    defer println("deferred");
    return compute();
}

int g() {
    var s = S(x = 41);
    return s.x + 1;
}

void main() {
    assert(f() == 42);
    assert(g() == 42);
}
