// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: generic-const-array-index-assignment.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void mutate<T, int N>(T[N] a) {
    // CHECK: [[@LINE+1]]:6: error: cannot assign to immutable array of type 'const int32[2]'
    a[0] = a[0];
}

void main() {
    const int[2] a = [1, 2];
    mutate(a);
}
