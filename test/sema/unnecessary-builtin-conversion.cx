// RUN: %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

void a(int i) {
    // CHECK: [[@LINE+1]]:13: warning: unnecessary conversion to same type
    var j = int(i);
}

void constSource() {
    const c = 5;
    // CHECK: [[@LINE+1]]:13: warning: unnecessary conversion to same type
    var j = int(c);
}

void redundantCast(int i) {
    // CHECK: [[@LINE+1]]:13: warning: redundant cast to same type 'int'
    var j = cast<int>(i);
}
