// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

struct HasPrintField {
    int print;
}

struct HasPrintConst {
    const print = 1;
}

enum EnumHasPrintMethod {
    A,
    B,

    int print() {
        return 1;
    }
}

enum EnumHasPrintConst {
    A,
    B,

    const print = 1;
}

void main() {
    var h = HasPrintField(9);
    // Print synthesis declines when a member already owns the name, so this stays an error.
    // CHECK: error: no matching function 'print(HasPrintField)'
    println(h);
    var c = HasPrintConst();
    // CHECK: error: no matching function 'print(HasPrintConst)'
    println(c);
    // CHECK: error: no matching function 'print(EnumHasPrintMethod)'
    println(EnumHasPrintMethod.A);
    // CHECK: error: no matching function 'print(EnumHasPrintConst)'
    println(EnumHasPrintConst.A);
}
