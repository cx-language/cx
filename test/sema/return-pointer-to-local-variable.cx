// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

int* f0() {
    var a = 3;
    // CHECK: [[@LINE+1]]:13: warning: returning pointer to local variable
    return &a;
}

int* f1() {
    var a = 3;
    // CHECK: [[@LINE+1]]:5: error: mismatching return type 'int32', expected 'int32*' (use '&' to take the address explicitly)
    return a;
}

struct S: Copyable {
    int i;

    int* f2() {
        // CHECK-NOT: [[@LINE+1]]:17: warning: returning pointer to local variable
        return &i;
    }

    int* f3() {
        // CHECK: [[@LINE+1]]:9: error: mismatching return type 'int32', expected 'int32*' (use '&' to take the address explicitly)
        return i;
    }
}

int* f4(int a) {
    // CHECK: [[@LINE+1]]:13: warning: returning pointer to local variable
    return &a;
}

int* f5(int a) {
    // CHECK: [[@LINE+1]]:5: error: mismatching return type 'int32', expected 'int32*' (use '&' to take the address explicitly)
    return a;
}

int* f6(int* a) {
    // CHECK-NOT: [[@LINE+1]]:12: warning: returning pointer to local variable
    return a;
}

int** f7(int* a) {
    // CHECK: [[@LINE+1]]:13: warning: returning pointer to local variable
    return &a;
}

int** f8(int* a) {
    // CHECK: [[@LINE+1]]:5: error: mismatching return type 'int32*', expected 'int32**' (use '&' to take the address explicitly)
    return a;
}

int* f9(int& a) {
    // CHECK-NOT: [[@LINE+1]]:13: warning: returning pointer to local variable
    return &a;
}
