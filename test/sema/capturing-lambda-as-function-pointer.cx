// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

// CHECK-NOT: warning

void takesFn(int(int) f) {
    _ = f(10);
}

void takesGeneric<T>(T(int) f) {
    _ = f(10);
}

struct S {
    int(int) cb;
}

int(int) returnsFn() {
    var a = 1;
    // CHECK: [[@LINE+1]]:5: error: cannot convert capturing lambda '(int32) => int32' to function type 'int32(int32)'
    return (int c) => c + a;
}

void main() {
    takesFn((int c) => c);
    takesGeneric((int c) => c);
    var a = 1;
    // CHECK: [[@LINE+1]]:13: error: cannot convert capturing lambda '(int32) => int32' to function type 'int32(int32)'
    takesFn((int c) => c + a);
    // CHECK: [[@LINE+1]]:18: error: cannot convert capturing lambda '(int32) => int32' to function type 'int32(int32)'
    takesGeneric((int c) => c + a);
    var s = S(cb = (int c) => c);
    // CHECK: [[@LINE+1]]:10: error: cannot convert capturing lambda '(int32) => int32' to function type 'int32(int32)'
    s.cb = (int c) => c + a;
    _ = returnsFn();
}

// CHECK-NOT: error
// CHECK-NOT: warning
