// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

var M = 8;
// CHECK: [[@LINE+1]]:1: error: array size must be a constant integer expression
uint8[M] a = undefined;

const N = 8;

void g() {
    var N = 5;
    // Must not fold against the shadowed global.
    // CHECK: [[@LINE+1]]:5: error: array size must be a constant integer expression
    uint8[N] c = undefined;
}

void unknownName() {
    // CHECK: [[@LINE+1]]:5: error: array size must be a constant integer expression
    uint8[Nope] u = undefined;
}

void divByZero() {
    // CHECK: [[@LINE+1]]:11: error: division by zero in array size
    uint8[N / 0] v = undefined;
}

void negativeSize() {
    // CHECK: [[@LINE+1]]:11: error: array size must be non-negative
    uint8[1 - N] w = undefined;
}

const Q = 8;

// The generic parameter collides with the global, so only the redefinition
// fires; the return type stays symbolic (no mis-folded size cascade).
// CHECK: [[@LINE+1]]:21: error: redefinition of 'Q'
uint8[Q] shadow<int Q>(int x) {
    uint8[Q] d = undefined;
    return d;
}
