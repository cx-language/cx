// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

using MyInt = int;
using Ints = List<int>;

int foo() {
    return 1;
}

int32 bar() {
    return 2;
}

int withParam(int x) {
    return x;
}

void main() {
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int' to 'bool'
    bool a = foo();
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int' to 'bool'
    bool b = 1;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int32' to 'bool'
    bool c = bar();
    // CHECK: [[@LINE+1]]:15: error: cannot assign 'bool' to 'MyInt'
    MyInt d = true;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int' to 'Ints'
    Ints e = 0;
    // CHECK: [[@LINE+2]]:14: warning: unnecessary conversion to same type
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int' to 'bool'
    bool f = int(1);
    // CHECK: [[@LINE+1]]:19: error: cannot assign 'int' to 'List<int>'
    List<int> g = 0;
    const int ci = 1;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'const int' to 'bool'
    bool h = ci;
    var x = 1;
    int* p = &x;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int*' to 'bool'
    bool i = p;
    int? o = null;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int?' to 'bool'
    bool j = o;
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int()' to 'bool'
    bool k = foo;
    // CHECK: [[@LINE+1]]:15: error: cannot assign 'int(int)' to 'bool'
    bool k2 = withParam;
    // A canonical declaration keeps its spelling even when initialized from an alias.
    int32 l = foo();
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'int32' to 'bool'
    bool m = l;
    MyInt n = 2;
    int32 o2 = n;
    // CHECK: [[@LINE+1]]:15: error: cannot assign 'int32' to 'bool'
    bool p2 = o2;
    var la = List([1, 2]);
    var lb = List([true]);
    // CHECK: [[@LINE+1]]:16: error: no matching operator '==' with arguments 'List<int>' and 'List<bool>'
    println(la == lb);
    // Float literals default to 'float', like int literals default to 'int'.
    // CHECK: [[@LINE+1]]:14: error: cannot assign 'float' to 'bool'
    bool r = 1.5;
}

