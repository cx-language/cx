// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-explicit-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:34: error: too many generic arguments to 'Outcome', expected 1
    var x = Outcome.Ok<int, bool>(value = 1);
}

// CHECK-NOT: generic-enum-explicit-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
