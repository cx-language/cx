// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-explicit-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Result<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:33: error: too many generic arguments to 'Result', expected 1
    var x = Result.Ok<int, bool>(value = 1);
}

// CHECK-NOT: generic-enum-explicit-arg-count.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
