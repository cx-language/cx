// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s


struct FixedArray<T, int N> {
    T[N] elements;
}

struct MyBox<T> {
    T value;
}

void main() {
    // CHECK: [[@LINE+2]]:24: error: expected type generic argument for parameter 'T' of 'FixedArray'
    // CHECK: [[@LINE+1]]:27: error: expected integer generic argument for parameter 'N' of 'FixedArray'
    var a = FixedArray<3, int>(elements = [1]);
    // CHECK: [[@LINE+1]]:19: error: expected type generic argument for parameter 'T' of 'MyBox'
    var b = MyBox<3>(value = 1);
    // CHECK: [[@LINE+1]]:29: error: expected integer generic argument for parameter 'N' of 'FixedArray'
    var c = FixedArray<int, string>(elements = [1]);
    _ = a;
    _ = b;
    _ = c;
}

