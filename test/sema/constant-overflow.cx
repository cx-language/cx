// RUN: %not %cx -typecheck %s | %FileCheck %s
// CHECK-NOT: constant-overflow.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    // CHECK: [[@LINE+1]]:24: error: 2147483648 is out of range for type 'int'
    println(2147483647 + 1);
    // CHECK: [[@LINE+1]]:24: error: 4294967294 is out of range for type 'int'
    println(2147483647 * 2);
    const int min = -2147483648;
    // CHECK: [[@LINE+1]]:17: error: -2147483649 is out of range for type 'const int'
    println(min - 1);
    const uint umax = 4294967295;
    const uint one = 1;
    // CHECK: [[@LINE+1]]:18: error: 4294967296 is out of range for type 'const uint'
    println(umax + one);
}

// CHECK-NOT: constant-overflow.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
