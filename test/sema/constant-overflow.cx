// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void main() {
    // CHECK: [[@LINE+1]]:13: error: 2147483648 is out of range for type 'int'
    println(2147483647 + 1);
    // CHECK: [[@LINE+1]]:13: error: 4294967294 is out of range for type 'int'
    println(2147483647 * 2);
    const int min = -2147483648;
    // CHECK: [[@LINE+1]]:13: error: -2147483649 is out of range for type 'int'
    println(min - 1);
    const uint umax = 4294967295;
    const uint one = 1;
    // CHECK: [[@LINE+1]]:13: error: 4294967296 is out of range for type 'uint'
    println(umax + one);
    // CHECK: [[@LINE+1]]:13: error: 2147483648 is out of range for type 'int'
    println(-min);
    // CHECK: [[@LINE+1]]:13: error: -1 is out of range for type 'uint'
    println(-one);
    // No error: -9223372036854775808 spells int64 min.
    const int64 min64 = -9223372036854775808;
    println(min64 < 0 ? 1 : 0);
    // No error: negating unsigned zero.
    const uint z = 0;
    println(-z);
    // Constant char arithmetic diagnoses like ints.
    // CHECK: [[@LINE+1]]:13: error: 9506 is out of range for type 'char'
    println('a' * 'b');
    // CHECK: [[@LINE+1]]:13: error: -1 is out of range for type 'char'
    println('a' - 'b');
    // CHECK: [[@LINE+1]]:13: error: -97 is out of range for type 'char'
    println(-'a');
    // No error: fitting char arithmetic.
    println('a' + 'b');
}

