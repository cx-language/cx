// RUN: %not %cx -typecheck %s -Werror 2>&1 | %FileCheck %s
// CHECK-NOT: index-from-end-constant-out-of-bounds.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
void main() {
    int[3] numbers = [10, 20, 30];
    // CHECK: [[@LINE+1]]:{{[0-9]+}}: error: accessing array out-of-bounds with index -1, array size is 3
    println(numbers[-4]);
}
// CHECK-NOT: index-from-end-constant-out-of-bounds.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
