// RUN: %cx -typecheck -Werror -Wno-unused %s

// An inferred const-slot applies at alias positions but must not leak into
// value generics instantiated from the same binding.
struct ProbeBox<T> {
    T v;
}

void f<T>(T* p, ProbeBox<T> b) {
}

void g(const int* p, ProbeBox<int> b) {
    f(p, b);
}
