// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s
// CHECK-NOT: index-assign-rvalue.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

float[2] getVec() { return [1.0, 2.0]; }
float[2]? getOptVec() { return [1.0, 2.0]; }

void main() {
    // CHECK: [[@LINE+1]]:13: error: cannot assign to element of rvalue of type 'float[2]'
    getVec()[0] = 5.0;
    // Unwrapping an rvalue optional is still an rvalue.
    // CHECK: [[@LINE+1]]:17: error: cannot assign to element of rvalue of type 'float[2]'
    getOptVec()![0] = 5.0;
    // But unwrapping an lvalue optional designates the payload, so this is fine.
    float[2]? opt = [1.0, 2.0];
    opt![0] = 5.0;
}

// CHECK-NOT: index-assign-rvalue.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
