// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

struct Mixed {
    c_int i;
    float f;
}

struct BigF {
    c_double a;
    c_double b;
    c_double c;
}

struct Nested {
    Mixed m;
    c_int x;
}

struct Exact16 {
    c_long a;
    c_long b;
}

struct HasList {
    float x;
    List<int> y;
}

struct HasLD {
    float80 x;
    c_int y;
}

struct NestedLD {
    HasLD inner;
}

enum FloatResult {
    Ok(float value),
    Err,
}

enum IntResult {
    Ok(c_int value),
    Err,
}

enum Color {
    Red,
    Green,
}

// Small float-containing aggregates cross in registers and are fine:
extern "C" void take_mixed(Mixed m);
extern "C" Mixed make_mixed();
extern "C" void take_nested(Nested n);
extern "C" void take_exact16(Exact16 e);
// Indirectly-passed float aggregates are fine:
extern "C" void take_bigf(BigF b);
extern "C" BigF make_bigf();
// Fixed-array parameters decay to pointers, so the element type is irrelevant:
extern "C" void take_farr4(float[4] a);
extern "C" void take_farr8(float[8] a);
extern "C" void take_ldarr(float80[2] a);
// C cannot return arrays, whatever the element type:
// CHECK: [[@LINE+1]]:12: error: type 'float[4]' cannot be returned by value in extern "C" signatures because C functions cannot return arrays; use an out-parameter instead
extern "C" float[4] make_farr4();
// CHECK: [[@LINE+1]]:12: error: type 'c_int[4]' cannot be returned by value in extern "C" signatures because C functions cannot return arrays; use an out-parameter instead
extern "C" c_int[4] make_iarr4();
// CHECK: [[@LINE+1]]:30: error: type 'HasList' cannot be passed by value in extern "C" signatures because it contains floating-point members and has a member with no C counterpart; pass it behind a pointer or reference instead
extern "C" void take_haslist(HasList h);
// Pointers, borrows, and scalars cross opaquely and are fine:
extern "C" void take_mixed_ptr(Mixed* m);
extern "C" void take_mixed_ref(Mixed& m);
extern "C" float take_float(float f);
extern "C" float80 take_ld(float80 x);
extern "C" void exp_mixed(Mixed m) {
}
// 80-bit floats cross in memory, so aggregates holding them are rejected:
// CHECK: [[@LINE+1]]:28: error: type 'HasLD' cannot be passed by value in extern "C" signatures because it contains 80-bit float members, which cross in memory; pass it behind a pointer or reference instead
extern "C" void take_hasld(HasLD h);
// CHECK: [[@LINE+1]]:12: error: type 'NestedLD' cannot be returned by value in extern "C" signatures because it contains 80-bit float members, which cross in memory; use an out-parameter instead
extern "C" NestedLD make_nestedld();
// Enums with float payloads have no C counterpart, so they are rejected;
// plain and integer-payload enums are fine:
extern "C" void take_color(Color c);
extern "C" void take_intresult(IntResult r);
// CHECK: [[@LINE+1]]:34: error: type 'FloatResult' cannot be passed by value in extern "C" signatures because it contains floating-point members and has a member with no C counterpart; pass it behind a pointer or reference instead
extern "C" void take_floatresult(FloatResult r);
// Referring to an extern "C" function as a value would call it indirectly,
// which cannot use the callee's C convention, so it is rejected:
extern "C" void exp_ok(BigF b) {
}
#if !Windows
extern "C++" c_int cpp_fn(c_int x);
#endif
void plain() {
}
void useAsValue() {
    // CHECK: [[@LINE+1]]:13: error: cannot refer to extern "C" function 'take_bigf' as a value; call it directly
    var g = take_bigf;
    // CHECK: [[@LINE+1]]:13: error: cannot refer to extern "C" function 'exp_ok' as a value; call it directly
    var h = exp_ok;
    var p = plain;
}
#if !Windows
void useCppAsValue() {
    var c = cpp_fn;
}
#endif
// Variadic extras obey the same rules, located at the argument:
extern "C" void vtake(c_int level, ...);
void callVarargs() {
    vtake(1, Mixed(1, 2.0));
    vtake(2, BigF(1.0, 2.0, 3.0));
    // CHECK: [[@LINE+1]]:14: error: type 'HasLD' cannot be passed by value in extern "C" signatures because it contains 80-bit float members, which cross in memory; pass it behind a pointer or reference instead
    vtake(3, HasLD(1.0, 2));
}
