// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

interface Greeter {
    void greet(string name);
}

// CHECK: [[@LINE+1]]:8: error: 'Person' doesn't have member function 'greet' (expected prototype 'void greet(string name)') required by interface 'Greeter'
struct Person: Greeter {
    void greet(int who) {
    }
}

void main() {
}
