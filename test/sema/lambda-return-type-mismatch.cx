// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void main() {
    var lambda = (int a, int b) {
        if (a > b) {
            return a + b
        } else {
            // CHECK: [[@LINE+1]]:13: error: mismatching return type 'bool', expected 'int32'
            return false
        }
    }
}
