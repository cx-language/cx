// RUN: %not %cx -typecheck %s | %FileCheck %s

// CHECK-NOT: generic-enum-infer-fail.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

void main() {
    // CHECK: [[@LINE+1]]:24: error: can't infer generic parameters, please specify them explicitly
    var x = Outcome.Err(code = 1);
}

// CHECK-NOT: generic-enum-infer-fail.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
