// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

T foo<T>(T a, T b) { return b; }

// CHECK: [[@LINE+3]]:23: error: too many generic arguments to 'foo', expected 1
// CHECK: [[@LINE+2]]:23: error: no matching function 'foo<int, int>(int, int)'
// CHECK: :3:3: note: candidate function:
void main() { var f = foo<int, int>(1, 2); }
