// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

void takesIntRef(Slice<int> values) {}

void main() {
    var ints = List<int>();
    takesIntRef(ints);
    var strings = List<string>();
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'List<string>' to 'takesIntRef', expected 'Slice<int>'
    takesIntRef(strings);
}

