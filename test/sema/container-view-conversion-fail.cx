// RUN: %not %cx -typecheck %s | %FileCheck %s
// CHECK-NOT: container-view-conversion-fail.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void takesIntRef(ArrayRef<int> values) {}

void main() {
    var ints = List<int>();
    takesIntRef(ints);
    var strings = List<string>();
    // CHECK: [[@LINE+1]]:17: error: invalid argument #1 type 'List<string>' to 'takesIntRef', expected 'ArrayRef<int>'
    takesIntRef(strings);
}

// CHECK-NOT: container-view-conversion-fail.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
