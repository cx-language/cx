// RUN: %not %cx -typecheck %s | %FileCheck %s

interface Greeter {
    void greet(public string name);
}

// CHECK: [[@LINE+1]]:8: error: 'Person' doesn't have member function 'greet' (expected prototype 'void greet(public string name)') required by interface 'Greeter'
struct Person: Greeter {
    void greet(public string who) {
    }
}

void main() {
}
