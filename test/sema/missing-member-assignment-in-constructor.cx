// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s

struct A {
    int i;
    int* j;

    // CHECK: [[@LINE+2]]:5: warning: constructor doesn't initialize member variable 'i'
    // CHECK: [[@LINE+1]]:5: warning: constructor doesn't initialize member variable 'j'
    A() {}
}

interface O {
    O(int p) {
        println(p);
    }

    void foo();
}

// Copies of interface constructors warn at the implementer, naming the
// inherited constructor, since the interface author cannot initialize
// implementer fields.
// CHECK: [[@LINE+5]]:5: warning: constructor doesn't initialize member variable 'k'
// CHECK: [[@LINE+1]]:8: warning: inherited constructor 'O(int)' doesn't initialize member variable 'k'
struct B : O {
    int k;

    B() {
        O.init(1);
    }

    void foo() {}
}

// Fields with default values stay silent for inherited copies too.
struct C : O {
    string m = "x";

    void foo() {}
}

// A bare `Type(...)` constructs a discarded temporary; only `init(...)`
// delegates. Skipped members of the outer object still warn.
struct D {
    int x = 42;
    int y;

    D(int a) {
        x = a;
        y = a;
    }

    // CHECK: [[@LINE+3]]:9: warning: unused result of type 'D'; use 'init(...)' to delegate to another constructor
    // CHECK: [[@LINE+1]]:5: warning: constructor doesn't initialize member variable 'y'
    D() {
        D(1);
    }
}

// Explicit discard stays silent.
struct E {
    int y;

    E(int a) {
        y = a;
    }

    E() {
        _ = E(1);
        y = 2;
    }
}

// Other-type temporaries get the plain message.
struct F {
    int y;

    F(int a) {
        y = a;
    }

    // CHECK: [[@LINE+3]]:9: warning: unused result of type 'E'
    // CHECK: [[@LINE+1]]:5: warning: constructor doesn't initialize member variable 'y'
    F() {
        E(1);
    }
}

// Delegation consumes its object and stays silent.
struct H {
    int y;

    H(int a) {
        y = a;
    }

    H() {
        init(1);
    }

    H(bool b) {
        this.init(1);
    }
}

// Outside a constructor `init(...)` builds a temporary like any call.
struct Q {
    int y;

    Q(int a) {
        y = a;
    }

    Q() {
        y = 0;
    }

    void reset() {
        // CHECK: [[@LINE+1]]:9: warning: unused result of type 'Q'
        init(5);
    }
}

struct Box<T> {
    T val;

    Box(T v) {
        val = v;
    }

    Box() {
        init(0);
    }
}

void _useBox() {
    _ = Box<int>();
}
