// RUN: %cx -typecheck %s 2>&1 | %FileCheck %s

void main() {
    var content = readFile("definitely-not-here-12345");
    if content == null {
        return;
    }
    // CHECK-NOT: overload-trial-warning.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
    // CHECK: [[@LINE+1]]:27: warning: unwrapping non-optional type 'StringBuffer' has no effect
    println(string(content!));
    // CHECK-NOT: overload-trial-warning.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
}
