// RUN: %cx run -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s
// RUN: %cx run --backend=c -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s

int[3] numbers = [1, 2, 3];
string greeting = "hello";
int? answer = 42;
int? nothing = null;
bool both = true && false;
bool either = false || true;
int t = 1 < 2 ? 3 : 4;
bool b = 2 > 3 ? true : false;
float f = 1.5 + 2.5;
float neg = -1.5;
bool less = 1 < 2;
int x = 1;
int* ptr = &x;

enum Color { red, green }
int inverted = ~Color.red;
int negated = -Color.red;
int diff = 0 - Color.green;
int sum = 1 + Color.green;

const one = 1;
const two = one + 1;
const three = one + 2;
int five = two + three;
int[2] pair = [one, one];

void main() {
    println(numbers[0]); // CHECK:1
    println(numbers[1]); // CHECK-NEXT:2
    println(numbers[2]); // CHECK-NEXT:3
    println(greeting); // CHECK-NEXT:hello
    println(answer!); // CHECK-NEXT:42
    println(nothing); // CHECK-NEXT:null
    println(both); // CHECK-NEXT:false
    println(either); // CHECK-NEXT:true
    println(t); // CHECK-NEXT:3
    println(b); // CHECK-NEXT:false
    println(f); // CHECK-NEXT:4
    println(neg); // CHECK-NEXT:-1.5
    println(less); // CHECK-NEXT:true
    println(*ptr); // CHECK-NEXT:1
    println(inverted); // CHECK-NEXT:-1
    println(negated); // CHECK-NEXT:0
    println(five); // CHECK-NEXT:5
    println(pair[0]); // CHECK-NEXT:1
    println(pair[1]); // CHECK-NEXT:1
    println(diff); // CHECK-NEXT:-1
    println(sum); // CHECK-NEXT:2
}
