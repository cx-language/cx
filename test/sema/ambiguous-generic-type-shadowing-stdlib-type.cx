// RUN: %not %cx -typecheck %s 2>&1 | %FileCheck %s

struct Local {
    int x;
}

struct Box<T> {
    T value;
}

void main() {
    // CHECK-NOT: ambiguous-generic-type-shadowing-stdlib-type.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
    // CHECK: [[@LINE+2]]:5: error: ambiguous reference to 'Box'
    // CHECK-NEXT: Box<Local>? x = null;
    Box<Local>? x = null;
}

