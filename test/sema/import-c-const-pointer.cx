// RUN: %cx -typecheck %s -Wno-unused

import "inputs/c-const-pointer.h";

// C const-qualification is dropped on import: const-qualified members and
// globals behave exactly like their mutable counterparts.
void constMemberImportsAsMutable(CS s) {
    c_int*? ok = s.p;
}

void writeThroughImportedMemberIsAllowed(CS s) {
    *(s.p!) = 1;
}

void constArrayGlobalImportsAsMutable() {
    c_int[*] ok = garr;
}
