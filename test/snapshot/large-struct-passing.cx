// RUN: check-snapshots

struct Big  {
    int a;
    int b;
    int c;
    int d;
    int e;
}

struct Outer {
    Big item;
    int tag;
}

struct Wide {
    int64 a;
    int64 b;
    int64 c;
    int64 d;
}

Big ident(Big x) {
    return x;
}

Outer makeOuter() {
    return Outer(Big(1, 2, 3, 4, 5), 7);
}

Wide identWide(Wide x) {
    return x;
}

int main() {
    var b = Big(1, 2, 3, 4, 5);
    var c = ident(b);
    var flag = true;
    var d = flag ? b : c;
    var w = Wide(int64(1), int64(2), int64(3), int64(4));
    var v = identWide(w);
    return d.a + makeOuter().item.a + makeOuter().tag + int(v.a);
}
