// RUN: check-snapshots

interface Interface {
    This* foo(This* a);
    This* bar();
}

struct S: Interface {
    S* that;

    S() { that = this; }

    S* foo(S* a) {
        return this;
    }

    S* bar() {
        return foo(foo(this));
    }
}

void main() {
    var a = S();
    var b = S();
    f(a.foo(b));
}

void f<T: Interface>(T* a) {
    a.foo(a.bar());
}
