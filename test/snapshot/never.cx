// RUN: %cx -typecheck %s -Wno-unused 2>&1 | %FileCheck %s
// RUN: check-snapshots -w

// CHECK-NOT: warning
never f() { f() }

// CHECK-NOT: warning
never g() { abortWrapper() }

// CHECK: [[@LINE+1]]:7: warning: 'h' is declared to never return but it does return
never h() {}

// CHECK-NOT: warning
void i() { f() }

// CHECK-NOT: warning
int i(int x) {
    switch (x) {
        case 0: return 1;
        default: f()
    }
}
