// RUN: check-snapshots -Wno-unused
// RUN: %cx -typecheck -Wno-unused %s | %FileCheck %s

void main() {
    int? a = null;
    int? b = Optional(2);
    int? c = 3;
    int? d = Optional();

    if (d == null) {}
    if (d != null) {}
    if (d) {}
    if (!d) {}
}

void f() {
    Optional<int> a = null;
    Optional<int> b = Optional(2);
    Optional<int> c = 3;
    Optional<int> d = Optional();

    c = null;
    if (c) {
        // TODO: Fix these to not require explicit unwrapping. How should overload resolution work with implicitly unwrapped optional arguments?
        var x = c! + 1;
        _ = 1 + c!;
        c = -(c!);
    }
    // if (c) c++; // TODO: Allow postfix incrementing/decrementing an implicitly unwrapped optional.

    // CHECK: [[@LINE+1]]:18: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    takesNonNull(c);
    if (c) {
        // CHECK-NOT: [[@LINE+1]]:22: warning:
        takesNonNull(c);
    }
}

void g() {
    char*[*]? p = null;
    if (p == null) {}
}

void takesNonNull(int i) {}
