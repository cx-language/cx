// RUN: check-snapshots -Wno-unused
// RUN: %cx -typecheck -Wno-unused %s 2>&1 | %FileCheck %s

void main() {
    int? a = null;
    int? b = Optional.Some(value = 2);
    int? c = 3;
    int? d = Optional.None;

    if (d == null) {}
    if (d != null) {}
    if (null == d) {}
    if (null != d) {}
    if (d) {}
    if (!d) {}
}

void f() {
    Optional<int> a = null;
    Optional<int> b = Optional.Some(value = 2);
    Optional<int> c = 3;
    Optional<int> d = Optional.None;

    c = null;
    if (c) {
        var x = c + 1;
        _ = 1 + c;
        c = -c;
    }
    if (c) c++;

    // CHECK: [[@LINE+1]]:18: warning: value may be null; unwrap it with a postfix '!' to silence this warning
    takesNonNull(c);
    if (c) {
        // CHECK-NOT: [[@LINE+1]]:22: warning:
        takesNonNull(c);
    }
}

void g() {
    char*[*]? p = null;
    if (p == null) {}
}

void takesNonNull(int i) {}
