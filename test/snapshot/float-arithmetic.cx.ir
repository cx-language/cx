
int32 main() {
    float32* a = alloca float32
    float32* b = alloca float32
    store float32 1 to a
    float32 a.load = load a
    float32 _0 = -a.load
    float32 _1 = float32 2 * _0
    store _1 to b
    float32 b.load = load b
    float32 _2 = b.load + float32 1
    store _2 to b
    float32 b.load_0 = load b
    float32 _3 = b.load_0 + float32 -1
    store _3 to b
    return int32 0
}
