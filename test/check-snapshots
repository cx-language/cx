#!/usr/bin/env python3

import os
import re
import shlex
import subprocess
import sys
from types import SimpleNamespace

# Policy: snapshot the owned cx IR broadly, but keep
# LLVM snapshots to a few golden tests that opt in with explicit print flags.
# Both dumps move together on most compiler changes, so per-test .ll files
# double review volume without adding signal.
all_checks = [
    SimpleNamespace(name="AST", flag="-print-ast", extension=".ast", is_default=False),
    SimpleNamespace(name="IR", flag="-print-ir", extension=".ir", is_default=True),
    SimpleNamespace(name="LLVM", flag="-print-llvm", extension=".ll", is_default=False),
]

cx, test_file, *cx_flags = sys.argv[1:]

checks_to_run = ([c for c in all_checks if c.flag in cx_flags]
                 or [c for c in all_checks if c.is_default])

print_flags = [c.flag for c in checks_to_run]
command = sys.argv[1:] + print_flags

try:
    raw_output = subprocess.check_output(command, text=True, stderr=subprocess.PIPE)
except subprocess.CalledProcessError as error:
    print("Command:", " ".join(command), file=sys.stderr)
    print(error.output, file=sys.stderr)
    print(error.stderr, file=sys.stderr)
    sys.exit(error.returncode)

sections = {}
if len(checks_to_run) == 1:
    sections[checks_to_run[0].name] = raw_output
else:
    matches = re.finditer(r"=== BEGIN (\w+) ===\n(.*?\n?)=== END \1 ===", raw_output, re.DOTALL)
    for match in matches:
        section_name = match.group(1)
        content = match.group(2)
        sections[section_name] = content

# The host target varies by machine; strip it so snapshots stay portable.
if "LLVM" in sections:
    sections["LLVM"] = re.sub(r"^target (datalayout|triple) = \".*\"\n", "", sections["LLVM"], flags=re.MULTILINE)
    # Debug file directories hold absolute source paths; strip them too.
    sections["LLVM"] = re.sub(r'!DIFile\(filename: ("[^"]*"), directory: "[^"]*"\)', r"!DIFile(filename: \1)", sections["LLVM"])
    # The debug info format varies by platform (CodeView on Windows, DWARF
    # elsewhere); canonicalize it so snapshots stay portable.
    sections["LLVM"] = re.sub(r'!\{i32 2, !"(?:CodeView|Dwarf Version)", i32 \d+\}', r'!{i32 2, !"DEBUG-FORMAT", i32 0}', sections["LLVM"])

for check in checks_to_run:
    snapshot_path = test_file + check.extension
    output = sections[check.name]

    if "UPDATE_SNAPSHOTS" in os.environ:
        with open(snapshot_path, "w") as snapshot_file:
            snapshot_file.write(output)
        continue

    try:
        with open(snapshot_path, "r") as snapshot_file:
            snapshot = snapshot_file.read().replace("\r\n", "\n")
    except IOError:
        print("Command:", " ".join(command), file=sys.stderr)
        print("FAIL: snapshot file not found\n", file=sys.stderr)
        print("Output:", file=sys.stderr)
        print(output, file=sys.stderr)
        print("To update: UPDATE_SNAPSHOTS=1 python3 " + shlex.join(sys.argv), file=sys.stderr)
        sys.exit(1)

    if output != snapshot:
        import difflib

        diff = difflib.unified_diff(snapshot.splitlines(1), output.splitlines(1))
        print("Command:", " ".join(command), file=sys.stderr)
        print("FAIL: output doesn't match snapshot\n", file=sys.stderr)
        print("- Snapshot", file=sys.stderr)
        print("+ Received\n", file=sys.stderr)
        print("".join(diff), file=sys.stderr)
        print("To update: UPDATE_SNAPSHOTS=1 python3 " + shlex.join(sys.argv), file=sys.stderr)
        sys.exit(1)
