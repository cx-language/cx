// Runtime checks for switch-enum-safety-check.cx, split out so no single
// test makes 8 compiler runs (see the timeout note in test/lit.cfg).
// RUN: check_exit_status 0 %cx run %S/switch-enum-safety-check.cx
// RUN: check_exit_status 0 %cx run --release-safe %S/switch-enum-safety-check.cx
// RUN: check_exit_status 0 %cx run --release %S/switch-enum-safety-check.cx
