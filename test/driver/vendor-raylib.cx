// REQUIRES: raylib
// UNSUPPORTED: windows
// RUN: %cx -typecheck --check-all %s -Wno-unused 2>&1 | %FileCheck %s --allow-empty --check-prefix=STATIC
// STATIC-NOT: warning:
// STATIC-NOT: error:
// RUN: %cx run -Wno-unused %s | %FileCheck %s

import raylib;

// Exercises the vendored module against the installed raylib: const values,
// struct layout, and linked calls. The typecheck run above validates every
// declaration; this run validates the values. Everything here runs without
// a window or GL context.

// Typechecked but never run: needs a GL context.
void probe() {
    InitWindow(64, 64, "probe");
    BeginDrawing();
    ClearBackground(Color(r = 0, g = 0, b = 0, a = 255));
    EndDrawing();
    CloseWindow();
}

int main() {
    println(FLAG_FULLSCREEN_MODE); // CHECK: 2
    println(KEY_A); // CHECK-NEXT: 65
    println(MOUSE_BUTTON_LEFT); // CHECK-NEXT: 0
    println(PIXELFORMAT_UNCOMPRESSED_R8G8B8A8); // CHECK-NEXT: 7
    println(GESTURE_TAP); // CHECK-NEXT: 1
    println(CAMERA_PERSPECTIVE); // CHECK-NEXT: 0
    println(RL_QUADS); // CHECK-NEXT: 7
    println(RL_TEXTURE_WRAP_REPEAT); // CHECK-NEXT: 10497
    println(RAYLIB_VERSION_MAJOR >= 6); // CHECK-NEXT: true
    println(PI); // CHECK-NEXT: 3.1415927
    println(sizeof(Vector2), " ", sizeof(Color), " ", sizeof(Matrix)); // CHECK-NEXT: 8 4 64
    println(TextFormat("%d + %d = %d", 1, 2, 3)!); // CHECK-NEXT: 1 + 2 = 3

    var red = Color(r = 255, g = 0, b = 0, a = 255);
    var packed = ColorToInt(red);
    println(packed); // CHECK-NEXT: -16776961
    var back = GetColor(c_uint(packed));
    println(back.r, " ", back.g, " ", back.b, " ", back.a); // CHECK-NEXT: 255 0 0 255

    println(GetDirectoryPath("/a/b/c.txt")!); // CHECK-NEXT: /a/b
    println(GetFileExtension("x.png")!); // CHECK-NEXT: .png
    println(GetFileName("/a/b/c.txt")!); // CHECK-NEXT: c.txt

    // rcamera.h: pure struct math, no GL needed.
    var cam = Camera3D(position = Vector3(x = 0, y = 0, z = 5), target = Vector3(x = 0, y = 0, z = 0), up = Vector3(x = 0, y = 1, z = 0), fovy = 60, projection = CAMERA_PERSPECTIVE);
    var fwd = GetCameraForward(&cam);
    println(fwd.x, " ", fwd.y, " ", fwd.z); // CHECK-NEXT: 0 0 -1
    var proj = GetCameraProjectionMatrix(&cam, 2.0);
    println(proj.m0, " ", proj.m5, " ", proj.m10, " ", proj.m14); // CHECK-NEXT: 0.8660254 1.7320508 -1.000025 -0.10000125

    // rlgl.h: the one query valid without a GL context (the build's GL
    // flavor, so only a lower bound is asserted).
    println(rlGetVersion() >= RL_OPENGL_11); // CHECK-NEXT: true
    return 0;
}
