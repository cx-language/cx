// RUN: %cx %s -o %T/stack-trace 2>&1 | %FileCheck --allow-empty --check-prefix=BUILD %s
// RUN: %not %T/stack-trace 2>&1 | %FileCheck %s
// UNSUPPORTED: windows
// Runs the built binary instead of `cx run`: JITed code has no symbol table for backtrace_symbols.
// CHECK-NOT: stack-trace.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
// BUILD-NOT: {{(warning|error)}}:

void inner() {
    abort("boom");
}

void middle() {
    inner();
}

void main() {
    middle();
}

// CHECK: boom
// CHECK: printStackTrace
// CHECK: abortWrapper
// CHECK: _EN4main5innerE
// CHECK: _EN4main6middleE
// CHECK: main
// CHECK-NOT: stack-trace.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
