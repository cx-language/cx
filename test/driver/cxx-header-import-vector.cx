// RUN: %cx --print-llvm %s | %FileCheck %s
// UNSUPPORTED: windows

import "cxx-vector-import.hpp";

void main() {
    var xs = List<int>();
    xs.push(10);
    println(if_sum(xs));
    Item a;
    a.weight = 5;
    Item*?[1] arr = [&a];
    Item*?[] s = arr;
    println(if_compound(s));
    FPoint p;
    p.x = 3;
    p.y = 4;
    println(if_pdot(p));
    Sixteen st;
    st.v[0] = 1;
    st.v[1] = 2;
    st.v[2] = 3;
    st.v[3] = 4;
    println(if_sixteen(st));
    println(if_cdouble(21));
}

// A const vector reference imports as const CxxVector&, and the call above
// converts the List implicitly.
// CHECK: declare i32 @"\01{{_?}}_Z6if_sumRKSt6vectorIiSaIiEE"(ptr)
// Compound vector elements (here Item*) import with Clang's exact mangling,
// including substitution compression.
// CHECK: declare i32 @"\01{{_?}}_Z11if_compoundRKSt6vectorIP4ItemSaIS1_EE"(ptr)
// Trivially copyable structs still import by value.
// CHECK: declare i32 @"\01{{_?}}_Z7if_pdot6FPoint"([1 x i64])
// A 16-byte struct crosses in two integer chunks.
// CHECK: declare i32 @"\01{{_?}}_Z10if_sixteen7Sixteen"([2 x i64])
// extern "C" functions in C++ headers keep their plain names.
// CHECK: declare i32 @if_cdouble(i32)

// By-value vectors (C++ passes them indirectly), vector<bool> (bit-packed),
// custom allocators, structs with destructors, and struct returns are skipped.
// CHECK-NOT: if_first
// CHECK-NOT: if_boolsum
// CHECK-NOT: if_custom
// CHECK-NOT: if_dtorval
// CHECK-NOT: if_mkpoint
// Large, float-containing, and bitfield structs cannot cross by value, and
// neither can callbacks taking them.
// CHECK-NOT: if_big
// CHECK-NOT: if_fpair
// CHECK-NOT: if_flags
// CHECK-NOT: if_bigcb
// A returned function pointer is only callable through cx, so its signature
// must cross too.
// CHECK-NOT: if_getcb
