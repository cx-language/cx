// RUN: %cx --print-llvm %s | %FileCheck %s
// UNSUPPORTED: linux, windows

extern "C++" c_int m_vecsum(const CxxVector<c_int>& v);
extern "C++" void m_vecptr(CxxVector<c_double>*? v);

void main() {
    var xs = List<c_int>();
    m_vecsum(xs);
    m_vecptr(null);
}

