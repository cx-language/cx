// RUN: check_exit_status 0 %cx run -Werror %s -- hello
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s -- hello

int main(string[] args) {
    var s = StringBuf("hi");
    s = StringBuf("hello");
    assert(string(s) == "hello");
    if args.size() > 0 {
        return 0;
    }
    return 1;
}
