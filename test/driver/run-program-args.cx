// RUN: %cx run %s -- hello | %FileCheck -match-full-lines %s
// RUN: %cx run %s -- hello "two words" | %FileCheck -match-full-lines --check-prefix=QUOTED %s
// RUN: %not %cx %s -- hello 2>&1 | %FileCheck --check-prefix=ERROR %s

int main(string[] args) {
    // CHECK: 2
    // QUOTED: 3
    println(args.size());
    // CHECK-NEXT: hello
    // QUOTED-NEXT: hello
    println(args[1]);
    // QUOTED-NEXT: two words
    if args.size() > 2 {
        println(args[2]);
    }
    return 0;
}

// ERROR: error: program arguments require the 'run' subcommand
