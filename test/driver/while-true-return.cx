// RUN: %cx run %s | %FileCheck -match-full-lines %s

int f(int n) {
    while true {
        if n > 0 {
            return n;
        }
        return 0;
    }
}

void main() {
    // CHECK-NOT: while-true-return.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
    // CHECK: 5
    println(f(5));
    // CHECK-NEXT: 0
    println(f(-3));
    // CHECK-NOT: while-true-return.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
}
