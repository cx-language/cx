// REQUIRES: x86_64
// UNSUPPORTED: windows
// RUN: %cx --print-llvm %s | %FileCheck %s

struct V2 {
    float x;
    float y;
}
struct V3 {
    float x;
    float y;
    float z;
}
struct V4 {
    float x;
    float y;
    float z;
    float w;
}
struct D1 {
    double d;
}
struct D2 {
    double x;
    double y;
}
struct FD {
    float f;
    double d;
}
struct DF {
    double d;
    float f;
}
struct IF {
    c_int i;
    float f;
}
struct CD {
    char c;
    double d;
}
struct DC {
    double d;
    char c;
}
struct ID {
    c_int i;
    double d;
}
struct DI {
    double d;
    c_int i;
}
struct IIF {
    c_int a;
    c_int b;
    float f;
}
struct FA3 {
    float[3] a;
}
struct NV2 {
    V2 a;
    V2 b;
}
struct D4 {
    double[4] d;
}
struct F1 {
    float f;
}

extern V2 mk_v2();
extern V3 mk_v3();
extern V4 mk_v4();
extern D1 mk_d1();
extern D2 mk_d2();
extern FD mk_fd();
extern DF mk_df();
extern IF mk_if();
extern CD mk_cd();
extern DC mk_dc();
extern ID mk_id();
extern DI mk_di();
extern IIF mk_iif();
extern FA3 mk_fa3();
extern NV2 mk_nv2();
extern D4 mk_d4();
extern F1 mk_f1();

// Each eightbyte becomes the scalar its SysV class dictates: INTEGER pieces
// take the smallest integer covering the used bytes, SSE pieces are float up
// to 4 bytes, else double.
// CHECK: declare double @mk_v2()
// CHECK: declare { double, float } @mk_v3()
// CHECK: declare { double, double } @mk_v4()
// CHECK: declare double @mk_d1()
// CHECK: declare { double, double } @mk_d2()
// CHECK: declare { float, double } @mk_fd()
// CHECK: declare { double, float } @mk_df()
// CHECK: declare i64 @mk_if()
// CHECK: declare { i8, double } @mk_cd()
// CHECK: declare { double, i8 } @mk_dc()
// CHECK: declare { i32, double } @mk_id()
// CHECK: declare { double, i32 } @mk_di()
// CHECK: declare { i64, float } @mk_iif()
// CHECK: declare { double, float } @mk_fa3()
// CHECK: declare { double, double } @mk_nv2()
// Larger aggregates still go indirect:
// CHECK: declare void @mk_d4(ptr sret(%D4) align 8)
// CHECK: declare float @mk_f1()

void main() {
    println(mk_v2().x);
    println(mk_v3().z);
    println(mk_v4().w);
    println(mk_d1().d);
    println(mk_d2().y);
    println(mk_fd().d);
    println(mk_df().f);
    println(mk_if().i);
    println(mk_cd().d);
    println(mk_dc().d);
    println(mk_id().d);
    println(mk_di().d);
    println(mk_iif().f);
    println(mk_fa3().a[0]);
    println(mk_nv2().a.x);
    println(mk_d4().d[0]);
    println(mk_f1().f);
}
