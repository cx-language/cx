// RUN: %cx --print-llvm %s | %FileCheck %s
// UNSUPPORTED: darwin, freebsd, openbsd, windows

extern "C++" c_int m_vecsum(const CxxVector<c_int>& v);
extern "C++" void m_vecptr(CxxVector<c_double>*? v);

void main() {
    var xs = List<c_int>();
    m_vecsum(xs);
    m_vecptr(null);
}

// CHECK: declare i32 @"\01{{_?}}_Z8m_vecsumRKSt6vectorIiSaIiEE"(ptr)
// CHECK: declare void @"\01{{_?}}_Z8m_vecptrPSt6vectorIdSaIdEE"(ptr)
