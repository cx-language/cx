// RUN: %cx -print-llvm %s | %FileCheck %s

struct Big : Copyable {
    int a;
    int b;
    int c;
    int d;
    int e;
}

Big ident(Big x) {
    return x;
}

void main() {
    var b = Big(1, 2, 3, 4, 5);
    _ = ident(b);
}

// Large structs pass by value with byval and return with sret, at both the
// definition and the call site. (Name mangling is covered elsewhere.)
// CHECK: %Big = type { i32, i32, i32, i32, i32 }
// CHECK-LABEL: define void @{{.*}}ident{{.*}}(ptr sret(%Big) align 4 %sret.arg, ptr byval(%Big) align 4 %x)
// CHECK: call void @{{.*}}ident{{.*}}(ptr sret(%Big) align 4 {{.*}}, ptr byval(%Big) align 4 {{.*}})
