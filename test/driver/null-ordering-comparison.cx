// RUN: %not %cx -typecheck %s -Wno-unused --error-limit=0 2>&1 | %FileCheck %s

void main() {
    int*? p = null;
    const int*? c = null;
    // CHECK: [[@LINE+1]]:13: error: invalid operands 'int*?' and 'int*?' to '<' (ordering comparisons against null are not allowed; use '==' or '!=' to check for null)
    println(p < null);
    // CHECK: [[@LINE+1]]:13: error: invalid operands 'int*?' and 'int*?' to '>' (ordering comparisons against null are not allowed; use '==' or '!=' to check for null)
    println(p > null);
    // CHECK: [[@LINE+1]]:13: error: invalid operands 'int*?' and 'int*?' to '<' (ordering comparisons against null are not allowed; use '==' or '!=' to check for null)
    println(c < null);
    // CHECK: [[@LINE+1]]:13: error: invalid operands 'int*?' and 'int*?' to '>' (ordering comparisons against null are not allowed; use '==' or '!=' to check for null)
    println(c > null);
    // CHECK: [[@LINE+1]]:13: error: invalid operands 'null' and 'int*?' to '<' (ordering comparisons against null are not allowed; use '==' or '!=' to check for null)
    println(null < p);
    println(p == null);
    println(c != null);
}
