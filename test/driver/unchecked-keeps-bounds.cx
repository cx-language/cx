// RUN: %not %cx run -Werror %s 2>&1 | %FileCheck -match-full-lines %s
// RUN: %not %cx run -Werror --backend=c %s 2>&1 | %FileCheck -match-full-lines %s

int getIndex() {
    return 5;
}

void main() {
    int[3] a = [10, 20, 30];
    @noOverflowCheck
    // CHECK: index out of bounds at unchecked-keeps-bounds.cx:[[@LINE+1]]:15
    println(a[getIndex()]);
}
