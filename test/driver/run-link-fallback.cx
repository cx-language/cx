// RUN: %not %cx run %s -lm 2>&1 | %FileCheck %s
// RUN: %not %cx run %s --no-jit 2>&1 | %FileCheck %s
// UNSUPPORTED: windows
// -lm and --no-jit force the link-and-exec fallback, so backtrace_symbols names functions.

void inner() {
    abort("boom");
}

void main() {
    inner();
}

// CHECK: boom
// CHECK: printStackTrace
// CHECK: abortWrapper
// CHECK: _CX1N4main5innerE4void0_
// CHECK: main
