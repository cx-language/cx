// RUN: %not %cx run %s -lm 2>&1 | %FileCheck %s
// UNSUPPORTED: windows
// -lm forces the link-and-exec fallback, so backtrace_symbols names functions.
// CHECK-NOT: run-link-fallback.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void inner() {
    abort("boom");
}

void main() {
    inner();
}

// CHECK: boom
// CHECK: printStackTrace
// CHECK: abortWrapper
// CHECK: _EN4main5innerE
// CHECK: main
// CHECK-NOT: run-link-fallback.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
