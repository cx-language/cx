// RUN: %cx --print-llvm %s | %FileCheck %s
// UNSUPPORTED: windows

extern "C++" c_int m_add(c_int a, c_int b);
extern "C++" void m_void();
extern "C++" void m_variadic(c_int x, ...);
extern "C++" void m_onlyvarargs(...);

struct Point {
    c_int x;
    c_int y;
}

struct Wide {
    c_int[4] v;
}

void wideCallback(Point p) {
}

extern "C++" c_int m_byval(Point p);
extern "C++" c_int m_wide(Wide w);
extern "C++" void m_cbwide(void(Point) callback);
extern "C++" c_int m_byref(const Point& p);
extern "C++" void m_ptr(c_int* p);
extern "C++" void m_nullable(c_int*? p);
extern "C++" void m_cptr(const c_int* p);
extern "C++" void m_cb(void(c_int) callback);
extern "C++" void m_scalars(bool b, char c, int8 s8, uint8 u8, int16 s16, uint16 u16, int32 s32, uint32 u32, c_long l, c_ulong ul, c_longlong ll,
                            c_ulonglong ull, float32 f32, float64 f64);
extern "C" void m_c_linkage(c_int x);

extern "C++" c_int m_export(c_int a) {
    return a * 2;
}

void myCallback(c_int x) {
}

void main() {
    Point p;
    p.x = 1;
    p.y = 2;
    c_int v = 5;
    m_add(1, 2);
    m_void();
    m_variadic(1, 2, 3);
    m_variadic(2, p);
    m_onlyvarargs();
    m_byval(p);
    Wide w;
    w.v[0] = 1;
    w.v[1] = 2;
    w.v[2] = 3;
    w.v[3] = 4;
    m_wide(w);
    m_cbwide(wideCallback);
    m_byref(p);
    m_ptr(&v);
    m_nullable(&v);
    m_cptr(&v);
    m_cb(myCallback);
    m_scalars(true, 'a', 1, 2, 3, 4, 5, 6, 0, 0, 0, 0, 1.0, 2.0);
    m_c_linkage(1);
    m_export(21);
}

// CHECK: declare i32 @"\01{{_?}}_Z5m_addii"(i32, i32)
// CHECK: declare void @"\01{{_?}}_Z6m_voidv"()
// CHECK: declare void @"\01{{_?}}_Z10m_variadiciz"(i32, ...)
// CHECK: declare void @"\01{{_?}}_Z13m_onlyvarargsz"(...)
// CHECK: declare i32 @"\01{{_?}}_Z7m_byval5Point"([1 x i64])
// CHECK: declare i32 @"\01{{_?}}_Z6m_wide4Wide"([2 x i64])
// CHECK: declare void @"\01{{_?}}_Z8m_cbwidePFv5PointE"(ptr)
// CHECK: declare i32 @"\01{{_?}}_Z7m_byrefRK5Point"(ptr)
// CHECK: declare void @"\01{{_?}}_Z5m_ptrPi"(ptr)
// CHECK: declare void @"\01{{_?}}_Z10m_nullablePi"(ptr)
// CHECK: declare void @"\01{{_?}}_Z6m_cptrPKi"(ptr)
// CHECK: declare void @"\01{{_?}}_Z4m_cbPFviE"(ptr)
// CHECK: declare void @"\01{{_?}}_Z9m_scalarsbcahstijlmxyfd"(i1, i8, i8, i8, i16, i16, i32, i32, i64, i64, i64, i64, float, double)
// CHECK: declare void @m_c_linkage(i32)
// CHECK: define i32 @"\01{{_?}}_Z8m_exporti"(i32 %a)
// Struct extras in variadic calls coerce like named parameters.
// CHECK: call void (i32, ...) @"\01{{_?}}_Z10m_variadiciz"(i32 2, [1 x i64] %{{.*}})
