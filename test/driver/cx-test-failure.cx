// RUN: %not %cx test %s 2>&1 | %FileCheck %s

@test
void testPass() {
    assert(1 == 1);
}

@test
void testFail() {
    assert(1 == 2);
}

// "ok" goes to buffered stdout while the failure goes to unbuffered stderr,
// so their merged order varies by platform; accept either.
// CHECK-DAG:Assertion failed
// CHECK-DAG:ok testPass
