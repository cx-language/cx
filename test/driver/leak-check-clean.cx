// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s

void main() {
    var p = allocateValue(42);
    assert(*p == 42);
    deallocate(p);

    var list = List([1, 2, 3]);
    assert(list[0] == 1);

    var box = Box(42);
    assert(*box.get() == 42);

    // Box destroys its payload: a heap string must not leak.
    var sbox = Box(StringBuf("heap-string-long-enough-to-allocate"));
    assert(string(*sbox.get()) == "heap-string-long-enough-to-allocate");

    var arena = Arena(chunkSize = 32);
    var v = arena.allocateValue(7);
    assert(*v! == 7);

    var t = (s = StringBuf("a"), n = 1);
    t = (s = StringBuf("bb"), n = 2);
    assert(string(t.s) == "bb");
    assert(t.n == 2);
}
