// RUN: %cx %s -o %T/absolute-output
// RUN: file-exists %T/absolute-output
// RUN: cd %T && %cx %s -o relative-output
// RUN: file-exists %T/relative-output
// RUN: %not %cx %s -o %T/nonexistent/output 2>&1 | %FileCheck %s

void main() {
    println("hi");
}

