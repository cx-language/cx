// Leak check disabled: Map<StringBuf, ...> keys are never destroyed (List element deinit is a no-op for types without an explicit destructor).
// RUN: check_exit_status 0 %cx test -Werror --no-leak-check %s

@test
void testInsert() {
    var map = Map<string, int>();

    map.insert("ok", 1);

    assert(map.contains("ok"));
    assert(!map.contains("lol"));
}

@test
void testRemoval() {
    var map = Map<string, int>();
    assert(map.size() == 0);

    map.insert("ok", 2);

    assert(map.contains("ok"));
    assert(map.size() == 1);

    map.remove("ok");
    assert(!map.contains("ok"));
    assert(map.size() == 0);
}

@test
void testDuplicates() {
    var map = Map<string, int>();

    map.insert("ok", 1);
    map.set("ok", 2);
    assert(map.contains("ok"));

    assert(map["ok"]! == 2);

    map.remove("ok");
    assert(!map.contains("ok"));
    assert(map["ok"] == null);
}

@test
void testGetter() {
    var map = Map<string, int>();

    map.insert("ok", 42);
    assert(map["ok"]! == 42);
}

@test
void testResize() {
    var map = Map<StringBuf, int>();

    for i in 0..255 {
        var lol = StringBuf();

        for _ in 0..(i+1) {
            lol.push('a');
        }

        map.insert(lol, i);
    }

    assert(map.size() == 255);
}

@test
void testSize() {
    var map = Map<string, string>();

    assert(map.size() == 0);
    map.insert("best", "ok");
    assert(map.size() == 1);
}

@test
void testIterator() {
    var map = Map<string, string>();

    map.insert("a", "a");
    map.insert("ccc", "ccc");
    map.insert("bb", "bb");

    var a = false;
    var bb = false;
    var ccc = false;

    for e in map {
        if (e.key == "a") {
            assert(!a);
            a = true;
        } else if (e.key == "bb") {
            assert(!bb);
            bb = true;
        } else if (e.key == "ccc") {
            assert(!ccc);
            ccc = true;
        } else {
            assert(false);
        }
    }

    assert(a);
    assert(bb);
    assert(ccc);
}

@test
void testEmptyMapIterator() {
    var map = Map<string, string>();
    map.insert("foo", "foo");
    map.remove("foo");

    for _ in map {
        assert(false);
    }
}

@test
void testUnitMapIterator() {
    var map = Map<string, string>();
    map.insert("foo", "foo");
    var count = 0;

    for e in map {
        count++;
        assert(e.key == "foo");
    }

    assert(count == 1);
}

@test
void testRemoveReturnValue() {
    var map = Map<string, int>();
    map.insert("ok", 2);

    assert(map.remove("ok")! == 2);
    assert(map.size() == 0);
    assert(map.remove("ok") == null);
    assert(map.size() == 0);
}

@test
void testClear() {
    var map = Map<string, int>();
    map.insert("a", 1);
    map.insert("b", 2);
    var capacity = map.capacity();

    map.clear();
    assert(map.size() == 0);
    assert(map.empty());
    assert(map.capacity() == capacity);
    assert(!map.contains("a"));

    map.insert("c", 3);
    assert(map["c"]! == 3);
}

@test
void testReserve() {
    var map = Map<string, int>();
    map.reserve(1000);
    assert(map.capacity() >= 1000);

    map.insert("a", 1);
    assert(map["a"]! == 1);
    assert(map.capacity() >= 1000);
}

@test
void testAllAnyNone() {
    var map = Map<string, int>();
    map.insert("a", 2);
    map.insert("b", 4);

    assert(map.all(e => e.value % 2 == 0));
    assert(!map.all(e => e.value > 2));
    assert(map.any(e => e.key == "b"));
    assert(!map.any(e => e.key == "z"));
    assert(map.none(e => e.value % 2 == 1));
    assert(!map.none(e => e.value == 4));

    assert(map.all((MapEntry<string, int>& e) => e.value > 0));
    assert(map.any((MapEntry<string, int>& e) => e.key == "a"));
    assert(map.none((MapEntry<string, int>& e) => e.value < 0));
}
