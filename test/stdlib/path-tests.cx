// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testSeparators() {
    assert(Path.isSeparator('/'), "Path.isSeparator slash");
    assert(Path.isSeparator('\\'), "Path.isSeparator backslash");
    assert(!Path.isSeparator('a'), "Path.isSeparator letter");
}

@test
void testSplitDrive() {
    var d = Path.splitDrive("/a/b");
    assert(d.drive == "" && d.rest == "/a/b", "Path.splitDrive posix");
    d = Path.splitDrive("a");
    assert(d.drive == "" && d.rest == "a", "Path.splitDrive plain");
    d = Path.splitDrive("");
    assert(d.drive == "" && d.rest == "", "Path.splitDrive empty");
    d = Path.splitDrive("C:/a");
    assert(d.drive == "C:" && d.rest == "/a", "Path.splitDrive drive abs");
    d = Path.splitDrive("C:a");
    assert(d.drive == "C:" && d.rest == "a", "Path.splitDrive drive rel");
    d = Path.splitDrive("C:");
    assert(d.drive == "C:" && d.rest == "", "Path.splitDrive drive only");
    d = Path.splitDrive("\\\\server\\share\\x");
    assert(d.drive == "\\\\server\\share" && d.rest == "\\x", "Path.splitDrive unc backslash");
    d = Path.splitDrive("//server/share/x");
    assert(d.drive == "//server/share" && d.rest == "/x", "Path.splitDrive unc slash");
    d = Path.splitDrive("//");
    assert(d.drive == "" && d.rest == "//", "Path.splitDrive lone slashes");
    d = Path.splitDrive("//server");
    assert(d.drive == "" && d.rest == "//server", "Path.splitDrive no share");
}

@test
void testIsAbsolute() {
    assert(Path.isAbsolute("/"), "Path.isAbsolute root");
    assert(Path.isAbsolute("/a"), "Path.isAbsolute posix");
    assert(!Path.isAbsolute("a"), "Path.isAbsolute relative");
    assert(!Path.isAbsolute(""), "Path.isAbsolute empty");
    assert(Path.isAbsolute("C:/a"), "Path.isAbsolute drive abs");
    assert(Path.isAbsolute("C:\\a"), "Path.isAbsolute drive backslash");
    assert(!Path.isAbsolute("C:a"), "Path.isAbsolute drive rel");
    assert(Path.isAbsolute("\\\\server\\share"), "Path.isAbsolute unc");
    assert(Path.isAbsolute("\\a"), "Path.isAbsolute lone backslash");
    assert(Path.isRelative("a/b"), "Path.isRelative posix");
    assert(!Path.isRelative("/"), "Path.isRelative root");
}

@test
void testSplit() {
    var s = Path.split("a/b");
    assert(s.dir == "a" && s.base == "b", "Path.split basic");
    s = Path.split("a/");
    assert(s.dir == "a" && s.base == "", "Path.split trailing slash");
    s = Path.split("a");
    assert(s.dir == "" && s.base == "a", "Path.split no dir");
    s = Path.split("/a");
    assert(s.dir == "/" && s.base == "a", "Path.split root file");
    s = Path.split("/");
    assert(s.dir == "/" && s.base == "", "Path.split root");
    s = Path.split("");
    assert(s.dir == "" && s.base == "", "Path.split empty");
    s = Path.split("a\\b");
    assert(s.dir == "a" && s.base == "b", "Path.split backslash");
    s = Path.split("//a");
    assert(s.dir == "//" && s.base == "a", "Path.split double root");
    s = Path.split("a//");
    assert(s.dir == "a" && s.base == "", "Path.split double trailing");
    s = Path.split("///");
    assert(s.dir == "///" && s.base == "", "Path.split all separators");
    s = Path.split("C:\\a\\b");
    assert(s.dir == "C:\\a" && s.base == "b", "Path.split drive backslash");
    assert(Path.dirname("C:/a/b") == "C:/a", "Path.dirname drive");
    assert(Path.basename("C:\\a\\b") == "b", "Path.basename drive");
    assert(Path.dirname("a/b") == "a", "Path.dirname basic");
    assert(Path.dirname("a/b/") == "a/b", "Path.dirname trailing slash");
    assert(Path.dirname("a") == "", "Path.dirname bare");
    assert(Path.basename("a/b") == "b", "Path.basename basic");
    assert(Path.basename("a/b/") == "", "Path.basename trailing slash");
    assert(Path.basename("a") == "a", "Path.basename bare");
}

@test
void testExtension() {
    var e = Path.splitExtension("a.tar.gz");
    assert(e.root == "a.tar" && e.ext == ".gz", "Path.splitExtension basic");
    e = Path.splitExtension("a/b.txt");
    assert(e.root == "a/b" && e.ext == ".txt", "Path.splitExtension dir");
    e = Path.splitExtension(".bashrc");
    assert(e.root == ".bashrc" && e.ext == "", "Path.splitExtension dotfile");
    e = Path.splitExtension("..");
    assert(e.root == ".." && e.ext == "", "Path.splitExtension dotdot");
    e = Path.splitExtension(".");
    assert(e.root == "." && e.ext == "", "Path.splitExtension dot");
    e = Path.splitExtension("...");
    assert(e.root == "..." && e.ext == "", "Path.splitExtension dots");
    e = Path.splitExtension("file.");
    assert(e.root == "file" && e.ext == ".", "Path.splitExtension trailing dot");
    e = Path.splitExtension("a/b");
    assert(e.root == "a/b" && e.ext == "", "Path.splitExtension none");
    e = Path.splitExtension("a/b/");
    assert(e.root == "a/b/" && e.ext == "", "Path.splitExtension trailing slash");
    e = Path.splitExtension("");
    assert(e.root == "" && e.ext == "", "Path.splitExtension empty");
    e = Path.splitExtension("a.d/b");
    assert(e.root == "a.d/b" && e.ext == "", "Path.splitExtension dot in dir");
    e = Path.splitExtension("C:\\a\\b.txt");
    assert(e.root == "C:\\a\\b" && e.ext == ".txt", "Path.splitExtension backslash");
    e = Path.splitExtension("a/b.c/d");
    assert(e.root == "a/b.c/d" && e.ext == "", "Path.splitExtension dot dir only");
    assert(Path.stem("a.") == "a", "Path.stem trailing dot");
    assert(Path.extension("a/b.txt") == ".txt", "Path.extension basic");
    assert(Path.extension("a/b") == "", "Path.extension none");
    assert(Path.extension(".bashrc") == "", "Path.extension dotfile");
    assert(Path.stem("a.tar.gz") == "a.tar", "Path.stem basic");
    assert(Path.stem(".bashrc") == ".bashrc", "Path.stem dotfile");
    assert(Path.stem("a/b/") == "", "Path.stem trailing slash");
    assert(Path.stem("a/b.txt") == "b", "Path.stem dir");
    assert(Path.stem("C:\\x\\y.md") == "y", "Path.stem backslash");

    var st = Path.stripExtension("a.tar.gz");
    assert(st == "a.tar", "Path.stripExtension basic");
    st = Path.stripExtension("a/b");
    assert(st == "a/b", "Path.stripExtension none");

    var w = Path.withExtension("a/b.txt", ".md");
    assert(w == "a/b.md", "Path.withExtension dotted");
    w = Path.withExtension("a/b.txt", "md");
    assert(w == "a/b.md", "Path.withExtension bare");
    w = Path.withExtension("a/b", ".md");
    assert(w == "a/b.md", "Path.withExtension added");
    w = Path.withExtension("a/b.txt", "");
    assert(w == "a/b", "Path.withExtension stripped");
    w = Path.withExtension("a.tar.gz", ".zip");
    assert(w == "a.tar.zip", "Path.withExtension last only");

    assert(Path.hasExtension("a.txt"), "Path.hasExtension yes");
    assert(!Path.hasExtension("a"), "Path.hasExtension no");
    assert(!Path.hasExtension(".bashrc"), "Path.hasExtension dotfile");
    assert(Path.isHidden(".bashrc"), "Path.isHidden dotfile");
    assert(Path.isHidden("a/.b"), "Path.isHidden nested");
    assert(!Path.isHidden("."), "Path.isHidden dot");
    assert(!Path.isHidden(".."), "Path.isHidden dotdot");
    assert(!Path.isHidden("a"), "Path.isHidden plain");
    assert(!Path.isHidden("a/b/"), "Path.isHidden trailing slash");
}

@test
void testJoin() {
    var r = Path.join("a", "b");
    assert(r == "a/b", "Path.join basic");
    r = Path.join("a/", "b");
    assert(r == "a/b", "Path.join trailing slash");
    r = Path.join("/", "b");
    assert(r == "/b", "Path.join root");
    r = Path.join("//", "b");
    assert(r == "//b", "Path.join double root");
    r = Path.join("a", "/b");
    assert(r == "/b", "Path.join absolute wins");
    r = Path.join("", "b");
    assert(r == "b", "Path.join empty a");
    r = Path.join("a", "");
    assert(r == "a/", "Path.join empty b");
    r = Path.join("a/", "");
    assert(r == "a/", "Path.join empty b keeps slash");
    r = Path.join("", "");
    assert(r == "", "Path.join both empty");
    r = Path.join("C:/a", "/b");
    assert(r == "C:/b", "Path.join keeps drive");
    r = Path.join("C:/a", "D:/b");
    assert(r == "D:/b", "Path.join other drive wins");
    r = Path.join("C:/a", "C:/b");
    assert(r == "C:/b", "Path.join same drive absolute");
    r = Path.join("C:a", "C:b");
    assert(r == "C:a/b", "Path.join same drive relative");
    r = Path.join("C:/a", "b");
    assert(r == "C:/a/b", "Path.join drive plus relative");
    r = Path.join("C:", "b");
    assert(r == "C:b", "Path.join bare drive");
    r = Path.join("a", "C:b");
    assert(r == "C:b", "Path.join drive b wins");
    r = Path.join("//srv/sh", "x");
    assert(r == "//srv/sh/x", "Path.join unc");
    r = Path.join("//srv/sh", "/x");
    assert(r == "//srv/sh/x", "Path.join unc keeps share");
    r = Path.join("a\\b", "c");
    assert(r == "a\\b/c", "Path.join keeps backslash");
    r = Path.join("a", "b/c");
    assert(r == "a/b/c", "Path.join multi-segment b");
    r = Path.join("a/b", "c/d");
    assert(r == "a/b/c/d", "Path.join multi-segment both");

    r = Path.joinAll(["a", "b", "c"]);
    assert(r == "a/b/c", "Path.joinAll basic");
    r = Path.joinAll(["a"]);
    assert(r == "a", "Path.joinAll single");
    r = Path.joinAll(["/a", "b"]);
    assert(r == "/a/b", "Path.joinAll rooted");
    r = Path.joinAll(["a", "/b"]);
    assert(r == "/b", "Path.joinAll absolute wins");
    r = Path.joinAll([]);
    assert(r == "", "Path.joinAll empty array");
    var empty = List<string>();
    r = Path.joinAll(empty);
    assert(r == "", "Path.joinAll empty list");
    var ab = List(["a", "b"]);
    r = Path.joinAll(ab);
    assert(r == "a/b", "Path.joinAll list");
}

@test
void testComponents() {
    var c = Path.components("a/b/c");
    assert(c.size() == 3 && c[0] == "a" && c[1] == "b" && c[2] == "c", "Path.components basic");
    c = Path.components("/a/b");
    assert(c.size() == 2 && c[0] == "a" && c[1] == "b", "Path.components rooted");
    c = Path.components("a//b");
    assert(c.size() == 2 && c[0] == "a" && c[1] == "b", "Path.components empty skipped");
    c = Path.components("");
    assert(c.size() == 0, "Path.components empty");
    c = Path.components("/");
    assert(c.size() == 0, "Path.components root");
    c = Path.components("a/");
    assert(c.size() == 1 && c[0] == "a", "Path.components trailing slash");
    c = Path.components("C:/a/b");
    assert(c.size() == 3 && c[0] == "C:" && c[1] == "a" && c[2] == "b", "Path.components drive");
    c = Path.components("//srv/sh/x");
    assert(c.size() == 2 && c[0] == "//srv/sh" && c[1] == "x", "Path.components unc");
    c = Path.components("a/./../b");
    assert(c.size() == 4 && c[0] == "a" && c[1] == "." && c[2] == ".." && c[3] == "b", "Path.components dots verbatim");

    var t = Path.toPosixSeparators("a\\b/c");
    assert(t == "a/b/c", "Path.toPosixSeparators mixed");
    t = Path.toPosixSeparators("a/b");
    assert(t == "a/b", "Path.toPosixSeparators plain");
    t = Path.toPosixSeparators("");
    assert(t == "", "Path.toPosixSeparators empty");
}

@test
void testNormalize() {
    var n = Path.normalize("");
    assert(n == ".", "Path.normalize empty");
    n = Path.normalize(".");
    assert(n == ".", "Path.normalize dot");
    n = Path.normalize("./");
    assert(n == ".", "Path.normalize dot slash");
    n = Path.normalize("a//b");
    assert(n == "a/b", "Path.normalize double slash");
    n = Path.normalize("a/./b");
    assert(n == "a/b", "Path.normalize dot skipped");
    n = Path.normalize("a/../b");
    assert(n == "b", "Path.normalize dotdot pops");
    n = Path.normalize("../a");
    assert(n == "../a", "Path.normalize leading dotdot");
    n = Path.normalize("/..");
    assert(n == "/", "Path.normalize above root");
    n = Path.normalize("a/");
    assert(n == "a", "Path.normalize trailing slash");
    n = Path.normalize("/");
    assert(n == "/", "Path.normalize root");
    n = Path.normalize("a/b/..");
    assert(n == "a", "Path.normalize trailing dotdot");
    n = Path.normalize("a/b/../..");
    assert(n == ".", "Path.normalize all popped");
    n = Path.normalize("C:/a/../..");
    assert(n == "C:/", "Path.normalize drive root");
    n = Path.normalize("C:a/../b");
    assert(n == "C:b", "Path.normalize drive relative");
    n = Path.normalize("C:");
    assert(n == "C:", "Path.normalize bare drive");
    n = Path.normalize("//srv/sh");
    assert(n == "//srv/sh", "Path.normalize unc root");
    n = Path.normalize("\\\\srv\\sh\\a\\..\\b");
    assert(n == "//srv/sh/b", "Path.normalize unc backslash");
    n = Path.normalize("a\\b");
    assert(n == "a/b", "Path.normalize backslash");
    n = Path.normalize("..");
    assert(n == "..", "Path.normalize dotdot");
    n = Path.normalize("../..");
    assert(n == "../..", "Path.normalize two dotdots");
    n = Path.normalize("a/../../b");
    assert(n == "../b", "Path.normalize dotdot past start");
    n = Path.normalize("/a/../../b");
    assert(n == "/b", "Path.normalize rooted dotdot past root");
    n = Path.normalize("C:\\a\\.\\b");
    assert(n == "C:/a/b", "Path.normalize drive dot backslash");
    n = Path.normalize("C:/");
    assert(n == "C:/", "Path.normalize drive root slash");
    n = Path.normalize("a/b/c/../../d");
    assert(n == "a/d", "Path.normalize double pop");
    n = Path.normalize("./a");
    assert(n == "a", "Path.normalize leading dot");
    n = Path.normalize("a/.");
    assert(n == "a", "Path.normalize trailing dot");
}

@test
void testRelativePath() {
    var r = Path.relativePath("/a/b", "/a/c");
    assert(r == "../c", "Path.relativePath sibling");
    r = Path.relativePath("/a/b", "/a/b/c");
    assert(r == "c", "Path.relativePath child");
    r = Path.relativePath("/a/b/c", "/a/b");
    assert(r == "..", "Path.relativePath parent");
    r = Path.relativePath("a/b", "a/b");
    assert(r == ".", "Path.relativePath same");
    r = Path.relativePath("a", "b");
    assert(r == "../b", "Path.relativePath neighbors");
    r = Path.relativePath("a/b", "c/d");
    assert(r == "../../c/d", "Path.relativePath disjoint");
    r = Path.relativePath("a", "");
    assert(r == "..", "Path.relativePath to empty");
    r = Path.relativePath("", "a");
    assert(r == "a", "Path.relativePath from empty");
    r = Path.relativePath("", "");
    assert(r == ".", "Path.relativePath both empty");
    r = Path.relativePath("/a", "b");
    assert(r == "b", "Path.relativePath mixed from absolute");
    r = Path.relativePath("a", "/b");
    assert(r == "/b", "Path.relativePath mixed to absolute");
    r = Path.relativePath("C:/a", "D:/b");
    assert(r == "D:/b", "Path.relativePath other drive");
    r = Path.relativePath("C:/a/b", "C:/a/c");
    assert(r == "../c", "Path.relativePath same drive");
    r = Path.relativePath("../a", "../b");
    assert(r == "../b", "Path.relativePath dotdot prefix");
}
