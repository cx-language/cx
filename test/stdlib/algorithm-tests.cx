// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testAllAnyNone() {
    assert((0...3).all(x => x < 4));
    assert(!(0..3).all(x => x != 2));
    assert("abc".any(x => x == 'c'));
    var abc = StringBuf("abc");
    assert(!abc.any(x => x == 'd'));
    var nums = List([0,1,2,3]);
    assert(nums.none(x => x > 3));
    assert(Slice<int>().none(x => true));
}

@test
void testInsertionSort() {
    var a = List<int>();
    for i in 0..5 {
        a.push(5 - i);
    }

    var real = List<int>();
    for i in 0..5 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testQuickSort() {
    var a = List<int>();

    for i in 0..64 {
        a.push(64 - i);
    }

    var real = List<int>();

    for i in 0..64 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testSortSlice() {
    var a = [5, 4, 3, 2, 1];
    sort(a);
    for i in 0..5 {
        assert(a[i] == i + 1);
    }
}

@test
void testSwapOwningValues() {
    // swap() is bytewise, so swapping owning values must neither double-free
    // nor leak. Heap strings defeat small-string optimization.
    var x = StringBuf("heap-string-one-long-enough");
    var y = StringBuf("heap-string-two-long-enough");
    swap(x, y);
    assert(x == "heap-string-two-long-enough");
    assert(y == "heap-string-one-long-enough");
    swap(x, x);
    assert(x == "heap-string-two-long-enough");
}

@test
void testMax() {
    var a = 7;
    var b = 9;
    assert(max(a, b) == 9);
    int* pa = &a;
    int* pb = &b;
    assert(max(pa, pb) == 9);
    *max(a, b) = 10;
    assert(b == 10);
    int m = max(a, b);
    assert(m == 10);
}

@test
void testMin() {
    var a = 7;
    var b = 9;
    assert(min(a, b) == 7);
    int* pa = &a;
    int* pb = &b;
    assert(min(pa, pb) == 7);
    *min(a, b) = 6;
    assert(a == 6);
    int m = min(a, b);
    assert(m == 6);
}

@test
void testMinMaxConst() {
    const a = 7;
    const b = 9;
    assert(max(a, b) == 9);
    assert(min(a, b) == 7);
    var r = minmax(a, b);
    assert(r.min == 7);
    assert(r.max == 9);
    assert(max(3, 4) == 4);
    assert(min(3, 4) == 3);
}

@test
void testMinmax() {
    var a = 7;
    var b = 9;
    assert(minmax(a, b).min == 7);
    assert(minmax(a, b).max == 9);
    assert(minmax(b, a).min == 7);
    assert(minmax(b, a).max == 9);
    *minmax(a, b).min = 6;
    assert(a == 6);
    var r = minmax(3, 1);
    assert(r.min == 1);
    assert(r.max == 3);
}

struct ListHolder: Comparable {
    List<int> items;
    Ordering compare(ListHolder& other) {
        return items.size() < other.items.size() ? Ordering.Less : items.size() > other.items.size() ? Ordering.Greater : Ordering.Equal;
    }
}

@test
void testMinmaxRefNoCopy() {
    // The ref overload needs only Comparable, so non-Copyable types work.
    var a = ListHolder(List([1, 2]));
    var b = ListHolder(List([1]));
    assert(minmax(a, b).min.items.size() == 1);
    assert(minmax(a, b).max.items.size() == 2);
}
