// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testAllAnyNone() {
    assert((0...3).all(x => x < 4));
    assert(!(0..3).all(x => x != 2));
    assert("abc".any(x => x == 'c'));
    var abc = StringBuf("abc");
    assert(!abc.any(x => x == 'd'));
    var nums = List([0,1,2,3]);
    assert(nums.none(x => x > 3));
    assert(Slice<int>().none(x => true));
}

@test
void testInsertionSort() {
    var a = List<int>();
    for i in 0..5 {
        a.push(5 - i);
    }

    var real = List<int>();
    for i in 0..5 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testQuickSort() {
    var a = List<int>();

    for i in 0..64 {
        a.push(64 - i);
    }

    var real = List<int>();

    for i in 0..64 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testMax() {
    var a = 7;
    var b = 9;
    assert(max(a, b) == 9);
    int* pa = &a;
    int* pb = &b;
    assert(max(pa, pb) == 9);
    *max(a, b) = 10;
    assert(b == 10);
    int m = max(a, b);
    assert(m == 10);
}

@test
void testMin() {
    var a = 7;
    var b = 9;
    assert(min(a, b) == 7);
    int* pa = &a;
    int* pb = &b;
    assert(min(pa, pb) == 7);
    *min(a, b) = 6;
    assert(a == 6);
    int m = min(a, b);
    assert(m == 6);
}

@test
void testMinmax() {
    var a = 7;
    var b = 9;
    var r = minmax(a, b);
    assert(r.min == 7);
    assert(r.max == 9);
    r = minmax(b, a);
    assert(r.min == 7);
    assert(r.max == 9);
    r = minmax(3, 1);
    assert(r.min == 1);
    assert(r.max == 3);
}
