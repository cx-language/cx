// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testAllAnyNone() {
    assert((0...3).all(x => x < 4));
    assert(!(0..3).all(x => x != 2));
    assert("abc".any(x => x == 'c'));
    var abc = StringBuf("abc");
    assert(!abc.any(x => x == 'd'));
    var nums = List([0,1,2,3]);
    assert(nums.none(x => x > 3));
    assert(Slice<int>().none(x => true));
}

@test
void testInsertionSort() {
    var a = List<int>();
    for i in 0..5 {
        a.push(5 - i);
    }

    var real = List<int>();
    for i in 0..5 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testQuickSort() {
    var a = List<int>();

    for i in 0..64 {
        a.push(64 - i);
    }

    var real = List<int>();

    for i in 0..64 {
        real.push(i + 1);
    }

    sort(a);

    assert(Slice(a) == Slice(real));
}

@test
void testSortSlice() {
    var a = [5, 4, 3, 2, 1];
    sort(a);
    for i in 0..5 {
        assert(a[i] == i + 1);
    }
}

struct SortItem {
    string name;
    int order;
}

@test
void testSortBy() {
    var a = [1, 2, 3, 4, 5];
    sortBy(a, (x, y) => x > y);
    for i in 0..5 {
        assert(a[i] == 5 - i);
    }
    var b = List<int>();
    for i in 0..5 {
        b.push(i + 1);
    }
    sortBy(b, (x, y) => x > y);
    for i in 0..5 {
        assert(b[i] == 5 - i);
    }
}

@test
void testSortByLarge() {
    var a = List<int>();
    for i in 0..64 {
        a.push(i + 1);
    }
    sortBy(a, (x, y) => x > y);
    for i in 0..64 {
        assert(a[i] == 64 - i);
    }
}

@test
void testSortByField() {
    var a = List<SortItem>();
    a.push(SortItem(name = "c", order = 3));
    a.push(SortItem(name = "a", order = 1));
    a.push(SortItem(name = "b", order = 2));
    sortBy(a, (x, y) => x.order < y.order);
    assert(a[0].name == "a");
    assert(a[1].name == "b");
    assert(a[2].name == "c");
}

@test
void testSortByStable() {
    var a = List<SortItem>();
    a.push(SortItem(name = "b1", order = 1));
    a.push(SortItem(name = "b2", order = 1));
    a.push(SortItem(name = "a", order = 0));
    sortBy(a, (x, y) => x.order < y.order);
    assert(a[0].name == "a");
    assert(a[1].name == "b1");
    assert(a[2].name == "b2");
}

@test
void testSortByEdges() {
    var empty = List<int>();
    sortBy(empty, (x, y) => x < y);
    assert(empty.size() == 0);
    var one = [42];
    sortBy(one, (x, y) => x < y);
    assert(one[0] == 42);
    var boundary = List<int>();
    for i in 0..33 {
        boundary.push(33 - i);
    }
    sortBy(boundary, (x, y) => x < y);
    for i in 0..33 {
        assert(boundary[i] == i + 1);
    }
    var equal = List<int>();
    for _ in 0..40 {
        equal.push(7);
    }
    sortBy(equal, (x, y) => x < y);
    for i in 0..40 {
        assert(equal[i] == 7);
    }
}

@test
void testSortByCapture() {
    var a = [1, 2, 3, 4, 5];
    var target = 4;
    sortBy(a, (x, y) => (x - target) * (x - target) < (y - target) * (y - target));
    assert(a[0] == 4);
    assert(a[1] == 3);
    assert(a[2] == 5);
    assert(a[3] == 2);
    assert(a[4] == 1);
}

@test
void testSwapOwningValues() {
    // swap() is bytewise, so swapping owning values must neither double-free
    // nor leak. Heap strings defeat small-string optimization.
    var x = StringBuf("heap-string-one-long-enough");
    var y = StringBuf("heap-string-two-long-enough");
    swap(x, y);
    assert(x == "heap-string-two-long-enough");
    assert(y == "heap-string-one-long-enough");
    swap(x, x);
    assert(x == "heap-string-two-long-enough");
}

@test
void testMax() {
    var a = 7;
    var b = 9;
    assert(max(a, b) == 9);
    int* pa = &a;
    int* pb = &b;
    // Pointer arguments compare addresses, not pointees.
    assert(max(pa, pb) == (pa >= pb ? pa : pb));
    *max(a, b) = 10;
    assert(b == 10);
    int m = max(a, b);
    assert(m == 10);
}

@test
void testMin() {
    var a = 7;
    var b = 9;
    assert(min(a, b) == 7);
    int* pa = &a;
    int* pb = &b;
    // Pointer arguments compare addresses, not pointees.
    assert(min(pa, pb) == (pa < pb ? pa : pb));
    *min(a, b) = 6;
    assert(a == 6);
    int m = min(a, b);
    assert(m == 6);
}

@test
void testMinMaxConst() {
    const a = 7;
    const b = 9;
    assert(max(a, b) == 9);
    assert(min(a, b) == 7);
    var r = minmax(a, b);
    assert(r.min == 7);
    assert(r.max == 9);
    assert(max(3, 4) == 4);
    assert(min(3, 4) == 3);
}

@test
void testMinmax() {
    var a = 7;
    var b = 9;
    assert(minmax(a, b).min == 7);
    assert(minmax(a, b).max == 9);
    assert(minmax(b, a).min == 7);
    assert(minmax(b, a).max == 9);
    *minmax(a, b).min = 6;
    assert(a == 6);
    var r = minmax(3, 1);
    assert(r.min == 1);
    assert(r.max == 3);
    // Pointer arguments compare addresses, not pointees.
    int* pa = &a;
    int* pb = &b;
    assert(minmax(pa, pb).min == (pa < pb ? pa : pb));
    assert(minmax(pa, pb).max == (pa < pb ? pb : pa));
}

struct ListHolder: Comparable {
    List<int> items;
    Ordering compare(ListHolder& other) {
        return items.size() < other.items.size() ? Ordering.Less : items.size() > other.items.size() ? Ordering.Greater : Ordering.Equal;
    }
}

@test
void testMinmaxRefNoCopy() {
    // The ref overload needs only Comparable, so non-Copyable types work.
    var a = ListHolder(List([1, 2]));
    var b = ListHolder(List([1]));
    assert(minmax(a, b).min.items.size() == 1);
    assert(minmax(a, b).max.items.size() == 2);
}
