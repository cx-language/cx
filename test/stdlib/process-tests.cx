// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testGetSetEnv() {
    Process.setenv("CX_TEST_PROCESS_VAR", "hello123");
    assert(Process.getenv("CX_TEST_PROCESS_VAR")! == "hello123");
}

@test
void testGetUnsetEnv() {
    assert(Process.getenv("CX_DEFINITELY_UNSET_VAR_XYZ") == null);
}

@test
void testRunStatus() {
    var r0 = Process.run("exit 0");
    assert(r0.status == 0);
    var r3 = Process.run("exit 3");
    assert(r3.status == 3);
    var silent = Process.run("exit 0");
    assert(string(silent.output) == "");
}

@test
void testRunOutput() {
    var result = Process.run("echo hello");
    assert(result.status == 0);
    assert(string(result.output).contains("hello"));
}
