// RUN: check_exit_status 0 %cx test -Werror %s
// RUN: check_exit_status 0 %cx test -Werror --release %s
// RUN: check_exit_status 0 %cx test -Werror --backend=c %s
// RUN: check_exit_status 0 %cx test -Werror --release --backend=c %s

@test
void testSmallListStaysInline() {
    var list = SmallList<int32, 4>();
    assert(list.empty() && list.size() == 0 && list.capacity() == 4);

    list.push(1);
    list.push(2);
    list.push(3);
    assert(list.size() == 3 && !list.empty());
    assert(list[0] == 1 && list[1] == 2 && list[2] == 3);
    assert(list.first() == 1 && list.last() == 3);

    list[1] = 20;
    assert(list[1] == 20);
    assert(list[-1] == 3 && list[-3] == 1);
    list[-1] = 30;
    assert(list.last() == 30);

    assert(list.pop() == 30);
    assert(list.size() == 2);
}

@test
void testSmallListSpillsToHeap() {
    var list = SmallList<int32, 2>();
    for i in 0..10 {
        list.push(i);
    }
    assert(list.size() == 10 && list.capacity() >= 10);
    for i in 0..10 {
        assert(list[i] == i);
    }

    // Mutations work the same on the heap.
    list[0] = 100;
    assert(list.first() == 100);
    assert(list.removeAt(0) == 100);
    assert(list.size() == 9 && list[0] == 1);
}

@test
void testSmallListConstructors() {
    var filled = SmallList<int32, 2>(3, 7);
    assert(filled.size() == 3 && filled[0] == 7 && filled[2] == 7);

    var fromArray = SmallList<int32, 2>([1, 2, 3]);
    assert(fromArray.size() == 3 && fromArray[2] == 3);

    var empty = SmallList<int32, 2>([]);
    assert(empty.empty());
}

@test
void testSmallListRemoveAndClear() {
    var list = SmallList<int32, 4>([1, 2, 3, 4]);
    assert(list.removeFirst() == 1);
    list.removeLast();
    assert(list.size() == 2 && list[0] == 2 && list[1] == 3);

    assert(list.removeFirst(n => n == 3)! == 3);
    assert(list.size() == 1);

    list.clear();
    assert(list.empty());
    list.push(9);
    assert(list.size() == 1 && list[0] == 9);
}

@test
void testSmallListContainsAndIndexOf() {
    var list = SmallList<int32, 2>([1, 2, 3]);
    var two = 2;
    var nine = 9;
    assert(list.contains(two) && !list.contains(nine));
    assert(list.indexOf(two)! == 1 && list.indexOf(nine) == null);
}

@test
void testSmallListIteration() {
    var list = SmallList<int32, 2>([1, 2, 3]);
    var sum = 0;
    for x in list {
        sum += x;
    }
    assert(sum == 6);

    // Manual iteration visits the same elements in order.
    var iterator = list.iterator();
    for expected in [1, 2, 3] {
        assert(iterator.hasValue() && iterator.value() == expected);
        iterator.increment();
    }
    assert(!iterator.hasValue());
}

@test
void testSmallListFunctionalHelpers() {
    var list = SmallList<int32, 2>([1, 2, 3, 4]);

    assert(list.find(n => n > 2)! == 3 && list.find(n => n > 9) == null);

    assert(list.map(n => n * 2).toList() == List([2, 4, 6, 8]));
    assert(list.filter(n => n % 2 == 0).toList() == List([2, 4]));
    var tail = SmallList<int32, 2>([5, 6]);
    assert(list.chain(tail.iterator()).toList() == List([1, 2, 3, 4, 5, 6]));

    assert(list.all(n => n > 0) && !list.all(n => n > 2));
    assert(list.any(n => n == 3) && !list.any(n => n > 9));
    assert(list.none(n => n > 9) && !list.none(n => n == 1));
}

@test
void testSmallListReserveAndEquality() {
    var list = SmallList<int32, 2>();
    list.reserve(100);
    assert(list.capacity() >= 100 && list.empty());
    list.push(1);
    assert(list[0] == 1);

    assert(SmallList<int32, 2>([1, 2]) == SmallList<int32, 2>([1, 2]));
    assert(!(SmallList<int32, 2>([1, 2]) == SmallList<int32, 2>([1, 3])));
    assert(!(SmallList<int32, 2>([1]) == SmallList<int32, 2>([1, 2])));
}

@test
void testSmallListCrossStorageEquality() {
    // Same elements compare equal regardless of inline capacity or storage.
    var inline = SmallList<int32, 4>([1, 2, 3]);
    var spilled = SmallList<int32, 2>([1, 2, 3]);
    var otherInline = SmallList<int32, 8>([1, 2, 3]);
    assert(inline == spilled && inline == otherInline);
    assert(spilled == inline);
}

@test
void testSmallListZeroInlineCapacity() {
    // N=0 spills immediately and otherwise behaves the same.
    var list = SmallList<int32, 0>();
    assert(list.empty() && list.capacity() == 0);
    list.push(1);
    assert(list.capacity() == 8);
    list.push(2);
    assert(list.size() == 2 && list[0] == 1 && list[1] == 2);
    assert(list.pop() == 2);
}

@test
void testSmallListPrintAndIteratorToList() {
    var list = SmallList<int32, 4>([1, 2, 3]);
    println(list);
    assert(list.iterator().toList() == List([1, 2, 3]));
}

int destroyedCount = 0;

struct Droppable {
    int x = 0;

    ~Droppable() {
        destroyedCount++;
    }
}

@test
void testSmallListDestroysInlineElements() {
    destroyedCount = 0;
    if true {
        var list = SmallList<Droppable, 4>();
        list.push(Droppable());
        list.push(Droppable());
        list.pop();
        // One element popped (destroyed with the returned value), one remains.
        assert(destroyedCount == 1);
    }
    assert(destroyedCount == 2);
}

@test
void testSmallListDestroysHeapElements() {
    destroyedCount = 0;
    if true {
        var list = SmallList<Droppable, 1>();
        list.push(Droppable());
        list.push(Droppable());
        list.push(Droppable());
        list.removeLast();
        assert(destroyedCount == 1);
    }
    assert(destroyedCount == 3);
}

@test
void testSmallListDestroysOnlyLiveInlineElements() {
    destroyedCount = 0;
    if true {
        var list = SmallList<Droppable, 4>();
        list.push(Droppable());
    }
    assert(destroyedCount == 1);
}

@test
void testSmallListDestructionAcrossMoves() {
    destroyedCount = 0;
    if true {
        var list = SmallList<Droppable, 4>();
        list.push(Droppable());
        list.push(Droppable());
        list.push(Droppable());
        assert(destroyedCount == 0);

        // removeAt moves the element out; the shift moves the rest.
        var removed = list.removeAt(1);
        assert(destroyedCount == 0);
        removed.deinit();
        assert(destroyedCount == 1);

        // clear() destroys the rest; the list stays usable.
        list.clear();
        assert(destroyedCount == 3);
        list.push(Droppable());
        assert(destroyedCount == 3);

        // Index overwrite destroys the old element.
        list[0] = Droppable();
        assert(destroyedCount == 4);
    }
    assert(destroyedCount == 5);

    destroyedCount = 0;
    if true {
        var spilled = SmallList<Droppable, 1>();
        spilled.push(Droppable());
        spilled.push(Droppable());
        spilled.push(Droppable());
        assert(destroyedCount == 0);

        var first = spilled.removeAt(0);
        assert(destroyedCount == 0);
        first.deinit();
        assert(destroyedCount == 1);

        // take() moves the list out, leaving an empty list behind.
        var taken = spilled.take();
        assert(spilled.empty() && taken.size() == 2);
        assert(destroyedCount == 1);
    }
    assert(destroyedCount == 3);
}

@test
void testSmallListDataIsContiguous() {
    var list = SmallList<int32, 4>([1, 2, 3]);
    var data = list.data();
    assert(data[0] == 1 && data[1] == 2 && data[2] == 3);
    data[1] = 20;
    assert(list[1] == 20);

    // Same through the heap spill path.
    var spilled = SmallList<int32, 2>([1, 2, 3]);
    var spilledData = spilled.data();
    assert(spilledData[0] == 1 && spilledData[2] == 3);
    spilledData[0] = 10;
    assert(spilled[0] == 10);
}

struct CopyablePayload {
    int n;
    string s;
}

@test
void testSmallListCopyablePayloadRemoval() {
    var a = SmallList<CopyablePayload, 4>();
    for i in 0..10 {
        a.push(CopyablePayload(i, "x"));
    }
    a.reserve(100);
    assert(a.size() == 10 && a[0].s == "x");
    assert(a.pop().n == 9);
    assert(a.removeAt(0).n == 0);
    assert(a.removeFirst().n == 1);
    assert(a.size() == 7);
    for i in 0..a.size() {
        assert(a[i].n == i + 2);
    }
}
