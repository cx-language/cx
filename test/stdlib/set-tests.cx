// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testInsert() {
    var s = Set<string>();

    s.insert("ok");

    assert(s.contains("ok"));
    assert(!s.contains("lol"));
}


@test
void testRemoval() {
    var s = Set<string>();

    s.insert("ok");
    assert(s.contains("ok"));

    assert(s.remove("ok"));
    assert(!s.contains("ok"));
    assert(!s.remove("ok"));
}

@test
void testDuplicates() {
    var s = Set<string>();

    s.insert("ok");
    s.insert("ok");
    assert(s.contains("ok"));

    s.remove("ok");
    assert(!s.contains("ok"));
}

@test
void testIterator() {
    var s = Set<string>();

    s.insert("a");
    s.insert("ccc");
    s.insert("bb");
    s.insert("a");
    s.insert("ccc");
    s.insert("ccc");

    var a = false;
    var bb = false;
    var ccc = false;

    for e in s {
        if (e == "a") {
            assert(!a);
            a = true;
        } else if (e == "bb") {
            assert(!bb);
            bb = true;
        } else if (e == "ccc") {
            assert(!ccc);
            ccc = true;
        } else {
            assert(false);
        }
    }

    assert(a);
    assert(bb);
    assert(ccc);
}

@test
void testEmptySetIterator() {
    var s = Set<string>();
    s.insert("foo");
    s.insert("foo");
    s.remove("foo");

    for _ in s {
        assert(false);
    }
}

@test
void testUnitSetIterator() {
    var s = Set<string>();
    s.insert("foo");
    s.insert("foo");
    var count = 0;

    for e in s {
        count++;
        assert(e == "foo");
    }

    assert(count == 1);
}

@test
void testClear() {
    var s = Set<string>();
    s.insert("a");
    s.insert("b");

    s.clear();
    assert(s.size() == 0);
    assert(s.empty());
    assert(!s.contains("a"));

    s.insert("c");
    assert(s.contains("c"));
}

@test
void testAllAnyNone() {
    var s = Set<int>();
    s.insert(2);
    s.insert(4);

    assert(s.all(n => n % 2 == 0));
    assert(!s.all(n => n > 2));
    assert(s.any(n => n == 4));
    assert(!s.any(n => n > 10));
    assert(s.none(n => n % 2 == 1));
    assert(!s.none(n => n == 2));

    assert(s.all((int& n) => n > 0));
    assert(s.any((int& n) => n == 2));
    assert(s.none((int& n) => n < 0));
}
