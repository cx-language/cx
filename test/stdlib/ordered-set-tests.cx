// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testInsert() {
    var s = OrderedSet<int>();

    s.insert(42);

    assert(s.contains(42));
    assert(!s.contains(39));
}

@test
void testRemoval() {
    var s = OrderedSet<int>();

    s.insert(42);
    assert(s.contains(42));

    assert(s.remove(42));
    assert(!s.contains(42));
    assert(!s.remove(42));
}

@test
void testDuplicates() {
    var s = OrderedSet<int>();

    s.insert(42);
    s.insert(42);
    assert(s.contains(42));

    s.remove(42);
    assert(!s.contains(42));
}

@test
void testIterator() {
    var s = OrderedSet<int>();

    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.insert(1);
    s.insert(2);
    s.insert(2);

    var a = false;
    var bb = false;
    var ccc = false;

    for e in s {
        if (e == 1) {
            assert(!a);
            a = true;
        } else if (e == 2) {
            assert(!bb);
            bb = true;
        } else if (e == 3) {
            assert(!ccc);
            ccc = true;
        } else {
            assert(false);
        }
    }

    assert(a);
    assert(bb);
    assert(ccc);
}

@test
void testEmptyOrderedSetIterator() {
    var s = OrderedSet<int>();
    s.insert(79);
    s.insert(79);
    s.remove(79);

    for _ in s {
        assert(false);
    }
}

@test
void testUnitOrderedSetIterator() {
    var s = OrderedSet<int>();
    s.insert(79);
    s.insert(79);
    var count = 0;

    for e in s {
        count++;
        assert(e == 79);
    }

    assert(count == 1);
}

@test
void testFirstLast() {
    var s = OrderedSet<uint>();

    s.insert(63);
    s.insert(69);
    s.insert(1);
    s.insert(53);

    assert(s.first()! == 1);
    assert(s.last()! == 69);
}

@test
void testLowerAndHigher() {
    var m = OrderedSet<int>();

    for i in 0..100 {
        m.insert(i);
    }

    assert(m.lower(0) == null);
    for i in 1..100 {
        assert(m.lower(i)! == i-1);
    }

    assert(m.higher(99) == null);
    for i in 0..99 {
        assert(m.higher(i)! == i+1);
    }
}

@test
void testEmptyOrderedSetFunctions() {
    var s = OrderedSet<uint>();

    assert(s.first() == null);
    assert(s.last() == null);
    assert(s.higher(48) == null);
    assert(s.lower(42) == null);
}

@test
void testIteratorOrder() {
    var set = OrderedSet<uint>();

    for i in 0..100 {
        set.insert(uint(i));
    }

    uint called = 0;
    for e in set {
        assert(e == called);
        called++;
    }

    assert(called == 100);

    set.clear();

    for i in 0..100 {
        set.insert(uint(99 - i));
    }

    called = 0;
    // Still in correct order
    for e in set {
        assert(e == called);
        called++;
    }

    assert(called == 100);
}

@test
void testRemoveReturnValue() {
    var s = OrderedSet<int>();
    s.insert(1);
    s.insert(2);

    assert(s.remove(1));
    assert(s.size() == 1);
    assert(!s.contains(1));
    assert(!s.remove(99));
    assert(s.size() == 1);
}

@test
void testClear() {
    var s = OrderedSet<int>();
    s.insert(1);
    s.insert(2);

    s.clear();
    assert(s.size() == 0);
    assert(s.empty());
    assert(!s.contains(1));

    s.insert(3);
    assert(s.contains(3));
}

@test
void testAllAnyNone() {
    var s = OrderedSet<int>();
    s.insert(2);
    s.insert(4);

    assert(s.all(n => n % 2 == 0));
    assert(!s.all(n => n > 2));
    assert(s.any(n => n == 4));
    assert(!s.any(n => n > 10));
    assert(s.none(n => n % 2 == 1));
    assert(!s.none(n => n == 2));

    assert(s.all((int& n) => n > 0));
    assert(s.any((int& n) => n == 2));
    assert(s.none((int& n) => n < 0));
}
