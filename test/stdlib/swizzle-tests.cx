// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s

void main() {
    testSingle();
    testMulti();
    testRgba();
    testReorderDuplicate();
    testSingleWrite();
    testMultiWrite();
    testCompoundWrite();
    testPointerBase();
}

void testSingle() {
    float[3] v = [1.0, 2.0, 3.0];
    assert(v.x == 1.0);
    assert(v.y == 2.0);
    assert(v.z == 3.0);
    assert(v.r == 1.0);
    assert(v.g == 2.0);
    assert(v.b == 3.0);
}

void testMulti() {
    float[3] v = [1.0, 2.0, 3.0];
    float[2] xy = v.xy;
    assert(xy[0] == 1.0);
    assert(xy[1] == 2.0);

    float[3] xyz = v.xyz;
    assert(xyz[0] == 1.0);
    assert(xyz[1] == 2.0);
    assert(xyz[2] == 3.0);
}

void testRgba() {
    float[4] w = [1.0, 2.0, 3.0, 4.0];
    assert(w.w == 4.0);
    assert(w.a == 4.0);
    float[2] ra = w.ra;
    assert(ra[0] == 1.0);
    assert(ra[1] == 4.0);
    float[4] wzyx = w.wzyx;
    assert(wzyx[0] == 4.0);
    assert(wzyx[3] == 1.0);
}

void testReorderDuplicate() {
    float[3] v = [1.0, 2.0, 3.0];
    float[3] zyx = v.zyx;
    assert(zyx[0] == 3.0);
    assert(zyx[1] == 2.0);
    assert(zyx[2] == 1.0);

    float[2] xx = v.xx;
    assert(xx[0] == 1.0);
    assert(xx[1] == 1.0);
}

void testSingleWrite() {
    float[2] v = [1.0, 2.0];
    v.x = 5.0;
    assert(v[0] == 5.0);
    assert(v[1] == 2.0);
    v.y = 6.0;
    assert(v.x == 5.0);
    assert(v.y == 6.0);

    float* p = &v.x;
    *p = 7.0;
    assert(v[0] == 7.0);
}

void testMultiWrite() {
    float[3] v = [1.0, 2.0, 3.0];
    v.xy = [10.0, 20.0];
    assert(v[0] == 10.0);
    assert(v[1] == 20.0);
    assert(v[2] == 3.0);

    v.zyx = [30.0, 20.0, 10.0];
    assert(v[0] == 10.0);
    assert(v[1] == 20.0);
    assert(v[2] == 30.0);

    float[2] w = [7.0, 8.0];
    v.xy = w.yx;
    assert(v.x == 8.0);
    assert(v.y == 7.0);
}

void testCompoundWrite() {
    float[3] v = [1.0, 2.0, 3.0];
    v.x += 5.0;
    assert(v.x == 6.0);
    v.xy += [1.0, 2.0];
    assert(v.x == 7.0);
    assert(v.y == 4.0);
    v.z++;
    assert(v.z == 4.0);
}

void testPointerBase() {
    float[3] v = [1.0, 2.0, 3.0];
    float[3]* q = &v;
    q.x = 10.0;
    assert(v[0] == 10.0);
    q.yz = [20.0, 30.0];
    assert(v[1] == 20.0);
    assert(v[2] == 30.0);
}
