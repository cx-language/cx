// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testStringComparison() {
    assert("abc" == "abc");
    assert(!("abc" == "not"));
    assert("abc" < "bcd");
}

@test
void testStringIterator() {
    var iterator = "xy".iterator();

    assert(iterator.hasValue());
    assert(iterator.value() == 'x');

    iterator.increment();
    assert(iterator.hasValue());
    assert(iterator.value() == 'y');

    iterator.increment();
    assert(!iterator.hasValue());
}

@test
void testIndexOf() {
    var s = StringBuf("word");

    // Start from beginning
    assert(s.indexOf('w') == 0);
    assert(s.indexOf('o') == 1);
    assert(s.indexOf('r') == 2);
    assert(s.indexOf('d') == 3);

    // Start from index
    assert(s.indexOf('w', 1) == null);
    assert(s.indexOf('d', 2) == 3);
}

@test
void testIndexOfString() {
    string s = "hello world";

    assert(s.indexOf("hello") == 0);
    assert(s.indexOf("world") == 6);
    assert(s.indexOf("o") == 4);
    assert(s.indexOf("z") == null);
    assert(s.indexOf("") == 0);
    assert(s.indexOf("o", 5) == 7);
    assert(s.indexOf("hello", 1) == null);

    assert(s.contains("world"));
    assert(!s.contains("z"));

    assert(s.indexOf('w') == 6);
    assert(s.indexOf('o', 5) == 7);
    assert(s.indexOf("world") == 6);
    assert(s.indexOf("world", 7) == null);
}

@test
void testSubstr() {
    var s = StringBuf("word");
    assert(s.substr(0..1) == "w");
    assert(s.substr(0..2) == "wo");
    assert(s.substr(0..3) == "wor");
    assert(s.substr(0..4) == "word");
    assert(s.substr(1..4) == "ord");
    assert(s.substr(2..4) == "rd");
    assert(s.substr(1..3) == "or");
    assert(s.substr(2..3) == "r");

    var s2 = StringBuf("this is the best sentence");
    assert(s2.substr(0..4) == "this");
    assert(s2.substr(5..7) == "is");
    assert(s2.substr(8..11) == "the");
    assert(s2.substr(12..16) == "best");
    assert(s2.substr(17..25) == "sentence");

    var s3 = StringBuf("best");
    assert(s3.substr(0..0) == "");
}

@test
void testSplit() {
    var s = StringBuf("this is the best sentence");
    var words = s.split();
    assert(words.size() == 5);
    assert(words[0] == "this");
    assert(words[1] == "is");
    assert(words[2] == "the");
    assert(words[3] == "best");
    assert(words[4] == "sentence");
}

@test
void testOtherSplit() {
    var s = StringBuf("this,sentence,is,comma,separated");
    var words = s.split(',');
    assert(words.size() == 5);
    assert(words[0] == "this");
    assert(words[1] == "sentence");
    assert(words[2] == "is");
    assert(words[3] == "comma");
    assert(words[4] == "separated");

    var s2 = StringBuf(",,1,,2");
    words = s2.split(',');
    assert(words.size() == 5);
    assert(words[0] == "");
    assert(words[1] == "");
    assert(words[2] == "1");
    assert(words[3] == "");
    assert(words[4] == "2");

    var s3 = StringBuf(",,,b,a,,,");
    words = s3.split(',');
    assert(words.size() == 8);
    assert(words[0] == "");
    assert(words[1] == "");
    assert(words[2] == "");
    assert(words[3] == "b");
    assert(words[4] == "a");
    assert(words[5] == "");
    assert(words[6] == "");
    assert(words[7] == "");
}

@test
void testBytes() {
    // TODO: Unicode / UTF-8
    var text = "The quick brown fox jumps over the lazy dog";
    var i = 0;

    for byte in text.bytes() {
        assert(byte == uint8(text[i]));
        i++;
    }

    assert(i == text.size());
}

@test
void testLines() {
    var text = "The quick brown fox \n\n\n jumps over\n the lazy dog\n";
    var expected = ["The quick brown fox ", "", "", " jumps over", " the lazy dog"];
    var i = 0;

    for line in text.lines() {
        assert(line == expected[i]);
        i++;
    }

    assert(i == expected.size());
}

@test
void testParseInt() {
    assert("".parseInt() == null);
    assert("a".parseInt() == null);
    assert("1a".parseInt() == null);
    assert("1".parseInt() == 1);
    assert("123789".parseInt() == 123789);
    assert("2147483647".parseInt() == 2147483647);
    assert("+42".parseInt() == 42);
    assert("-42".parseInt() == -42);
    assert("-".parseInt() == null);
    assert("+".parseInt() == null);
    assert("0".parseInt() == 0);
    assert("007".parseInt() == 7);
    assert("0x10".parseInt() == 16);
    assert("0xff".parseInt() == 255);
    assert("0xFF".parseInt() == 255);
    assert("-0x10".parseInt() == -16);
    assert("0x".parseInt() == null);
    assert("0b101".parseInt() == 5);
    assert("0b102".parseInt() == null);
    assert("0b".parseInt() == null);
    assert("0o17".parseInt() == 15);
    assert("0o18".parseInt() == null);
    assert("0o".parseInt() == null);
    assert("2147483648".parseInt() == null);
    assert("-2147483648".parseInt()! == int.min);
    assert("-2147483649".parseInt() == null);
    assert("0x7fffffff".parseInt() == 2147483647);
    assert("0x80000000".parseInt() == null);
}

@test
void testEscape() {
    var emptyEscape = "".escape();
    assert(emptyEscape == "");
    var plainEscape = "0 r t \' n".escape();
    assert(plainEscape == "0 r t ' n");
    var controlEscape = "\0 \r \t \' \" \\ \n".escape();
    assert(controlEscape == "\\0 \\r \\t ' \\\" \\\\ \\n");
}

@test
void testRepeat() {
    assert("abc".repeat(3) == "abcabcabc");
    assert("1".repeat(5) == "11111");
    assert("".repeat(3) == "");
    assert("abc".repeat(0) == "");
    assert("abc".repeat(1) == "abc");
}

@test
void testStartsEndsWith() {
    assert("abc".startsWith("a"));
    assert("abc".startsWith("abc"));
    assert("abc".startsWith(""));
    assert(!("abc".startsWith("b")));
    assert(!("abc".startsWith("abcd")));
    assert(!("".startsWith("a")));
    assert("".startsWith(""));

    assert("abc".endsWith("c"));
    assert("abc".endsWith("abc"));
    assert("abc".endsWith(""));
    assert(!("abc".endsWith("b")));
    assert(!("abc".endsWith("zabc")));
    assert(!("".endsWith("c")));
    assert("".endsWith(""));
}

@test
void testAppendPrintable() {
    var b = StringBuf();
    b.append(0);
    assert(b == "0");
    b.append(-35);
    assert(b == "0-35");
    b.append(4.5);
    assert(b == "0-354.5");
    b.push('!');
    assert(b == "0-354.5!");
    b.append(" done");
    assert(b == "0-354.5! done");
    var s = StringBuf();
    s.append("abc");
    assert(s == "abc");
}

@test
void testFirstLast() {
    var s = "hello";

    assert(s.first() == 'h');
    assert(s.last() == 'o');

    var b = StringBuf("hi");
    assert(b.first() == 'h');
    assert(b.last() == 'i');
}

@test
void testStringBufPushPop() {
    var b = StringBuf();
    b.push('a');
    b.push('b');
    assert(b == "ab");

    assert(b.pop() == 'b');
    assert(b == "a");
    assert(b.removeFirst() == 'a');
    assert(b.empty());
}

@test
void testStringBufClear() {
    var prealloc = StringBuf(capacity = 100);
    assert(prealloc.capacity() >= 100);

    var b = StringBuf("hello");
    b.reserve(100);
    assert(b.capacity() >= 100);

    b.clear();
    assert(b.empty());
    assert(b.size() == 0);
    assert(b.capacity() >= 100);
    assert(b == "");

    b.push('x');
    assert(b == "x");
}
