// RUN: %not %cx run %s 2>&1 | %FileCheck %s

// CHECK-NOT: result-unwrap-err.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    var err = Result.Err<int, string>(error = "not a digit");
    unwrap(err);
}

// CHECK: called unwrap() on Err: not a digit
// CHECK-NOT: result-unwrap-err.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:
