// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testReadWriteFile() {
    var text = "The quick brown fox jumps over the lazy dog\n";
    bool success = File.write("test.txt", text);
    assert(success);
    var content = File.read("test.txt").unwrap();
    File.remove("test.txt");
    assert(string(content) == text);
}

@test
void testReadNonExistentFile() {
    var content = File.read("dog.txt");
    assert(content == Err);
}
