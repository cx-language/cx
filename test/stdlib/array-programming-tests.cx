// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s

void main() {
    testArrayArray();
    testBroadcast();
    testComparison();
    testIntArrays();
}

void testArrayArray() {
    float[3] a = [1.0, 2.0, 3.0];
    float[3] b = [4.0, 5.0, 6.0];
    float[3] c = a + b;
    assert(c[0] == 5.0);
    assert(c[1] == 7.0);
    assert(c[2] == 9.0);

    float[3] d = b - a;
    assert(d[0] == 3.0);
    assert(d[1] == 3.0);
    assert(d[2] == 3.0);

    float[3] e = a * b;
    assert(e[0] == 4.0);
    assert(e[1] == 10.0);
    assert(e[2] == 18.0);

    float[3] f = b / a;
    assert(f[0] == 4.0);
    assert(f[1] == 2.5);
    assert(f[2] == 2.0);
}

void testBroadcast() {
    float[3] a = [1.0, 2.0, 3.0];
    float[3] b = a * 2.0;
    assert(b[0] == 2.0);
    assert(b[1] == 4.0);
    assert(b[2] == 6.0);

    float[3] c = 10.0 - a;
    assert(c[0] == 9.0);
    assert(c[1] == 8.0);
    assert(c[2] == 7.0);

    float[3] d = a + 0.5;
    assert(d[0] == 1.5);
    assert(d[2] == 3.5);
}

void testComparison() {
    float[3] a = [1.0, 2.0, 3.0];
    float[3] b = [1.0, 2.0, 3.0];
    float[3] c = [1.0, 2.0, 4.0];
    assert(a == b);
    assert(!(a == c));
    assert(a != c);
    assert(!(a != b));

    // Broadcast comparison.
    float[2] d = [1.0, 1.0];
    assert(!(d == 2.0));
    assert(d != 2.0);
}

void testIntArrays() {
    int[3] a = [1, 2, 3];
    int[3] b = [4, 5, 6];
    int[3] c = a + b;
    assert(c[0] == 5);
    assert(c[2] == 9);

    int[3] d = b % a;
    assert(d[0] == 0);
    assert(d[1] == 1);
    assert(d[2] == 0);

    int[3] e = a & b;
    assert(e[0] == (1 & 4));
    assert(e[1] == (2 & 5));
}
