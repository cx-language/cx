// RUN: check_exit_status 0 %cx run -Werror %s

void main() {
    int v = 5;
    int w = 6;
    int*? p = &v;
    int*? n = null;
    assert(p == v);
    assert(!(p == w));
    assert(!(n == v));
    assert(!(p != v));
    assert(p != w);
    assert(n != v);
    // Value on the left resolves to the symmetric overloads, not ambiguously.
    assert(v == p);
    assert(!(w == p));
    assert(!(v == n));
    assert(!(v != p));
    assert(w != p);
    assert(v != n);
    // Value optionals compare in both orders too.
    int? o = 5;
    int? m = null;
    assert(o == v);
    assert(v == o);
    assert(!(o == w));
    assert(!(w == o));
    assert(!(m == v));
    assert(!(v == m));
    assert(o != w);
    assert(w != o);
    assert(m != v);
    assert(v != m);
}
