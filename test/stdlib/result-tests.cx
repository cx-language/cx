// RUN: check_exit_status 0 %cx test -Werror %s
// RUN: check_exit_status 0 %cx test -Werror --release %s

Result<int, string> parseDigit(char c) {
    if c >= '0' && c <= '9' {
        return Result.Ok(value = int(c) - int('0'));
    }
    return Result.Err(error = "not a digit");
}

@test
void testConstruction() {
    Result<int, string> inferred = Result.Ok(value = 1);
    assert(inferred == Ok);

    var explicit = Result.Ok<int, string>(value = 2);
    assert(explicit.unwrap() == 2);

    Result<int, string> fromDeclaredType = Result.Err(error = "boom");
    assert(fromDeclaredType == Err);

    var explicitErr = Result.Err<int, string>(error = "bang");
    assert(explicitErr == Err);
}

@test
void testCaseComparison() {
    var ok = parseDigit('7');
    var err = parseDigit('x');

    assert(ok == Ok);
    assert(ok != Err);
    assert(err == Err);
    assert(err != Ok);
    assert(!(ok == Err));
    assert(!(err == Ok));
    assert(ok == Result.Ok);
    assert(err == Result.Err);
}

@test
void testUnwrap() {
    assert(parseDigit('7').unwrap() == 7);
    assert(Result.Ok<int, int>(value = 42).unwrap() == 42);
}

@test
void testSwitch() {
    var ok = parseDigit('7');
    var err = parseDigit('x');

    switch (ok) {
        case Ok value:
            assert(value == 7);
        case Err:
            assert(false);
    }

    switch (err) {
        case Result.Ok:
            assert(false);
        case Result.Err error:
            assert(error == "not a digit");
    }
}

@test
void testPrint() {
    print(parseDigit('7'));
    print(parseDigit('x'));
}
