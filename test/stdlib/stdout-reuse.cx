// RUN: %cx test -Werror %s | %FileCheck -match-full-lines -strict-whitespace %s

void logLine<T: Printable>(T&... args) {
    var out = stdout();
    for arg in args {
        out.write(arg);
    }
    out.write("\n");
}

@test
void testStdoutReuse() {
    stdout().write("one\n"); // CHECK:one
    stdout().write("two\n"); // CHECK:two
    logLine("logline ", 1, " ", 2.5, " ", true); // CHECK:logline 1 2.5 true
    logLine("logline ", 2, " ", 3.5, " ", false); // CHECK:logline 2 3.5 false
    println("survived"); // CHECK:survived
    // CHECK:ok testStdoutReuse
}
