// RUN: check_exit_status 0 %cx test -Werror %s
// RUN: check_exit_status 0 %cx test -Werror --backend=c %s
// RUN: check_exit_status 0 %cx test -Werror --backend=c --c-dispatch %s

@test
void testWrappingAddSubMul() {
    assert(byte(255) +% 1 == 0);
    assert(byte(0) -% 1 == 255);
    assert(byte(200) *% 2 == 144);
    assert(int8(127) +% 1 == -128);
    assert(int8(-128) -% 1 == 127);
    assert(int8(64) *% 4 == 0);
    assert(2147483647 +% 1 == -2147483648);
    assert(uint(4294967295) +% uint(1) == uint(0));
    assert(uint(0) -% uint(1) == uint(4294967295));
}

@test
void testSaturatingAddSubMul() {
    assert(byte(255) +| 1 == 255);
    assert(byte(0) -| 1 == 0);
    assert(byte(200) *| 2 == 255);
    assert(int8(127) +| 1 == 127);
    assert(int8(-128) -| 1 == -128);
    assert(int8(100) +| 50 == 127);
    assert(int8(-100) +| -50 == -128);
    assert(int8(64) *| 4 == 127);
    assert(int8(-64) *| 4 == -128);
    assert(int8(-128) *| -1 == 127);
    assert(2147483647 +| 1 == 2147483647);
    assert(uint(0) -| uint(1) == uint(0));
}

@test
void testSaturating128() {
    // Limits spelled via shifts: integer literals max out at 64 bits.
    int128 smax = (int128(1) << int128(126)) +| (int128(1) << int128(126));
    int128 smin = -smax - int128(1);
    uint128 umax = uint128(-1);
    assert(smax +| int128(1) == smax);
    assert(smin -| int128(1) == smin);
    assert(smin +| int128(-1) == smin);
    assert((smax -| smax) +| smax == smax);
    assert(umax +| uint128(1) == umax);
    assert(uint128(0) -| uint128(1) == uint128(0));
    assert((int128(1) << int128(100)) *| (int128(1) << int128(100)) == smax);
    assert(umax *| umax == umax);
}

@test
void testWrappingNegation() {
    int8 min = -128;
    assert(-%min == -128);
    assert(-%int8(1) == -1);
    assert(-%byte(1) == 255);
    assert(-%byte(0) == 0);
}

@test
void testSaturatingShift() {
    assert(byte(1) <<| 8 == 255);
    assert(byte(1) <<| 3 == 8);
    assert(byte(0) <<| 8 == 0);
    assert(byte(200) <<| 1 == 255);
    assert(int8(1) <<| 7 == 127);
    assert(int8(-1) <<| 8 == -128);
    assert(int8(-64) <<| 1 == -128);
}

@test
void testCompoundAssignment() {
    var a = byte(255);
    a +%= 1;
    assert(a == 0);
    a = 255;
    a +|= 1;
    assert(a == 255);
    a = 200;
    a *%= 2;
    assert(a == 144);
    a = 200;
    a *|= 2;
    assert(a == 255);
    a = 0;
    a -%= 1;
    assert(a == 255);
    a = 0;
    a -|= 1;
    assert(a == 0);
    a = 1;
    a <<|= 8;
    assert(a == 255);
}

@test
void testRuntimeOperands() {
    byte x = 255;
    byte y = 1;
    assert(x +% y == 0);
    assert(x +| y == 255);
    x = 200;
    y = 2;
    assert(x *% y == 144);
    assert(x *| y == 255);
    int8 m = -128;
    assert(-%m == -128);
    byte s = 1;
    byte n = 8;
    assert(s <<| n == 255);
}

@test
void testConstants() {
    const byte maxu8 = 255;
    const byte wrapAdd = maxu8 +% 1;
    const byte satAdd = maxu8 +| 1;
    const byte twoHundred = 200;
    const byte wrapMul = twoHundred *% 2;
    const byte satMul = twoHundred *| 2;
    const int8 min8 = -128;
    const int8 wrapNeg = -%min8;
    const byte one = 1;
    const byte satShl = one <<| 8;
    assert(wrapAdd == 0);
    assert(satAdd == 255);
    assert(wrapMul == 144);
    assert(satMul == 255);
    assert(wrapNeg == -128);
    assert(satShl == 255);
}

@test
void testArrayProgramming() {
    byte[2] a = [255, 200];
    byte[2] wrap = a +% byte(1);
    assert(wrap[0] == 0);
    assert(wrap[1] == 201);
    byte[2] sat = a +| byte(1);
    assert(sat[0] == 255);
    assert(sat[1] == 201);
    byte[2] wrapMul = a *% byte(2);
    assert(wrapMul[0] == 254);
    assert(wrapMul[1] == 144);
    byte[2] satMul = a *| byte(2);
    assert(satMul[0] == 255);
    assert(satMul[1] == 255);
}

@test
void testInt64Wrapping() {
    int64 max = 9223372036854775807;
    assert(max +% 1 == -9223372036854775808);
    assert(max +| 1 == 9223372036854775807);
    uint64 umax = 18446744073709551615;
    assert(umax +% uint64(1) == uint64(0));
    assert(umax +| uint64(1) == umax);
}
