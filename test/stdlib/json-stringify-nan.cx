// RUN: %not %cx run %s 2>&1 | %FileCheck %s

// CHECK-NOT: json-stringify-nan.cx:{{[0-9]+}}:{{[0-9]+}}: {{(warning|error)}}:

void main() {
    var v = JsonValue.Number(0.0 / 0.0);
    print(v.toString());
}

// CHECK: JsonValue.Number must be finite
