// RUN: check_exit_status 0 %cx test -Werror %s
// RUN: check_exit_status 0 %cx test --backend=c -Werror %s

@test
void testFind() {
    var a = List<int>();
    assert(Slice(a).find(x => x == 1) == null);
    a.push(1);
    assert(Slice(a).find(x => x == 1)! == 1); // TODO: '!' shouldn't be required
    a.push(2);
    assert(Slice(a).find(x => x == 2)! == 2); // TODO: '!' shouldn't be required
    assert(Slice(a).find(x => x == 3) == null);
}

@test
void testEquality() {
    var x = List([1, 2, 3]);
    var y = List([1, 2, 3]);
    var rx = Slice(x);
    var ry = Slice(y);

    assert(rx == ry);
    assert(!(rx != ry));
    assert(x == y);

    y[0] = 99;
    assert(rx != ry);
    assert(!(rx == ry));
    assert(x != y);
}

@test
void testFirstLastContainsIndexOf() {
    var a = List([10, 20, 30]);
    var s = Slice(a);

    assert(s.first() == 10);
    assert(s.last() == 30);
    assert(s.contains(20));
    assert(!s.contains(99));
    assert(s.indexOf(10) == 0);
    assert(s.indexOf(30) == 2);
    assert(s.indexOf(99) == null);
}

@test
void testMapFilterChain() {
    var a = List([0, 1, 2, 3, 4]);
    var s = Slice(a);
    var b = List([5, 6]);

    var doubled = s.map(n => n * 2).toList();
    var expectedDoubled = List([0, 2, 4, 6, 8]);
    assert(doubled == expectedDoubled);
    var evens = s.filter(n => n % 2 == 0).toList();
    var expectedEvens = List([0, 2, 4]);
    assert(evens == expectedEvens);
    var incremented = s.map((int& n) => n + 1).toList();
    var expectedIncremented = List([1, 2, 3, 4, 5]);
    assert(incremented == expectedIncremented);
    var big = s.filter((int& n) => n > 2).toList();
    var expectedBig = List([3, 4]);
    assert(big == expectedBig);
    var chained = s.chain(b.iterator()).toList();
    var expectedChained = List([0, 1, 2, 3, 4, 5, 6]);
    assert(chained == expectedChained);

    var iterator = s.enumerate();
    assert(iterator.hasValue());
    assert(iterator.value().index == 0);
    assert(*iterator.value().value == 0);
    iterator.increment();
    assert(iterator.value().index == 1);
    assert(*iterator.value().value == 1);
}

@test
void testAllAnyNone() {
    var a = List([2, 4, 6]);
    var s = Slice(a);

    assert(s.all(n => n % 2 == 0));
    assert(!s.all(n => n > 4));
    assert(s.any(n => n == 4));
    assert(!s.any(n => n > 10));
    assert(s.none(n => n % 2 == 1));
    assert(!s.none(n => n == 2));

    assert(s.all((int& n) => n % 2 == 0));
    assert(s.any((int& n) => n == 6));
    assert(s.none((int& n) => n < 0));
}
