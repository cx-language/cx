// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run --backend=c -Werror %s

void main() {
    testFind();
    testEquality();
}

void testFind() {
    var a = List<int>();
    assert(Slice(a).find(x => x == 1) == null);
    a.push(1);
    assert(Slice(a).find(x => x == 1)! == 1); // TODO: '!' shouldn't be required
    a.push(2);
    assert(Slice(a).find(x => x == 2)! == 2); // TODO: '!' shouldn't be required
    assert(Slice(a).find(x => x == 3) == null);
}

void testEquality() {
    var x = List([1, 2, 3]);
    var y = List([1, 2, 3]);
    var rx = Slice(x);
    var ry = Slice(y);

    assert(rx == ry);
    assert(!(rx != ry));
    assert(x == y);

    y[0] = 99;
    assert(rx != ry);
    assert(!(rx == ry));
    assert(x != y);
}
