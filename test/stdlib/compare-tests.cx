// RUN: check_exit_status 0 %cx test -Werror %s

struct C: Comparable {
    int a;

    Ordering compare(C& other) {
        return this.a.compare(other.a);
    }
}

struct E: Equatable {
    int a;

    bool equals(E& other) {
        return this.a == other.a;
    }
}

@test
void testComparable() {
    var a = C(6);
    var b = C(99);

    assert(a <= b);
    assert(!(a >= b));
    assert(!(a > b));
    assert(a < b);
    assert(!(a == b));
    assert(a != b);
}

@test
void testEquatable() {
    var x = E(6);
    var y = E(99);
    var z = E(6);

    assert(!(x == y));
    assert(x != y);
    assert(x == z);
    assert(!(x != z));
}
