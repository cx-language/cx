// Leak check disabled: std fs functions build StringBuf(path) temporaries internally, and List<StringBuf> elements are never destroyed.
// RUN: check_exit_status 0 %cx test -Werror --no-leak-check %s

@test
void testExists() {
    assert(File.exists("."));
    assert(!File.exists("CX_DEFINITELY_MISSING_FILE_XYZ"));
}

@test
void testCreateListRenameRemove() {
    assert(File.createDirectory("cx_fs_test_dir"));
    assert(!File.createDirectory("cx_fs_test_dir"));
    assert(File.exists("cx_fs_test_dir"));
    assert(File.write("cx_fs_test_dir/a.txt", "hello"));
    assert(File.write("cx_fs_test_dir/b.txt", "world!"));

    var names = File.listDirectory("cx_fs_test_dir");
    assert(names.size() == 2);
    assert(string(names[0]) == "a.txt");
    assert(string(names[1]) == "b.txt");

    assert(File.rename("cx_fs_test_dir/a.txt", "cx_fs_test_dir/c.txt"));
    assert(!File.exists("cx_fs_test_dir/a.txt"));
    assert(File.exists("cx_fs_test_dir/c.txt"));

    assert(File.remove("cx_fs_test_dir/b.txt"));
    assert(File.remove("cx_fs_test_dir/c.txt"));
    assert(File.removeDirectory("cx_fs_test_dir"));
    assert(!File.exists("cx_fs_test_dir"));
}

@test
void testFileSize() {
    assert(File.write("cx_fs_test_size.txt", "hello"));
    assert(File.size("cx_fs_test_size.txt")! == 5);
    assert(File.remove("cx_fs_test_size.txt"));
    assert(File.size("CX_DEFINITELY_MISSING_FILE_XYZ") == null);
}

@test
void testCurrentAndChangeDirectory() {
    assert(File.createDirectory("cx_fs_test_cwd_dir"));
    assert(File.changeDirectory("cx_fs_test_cwd_dir"));
    assert(string(File.currentDirectory()).endsWith("cx_fs_test_cwd_dir"));
    assert(File.changeDirectory(".."));
    assert(File.removeDirectory("cx_fs_test_cwd_dir"));
}

@test
void testListMissingDirectory() {
    assert(File.listDirectory("CX_DEFINITELY_MISSING_DIR_XYZ").size() == 0);
}
