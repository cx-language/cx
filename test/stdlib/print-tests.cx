// RUN: %cx run -Werror %s | %FileCheck -match-full-lines %s

struct A: Printable {
    string a;

    void print(StringBuffer* stream) {
        stream.write(a);
        stream.write(a);
        stream.write("!");
    }
}

void main() {
    println(true); // CHECK: true
    println(false); // CHECK-NEXT: false
    println(A("foo")); // CHECK-NEXT: foofoo!
    println(0.1 + 0.2); // CHECK-NEXT: 0.3
    println("f", 0, '0'); // CHECK-NEXT: f00
    println([1, 2, 3]); // CHECK-NEXT: [1, 2, 3]
    println(List([1, 2, 3])); // CHECK-NEXT: [1, 2, 3]
    println(List([1])); // CHECK-NEXT: [1]
    println(List<int>()); // CHECK-NEXT: []
    Optional<int> empty = Optional.None;
    println(empty); // CHECK-NEXT: null
    println(Optional.Some(value = 42)); // CHECK-NEXT: 42
    println(0); // CHECK-NEXT: 0
    println(-1); // CHECK-NEXT: -1
    println(int64_min); // CHECK-NEXT: -9223372036854775808
    println(uint64_max); // CHECK-NEXT: 18446744073709551615
}
