// RUN: %cx test -Werror %s | %FileCheck -match-full-lines %s

@test
void testSum() {
    println(List([1, 2, 3]).sum()); // CHECK: 6
    var three = List([1, 2, 3]);
    println(three.sum()); // CHECK-NEXT: 6
    println(List([1.5, 2.5]).sum()); // CHECK-NEXT: 4
    println(List([-1, 1]).sum()); // CHECK-NEXT: 0
    println(List([7]).sum()); // CHECK-NEXT: 7
    var arr = [10, 20, 30];
    println(arr.sum()); // CHECK-NEXT: 60
    println(Slice(three).sum()); // CHECK-NEXT: 6
    println((1..4).sum()); // CHECK-NEXT: 6
    println(ClosedRange(1, 3).sum()); // CHECK-NEXT: 6
    var set = Set<int>();
    set.insert(4);
    set.insert(5);
    println(set.sum()); // CHECK-NEXT: 9
    var ordered = OrderedSet<int>();
    ordered.insert(4);
    ordered.insert(5);
    println(ordered.sum()); // CHECK-NEXT: 9
    var small = SmallList<int, 4>();
    small.push(1);
    small.push(2);
    println(small.sum()); // CHECK-NEXT: 3
    println(List([1, 2, 3, 4]).filter(n => n % 2 == 0).sum()); // CHECK-NEXT: 6
    println(List([1, 2]).map(n => n * 10).sum()); // CHECK-NEXT: 30
    println(List([1, 2]).chain(List([3, 4]).iterator()).sum()); // CHECK-NEXT: 10
    // Empty containers sum to zero instead of aborting.
    println(List<int>().sum()); // CHECK-NEXT: 0
    println(List<int>().filter(n => true).sum()); // CHECK-NEXT: 0
    println((3..0).sum()); // CHECK-NEXT: 0
    println(Set<int>().sum()); // CHECK-NEXT: 0
    println(List([int8(1), int8(2)]).sum()); // CHECK-NEXT: 3
    println("ABC".bytes().sum()); // CHECK-NEXT: 198
    println(RepeatIterator(3, 4).sum()); // CHECK-NEXT: 12
    // Partially consumed iterators sum only the remainder.
    var it = List([1, 2, 3]).iterator();
    it.increment();
    println(it.sum()); // CHECK-NEXT: 5
    // CHECK-NEXT: ok testSum
}
