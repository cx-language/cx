// RUN: %cx test %s | %FileCheck %s

bool isEven(int& n) {
    return n % 2 == 0;
}

@test
void testFilterMap() {
    var numbers = List([0, 1, 2, 3, 4]);

    var even = numbers.filter(isEven).toList();
    // CHECK: [0, 2, 4]
    println(even);

    var doubled = even.map(n => n * 2).toList();
    // CHECK-NEXT: [0, 4, 8]
    // CHECK-NEXT: ok testFilterMap
    println(doubled);
}

@test
void testMapOwningOutput() {
    var strings = List([1, 2]).map(n => StringBuf("x"));
    // CHECK-NEXT: x
    println(strings.value());
    strings.increment();
    // CHECK-NEXT: x
    println(strings.value());
    strings.increment();
    // An empty source never fills the cache; destroying it must be clean too.
    var empty = List<int>().map(n => StringBuf("y"));
    assert(!empty.hasValue());
    // CHECK-NEXT: ok testMapOwningOutput
}
