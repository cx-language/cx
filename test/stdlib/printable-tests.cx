// RUN: check_exit_status 0 %cx test -Werror %s

struct A: Printable {
    string a;
    string b;

    void print(OutputStream& stream) {
        stream.append(a);
        stream.append("+");
        stream.append(b);
    }
}

@test
void testCustomPrintableStruct() {
    var text = A("foo", "bar").toString();
    assert(string(text) == "foo+bar");
}

struct Point {
    int x;
    int y;
}

struct Line {
    Point a;
    Point b;
    string label;
}

struct Pair<T> {
    T first;
    T second;
}

struct Node {
    int value;
    Node*? next;
}

@test
void testSynthesizedStructPrint() {
    assert(string(Point(1, 2).toString()) == "Point(x: 1, y: 2)");
    assert(string(Line(Point(0, 0), Point(3, 4), "diag").toString()) == "Line(a: Point(x: 0, y: 0), b: Point(x: 3, y: 4), label: diag)");
}

@test
void testSynthesizedGenericStructPrint() {
    assert(string(Pair<int>(1, 2).toString()) == "Pair(first: 1, second: 2)");
    var nested = Pair<Point>(Point(1, 1), Point(2, 2));
    assert(string(nested.toString()) == "Pair(first: Point(x: 1, y: 1), second: Point(x: 2, y: 2))");
}

@test
void testSynthesizedNullableFieldPrint() {
    assert(string(Node(2, null).toString()) == "Node(value: 2, next: null)");
    var tail = Node(2, null);
    assert(string(Node(1, &tail).toString()) == "Node(value: 1, next: Node(value: 2, next: null))");
}

@test
void testPrintDoesNotMove() {
    var buf = StringBuf("hello");
    print(buf);
    println(buf);
    println(buf, buf);
    assert(string(buf) == "hello");
}

@test
void testSynthesizedStructInContainerPrint() {
    var list = List<Point>();
    list.push(Point(5, 6));
    list.push(Point(7, 8));
    var buf = StringBuf();
    var stream = OutputStream(&buf);
    list.print(stream);
    assert(string(buf) == "[Point(x: 5, y: 6), Point(x: 7, y: 8)]");
}

enum Color {
    Red,
    Green,
}

enum Outcome<T> {
    Ok(T value),
    Err(int code),
}

enum Event {
    Click(int x, int y),
    Quit,
}

enum MaybeName {
    Name(string? value),
    Anonymous,
}

enum ClickEvent {
    Click(int? x, int y),
    Miss,
}

@test
void testSynthesizedEnumPrint() {
    assert(string(Color.Red.toString()) == "Red");
    assert(string(Event.Quit.toString()) == "Quit");
    assert(string(Event.Click(x = 3, y = 4).toString()) == "Click(3, 4)");
    assert(string(ClickEvent.Click(x = 1, y = 2).toString()) == "Click(1, 2)");
    assert(string(ClickEvent.Click(x = null, y = 2).toString()) == "Click(null, 2)");
    assert(string(Outcome.Ok("hi").toString()) == "Ok(hi)");
    assert(string(Outcome.Err<string>(1).toString()) == "Err(1)");
    assert(string(MaybeName.Name("Bo").toString()) == "Name(Bo)");
    assert(string(MaybeName.Name(null).toString()) == "Name(null)");
}

@test
void testSynthesizedEnumInContainerPrint() {
    var list = List<Color>();
    list.push(Color.Red);
    list.push(Color.Green);
    var buf = StringBuf();
    var stream = OutputStream(&buf);
    list.print(stream);
    assert(string(buf) == "[Red, Green]");
}

enum HasList {
    Hold(List<int> items),
    Empty,
}

@test
void testSynthesizedEnumPrintDoesNotMove() {
    var event = HasList.Hold(List([1, 2]));
    print(event);
    println(event);
    assert(string(event.toString()) == "Hold([1, 2])");
}

@test
void testIteratorPrint() {
    assert(string((0..3).iterator().toString()) == "[0, 1, 2]");
    assert(string((0..0).iterator().toString()) == "[]");
    assert(string(Slice(List([1, 2])).iterator().toString()) == "[1, 2]");
    assert(string(List([1, 2, 3, 4]).filter(n => n % 2 == 0).toString()) == "[2, 4]");
    assert(string(List([1, 2]).map(n => n * 10).toString()) == "[10, 20]");
    assert(string(RepeatIterator(7, 2).toString()) == "[7, 7]");
    assert(string("abc".iterator().toString()) == "[a, b, c]");
    var rest = (0..3).iterator();
    rest.increment();
    assert(string(rest.toString()) == "[1, 2]");
    var keep = (0..3).iterator();
    assert(string(keep.toString()) == "[0, 1, 2]");
    assert(string(keep.toString()) == "[0, 1, 2]");
    var keepPrint = (0..2).iterator();
    println(keepPrint);
    assert(string(keepPrint.toString()) == "[0, 1]");
}
