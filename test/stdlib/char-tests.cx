// RUN: check_exit_status 0 %cx test -Werror %s

@test
void testIsAlpha() {
    assert('a'.isAlpha());
    assert('z'.isAlpha());
    assert('A'.isAlpha());
    assert('Z'.isAlpha());
    assert(!'_'.isAlpha());
}

@test
void testIsDigit() {
    assert('0'.isDigit());
    assert('9'.isDigit());
    assert(!'A'.isDigit());
}

@test
void testIsWhitespace() {
    assert(' '.isWhitespace());
    assert('\t'.isWhitespace());
    assert('\n'.isWhitespace());
    assert('\r'.isWhitespace());
    assert(!'\0'.isWhitespace());
}
