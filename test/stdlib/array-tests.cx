// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s

void main() {
    testConstruction();
    testSize();
    testIndex();
    testIteration();
    testDistinctSizes();
    testNested();
    testInference();
}

void testConstruction() {
    var a = Array<int, 3>(elements = [10, 20, 30]);
    assert(a.size() == 3);
    assert(a[0] == 10);
    assert(a[2] == 30);
}

void testSize() {
    var one = Array(elements = [1]);
    assert(one.size() == 1);
    var five = Array<int, 5>(elements = [1, 2, 3, 4, 5]);
    assert(five.size() == 5);
}

void testIndex() {
    var a = Array<int, 3>(elements = [10, 20, 30]);
    a[1] = 99;
    assert(a[1] == 99);
    assert(a.data()[0] == 10);
    assert(a.data()[2] == 30);
}

void testIteration() {
    var a = Array<int, 3>(elements = [10, 20, 30]);
    var total = 0;
    for x in a {
        total += x;
    }
    assert(total == 60);
}

void testDistinctSizes() {
    var two = Array<int, 2>(elements = [1, 2]);
    var three = Array<int, 3>(elements = [1, 2, 3]);
    assert(two.size() == 2);
    assert(three.size() == 3);
}

void testNested() {
    var m = Array<Array<int, 2>, 2>(elements = [Array(elements = [1, 2]), Array(elements = [3, 4])]);
    assert(m.size() == 2);
    assert(m[0][1] == 2);
    assert(m[1][0] == 3);
}

int sumArray<T, int N>(Array<T, N> a) {
    var total = 0;
    for x in a.elements {
        total += x;
    }
    return total;
}

void testInference() {
    assert(sumArray(Array<int, 3>(elements = [10, 20, 30])) == 60);
    assert(sumArray(Array<int, 2>(elements = [1, 2])) == 3);
}
