// RUN: check_exit_status 0 %cx run -Werror %s
// RUN: check_exit_status 0 %cx run -Werror --backend=c %s

void main() {
    testConstruction();
    testSize();
    testIndex();
    testIteration();
    testDistinctSizes();
    testNested();
    testInference();
    testValueConstruction();
    testDot();
    testLength();
    testNormalized();
    testCross();
    testPointerElements();
    testConst();
    testFirstLastContainsIndexOf();
    testFindMapFilter();
    testChainEnumerate();
    testAllAnyNone();
}

void testConstruction() {
    int[3] a = [10, 20, 30];
    assert(a.size() == 3);
    assert(a[0] == 10);
    assert(a[2] == 30);
}

void testSize() {
    int[1] one = [1];
    assert(one.size() == 1);
    int[5] five = [1, 2, 3, 4, 5];
    assert(five.size() == 5);
}

void testIndex() {
    int[3] a = [10, 20, 30];
    a[1] = 99;
    assert(a[1] == 99);
    assert(a.data()[0] == 10);
    assert(a.data()[2] == 30);
}

void testIteration() {
    int[3] a = [10, 20, 30];
    var total = 0;
    for x in a {
        total += x;
    }
    assert(total == 60);
}

void testDistinctSizes() {
    int[2] two = [1, 2];
    int[3] three = [1, 2, 3];
    assert(two.size() == 2);
    assert(three.size() == 3);
}

void testNested() {
    int[2][2] m = [[1, 2], [3, 4]];
    assert(m.size() == 2);
    assert(m[0][1] == 2);
    assert(m[1][0] == 3);
}

int sumArray<T, int N>(Array<T, N> a) {
    var total = 0;
    for x in a {
        total += x;
    }
    return total;
}

int firstElement<T>(T[*] a) {
    return a[0];
}

int genericSize<T, int N>(T[N] a) {
    return a.size() + a[0];
}

int[2] makeArray() {
    return [10, 20];
}

int firstOrNegative(int[*]? p) {
    if (p == null) return -1;
    return p[0];
}

void testInference() {
    int[3] a3 = [10, 20, 30];
    int[2] a2 = [1, 2];
    assert(sumArray(a3) == 60);
    assert(sumArray(a2) == 3);
    assert(firstElement(a3) == 10);
    assert(firstElement(a2) == 1);
    assert(genericSize(a3) == 13);
    assert(genericSize(a2) == 3);
    assert(makeArray()[1] == 20);
}

void testValueConstruction() {
    int[3] constructed = Array();
    assert(constructed.size() == 3);

    int[*] p = [4, 5, 6];
    assert(p[1] == 5);

    int[*]? optional = [8, 9];
    if (optional != null) assert(optional[0] == 8);
    assert(firstOrNegative([]) == -1);

    int[0] empty = [];
    assert(empty == empty);
    assert(!(empty != 1));

    int[2] source = [7, 8];
    const int[2] destination = source;
    assert(destination[1] == 8);
    const int[*] constData = source;
    assert(constData[1] == 8);

    const int[2] c = [1, 2];
    assert(c.data()[0] == 1);
    int[2] m = [3, 4];
    m.data()[0] = 5;
    assert(m[0] == 5);
}

void testDot() {
    float[2] a = [1.0, 2.0];
    float[2] b = [3.0, 4.0];
    assert(a.dot(b) == 11.0);
    int[2] ai = [1, 2];
    int[2] bi = [3, 4];
    assert(ai.dot(bi) == 11);
    float[3] c = [1.0, 2.0, 3.0];
    float[3] d = [4.0, 5.0, 6.0];
    assert(c.dot(d) == 32.0);
}

void testLength() {
    float[2] a = [3.0, 4.0];
    assert(a.length() == 5.0);
    int[2] ai = [3, 4];
    assert(ai.length() == 5.0);
    float[3] b = [1.0, 2.0, 2.0];
    assert(b.length() == 3.0);
}

void testNormalized() {
    float[2] a = [3.0, 4.0];
    var n = a.normalized();
    assert(n[0] == 0.6 && n[1] == 0.8);
    assert(a[0] == 3.0 && a[1] == 4.0);
    float[3] b = [1.0, 2.0, 2.0];
    var m = b.normalized();
    assert(m[2] == m[1] && m[1] == 2.0 * m[0]);
}

void testCross() {
    float[3] x = [1.0, 0.0, 0.0];
    float[3] y = [0.0, 1.0, 0.0];
    var z = cross(x, y);
    assert(z[0] == 0.0 && z[1] == 0.0 && z[2] == 1.0);
    int[3] xi = [1, 0, 0];
    int[3] yi = [0, 1, 0];
    var zi = cross(xi, yi);
    assert(zi[0] == 0 && zi[1] == 0 && zi[2] == 1);
}

void testPointerElements() {
    // Instantiating generic Array methods with a non-basic element type must not crash.
    var x = 1;
    var y = 2;
    int*[2] ptrs = [&x, &y];
    assert(ptrs.size() == 2);
    assert(ptrs[0] == &x);
    assert(ptrs[1] == &y);
}

void testConst() {
    const float[2] a = [3.0, 4.0];
    const float[2] b = [1.0, 2.0];
    assert(a.dot(b) == 11.0);
    assert(a.length() == 5.0);
    var n = a.normalized();
    assert(n[0] == 0.6 && n[1] == 0.8);
    const float[3] x = [1.0, 0.0, 0.0];
    const float[3] y = [0.0, 1.0, 0.0];
    var z = cross(x, y);
    assert(z[0] == 0.0 && z[1] == 0.0 && z[2] == 1.0);
}

void testFirstLastContainsIndexOf() {
    int[3] a = [10, 20, 30];

    assert(a.first() == 10);
    assert(a.last() == 30);
    assert(a.contains(20));
    assert(!a.contains(99));
    assert(a.indexOf(10) == 0);
    assert(a.indexOf(30) == 2);
    assert(a.indexOf(99) == a.size());
}

void testFindMapFilter() {
    int[5] a = [0, 1, 2, 3, 4];

    assert(a.find(x => x == 2)! == 2); // TODO: '!' shouldn't be required
    assert(a.find(x => x == 9) == null);
    assert(a.map(n => n * 2).toList() == List([0, 2, 4, 6, 8]));
    assert(a.filter(n => n % 2 == 0).toList() == List([0, 2, 4]));
    assert(a.map((int& n) => n + 1).toList() == List([1, 2, 3, 4, 5]));
    assert(a.filter((int& n) => n > 2).toList() == List([3, 4]));
}

void testChainEnumerate() {
    int[2] a = [1, 2];
    int[2] b = [3, 4];

    assert(a.chain(b.iterator()).toList() == List([1, 2, 3, 4]));

    var iterator = a.enumerate();
    assert(iterator.hasValue());
    assert(iterator.value().index == 0);
    assert(*iterator.value().value == 1);
    iterator.increment();
    assert(iterator.value().index == 1);
    assert(*iterator.value().value == 2);
    iterator.increment();
    assert(!iterator.hasValue());
}

void testAllAnyNone() {
    int[3] a = [2, 4, 6];

    assert(a.all(n => n % 2 == 0));
    assert(!a.all(n => n > 4));
    assert(a.any(n => n == 4));
    assert(!a.any(n => n > 10));
    assert(a.none(n => n % 2 == 1));
    assert(!a.none(n => n == 2));

    assert(a.all((int& n) => n % 2 == 0));
    assert(a.any((int& n) => n == 6));
    assert(a.none((int& n) => n < 0));
}
