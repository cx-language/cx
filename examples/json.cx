// Read render settings out of a JSON blob.
void main() {
    var text = "\{\"width\": 1920, \"height\": 1080}";
    var config = parseJson(text).unwrap();
    switch config {
        case Object members:
            for m in members {
                println(m.key, " = ", m.value);
            }
        default:
            println("expected a JSON object");
    }
}
