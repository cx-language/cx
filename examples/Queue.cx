import "string.h";

/// First-in-first-out data structure
struct Queue<T> {
    private Node<T>*? head;
    private Node<T>*? tail;
    private int size;

    /// Initialize an empty Queue
    Queue() {
        head = null;
        tail = null;
        size = 0;
    }

    /// Frees all nodes.
    ~Queue() {
        clear();
    }

    /// Moves the queue out, leaving an empty queue in its place.
    Queue<T> take() {
        return takeFrom(this, Queue());
    }

    /// Removes all elements from the queue.
    void clear() {
        while !empty() {
            var node = head!;
            var next = node.next;
            node.value.deinit();
            deallocate(node);
            head = next;
        }
        tail = null;
        size = 0;
    }

    /// Add to the back of the queue
    void push(T value) {
        var newNode = allocateValue(Node(value));

        if empty() {
            head = newNode;
            tail = newNode;
        } else {
            tail!.next = newNode;
            tail = newNode;
        }

        size++;
    }

    /// Retrieve and remove head of the queue
    T pop() {
        if empty() abort("Called pop() on empty Queue\n");
        // The node is deallocated below, so the value moves out of the dead
        // storage directly; no default is left behind.
        var h = head!;
        T value = undefined;
        memcpy(&value, &h.value, sizeof(T));
        var next = h.next;
        deallocate(h);
        head = next;

        if head == null {
            tail = null;
        }

        size--;
        return value;
    }

    /// Access element in the front of the queue
    T& first() {
        if empty() abort("Called first() on empty Queue\n");
        return head!.value;
    }

    /// Returns the number of elements in the queue
    int size() {
        return size;
    }

    /// Check if queue is empty
    bool empty() {
        return head == null;
    }
}

/// One element of a queue.
struct Node<T> {
    private Node<T>*? next;
    private T value;

    /// Initializes a node holding the given value.
    Node(T val) {
        this.value = val;
        this.next = null;
    }
}

@test
void testPushPop() {
    var q = Queue<int>();

    assert(q.size() == 0);
    q.push(23);
    q.push(48);

    assert(q.size() == 2);

    var elem = q.pop();
    assert(q.size() == 1);
    assert(elem == 23);

    elem = q.pop();

    assert(elem == 48);
    assert(q.size() == 0);
}

@test
void testEmpty() {
    var q = Queue<string>();

    assert(q.empty());

    q.push("foo");
    assert(!q.empty());
    q.push("bar");
    assert(!q.empty());
    q.pop();
    q.pop();
    assert(q.empty());
}

@test
void testPushAfterPop() {
    var q = Queue<string>();

    q.push("foo");
    assert(q.size() == 1);
    q.pop();
    assert(q.size() == 0);
    q.push("bar");
    assert(q.size() == 1);
    q.pop();
    assert(q.size() == 0);
}

@test
void testFirst() {
    var q = Queue<string>();

    q.push("foo");
    q.push("bar");
    assert(q.first() == "foo");
    assert(q.pop() == "foo");
    assert(q.first() == "bar");
    assert(q.pop() == "bar");
}

@test
void testClear() {
    var q = Queue<string>();
    q.push("foo");
    q.push("bar");

    q.clear();
    assert(q.size() == 0);
    assert(q.empty());

    q.push("baz");
    assert(q.first() == "baz");
    assert(q.pop() == "baz");
    assert(q.empty());
}

@test
void testOwningValues() {
    var q = Queue<StringBuf>();
    q.push(StringBuf("a"));
    q.push(StringBuf("bb"));
    assert(string(q.pop()) == "a");

    q.push(StringBuf("ccc"));
    q.clear();
    assert(q.empty());

    // Destroyed with entries still in it.
    q.push(StringBuf("dd"));
    assert(string(q.first()) == "dd");
}
