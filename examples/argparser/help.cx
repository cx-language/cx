// Help text generation for argparser. See argparser.cx for the API overview.

private StringBuf flagLeftCell(FlagSpec& spec) {
    var cell = StringBuf("  ");
    if spec.shortName.size() > 0 {
        cell.append("-");
        cell.append(spec.shortName);
        cell.append(", ");
    }
    cell.append("--");
    cell.append(spec.name);
    return cell;
}

private StringBuf optionLeftCell(OptionSpec& spec) {
    var cell = flagLeftCellFor(spec.shortName, spec.name);
    cell.append(" ");
    cell.append(spec.valueName);
    return cell;
}

private StringBuf intOptionLeftCell(IntOptionSpec& spec) {
    var cell = flagLeftCellFor(spec.shortName, spec.name);
    cell.append(" ");
    cell.append(spec.valueName);
    return cell;
}

private StringBuf flagLeftCellFor(string shortName, string name) {
    var cell = StringBuf("  ");
    if shortName.size() > 0 {
        cell.append("-");
        cell.append(shortName);
        cell.append(", ");
    }
    cell.append("--");
    cell.append(name);
    return cell;
}

private bool setHasOptions(OptionSet& set) {
    return set.flags.size() > 0 || set.options.size() > 0 || set.intOptions.size() > 0;
}

// Appends "[options]", "<REQ>", "[OPT]" fragments for the set to buf.
private void writeUsageArgs(StringBuf& buf, OptionSet& set) {
    if setHasOptions(set) {
        buf.append(" [options]");
    }
    for p in set.positionals {
        buf.append(" ");
        if p.required {
            buf.append("<");
            buf.append(p.name);
            buf.append(">");
        } else {
            buf.append("[");
            buf.append(p.name);
            buf.append("]");
        }
    }
}

// Width of the widest option row, including the auto-generated help row.
private int optionSectionWidth(OptionSet& set) {
    var width = 10; // "  -h, --help"
    for f in set.flags {
        var cell = flagLeftCell(f);
        if cell.size() > width {
            width = cell.size();
        }
    }
    for o in set.options {
        var cell = optionLeftCell(o);
        if cell.size() > width {
            width = cell.size();
        }
    }
    for o in set.intOptions {
        var cell = intOptionLeftCell(o);
        if cell.size() > width {
            width = cell.size();
        }
    }
    return width;
}

private void writePaddedRow(StringBuf& buf, string left, string help, int width) {
    buf.append(left);
    buf.append(" ".repeat(width - left.size() + 2));
    buf.append(help);
    buf.append("\n");
}

private void writeOptionsSection(StringBuf& buf, OptionSet& set) {
    buf.append("Options:\n");
    var width = optionSectionWidth(set);
    for f in set.flags {
        var cell = flagLeftCell(f);
        writePaddedRow(buf, cell.substr(0), f.help, width);
    }
    for o in set.options {
        var cell = optionLeftCell(o);
        writePaddedRow(buf, cell.substr(0), o.help, width);
    }
    for o in set.intOptions {
        var cell = intOptionLeftCell(o);
        writePaddedRow(buf, cell.substr(0), o.help, width);
    }
    writePaddedRow(buf, "  -h, --help", "Show this help message and exit.", width);
}

private void writeArgumentsSection(StringBuf& buf, OptionSet& set) {
    if set.positionals.size() == 0 {
        return;
    }
    buf.append("\nArguments:\n");
    var width = 0;
    for p in set.positionals {
        var w = p.name.size() + 2;
        if w > width {
            width = w;
        }
    }
    for p in set.positionals {
        var left = StringBuf("  ") + p.name;
        if p.required {
            writePaddedRow(buf, left.substr(0), p.help, width);
        } else {
            var help = StringBuf(p.help) + " (optional)";
            writePaddedRow(buf, left.substr(0), help.substr(0), width);
        }
    }
}

// Full help text for the program: usage, description, commands, options.
StringBuf helpText(ArgParser& parser) {
    var buf = StringBuf("Usage: ");
    buf.append(parser.name);
    if parser.commands.size() > 0 {
        buf.append(" [options] <command> [<args>]");
    } else {
        writeUsageArgs(buf, parser.options);
    }
    buf.append("\n");
    if parser.description.size() > 0 {
        buf.append("\n");
        buf.append(parser.description);
        buf.append("\n");
    }
    if parser.commands.size() > 0 {
        buf.append("\nCommands:\n");
        var width = 0;
        for c in parser.commands {
            var w = c.name.size() + 2;
            if w > width {
                width = w;
            }
        }
        for c in parser.commands {
            var left = StringBuf("  ") + c.name;
            writePaddedRow(buf, left.substr(0), c.help, width);
        }
        buf.append("\nRun '");
        buf.append(parser.name);
        buf.append(" <command> --help' for command-specific help.\n");
    }
    buf.append("\n");
    writeOptionsSection(buf, parser.options);
    writeArgumentsSection(buf, parser.options);
    return buf;
}

// Help text for one subcommand.
StringBuf commandHelpText(ArgParser& parser, CommandSpec& cmd) {
    var buf = StringBuf("Usage: ");
    buf.append(parser.name);
    buf.append(" ");
    buf.append(cmd.name);
    writeUsageArgs(buf, cmd.options);
    buf.append("\n");
    if cmd.help.size() > 0 {
        buf.append("\n");
        buf.append(cmd.help);
        buf.append("\n");
    }
    buf.append("\n");
    writeOptionsSection(buf, cmd.options);
    writeArgumentsSection(buf, cmd.options);
    return buf;
}
