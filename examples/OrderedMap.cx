/// An ordered key-value container that supports fast insertion, deletion and lookup
struct OrderedMap<Key, Value> {
    private AVLnode<Key, Value>*? root;
    private int size;

    /// Initializes an empty map.
    OrderedMap() {
        root = null;
        size = 0;
    }

    /// Frees all nodes.
    ~OrderedMap() {
        clear();
    }

    /// Moves the map out, leaving an empty map in its place.
    OrderedMap<Key, Value> take() {
        return takeFrom(this, OrderedMap());
    }

    /// Removes all entries from the map.
    void clear() {
        if root != null {
            root.deallocate();
            root = null;
        }
        size = 0;
    }

    /// Returns true if all entries satisfy the predicate.
    bool all(bool(MapEntry<Key, Value>&) predicate) { return all(iterator(), predicate); }

    /// Returns true if all entries satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }

    /// Returns true if any entry satisfies the predicate.
    bool any(bool(MapEntry<Key, Value>&) predicate) { return any(iterator(), predicate); }

    /// Returns true if any entry satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }

    /// Returns true if no entry satisfies the predicate.
    bool none(bool(MapEntry<Key, Value>&) predicate) { return none(iterator(), predicate); }

    /// Returns true if no entry satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    /// Returns the size of the Map
    int size() {
        return size;
    }

    /// Returns true if the Map is empty, otherwise false
    bool empty() {
        return size == 0;
    }

    private void rebalance(AVLnode<Key, Value>* node) {
        var n = node;
        setBalance(n);

        if n.balance == -2 {
            if height(n.left!.left) >= height(n.left.right) {
                n = rotateRight(n);
            } else {
                n = rotateLeftThenRight(n);
            }
        } else if n.balance == 2 {
            if height(n.right!.right) >= height(n.right.left) {
                n = rotateLeft(n);
            } else {
                n = rotateRightThenLeft(n);
            }
        }

        if n.parent != null {
            rebalance(n.parent);
        } else {
            root = n;
        }
    }

    private AVLnode<Key, Value>* rotateLeft(AVLnode<Key, Value>* node) {
        var a = node;
        var b = a.right!;
        b.parent = a.parent;
        a.right = b.left;

        if a.right != null {
            a.right.parent = a;
        }

        b.left = a;
        a.parent = b;

        if b.parent != null {
            if b.parent.right == a {
                b.parent.right = b;
            } else {
                b.parent.left = b;
            }
        }

        setBalance(a);
        setBalance(b);
        return b;
    }

    private AVLnode<Key, Value>* rotateRight(AVLnode<Key, Value>* node) {
        var a = node;
        var b = a.left!;
        b.parent = a.parent;
        a.left = b.right;

        if a.left != null {
            a.left.parent = a;
        }

        b.right = a;
        a.parent = b;

        if b.parent != null {
            if b.parent.right == a {
                b.parent.right = b;
            } else {
                b.parent.left = b;
            }
        }

        setBalance(a);
        setBalance(b);
        return b;
    }

    private AVLnode<Key, Value>* rotateLeftThenRight(AVLnode<Key, Value>* n) {
        n.left = rotateLeft(n.left!);
        return rotateRight(n);
    }

    private AVLnode<Key, Value>* rotateRightThenLeft(AVLnode<Key, Value>* n) {
        n.right = rotateRight(n.right!);
        return rotateLeft(n);
    }

    private int height(AVLnode<Key, Value>*? n) {
        if n == null {
            return -1;
        }
        return 1 + max(height(n.left), height(n.right));
    }

    private void setBalance(AVLnode<Key, Value>* n) {
        n.balance = height(n.right) - height(n.left);
    }

    /// Checks if the given element is in the Map. Returns true if it is, otherwise false
    bool contains(Key& key) {
        return findNode(key) != null;
    }

    /// Returns the value of the given key, if it exists in the Map. Otherwise, returns null.
    Value&? operator[](Key& key) {
        var found = findNode(key);
        if found != null {
            return found.entry.value;
        }
        return null;
    }

    /// Inserts a key-value pair into the Map.
    bool insert(Key key, Value value) {
        if root == null {
            root = allocateValue(AVLnode(key, null, value));
        } else {
            // Find the insertion point first without moving anything; the key and value move
            // below on all paths, since values moved on only one path are still destroyed at
            // scope end.
            var n = root;
            var parent = n;
            var goLeft = false;

            while true {
                if n.entry.key == key {
                    return false;
                }

                parent = n;
                goLeft = n.entry.key > key;
                var newNode = goLeft ? n.left : n.right;

                if newNode == null {
                    break;
                }
                n = newNode;
            }

            if goLeft {
                parent.left = allocateValue(AVLnode<Key, Value>(key, parent, value)); // TODO: Should work without specifying generic arguments.
            } else {
                parent.right = allocateValue(AVLnode<Key, Value>(key, parent, value));
            }

            rebalance(parent);
        }

        size++;
        return true;
    }

    /// Removes a key and its associated value from the map, returning the value, or null if it isn't there.
    Value? remove(Key& key) {
        if root == null {
            return null;
        }

        var n = root;
        var parent = root;
        AVLnode<Key, Value>*? delNode = null;
        AVLnode<Key, Value>*? child = root;

        while child != null {
            parent = n;
            n = child;
            child = *key >= n.entry.key ? n.right : n.left;
            if *key == n.entry.key {
                delNode = n;
            }
        }

        if delNode != null {
            // Move the value out; destroy the old key; shuffle the successor
            // entry into delNode (skipped when delNode is n); free n raw.
            var dead = n!;
            Value removedValue = undefined;
            (&removedValue).init((*delNode).entry.value);
            delNode.entry.key.deinit();
            if delNode != n {
                (&(*delNode).entry.key).init((*n).entry.key);
                (&(*delNode).entry.value).init((*n).entry.value);
            }

            child = n.left != null ? n.left : n.right;

            // n ends at root only when the search never descends, so delNode
            // is root too (keys are unique). Keys can't be compared: dead.
            if root == n {
                root = child;
                if child != null {
                    child.parent = null;
                }
            } else {
                if parent.left == n {
                    parent.left = child;
                } else {
                    parent.right = child;
                }
                if child != null {
                    child.parent = parent;
                }

                rebalance(parent);
            }
            deallocate(dead);
            size--;
            return removedValue;
        }
        return null;
    }

    /// Returns the key-value pair corresponding to `key`, or null if it doesn't exist in the Map
    MapEntry<Key, Value>&? find(Key& key) {
        var node = findNode(key);
        if node != null {
            return node.entry;
        }
        return null;
    }

    /// Returns the node corresponding to `key`, or null if it doesn't exist in the Map
    AVLnode<Key, Value>*? findNode(Key& key) {
        var n = root;

        while true {
            if n == null {
                return null;
            }

            if n.entry.key == *key {
                return n;
            }

            var goLeft = n.entry.key > *key;
            n = goLeft ? n.left : n.right;
        }

        return null;
    }

    /// Returns the key immediately smaller than the one given,
    /// or null, if `key` is the smallest in the Map.
    Key&? lowerKey(Key& key) {
        var found = findNode(key);
        if found == null {
            return null;
        }
        var lower = lowerNode(found);

        if lower == null {
            return null;
        }
        return lower.entry.key;
    }

    private AVLnode<Key, Value>* maxInSubtree(AVLnode<Key, Value>* node) {
        var n = node;
        while n.right != null {
            n = n.right;
        }
        return n;
    }

    private AVLnode<Key, Value>* minInSubtree(AVLnode<Key, Value>* node) {
        var n = node;
        while n.left != null {
            n = n.left;
        }
        return n;
    }

    /// Returns the node that contains the key immediately smaller than the key of the given node,
    /// or null, if the key of `node` is the smallest value.
    AVLnode<Key, Value>*? lowerNode(AVLnode<Key, Value>* node) {
        if node.left != null {
            return maxInSubtree(node.left);
        }

        var n = node;
        while n.parent != null {
            if n == n.parent.right {
                return n.parent;
            }
            n = n.parent;
        }
        return null;
    }

    /// Returns the key immediately higher than the one given,
    /// or null, if `key` is the largest in the Map.
    Key&? higherKey(Key& key) {
        var found = findNode(key);
        if found == null {
            return null;
        }

        var higher = higherNode(found);

        if higher == null {
            return null;
        }
        return higher.entry.key;
    }

    /// Returns the node that contains the key immediately larger than the key of the given node,
    /// or null, if the key of `node` is the largest value.
    AVLnode<Key, Value>*? higherNode(AVLnode<Key, Value>* node) {
        if node.right != null {
            return minInSubtree(node.right);
        }

        var n = node;
        while n.parent != null {
            if n == n.parent.left {
                return n.parent;
            }
            n = n.parent;
        }
        return null;
    }

    /// Returns the smallest element in the Map, or null if the Map is empty.
    Key&? first() {
        if root == null {
            return null;
        }
        return minInSubtree(root).entry.key;
    }

    /// Returns the node with the smallest key in the Map, or null if the Map is empty.
    AVLnode<Key, Value>*? firstNode() {
        if root == null {
            return null;
        }
        return minInSubtree(root);
    }

    /// Returns the largest element in the Map, or null if the map is empty.
    Key&? last() {
        if root == null {
            return null;
        }
        return maxInSubtree(root).entry.key;
    }

    /// Returns the node with the largest key in the Map, or null if the Map is empty.
    AVLnode<Key, Value>*? lastNode() {
        if root == null {
            return null;
        }
        return maxInSubtree(root);
    }

    /// Iterate over the map, in order
    OrderedMapIterator<Key, Value> iterator() {
        return OrderedMapIterator(this);
    }
}

/// One node in the AVL tree
struct AVLnode<Key, Value> {
    private MapEntry<Key, Value> entry;
    private int balance;
    private AVLnode<Key, Value>*? parent;
    private AVLnode<Key, Value>*? left;
    private AVLnode<Key, Value>*? right;

    /// Initializes a node holding the given key and value.
    AVLnode(Key key, AVLnode<Key, Value>*? parent, Value value) {
        this.entry = MapEntry(key, value);
        this.parent = parent;
        this.balance = 0;
        this.left = null;
        this.right = null;
    }

    /// Frees the subtree rooted at this node.
    void deallocate() {
        if left != null {
            left.deallocate();
        }
        if right != null {
            right.deallocate();
        }
        entry.deinit();
        deallocate(&this);
    }
}

/// Iterates over the entries of an ordered map, in order.
struct OrderedMapIterator<Key, Value>: Iterator<MapEntry<Key, Value>&> {
    private AVLnode<Key, Value>*? current;
    private OrderedMap<Key, Value>* map;

    /// Initializes an iterator over the given map.
    OrderedMapIterator(OrderedMap<Key, Value>& map) {
        current = map.firstNode();
        this.map = &map;
    }

    /// Returns true if there are more entries.
    bool hasValue() {
        return current != null;
    }

    /// Returns the current entry.
    MapEntry<Key, Value>& value() {
        return current!.entry;
    }

    /// Advances to the next entry.
    void increment() {
        current = map.higherNode(current!);
    }
}

@test
void testInsertAndContains() {
    var m = OrderedMap<int, int>();
    assert(m.size() == 0);

    m.insert(7, 8);
    assert(m.contains(7));

    for i in 0..10 {
        m.insert(i, i);
        assert(m.contains(i));
    }

    assert(!m.contains(42));
    assert(m.size() == 10);
}

@test
void testInsertAndDelete() {
    var m = OrderedMap<int, int>();

    m.insert(42, 39);
    assert(m.contains(42));

    m.remove(42);
    assert(!m.contains(42));

    for i in 42..79 {
        m.insert(i, 42);
    }

    for i in 42..79 {
        assert(m.contains(i));
        m.remove(i);
        assert(!m.contains(i));
    }
}

@test
void testInsertAndIndex() {
    var m = OrderedMap<int, int>();

    m.insert(42, 39);
    assert(m[42]! == 39);

    m.remove(42);

    for i in 42..79 {
        m.insert(i, i+7);
    }

    for i in 42..79 {
        assert(m[i]! == i+7);

        m.remove(i);
        assert(m[i] == null);
    }
}

@test
void testLowerAndHigher() {
    var m = OrderedMap<int, int>();

    for i in 0..100 {
        m.insert(i, i+6);
    }

    assert(m.lowerKey(0) == null);
    for i in 1..100 {
        assert(m.lowerKey(i)! == i-1);
    }

    assert(m.higherKey(99) == null);
    for i in 0..99 {
        assert(m.higherKey(i)! == i+1);
    }
}

@test
void testRemoveRepairsChildParent() {
    // Removing 1 promotes a child; parent walks must see the rewired link.
    var m = OrderedMap<int, int>();
    for i in 0..4 {
        m.insert(i, i * 10);
    }
    m.remove(1);
    assert(m.size() == 3);
    assert(m.lowerKey(3)! == 2);
    assert(m.higherKey(0)! == 2);
    assert(m.higherKey(2)! == 3);
    assert(m.lowerKey(0) == null);
    assert(m.higherKey(3) == null);
    var expected = 0;
    for e in m {
        if expected == 1 {
            expected++;
        }
        assert(e.key == expected);
        expected++;
    }
    // Promoting to root clears the parent.
    var r = OrderedMap<int, int>();
    r.insert(1, 10);
    r.insert(0, 0);
    r.remove(1);
    assert(r.size() == 1);
    assert(r.lowerKey(0) == null);
    assert(r.higherKey(0) == null);
    for e in r {
        assert(e.key == 0);
    }
}

@test
void testFirstLast() {
    var m = OrderedMap<int, int>();

    m.insert(63, 3);
    m.insert(69, 3);
    m.insert(1, 3);
    m.insert(53, 3);

    assert(m.first()! == 1);
    assert(m.last()! == 69);
}

@test
void testEmptyMapFunctions() {
    var m = OrderedMap<int, int>();

    assert(m.first() == null);
    assert(m.last() == null);
    assert(m.higherKey(48) == null);
    assert(m.lowerKey(42) == null);
}

@test
void testEmptyMapIterator() {
    var map = OrderedMap<int, int>();
    map.insert(1, 2);
    map.insert(1, 2);
    map.remove(1);

    for _ in map {
        assert(false);
    }
}

@test
void testIteratorOrder() {
    var map = OrderedMap<int, int>();

    for i in 0..100 {
        map.insert(i, i-12);
    }

    var called = 0;
    for e in map {
        assert(e.key == called);
        assert(e.value == called - 12);
        called++;
    }

    assert(called == 100);

    map = OrderedMap();

    for i in 0..100 {
        map.insert(99 - i, i-12);
    }

    called = 0;
    // Still in correct order
    for e in map {
        assert(e.key == called);
        assert(e.value == 99 - called - 12);
        called++;
    }

    assert(called == 100);


}

@test
void testUnitMapIterator() {
    var map = OrderedMap<int, int>();
    map.insert(1, 2);
    map.insert(1, 4);

    var count = 0;

    for e in map {
        count++;
        assert(e.key == 1);
    }

    assert(count == 1);
}

@test
void testRemoveReturnValue() {
    var m = OrderedMap<int, int>();
    m.insert(1, 10);
    m.insert(2, 20);

    assert(m.remove(1)! == 10);
    assert(m.size() == 1);
    assert(!m.contains(1));
    assert(m[2]! == 20);

    assert(m.remove(99) == null);
    assert(m.size() == 1);
}

@test
void testClear() {
    var m = OrderedMap<int, int>();
    m.insert(1, 10);
    m.insert(2, 20);

    m.clear();
    assert(m.size() == 0);
    assert(m.empty());
    assert(!m.contains(1));

    m.insert(3, 30);
    assert(m[3]! == 30);
}

@test
void testAllAnyNone() {
    var m = OrderedMap<int, int>();
    m.insert(1, 2);
    m.insert(2, 4);

    assert(m.all(e => e.value % 2 == 0));
    assert(!m.all(e => e.value > 2));
    assert(m.any(e => e.key == 2));
    assert(!m.any(e => e.key == 9));
    assert(m.none(e => e.value % 2 == 1));
    assert(!m.none(e => e.value == 4));

    assert(m.all((MapEntry<int, int>& e) => e.value > 0));
    assert(m.any((MapEntry<int, int>& e) => e.key == 1));
    assert(m.none((MapEntry<int, int>& e) => e.value < 0));
}

void churnHeap() {
    var junk = List<StringBuf>();
    for i in 0..500 {
        var s = StringBuf();
        s.append("zzzzzzzzzzzzzzzzzzzz");
        s.append(i);
        junk.push(s);
    }
}

@test
void testStringBufKeys() {
    var m = OrderedMap<StringBuf, int>();

    var words = ["delta", "albe", "charlie", "bravo"];
    for w, i in words {
        var word = StringBuf();
        word.append(w);
        m.insert(word, i);
    }

    churnHeap();

    assert(m.size() == 4);
    for w, i in words {
        var lookup = StringBuf();
        lookup.append(w);
        assert(m.contains(lookup));
        assert(m[lookup]! == i);
    }

    var previous = StringBuf();
    for e in m {
        assert(previous < e.key);
        previous = StringBuf(string(e.key));
    }
}

@test
void testOwningEntriesClear() {
    var m = OrderedMap<StringBuf, StringBuf>();

    var k1 = StringBuf("one");
    var v1 = StringBuf("1");
    m.insert(k1, v1);
    var k2 = StringBuf("two");
    var v2 = StringBuf("2");
    m.insert(k2, v2);
    assert(m.size() == 2);

    m.clear();
    assert(m.size() == 0);
    assert(m.empty());

    // Destroyed with entries still in it.
    var k3 = StringBuf("three");
    var v3 = StringBuf("3");
    m.insert(k3, v3);
    assert(m.size() == 1);
}

StringBuf numKey(int i) {
    var k = StringBuf("key");
    k.push(char('0' + i));
    return k;
}

@test
void testOwningEntriesRemove() {
    var m = OrderedMap<StringBuf, List<int>>();

    for i in 0..10 {
        var v = List<int>();
        v.push(i);
        m.insert(numKey(i), v);
    }
    assert(m.size() == 10);

    // Remove from the middle (shuffles a successor entry into place).
    var mid = numKey(5);
    var midValue = m.remove(mid)!;
    assert(midValue.size() == 1);
    assert(midValue[0] == 5);
    assert(m.size() == 9);
    assert(!m.contains(mid));

    // Survivors intact, in order.
    var expected = 0;
    for e in m {
        if expected == 5 {
            expected++;
        }
        assert(e.key == numKey(expected));
        assert(e.value.size() == 1);
        assert(e.value[0] == expected);
        expected++;
    }
    assert(expected == 10);

    // Remove everything else.
    for i in 0..10 {
        if i == 5 {
            continue;
        }
        assert(m.remove(numKey(i))!.size() == 1);
    }
    assert(m.size() == 0);
    assert(m.remove(mid) == null);
}
