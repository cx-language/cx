/// An ordered Set that supports fast lookup, insertion and deletion.
struct OrderedSet<Element> {
    private OrderedMap<Element, bool> map;

    /// Initiates an empty Set.
    OrderedSet() {
        map = OrderedMap();
    }

    /// Moves the set out, leaving an empty set in its place.
    OrderedSet<Element> take() {
        return takeFrom(&this, OrderedSet());
    }

    /// Inserts an element into the Set.
    bool insert(Element e) {
        return map.insert(e, false);
    }

    /// Returns true if the Set contains `e`, otherwise false.
    bool contains(Element& e) {
        return map.contains(e);
    }

    /// Removes an element from the Set, returning true if it was there.
    bool remove(Element& e) {
        return map.remove(e) != null;
    }

    /// Returns the value immediately lower than `e`, or `null` if
    /// `e` is the smallest element in the Set.
    Element&? lower(Element& e) {
        return map.lowerKey(e);
    }

    /// Returns the value immediately higher than `e`, or `null` if
    /// `e` is the largest element in the Set.
    Element&? higher(Element& e) {
        return map.higherKey(e);
    }

    /// Returns the smallest element in the Set, or `null` if the Set is empty.
    Element&? first() {
        return map.first();
    }

    /// Returns the largest element in the Set, or `null` if the Set is empty.
    Element&? last() {
        return map.last();
    }

    /// Returns the size of the Set.
    int size() {
        return map.size();
    }

    /// Returns true if the Set is empty, otherwise false.
    bool empty() {
        return map.size() == 0;
    }

    /// Removes all elements from the set.
    void clear() {
        map.clear();
    }

    /// Returns the sum of the elements, or zero if there are none.
    Element sum() { return iterator().sum(); }

    /// Returns true if all elements satisfy the predicate.
    bool all(bool(Element&) predicate) { return all(iterator(), predicate); }

    /// Returns true if all elements satisfy the predicate.
    bool all<T: Copyable>(bool(T) predicate) { return all(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any(bool(Element&) predicate) { return any(iterator(), predicate); }

    /// Returns true if any element satisfies the predicate.
    bool any<T: Copyable>(bool(T) predicate) { return any(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none(bool(Element&) predicate) { return none(iterator(), predicate); }

    /// Returns true if no element satisfies the predicate.
    bool none<T: Copyable>(bool(T) predicate) { return none(iterator(), predicate); }

    /// Iterate over the map, in order
    OrderedSetIterator<Element> iterator() {
        return OrderedSetIterator(this);
    }
}

/// Iterates over the elements of an ordered set, in order.
struct OrderedSetIterator<Element>: Iterator<Element&> {
    private OrderedMapIterator<Element, bool> mapIter;

    /// Initializes an iterator over the given set.
    OrderedSetIterator(OrderedSet<Element>& set) {
        this.mapIter = set.map.iterator();
    }

    /// Returns true if there are more elements.
    bool hasValue() {
        return mapIter.hasValue();
    }

    /// Returns the current element.
    Element& value() {
        return mapIter.value().key;
    }

    /// Advances to the next element.
    void increment() {
        mapIter.increment();
    }

    /// Returns the sum of the remaining elements, or zero if there are none.
    Element sum() {
        return sumRemaining(*this, Element(0));
    }
}

@test
void testInsert() {
    var s = OrderedSet<int>();

    s.insert(42);

    assert(s.contains(42));
    assert(!s.contains(39));
}

@test
void testRemoval() {
    var s = OrderedSet<int>();

    s.insert(42);
    assert(s.contains(42));

    assert(s.remove(42));
    assert(!s.contains(42));
    assert(!s.remove(42));
}

@test
void testDuplicates() {
    var s = OrderedSet<int>();

    s.insert(42);
    s.insert(42);
    assert(s.contains(42));

    s.remove(42);
    assert(!s.contains(42));
}

@test
void testIterator() {
    var s = OrderedSet<int>();

    s.insert(1);
    s.insert(2);
    s.insert(3);
    s.insert(1);
    s.insert(2);
    s.insert(2);

    var a = false;
    var bb = false;
    var ccc = false;

    for e in s {
        if (e == 1) {
            assert(!a);
            a = true;
        } else if (e == 2) {
            assert(!bb);
            bb = true;
        } else if (e == 3) {
            assert(!ccc);
            ccc = true;
        } else {
            assert(false);
        }
    }

    assert(a);
    assert(bb);
    assert(ccc);
}

@test
void testEmptyOrderedSetIterator() {
    var s = OrderedSet<int>();
    s.insert(79);
    s.insert(79);
    s.remove(79);

    for _ in s {
        assert(false);
    }
}

@test
void testUnitOrderedSetIterator() {
    var s = OrderedSet<int>();
    s.insert(79);
    s.insert(79);
    var count = 0;

    for e in s {
        count++;
        assert(e == 79);
    }

    assert(count == 1);
}

@test
void testSetFirstLast() {
    var s = OrderedSet<uint>();

    s.insert(63);
    s.insert(69);
    s.insert(1);
    s.insert(53);

    assert(s.first()! == 1);
    assert(s.last()! == 69);
}

@test
void testSetLowerAndHigher() {
    var m = OrderedSet<int>();

    for i in 0..100 {
        m.insert(i);
    }

    assert(m.lower(0) == null);
    for i in 1..100 {
        assert(m.lower(i)! == i-1);
    }

    assert(m.higher(99) == null);
    for i in 0..99 {
        assert(m.higher(i)! == i+1);
    }
}

@test
void testEmptyOrderedSetFunctions() {
    var s = OrderedSet<uint>();

    assert(s.first() == null);
    assert(s.last() == null);
    assert(s.higher(48) == null);
    assert(s.lower(42) == null);
}

@test
void testSetIteratorOrder() {
    var set = OrderedSet<uint>();

    for i in 0..100 {
        set.insert(uint(i));
    }

    uint called = 0;
    for e in set {
        assert(e == called);
        called++;
    }

    assert(called == 100);

    set.clear();

    for i in 0..100 {
        set.insert(uint(99 - i));
    }

    called = 0;
    // Still in correct order
    for e in set {
        assert(e == called);
        called++;
    }

    assert(called == 100);
}

@test
void testSetRemoveReturnValue() {
    var s = OrderedSet<int>();
    s.insert(1);
    s.insert(2);

    assert(s.remove(1));
    assert(s.size() == 1);
    assert(!s.contains(1));
    assert(!s.remove(99));
    assert(s.size() == 1);
}

@test
void testSetClear() {
    var s = OrderedSet<int>();
    s.insert(1);
    s.insert(2);

    s.clear();
    assert(s.size() == 0);
    assert(s.empty());
    assert(!s.contains(1));

    s.insert(3);
    assert(s.contains(3));
}

@test
void testSetAllAnyNone() {
    var s = OrderedSet<int>();
    s.insert(2);
    s.insert(4);

    assert(s.all(n => n % 2 == 0));
    assert(!s.all(n => n > 2));
    assert(s.any(n => n == 4));
    assert(!s.any(n => n > 10));
    assert(s.none(n => n % 2 == 1));
    assert(!s.none(n => n == 2));

    assert(s.all((int& n) => n > 0));
    assert(s.any((int& n) => n == 2));
    assert(s.none((int& n) => n < 0));
}
