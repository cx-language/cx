// cx functions exported to C++. The `extern "C++"` gives them Itanium-mangled
// names (see cxlib.hpp), so C++ callers link them like any C++ function.

extern "C++" c_int cx_is_even(c_int n) {
    return n % 2 == 0 ? 1 : 0;
}

extern "C++" c_int cx_vec_sum(const CxxVector<c_int>& v) {
    var total = c_int(0);
    for i in 0..v.size() {
        total += v[i];
    }
    return total;
}
