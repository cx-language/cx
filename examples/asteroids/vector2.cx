// 2D vector helpers built on float[2] arrays.

float[2] vectorFromAngle(float angle) {
    return [cos(angle), sin(angle)];
}

float[2] rotated(float[2] v, public float[2] origin, public float angle) {
    var dx = v.x - origin.x;
    var dy = v.y - origin.y;
    var c = cos(angle);
    var s = sin(angle);
    return [c * dx - s * dy + origin.x, s * dx + c * dy + origin.y];
}

float distance(float[2] a, float[2] b) {
    var dx = a.x - b.x;
    var dy = a.y - b.y;
    return sqrt(dx * dx + dy * dy);
}
