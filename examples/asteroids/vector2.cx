// 2D vector helpers built on the standard Vector2 type.

Vector2<float> vectorFromAngle(float angle) {
    return Vector2(cos(angle), sin(angle));
}

Vector2<float> rotated(Vector2<float> v, public Vector2<float> origin, public float angle) {
    var dx = v.x - origin.x;
    var dy = v.y - origin.y;
    var c = cos(angle);
    var s = sin(angle);
    return Vector2(c * dx - s * dy + origin.x, s * dx + c * dy + origin.y);
}

float distance(Vector2<float> a, Vector2<float> b) {
    var dx = a.x - b.x;
    var dy = a.y - b.y;
    return sqrt(dx * dx + dy * dy);
}
