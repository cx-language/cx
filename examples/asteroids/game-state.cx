import "SDL3/SDL.h";

struct GameState {
    Player player;
    List<Asteroid> asteroids;
    uint64 ticks;
    uint64 timeOfLastAsteroidSpawn;
    float asteroidSpawnInterval;

    GameState() {
        player = Player();
        asteroids = List();
        asteroids.push(Asteroid());

        ticks = SDL_GetTicks();
        timeOfLastAsteroidSpawn = ticks;
        asteroidSpawnInterval = 2000;
    }

    void update() {
        var newTicks = SDL_GetTicks();
        var delta = float(newTicks - ticks);
        ticks = newTicks;

        player.update(delta, this);

        for asteroid in asteroids {
            asteroid.update(delta);
        }

        if newTicks - timeOfLastAsteroidSpawn > uint64(asteroidSpawnInterval) {
            asteroids.push(Asteroid());
            timeOfLastAsteroidSpawn = newTicks;
            asteroidSpawnInterval *= 0.99;
        }
    }

    void render(SDL_Renderer* renderer) {
        player.render(renderer);

        for asteroid in asteroids {
            asteroid.render(renderer);
        }
    }
}
