import "SDL3/SDL.h";
import "stdlib.h";

const maxRotationSpeed = 0.007;
const formVariation = 0.4;
const minSpeed = 0.05;
const maxSpeed = 0.2;
const minSize = 5;
const maxSize = 30;

float randomFloat(float a, float b) {
    return a + float(rand()) / float(RAND_MAX) * (b - a);
}

struct Asteroid {
    float[2] position;
    float[2] velocity;
    float rotation;
    float rotationSpeed;
    float size;
    float[2][8] vertices;

    Asteroid() {
        position = [randomFloat(0, width), randomFloat(0, height)];
        var direction = randomFloat(-pi, pi);
        var speed = randomFloat(minSpeed, maxSpeed);
        velocity = vectorFromAngle(direction) * speed;
        rotation = 0;
        rotationSpeed = randomFloat(-maxRotationSpeed, maxRotationSpeed);
        size = randomFloat(minSize, maxSize);
        vertices = undefined;

        for i in 0..vertices.size() {
            var offset = 1 + randomFloat(-formVariation, formVariation);
            var angle = float(i) / float(vertices.size()) * pi * 2;
            vertices[i] = vectorFromAngle(angle) * (offset * size);
        }
    }

    void update(float delta) {
        position[0] += velocity.x * delta;
        position[1] += velocity.y * delta;
        rotation += rotationSpeed * delta;

        while position.x < 0 position[0] += width;
        while position.y < 0 position[1] += height;
        while position.x >= width position[0] -= width;
        while position.y >= height position[1] -= height;
    }

    void render(SDL_Renderer* renderer) {
        for i in -1...1 {
            for j in -1...1 {
                var diff = [float(i) * width, float(j) * height];

                for k in 0..vertices.size() {
                    var l = (k + 1) % vertices.size();
                    var a = position + vertices[k] + diff;
                    var b = position + vertices[l] + diff;
                    SDL_RenderLine(renderer, a.x, a.y, b.x, b.y);
                }
            }
        }
    }
}
