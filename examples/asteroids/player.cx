import "SDL3/SDL.h";

const turningSpeed = 0.008;
const movementSpeed = 0.002;
const deceleration = 0.002;
const playerSize = 10;

struct Player {
    float[2] position;
    float[2] velocity;
    float direction;
    List<Missile> missiles;
    float timeSinceLastMissileShot;

    Player() {
        position = [width / 2.0, height / 2.0];
        velocity = [0.0, 0.0];
        direction = 0;
        missiles = List();
        timeSinceLastMissileShot = 0;
    }

    void render(SDL_Renderer* renderer) {
        var a = [position.x - playerSize, position.y - playerSize];
        var b = [position.x - playerSize, position.y + playerSize];
        var c = [position.x + playerSize + playerSize, position.y];

        a = rotated(a, origin = position, angle = direction);
        b = rotated(b, origin = position, angle = direction);
        c = rotated(c, origin = position, angle = direction);

        for i in -1...1 {
            for j in -1...1 {
                var diff = [float(i) * width, float(j) * height];
                var aa = a + diff;
                var bb = b + diff;
                var cc = c + diff;
                SDL_RenderLine(renderer, aa.x, aa.y, bb.x, bb.y);
                SDL_RenderLine(renderer, bb.x, bb.y, cc.x, cc.y);
                SDL_RenderLine(renderer, cc.x, cc.y, aa.x, aa.y);
            }
        }

        for missile in missiles {
            missile.render(renderer);
        }
    }

    void update(float delta, GameState& state) {
        if isKeyDown(SDL_SCANCODE_RIGHT) {
            direction += turningSpeed * delta;
        }
        if isKeyDown(SDL_SCANCODE_LEFT) {
            direction -= turningSpeed * delta;
        }
        if isKeyDown(SDL_SCANCODE_UP) {
            velocity[0] += cos(direction) * movementSpeed * delta;
            velocity[1] += sin(direction) * movementSpeed * delta;
        }
        if isKeyDown(SDL_SCANCODE_DOWN) {
            velocity[0] -= cos(direction) * movementSpeed * delta;
            velocity[1] -= sin(direction) * movementSpeed * delta;
        }
        if isKeyDown(SDL_SCANCODE_SPACE) {
            shootMissile();
        }

        position[0] += velocity.x * delta;
        position[1] += velocity.y * delta;
        velocity[0] *= 1 - deceleration * delta;
        velocity[1] *= 1 - deceleration * delta;

        while position.x < 0 position[0] += width;
        while position.y < 0 position[1] += height;
        while position.x >= width position[0] -= width;
        while position.y >= height position[1] -= height;

        timeSinceLastMissileShot += delta;

        for missile in missiles {
            missile.update(delta, state);
        }
    }

    void shootMissile() {
        if timeSinceLastMissileShot > missileCooldown {
            var position = this.position + vectorFromAngle(direction) * float(playerSize) * 2.0 + vectorFromAngle(direction) * float(missileSize);
            missiles.push(Missile(position, direction));
            timeSinceLastMissileShot = 0;
        }
    }
}
