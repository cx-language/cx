import sdl3;

const width = 640;
const height = 480;

const bool[*]? keyState = null;

bool isKeyDown(SDL_Scancode key) {
    return keyState![key];
}

void main() {
    if !SDL_Init(SDL_INIT_VIDEO) {
        println(SDL_GetError()!);
        return;
    }
    defer SDL_Quit();

    var window = SDL_CreateWindow("cx Asteroids",
        width, height, SDL_WINDOW_HIGH_PIXEL_DENSITY);

    if window == null {
        println(SDL_GetError()!);
        return;
    }

    defer SDL_DestroyWindow(window);

    var renderer = SDL_CreateRenderer(window, null);

    if renderer == null {
        println(SDL_GetError()!);
        return;
    }

    defer SDL_DestroyRenderer(renderer);
    // Map game coordinates onto the full output at any pixel density.
    SDL_SetRenderLogicalPresentation(renderer, width, height, SDL_LOGICAL_PRESENTATION_STRETCH);

    mainLoop(renderer);
}

void mainLoop(SDL_Renderer* renderer) {
    SDL_Event event = undefined;
    var state = GameState();
    keyState = SDL_GetKeyboardState(null)!;

    while true {
        if SDL_PollEvent(&event) {
            switch event.type {
                case SDL_EVENT_QUIT:
                    return;
                case SDL_EVENT_KEY_DOWN:
                    if event.key.key == SDLK_ESCAPE {
                        return;
                    }
            }
        }

        state.update();

        SDL_SetRenderDrawColor(renderer, 0x00, 0x00, 0x00, 0xFF);
        SDL_RenderClear(renderer);
        SDL_SetRenderDrawColor(renderer, 0xFF, 0xFF, 0xFF, 0xFF);
        state.render(renderer);
        SDL_RenderPresent(renderer);
    }
}
