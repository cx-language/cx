import "SDL3/SDL.h";

const missileSize = 20;
const missileSpeed = 0.3;
const missileCooldown = 200;

struct Missile {
    Vector2<float> position;
    float direction;

    void render(SDL_Renderer* renderer) {
        var a = position;
        var b = tailPosition();
        SDL_RenderLine(renderer, a.x, a.y, b.x, b.y);
    }

    void update(float delta, GameState* state) {
        var velocity = vectorFromAngle(direction) * missileSpeed;
        position = position + velocity * delta;

        for i in 0..state.asteroids.size() {
            var asteroid = state.asteroids[i];

            if distance(asteroid.position, position) <= asteroid.size ||
                distance(asteroid.position, tailPosition()) <= asteroid.size {
                state.asteroids.removeAt(i);
                break; // state.asteroids has been mutated, stop iteration.
            }
        }
    }

    Vector2<float> tailPosition() {
        return rotated(position - Vector2(float(missileSize), 0.0), origin = position, angle = direction);
    }
}
