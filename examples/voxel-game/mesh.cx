import "GLFW/glfw3.h";

// Non-indexed triangle mesh with separate position, normal, color, and
// UV buffers (one vertex per corner, three corners per triangle).
struct Mesh {
    uint vao;
    uint positionVbo;
    uint normalVbo;
    uint colorVbo;
    uint uvVbo;
    int vertexCount;
}

void initMesh(Mesh& mesh, float[] positions, float[] normals, float[] colors, float[] uvs) {
    assert(positions.size() == normals.size());
    assert(positions.size() == colors.size());
    assert(positions.size() % 3 == 0);
    assert(uvs.size() * 3 == positions.size() * 2);
    mesh.vertexCount = positions.size() / 3;

    glGenVertexArrays(1, &mesh.vao);
    glBindVertexArray(mesh.vao);

    glGenBuffers(1, &mesh.positionVbo);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.positionVbo);
    glBufferData(GL_ARRAY_BUFFER, positions.size() * 4, positions.data(), GL_STATIC_DRAW);
    glEnableVertexAttribArray(0);
    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 0, null);

    glGenBuffers(1, &mesh.normalVbo);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.normalVbo);
    glBufferData(GL_ARRAY_BUFFER, normals.size() * 4, normals.data(), GL_STATIC_DRAW);
    glEnableVertexAttribArray(1);
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 0, null);

    glGenBuffers(1, &mesh.colorVbo);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.colorVbo);
    glBufferData(GL_ARRAY_BUFFER, colors.size() * 4, colors.data(), GL_STATIC_DRAW);
    glEnableVertexAttribArray(2);
    glVertexAttribPointer(2, 3, GL_FLOAT, GL_FALSE, 0, null);

    glGenBuffers(1, &mesh.uvVbo);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.uvVbo);
    glBufferData(GL_ARRAY_BUFFER, uvs.size() * 4, uvs.data(), GL_STATIC_DRAW);
    glEnableVertexAttribArray(3);
    glVertexAttribPointer(3, 2, GL_FLOAT, GL_FALSE, 0, null);

    glBindVertexArray(0);
}

void drawMesh(Mesh& mesh) {
    glBindVertexArray(mesh.vao);
    glDrawArrays(GL_TRIANGLES, 0, mesh.vertexCount);
    glBindVertexArray(0);
}

void drawMeshLines(Mesh& mesh) {
    glBindVertexArray(mesh.vao);
    glDrawArrays(GL_LINES, 0, mesh.vertexCount);
    glBindVertexArray(0);
}

void destroyMesh(Mesh& mesh) {
    glDeleteVertexArrays(1, &mesh.vao);
    glDeleteBuffers(1, &mesh.positionVbo);
    glDeleteBuffers(1, &mesh.normalVbo);
    glDeleteBuffers(1, &mesh.colorVbo);
    glDeleteBuffers(1, &mesh.uvVbo);
}

void pushCorner(List<float>& dst, Vector3<float> v) {
    dst.push(v.x);
    dst.push(v.y);
    dst.push(v.z);
}

void pushTri(List<float>& positions, List<float>& normals, Vector3<float> a, Vector3<float> b, Vector3<float> c, Vector3<float> n) {
    pushCorner(positions, a);
    pushCorner(positions, b);
    pushCorner(positions, c);
    pushCorner(normals, n);
    pushCorner(normals, n);
    pushCorner(normals, n);
}

void pushQuad(List<float>& positions, List<float>& normals, Vector3<float> a, Vector3<float> b, Vector3<float> c, Vector3<float> d, Vector3<float> n) {
    pushTri(positions, normals, a, b, c, n);
    pushTri(positions, normals, a, c, d, n);
}

void pushLine(List<float>& positions, List<float>& normals, Vector3<float> a, Vector3<float> b) {
    pushCorner(positions, a);
    pushCorner(positions, b);
    var up = Vector3(0.0, 1.0, 0.0);
    pushCorner(normals, up);
    pushCorner(normals, up);
}

void pushLineColor(List<float>& colors, Vector3<float> color) {
    for _ in 0..2 {
        colors.push(color.x);
        colors.push(color.y);
        colors.push(color.z);
    }
}

void pushUV(List<float>& uvs, float u, float v) {
    uvs.push(u);
    uvs.push(v);
}

void pushTriUV(List<float>& uvs, float au, float av, float bu, float bv, float cu, float cv) {
    pushUV(uvs, au, av);
    pushUV(uvs, bu, bv);
    pushUV(uvs, cu, cv);
}

void pushLineUV(List<float>& uvs) {
    pushUV(uvs, 0.0, 0.0);
    pushUV(uvs, 0.0, 0.0);
}
