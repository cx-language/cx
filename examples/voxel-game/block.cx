// Block ids, face ids, and per-block colors.

const uint8 blockAir = 0;
const uint8 blockGrass = 1;
const uint8 blockDirt = 2;
const uint8 blockStone = 3;
const uint8 blockSand = 4;
const uint8 blockWood = 5;
const uint8 blockLeaves = 6;

const int faceTop = 0;
const int faceBottom = 1;
const int facePX = 2;
const int faceNX = 3;
const int facePZ = 4;
const int faceNZ = 5;

Vec3 dirtColor() {
    return Vec3(0.5, 0.35, 0.2);
}

Vec3 blockColor(uint8 block, int face) {
    if block == blockGrass {
        if face == faceTop {
            return Vec3(0.35, 0.75, 0.25);
        }
        return dirtColor();
    }
    if block == blockDirt {
        return dirtColor();
    }
    if block == blockStone {
        return Vec3(0.5, 0.5, 0.5);
    }
    if block == blockSand {
        return Vec3(0.85, 0.8, 0.6);
    }
    if block == blockWood {
        return Vec3(0.45, 0.3, 0.15);
    }
    if block == blockLeaves {
        return Vec3(0.2, 0.55, 0.2);
    }
    return Vec3(1.0, 0.0, 1.0);
}
