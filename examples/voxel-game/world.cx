// Voxel world: chunk storage, terrain generation, trees, and meshing.

const int chunkW = 16;
const int chunkH = 64;
const int chunkD = 16;

struct Chunk: Copyable {
    int cx;
    int cz;
    uint8[16 * 64 * 16] blocks;
    Mesh mesh;
    bool hasMesh;
}

struct World {
    int chunksX;
    int chunksZ;
    List<Chunk> chunks;
}

int blockIndex(int x, int y, int z) {
    return x + z * chunkW + y * chunkW * chunkD;
}

Chunk*? worldChunk(World& w, int cx, int cz) {
    if cx < 0 || cz < 0 || cx >= w.chunksX || cz >= w.chunksZ {
        return null;
    }
    return &w.chunks[cz * w.chunksX + cx];
}

uint8 worldGet(World& w, int x, int y, int z) {
    if y < 0 {
        return blockStone;
    }
    if y >= chunkH {
        return blockAir;
    }
    if x < 0 || z < 0 {
        return blockStone;
    }
    var c = worldChunk(w, x / chunkW, z / chunkD);
    if c == null {
        return blockStone;
    }
    return c.blocks[blockIndex(x % chunkW, y, z % chunkD)];
}

void worldSet(World& w, int x, int y, int z, uint8 b) {
    if y < 0 || y >= chunkH || x < 0 || z < 0 {
        return;
    }
    var c = worldChunk(w, x / chunkW, z / chunkD);
    if c == null {
        return;
    }
    c.blocks[blockIndex(x % chunkW, y, z % chunkD)] = b;
}

void genChunkTerrain(Chunk& c) {
    for x in 0..chunkW {
        for z in 0..chunkD {
            var gx = c.cx * chunkW + x;
            var gz = c.cz * chunkD + z;
            var h = terrainHeight(gx, gz);
            for y in 0..h {
                var b = blockStone;
                if y == h - 1 {
                    if h <= 20 {
                        b = blockSand;
                    } else {
                        b = blockGrass;
                    }
                } else if y >= h - 4 {
                    if h <= 20 {
                        b = blockSand;
                    } else {
                        b = blockDirt;
                    }
                }
                c.blocks[blockIndex(x, y, z)] = b;
            }
        }
    }
}

Chunk makeChunk(int cx, int cz) {
    Chunk c = undefined;
    c.cx = cx;
    c.cz = cz;
    c.hasMesh = false;
    var blockCount = chunkW * chunkH * chunkD;
    for i in 0..blockCount {
        c.blocks[i] = blockAir;
    }
    genChunkTerrain(c);
    return c;
}

void plantTrees(World& w) {
    for ci in 0..w.chunks.size() {
        var c = w.chunks[ci];
        for x in 0..chunkW {
            for z in 0..chunkD {
                var gx = c.cx * chunkW + x;
                var gz = c.cz * chunkD + z;
                if hash01(gx * 3 + 5, gz * 3 + 11) > 0.0015 {
                    continue;
                }
                var h = terrainHeight(gx, gz);
                if h + 8 >= chunkH {
                    continue;
                }
                if worldGet(w, gx, h - 1, gz) != blockGrass {
                    continue;
                }
                for t in 0..4 {
                    worldSet(w, gx, h + t, gz, blockWood);
                }
                for dy in 2..5 {
                    var r = 2;
                    if dy == 4 {
                        r = 1;
                    }
                    var lo = -r;
                    var hi = r + 1;
                    for ox in lo..hi {
                        for oz in lo..hi {
                            if ox == 0 && oz == 0 && dy < 4 {
                                continue;
                            }
                            if worldGet(w, gx + ox, h + dy, gz + oz) == blockAir {
                                worldSet(w, gx + ox, h + dy, gz + oz, blockLeaves);
                            }
                        }
                    }
                }
            }
        }
    }
}

void pushFaceColor(List<float>& colors, float[3] color) {
    for _ in 0..6 {
        colors.push(color.x);
        colors.push(color.y);
        colors.push(color.z);
    }
}

// UVs for one block face under orientation variant (0-7: four
// rotations, plus mirror when variant >= 4). Corner order matches
// pushQuad: triangulation and lighting are unaffected.
void pushFaceUV(List<float>& uvs, int tile, int variant) {
    var t = tileUV(tile);
    var au = t.u0;
    var av = t.v0;
    var bu = t.u1;
    var bv = t.v0;
    var cu = t.u1;
    var cv = t.v1;
    var du = t.u0;
    var dv = t.v1;
    if variant >= 4 {
        var tmp = au;
        au = bu;
        bu = tmp;
        tmp = cu;
        cu = du;
        du = tmp;
        variant -= 4;
    }
    if variant == 1 {
        var tu = au;
        var tv = av;
        au = bu;
        av = bv;
        bu = cu;
        bv = cv;
        cu = du;
        cv = dv;
        du = tu;
        dv = tv;
    } else if variant == 2 {
        var tu = au;
        var tv = av;
        au = cu;
        av = cv;
        cu = tu;
        cv = tv;
        tu = bu;
        tv = bv;
        bu = du;
        bv = dv;
        du = tu;
        dv = tv;
    } else if variant == 3 {
        var tu = au;
        var tv = av;
        au = du;
        av = dv;
        du = cu;
        dv = cv;
        cu = bu;
        cv = bv;
        bu = tu;
        bv = tv;
    }
    pushTriUV(uvs, au, av, bu, bv, cu, cv);
    pushTriUV(uvs, au, av, cu, cv, du, dv);
}

void pushBlockFace(List<float>& positions, List<float>& normals, List<float>& colors, List<float>& uvs, int x, int y, int z, int face, int tile) {
    var ox = float(x);
    var oy = float(y);
    var oz = float(z);
    if face == faceTop {
        pushQuad(positions, normals,
            [ox, oy + 1.0, oz], [ox, oy + 1.0, oz + 1.0],
            [ox + 1.0, oy + 1.0, oz + 1.0], [ox + 1.0, oy + 1.0, oz],
            [0.0, 1.0, 0.0]);
    } else if face == faceBottom {
        pushQuad(positions, normals,
            [ox, oy, oz], [ox + 1.0, oy, oz],
            [ox + 1.0, oy, oz + 1.0], [ox, oy, oz + 1.0],
            [0.0, -1.0, 0.0]);
    } else if face == facePX {
        pushQuad(positions, normals,
            [ox + 1.0, oy, oz], [ox + 1.0, oy, oz + 1.0],
            [ox + 1.0, oy + 1.0, oz + 1.0], [ox + 1.0, oy + 1.0, oz],
            [1.0, 0.0, 0.0]);
    } else if face == faceNX {
        pushQuad(positions, normals,
            [ox, oy, oz + 1.0], [ox, oy, oz],
            [ox, oy + 1.0, oz], [ox, oy + 1.0, oz + 1.0],
            [-1.0, 0.0, 0.0]);
    } else if face == facePZ {
        pushQuad(positions, normals,
            [ox, oy, oz + 1.0], [ox + 1.0, oy, oz + 1.0],
            [ox + 1.0, oy + 1.0, oz + 1.0], [ox, oy + 1.0, oz + 1.0],
            [0.0, 0.0, 1.0]);
    } else {
        pushQuad(positions, normals,
            [ox + 1.0, oy, oz], [ox, oy, oz],
            [ox, oy + 1.0, oz], [ox + 1.0, oy + 1.0, oz],
            [0.0, 0.0, -1.0]);
    }
    pushFaceColor(colors, [1.0, 1.0, 1.0]);
    pushFaceUV(uvs, tile, faceVariant(tile, x, y, z, face));
}

void buildChunkMesh(World& w, Chunk& c) {
    if c.hasMesh {
        destroyMesh(c.mesh);
        c.hasMesh = false;
    }
    var positions = List<float>();
    var normals = List<float>();
    var colors = List<float>();
    var uvs = List<float>();
    int[6] dx = [0, 0, 1, -1, 0, 0];
    int[6] dy = [1, -1, 0, 0, 0, 0];
    int[6] dz = [0, 0, 0, 0, 1, -1];
    for x in 0..chunkW {
        for y in 0..chunkH {
            for z in 0..chunkD {
                var b = c.blocks[blockIndex(x, y, z)];
                if b == blockAir {
                    continue;
                }
                var gx = c.cx * chunkW + x;
                var gy = y;
                var gz = c.cz * chunkD + z;
                for f in 0..6 {
                    if worldGet(w, gx + dx[f], gy + dy[f], gz + dz[f]) == blockAir {
                        pushBlockFace(positions, normals, colors, uvs, gx, gy, gz, f, tileForBlock(b, f));
                    }
                }
            }
        }
    }
    initMesh(c.mesh, positions, normals, colors, uvs);
    c.hasMesh = true;
}

World makeWorldData(int chunksX, int chunksZ) {
    World w = World(chunksX = chunksX, chunksZ = chunksZ, chunks = List<Chunk>());
    for cz in 0..chunksZ {
        for cx in 0..chunksX {
            w.chunks.push(makeChunk(cx, cz));
        }
    }
    plantTrees(w);
    return w;
}

void buildAllMeshes(World& w) {
    for i in 0..w.chunks.size() {
        buildChunkMesh(w, w.chunks[i]);
    }
}

World makeWorld(int chunksX, int chunksZ) {
    var w = makeWorldData(chunksX, chunksZ);
    buildAllMeshes(w);
    return w;
}

void destroyWorld(World& w) {
    for i in 0..w.chunks.size() {
        var c = w.chunks[i];
        if c.hasMesh {
            destroyMesh(c.mesh);
            c.hasMesh = false;
        }
    }
}
