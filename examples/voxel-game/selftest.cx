import "GLFW/glfw3.h";

void expectNear(float64 actual, float64 expected, string label) {
    if abs(actual - expected) > 0.001 {
        println("FAIL: ", label, " got ", actual, " want ", expected);
        abort("self-test failed");
    }
}

void testMath() {
    var a = Vector3(1.0, 0.0, 0.0);
    var b = Vector3(0.0, 1.0, 0.0);
    expectNear(a.dot(b), 0.0, "dot perpendicular");
    expectNear(a.dot(a), 1.0, "dot self");
    var c = a.cross(b);
    expectNear(c.x, 0.0, "cross x");
    expectNear(c.y, 0.0, "cross y");
    expectNear(c.z, 1.0, "cross z");
    expectNear(Vector3(3.0, 4.0, 0.0).length(), 5.0, "length");
    expectNear(Vector3(0.0, 0.0, 7.0).normalized().z, 1.0, "normalized");
    var scaled = 2.0 * Vector3(1.0, 2.0, 3.0);
    expectNear(scaled.y, 4.0, "scalar mul left");
    var added = Vector3(1.0, 1.0, 1.0) + Vector3(2.0, 3.0, 4.0);
    expectNear(added.z, 5.0, "add");

    var ident = mat4Identity();
    var p = mat4Perspective(radians(90.0), 1.0, 0.1, 100.0);
    var q = ident * p;
    for i in 0..16 {
        expectNear(q.m[i], p.m[i], "identity mul");
    }
    expectNear(p.m[0], 1.0, "perspective m0");
    expectNear(p.m[5], 1.0, "perspective m5");
    expectNear(p.m[11], -1.0, "perspective m11");

    var eye = Vector3(0.0, 0.0, 3.0);
    var view = mat4LookAt(eye, Vector3(0.0, 0.0, 0.0), Vector3(0.0, 1.0, 0.0));
    expectNear(view.m[14], -3.0, "lookAt translate");
    println("math ok");
}

void testNoise() {
    var h0 = terrainHeight(0, 0);
    if h0 < 10 || h0 > 45 {
        abort("self-test: terrainHeight(0, 0) out of range");
    }
    if terrainHeight(0, 0) != h0 {
        abort("self-test: terrainHeight not deterministic");
    }
    var different = false;
    for x in 0..32 {
        if terrainHeight(x, 7) != h0 {
            different = true;
        }
    }
    if !different {
        abort("self-test: terrain is flat");
    }
    println("noise ok");
}

int topSolid(World* w, int x, int z) {
    var y = chunkH - 1;
    while y >= 0 {
        if worldGet(w, x, y, z) != blockAir {
            return y;
        }
        y--;
    }
    return -1;
}

void testPlayer() {
    var world = makeWorldData(2, 2);
    var top = topSolid(world, 16, 16);
    var player = Player(pos = Vector3(16.5, 50.0, 16.5), vel = Vector3(0.0, 0.0, 0.0),
        yaw = 0.0, pitch = 0.0, onGround = false);
    var input = Input();
    for _ in 0..240 {
        updatePlayer(world, player, input, 1.0 / 60.0);
    }
    if !player.onGround {
        abort("self-test: player did not land");
    }
    expectNear(player.pos.y, float(top) + 1.0, "landing height");

    input.jump = true;
    updatePlayer(world, player, input, 1.0 / 60.0);
    input.jump = false;
    if player.onGround {
        abort("self-test: jump did not lift off");
    }
    var maxY = player.pos.y;
    for _ in 0..240 {
        updatePlayer(world, player, input, 1.0 / 60.0);
        if player.pos.y > maxY {
            maxY = player.pos.y;
        }
    }
    if !player.onGround {
        abort("self-test: player did not land after jump");
    }
    if maxY < float(top) + 2.0 {
        abort("self-test: jump too low");
    }

    var g = topSolid(world, 16, 16);
    for x in 14..22 {
        for y in g - 1..g + 5 {
            for z in 15..18 {
                worldSet(world, x, y, z, blockAir);
            }
        }
    }
    for x in 14..22 {
        for z in 15..18 {
            worldSet(world, x, g - 1, z, blockStone);
        }
    }
    for y in g..g + 5 {
        for z in 15..18 {
            worldSet(world, 20, y, z, blockStone);
        }
    }
    player.pos = Vector3(16.5, float(g) + 0.5, 16.5);
    player.vel = Vector3(0.0, 0.0, 0.0);
    player.yaw = pi / 2.0;
    player.onGround = false;
    input.forward = true;
    for _ in 0..240 {
        updatePlayer(world, player, input, 1.0 / 60.0);
    }
    input.forward = false;
    println("wall stop x: ", player.pos.x);
    if player.pos.x > 19.8 || player.pos.x < 19.0 {
        abort("self-test: wall stop wrong");
    }
    if !player.onGround {
        abort("self-test: player not grounded after walk");
    }
    println("player ok");
}

void checkAppendPrintable(int value, string want) {
    var b = StringBuffer();
    b.append(value);
    if !(b == want) {
        abort("self-test: append failed");
    }
}

void testAppendPrintable() {
    checkAppendPrintable(0, "0");
    checkAppendPrintable(7, "7");
    checkAppendPrintable(42, "42");
    checkAppendPrintable(120, "120");
    checkAppendPrintable(1000, "1000");
    checkAppendPrintable(-35, "-35");
    var b = StringBuffer("fps=");
    b.append(60);
    if !(b == "fps=60") {
        abort("self-test: append suffix failed");
    }
    println("append ok");
}

void testLogStream() {
    stdout().writeln("logstream ", "ok");
    println("stdout ok");
}

void testLook() {
    var world = makeWorldData(1, 1);
    var player = Player(pos = Vector3(8.5, 50.0, 8.5), vel = Vector3(0.0, 0.0, 0.0),
        yaw = 0.0, pitch = 0.0, onGround = false);
    var input = Input();
    input.lookDX = 100.0;
    input.lookDY = 60.0;
    updatePlayer(world, player, input, 1.0 / 60.0);
    expectNear(player.yaw, 0.3, "look yaw");
    expectNear(player.pitch, -0.18, "look pitch");
    input.lookDX = 0.0;
    input.lookDY = -10000.0;
    updatePlayer(world, player, input, 1.0 / 60.0);
    expectNear(player.pitch, 1.55, "pitch clamp up");
    input.lookDY = 10000.0;
    updatePlayer(world, player, input, 1.0 / 60.0);
    expectNear(player.pitch, -1.55, "pitch clamp down");
    var dir = lookDir(player);
    if dir.y > -0.99 {
        abort("self-test: look down dir wrong");
    }
    println("look ok");
}

void testRaycast() {
    var world = makeWorldData(2, 2);
    var top = topSolid(world, 5, 5);
    var hit = raycastVoxel(world, Vector3(5.5, 60.0, 5.5), Vector3(0.0, -1.0, 0.0), 100.0);
    if !hit.hit || hit.x != 5 || hit.y != top || hit.z != 5 {
        abort("self-test: vertical raycast missed");
    }
    if hit.px != 5 || hit.py != top + 1 || hit.pz != 5 {
        abort("self-test: vertical raycast prev cell wrong");
    }
    worldSet(world, 8, 50, 5, blockStone);
    var side = raycastVoxel(world, Vector3(5.5, 50.5, 5.5), Vector3(1.0, 0.0, 0.0), 10.0);
    if !side.hit || side.x != 8 || side.y != 50 || side.z != 5 {
        abort("self-test: horizontal raycast missed");
    }
    if side.px != 7 || side.py != 50 || side.pz != 5 {
        abort("self-test: horizontal raycast prev cell wrong");
    }
    var short = raycastVoxel(world, Vector3(5.5, 50.5, 5.5), Vector3(1.0, 0.0, 0.0), 2.0);
    if short.hit {
        abort("self-test: raycast ignored maxDist");
    }
    var sky = raycastVoxel(world, Vector3(5.5, 60.0, 5.5), Vector3(0.0, 1.0, 0.0), 10.0);
    if sky.hit {
        abort("self-test: sky raycast hit");
    }
    println("raycast ok");
}

void testWorld(World* w) {
    if worldGet(w, 0, 0, 0) != blockStone {
        abort("self-test: expected stone at y=0");
    }
    if worldGet(w, 0, 63, 0) != blockAir {
        abort("self-test: expected air at y=63");
    }
    if worldGet(w, -1, 10, 0) != blockStone {
        abort("self-test: expected solid outside world");
    }
    var h = terrainHeight(5, 5);
    var top = worldGet(w, 5, h - 1, 5);
    if top != blockGrass && top != blockSand {
        abort("self-test: unexpected surface block");
    }
    var solid = 0;
    for x in 0..32 {
        for z in 0..32 {
            for y in 0..64 {
                if worldGet(w, x, y, z) != blockAir {
                    solid++;
                }
            }
        }
    }
    println("solid blocks: ", solid);
    if solid < 10000 {
        abort("self-test: too few solid blocks");
    }
    var verts = 0;
    for i in 0..w.chunks.size() {
        verts += w.chunks[i].mesh.vertexCount;
    }
    println("mesh vertices: ", verts);
    if verts < 1000 {
        abort("self-test: mesh too small");
    }
    println("world ok");
}

void testTexture() {
    if tileForBlock(blockGrass, faceTop) != tileGrassTop {
        abort("self-test: grass top tile wrong");
    }
    if tileForBlock(blockGrass, facePX) != tileGrassSide {
        abort("self-test: grass side tile wrong");
    }
    if tileForBlock(blockGrass, faceBottom) != tileDirt {
        abort("self-test: grass bottom tile wrong");
    }
    if tileForBlock(blockDirt, faceTop) != tileDirt {
        abort("self-test: dirt tile wrong");
    }
    if tileForBlock(blockWood, faceTop) != tileWoodTop {
        abort("self-test: wood top tile wrong");
    }
    if tileForBlock(blockWood, faceNX) != tileWoodSide {
        abort("self-test: wood side tile wrong");
    }
    if tileForBlock(blockLeaves, facePZ) != tileLeaves {
        abort("self-test: leaves tile wrong");
    }
    var uv = tileUV(tileGrassSide);
    var inset0 = uv.u0 * float(atlasWidth) - float(tileGrassSide * tileSize);
    if inset0 <= 0.0 || inset0 >= 0.5 {
        abort("self-test: atlas u0 inset wrong");
    }
    var inset1 = float((tileGrassSide + 1) * tileSize) - uv.u1 * float(atlasWidth);
    if inset1 <= 0.0 || inset1 >= 0.5 {
        abort("self-test: atlas u1 inset wrong");
    }
    expectNear(uv.u1 - uv.u0, 0.125, "tile span");
    expectNear(uv.v0, 0.0, "tile v0");
    expectNear(uv.v1, 1.0, "tile v1");
    var dirt = tilePixel(tileDirt, 3, 3);
    if dirt.r < 100 || dirt.r > 160 || dirt.g < 60 || dirt.g > 120 || dirt.b < 25 || dirt.b > 80 {
        abort("self-test: dirt texel out of range");
    }
    var edge = tilePixel(tileGrassSide, 0, 15);
    if edge.g < 130 {
        abort("self-test: grass side top row not green");
    }
    var topMax = 0;
    for y in 0..16 {
        for x in 0..16 {
            var gg = tilePixel(tileGrassTop, x, y).g;
            if gg > topMax {
                topMax = gg;
            }
        }
    }
    if topMax > 170 {
        abort("self-test: grass top too bright");
    }
    var soil = tilePixel(tileGrassSide, 0, 0);
    if soil.g > 120 {
        abort("self-test: grass side bottom row not dirt");
    }
    var lastGroove = -100;
    var grooves = 0;
    for x in 0..16 {
        if tilePixel(tileWoodSide, x, 8).r < 103 {
            if grooves > 0 && x - lastGroove != 4 {
                abort("self-test: bark grooves unevenly spaced");
            }
            lastGroove = x;
            grooves++;
        }
    }
    if grooves != 4 {
        abort("self-test: bark groove count wrong");
    }
    var minG = 1000;
    var maxG = -1000;
    for y in 0..16 {
        for x in 0..16 {
            var leaf = tilePixel(tileLeaves, x, y);
            if leaf.g <= leaf.r + 20 || leaf.r > 70 {
                abort("self-test: leaves texel out of range");
            }
            if leaf.g < minG {
                minG = leaf.g;
            }
            if leaf.g > maxG {
                maxG = leaf.g;
            }
        }
    }
    if minG < 115 || maxG > 160 {
        abort("self-test: leaves brightness out of range");
    }
    if maxG - minG < 15 {
        abort("self-test: leaves tile has no variation");
    }
    for i in 0..16 {
        if tilePixel(tileWoodTop, i, 0).r >= 95 || tilePixel(tileWoodTop, i, 15).r >= 95 ||
            tilePixel(tileWoodTop, 0, i).r >= 95 || tilePixel(tileWoodTop, 15, i).r >= 95 {
            abort("self-test: log border not bark");
        }
    }
    int[8] inX = [1, 14, 1, 14, 8, 8, 1, 14];
    int[8] inY = [1, 1, 14, 14, 1, 14, 8, 8];
    for i in 0..8 {
        if tilePixel(tileWoodTop, inX[i], inY[i]).r < 95 {
            abort("self-test: bark thicker than 1px");
        }
    }
    if tilePixel(tileWoodTop, 7, 7).r < 120 {
        abort("self-test: log center not light");
    }
    bool[8] seen = [false, false, false, false, false, false, false, false];
    for x in 0..4 {
        for y in 10..14 {
            for z in 0..4 {
                for f in 0..6 {
                    var v = faceVariant(tileDirt, x, y, z, f);
                    if v < 0 || v > 7 {
                        abort("self-test: face variant out of range");
                    }
                    seen[v] = true;
                    var vd = faceVariant(tileGrassSide, x, y, z, f);
                    if vd != 0 && vd != 4 {
                        abort("self-test: directional tile rotates");
                    }
                    var wb = faceVariant(tileWoodSide, x, y, z, f);
                    if wb != 0 && wb != 4 {
                        abort("self-test: bark tile rotates");
                    }
                }
            }
        }
    }
    var distinct = 0;
    for i in 0..8 {
        if seen[i] == true {
            distinct++;
        }
    }
    if distinct < 5 {
        abort("self-test: face variants not spread");
    }
    var uv0 = List<float>();
    pushFaceUV(uv0, tileDirt, 0);
    var uv2 = List<float>();
    pushFaceUV(uv2, tileDirt, 2);
    var uv4 = List<float>();
    pushFaceUV(uv4, tileDirt, 4);
    if uv0.size() != 12 {
        abort("self-test: face UV count wrong");
    }
    expectNear(uv0[0], 0.25, "face uv u0");
    expectNear(uv0[1], 0.0, "face uv v0");
    expectNear(uv2[0], 0.375, "face uv rot180 u");
    expectNear(uv2[1], 1.0, "face uv rot180 v");
    expectNear(uv4[0], 0.375, "face uv mirror u");
    expectNear(uv4[1], 0.0, "face uv mirror v");
    var a = tilePixel(tileStone, 5, 9);
    var b = tilePixel(tileStone, 5, 9);
    if a.r != b.r || a.g != b.g || a.b != b.b {
        abort("self-test: texture not deterministic");
    }
    println("texture ok");
}

void testRestingContact() {
    var world = makeWorldData(1, 1);
    for x in 0..16 {
        for z in 0..16 {
            for y in 0..11 {
                worldSet(world, x, y, z, blockStone);
            }
            for y in 11..16 {
                worldSet(world, x, y, z, blockAir);
            }
        }
    }
    var player = Player(pos = Vector3(8.5, 11.5, 8.5), vel = Vector3(0.0, 0.0, 0.0),
        yaw = 0.0, pitch = 0.0, onGround = false);
    var input = Input();
    for _ in 0..120 {
        updatePlayer(world, player, input, 1.0 / 60.0);
    }
    if !player.onGround {
        abort("self-test: resting player did not land");
    }
    var restY = player.pos.y;
    for _ in 0..240 {
        updatePlayer(world, player, input, 1.0 / 120.0);
        if player.pos.y != restY {
            abort("self-test: resting player moved");
        }
    }
    for y in 0..11 {
        worldSet(world, 8, y, 7, blockAir);
    }
    input.forward = true;
    var fell = false;
    for _ in 0..240 {
        updatePlayer(world, player, input, 1.0 / 60.0);
        if !player.onGround {
            fell = true;
            break;
        }
    }
    if !fell {
        abort("self-test: ledge drop did not fall");
    }
    var airY = player.pos.y;
    for _ in 0..30 {
        updatePlayer(world, player, input, 1.0 / 60.0);
    }
    if player.pos.y >= airY {
        abort("self-test: ledge drop did not descend");
    }
    println("resting ok");
}

void testCrosshair() {
    var m = crosshairMatrix(1280, 720);
    expectNear(m.m[0], 720.0 / 1280.0, "crosshair aspect");
    expectNear(m.m[5], 1.0, "crosshair y scale");
    expectNear(m.m[10], 1.0, "crosshair z scale");
    expectNear(m.m[15], 1.0, "crosshair w scale");
    println("crosshair ok");
}

void testRender() {
    if glfwInit() == 0 {
        abort("self-test: glfwInit failed");
    }
    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
    glfwWindowHint(GLFW_OPENGL_FORWARD_COMPAT, 1);
    glfwWindowHint(GLFW_VISIBLE, 0);
    glfwWindowHint(GLFW_SAMPLES, 4);
    var window = glfwCreateWindow(64, 64, "self-test", null, null);
    if window == null {
        abort("self-test: window failed");
    }
    glfwMakeContextCurrent(window);

    var world = makeWorld(2, 2);
    testWorld(world);

    var program = createProgram("assets/block.vert", "assets/block.frag");
    var blockTex = createBlockTexture();
    glUseProgram(program);

    glEnable(GL_DEPTH_TEST);
    glViewport(0, 0, 64, 64);
    glClearColor(0.45, 0.65, 1.0, 1.0);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    var proj = mat4Perspective(radians(70.0), 1.0, 0.1, 200.0);
    var eye = Vector3(16.5, 60.0, 16.5);
    var view = mat4LookAt(eye, Vector3(16.5, 0.0, 16.5), Vector3(0.0, 0.0, -1.0));
    var mvp = proj * view;
    var uniforms = getBlockUniforms(program);
    setMat4(uniforms.mvp, mvp);
    bindBlockTexture(uniforms, blockTex);
    setBlockFog(uniforms, eye);
    for i in 0..world.chunks.size() {
        drawMesh(world.chunks[i].mesh);
    }
    checkGlError("self-test draw");

    uint8[64 * 64 * 4] pixels = undefined;
    glReadPixels(0, 0, 64, 64, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
    int center = (32 * 64 + 32) * 4;
    var r = pixels[center];
    var g = pixels[center + 1];
    var bb = pixels[center + 2];
    println("center pixel: ", r, " ", g, " ", bb);
    if bb == 255 {
        abort("self-test: center pixel is sky, terrain missing");
    }
    if int(r) + int(g) + int(bb) < 60 {
        abort("self-test: center pixel too dark");
    }

    var etop = topSolid(world, 10, 10);
    var editor = Player(pos = Vector3(10.5, float(etop) + 3.0, 10.5), vel = Vector3(0.0, 0.0, 0.0),
        yaw = 0.0, pitch = -1.55, onGround = false);
    if !tryBreak(world, editor) {
        abort("self-test: break failed");
    }
    if worldGet(world, 10, etop, 10) != blockAir {
        abort("self-test: break did not clear");
    }
    if !tryPlace(world, editor, blockStone) {
        abort("self-test: place failed");
    }
    if worldGet(world, 10, etop, 10) != blockStone {
        abort("self-test: place did not set");
    }
    editor.pos = Vector3(10.5, float(etop) + 1.1, 10.5);
    if tryPlace(world, editor, blockStone) {
        abort("self-test: place inside player allowed");
    }
    checkGlError("self-test rebuild");
    println("edit ok");
    destroyWorld(world);
    destroyBlockTexture(blockTex);
    glDeleteProgram(program);
    glfwDestroyWindow(window);
    glfwTerminate();
    println("render ok");
}

int runSelfTest() {
    testMath();
    testAppendPrintable();
    testLogStream();
    testNoise();
    testPlayer();
    testLook();
    testRaycast();
    testTexture();
    testCrosshair();
    testRestingContact();
    testRender();
    println("self-test passed");
    return 0;
}
