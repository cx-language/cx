import "GLFW/glfw3.h";

// Procedural 16x16 block textures packed side by side in a 128x16 RGB
// atlas (8 tiles, y = 0 is the bottom row to match GL unpack order).
const int tileSize = 16;
const int tileCount = 8;
const int atlasWidth = 128;
const int atlasHeight = 16;

const int tileGrassTop = 0;
const int tileGrassSide = 1;
const int tileDirt = 2;
const int tileStone = 3;
const int tileSand = 4;
const int tileWoodTop = 5;
const int tileWoodSide = 6;
const int tileLeaves = 7;

int tileForBlock(uint8 block, int face) {
    if block == blockGrass {
        if face == faceTop {
            return tileGrassTop;
        }
        if face == faceBottom {
            return tileDirt;
        }
        return tileGrassSide;
    }
    if block == blockDirt {
        return tileDirt;
    }
    if block == blockStone {
        return tileStone;
    }
    if block == blockSand {
        return tileSand;
    }
    if block == blockWood {
        if face == faceTop || face == faceBottom {
            return tileWoodTop;
        }
        return tileWoodSide;
    }
    if block == blockLeaves {
        return tileLeaves;
    }
    return tileStone;
}

// Tiles with vertical structure must not rotate.
bool tileDirectional(int tile) {
    return tile == tileGrassSide || tile == tileWoodSide;
}

// Orientation variant for a face, from block coords. Uniform tiles get
// 8 orientations (rotation + mirror); directional tiles get 2 (mirror
// only) so vertical structure stays vertical.
int faceVariant(int tile, int x, int y, int z, int face) {
    var h = int(hash2(x * 131 + y * 17 + z * 7 + face * 1009, x - z + face * 31) % 8);
    if tileDirectional(tile) {
        return h % 2 * 4;
    }
    return h;
}

// UV rect for a tile. Edges sit a hair (0.013 texels) inside the tile
// bounds so float rounding can never push a sample into the neighbor
// tile. The inset must stay far below half a texel, which would squash
// edge texels. V needs no inset: the atlas is one tile tall, so
// clamping resolves outer edges to edge texels.
(float u0, float v0, float u1, float v1) tileUV(int tile) {
    var u0 = float(tile * tileSize) / float(atlasWidth) + 0.0001;
    var u1 = float((tile + 1) * tileSize) / float(atlasWidth) - 0.0001;
    var v0 = 0.0;
    var v1 = 1.0;
    return (u0 = u0, v0 = v0, u1 = u1, v1 = v1);
}

// Deterministic brightness delta in [-amount, amount] for a texel.
int texDelta(int tag, int x, int y, int amount) {
    var h = hash01(tag * 1000 + x * tileSize + y, tag + 7);
    return int((h - 0.5) * 2.0 * float(amount));
}

(int r, int g, int b) texel(int r, int g, int b, int d) {
    return (r = clamp(r + d, 0, 255), g = clamp(g + d, 0, 255), b = clamp(b + d, 0, 255));
}

(int r, int g, int b) tilePixel(int tile, int x, int y) {
    if tile == tileGrassTop {
        return texel(71, 153, 51, texDelta(tile, x, y, 12));
    }
    if tile == tileGrassSide {
        var edge = 3 + int(hash01(x + 3000, tile) * 2.0);
        if y >= tileSize - edge {
            return texel(71, 153, 51, texDelta(tile, x, y, 12));
        }
        return texel(128, 89, 51, texDelta(tileDirt, x, y, 14));
    }
    if tile == tileDirt {
        return texel(128, 89, 51, texDelta(tile, x, y, 14));
    }
    if tile == tileStone {
        var d = texDelta(tile, x, y, 8);
        var h = hash01(x + 5000, y + tile);
        if h < 0.07 {
            return texel(96, 96, 96, d);
        }
        if h > 0.93 {
            return texel(160, 160, 160, d);
        }
        return texel(128, 128, 128, d);
    }
    if tile == tileSand {
        return texel(217, 204, 153, texDelta(tile, x, y, 7));
    }
    if tile == tileWoodTop {
        var ex = x;
        if ex > 7 {
            ex = 15 - x;
        }
        var ey = y;
        if ey > 7 {
            ey = 15 - y;
        }
        var edge = ex;
        if ey < edge {
            edge = ey;
        }
        var d = texDelta(tile, x, y, 6);
        if edge == 0 {
            return texel(80, 55, 25, d);
        }
        if edge % 2 == 1 {
            return texel(140, 100, 55, d);
        }
        return texel(115, 77, 38, d);
    }
    if tile == tileWoodSide {
        var d = texDelta(tile, x, y, 8);
        if x % 4 == 0 {
            return texel(88, 58, 28, d);
        }
        return texel(115, 77, 38, d);
    }
    return texel(51, 140, 51, texDelta(tile, x, y, 14));
}

void fillAtlas(uint8[*] pixels) {
    for tile in 0..tileCount {
        for y in 0..tileSize {
            for x in 0..tileSize {
                var c = tilePixel(tile, x, y);
                var i = (y * atlasWidth + tile * tileSize + x) * 3;
                pixels[i] = uint8(c.r);
                pixels[i + 1] = uint8(c.g);
                pixels[i + 2] = uint8(c.b);
            }
        }
    }
}

uint createBlockTexture() {
    uint8[128 * 16 * 3] atlas = undefined;
    fillAtlas(atlas.data());
    uint tex = undefined;
    glGenTextures(1, tex);
    glBindTexture(GL_TEXTURE_2D, tex);
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, atlasWidth, atlasHeight, 0, GL_RGB, GL_UNSIGNED_BYTE, atlas.data());
    return tex;
}

void bindBlockTexture(BlockUniforms* u, uint tex) {
    glActiveTexture(GL_TEXTURE0);
    glBindTexture(GL_TEXTURE_2D, tex);
    setInt(u.blockTex, 0);
}

void destroyBlockTexture(uint tex) {
    glDeleteTextures(1, tex);
}
