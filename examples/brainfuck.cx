struct Tape {
    List<int> cells;
    int pos;

    Tape() {
        cells = List([0]);
        pos = 0;
    }

    int value() {
        return cells[pos];
    }
}

struct Program {
    StringBuf code;
    Map<int, int> bracketMap;

    Program(string text) {
        code = StringBuf();
        bracketMap = Map();

        var leftStack = List<int>();
        var pc = 0;

        for ch in text {
            if !"+-><[].,".contains(ch)
                continue;

            switch ch {
                case '[':
                    leftStack.push(pc);

                case ']':
                    if !leftStack.empty() {
                        var left = leftStack.pop();
                        var right = pc;
                        bracketMap.set(left, right);
                        bracketMap.set(right, left);
                    }
            }

            pc++;
            code.append(ch);
        }
    }
}

void main() {
    var text = readFile("inputs/mandel.b").unwrap();
    var program = Program(string(text));
    var tape = Tape();
    var pc = 0;
    var size = program.code.size();

    while pc < size {
        switch program.code[pc] {
            case '+':
                tape.cells[tape.pos]++;

            case '-':
                tape.cells[tape.pos]--;

            case '>':
                tape.pos++;

                if tape.pos >= tape.cells.size()
                    tape.cells.push(0);

            case '<':
                if tape.pos > 0
                    tape.pos--;

            case '[':
                if tape.value() == 0
                    pc = program.bracketMap[pc]!;

            case ']':
                if tape.value() != 0
                    pc = program.bracketMap[pc]!;

            case '.':
                print(char(tape.value()));
        }

        pc++;
    }
}
