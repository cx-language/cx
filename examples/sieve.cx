// Prime number sieve.
void main() {
    const count = 30;
    var isPrime = List<bool> {};
    for (var i in 0..count) {
        isPrime.push(true);
    }
    for (var i in 2..count) {
        if (!isPrime[i]) continue;
        println(i);
        var j = i * i;
        while (j < count) {
            isPrime[j] = false;
            j += i;
        }
    }
}
