// Filter the error lines out of application logs.
struct LogEntry {
    string level;
    string message;
}

void main() {
    var logs = List([
        LogEntry(level = "INFO", message = "server started"),
        LogEntry(level = "ERROR", message = "disk full"),
        LogEntry(level = "INFO", message = "request handled"),
        LogEntry(level = "ERROR", message = "connection reset")
    ]);
    println(logs.filter(e => e.level == "ERROR").map(e => e.message));
}
